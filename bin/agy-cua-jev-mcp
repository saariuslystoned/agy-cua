MIN_WAIT_TIMEOUT_MS = 0
MAX_WAIT_TIMEOUT_MS = 10_000
SKELETON_SHALLOW_MAX_DEPTH = 2

SNAPSHOT_ID_RE = re.compile(r"^s[0-9a-f]{8,}$")
BROWSER_SNAPSHOT_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$")
BROWSER_REF_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$")
CANDIDATE_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$")
SESSION_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$")
LOOPBACK_RE = re.compile(r"^https?://(?:localhost|127\.0\.0\.1|\[::1\])(?::[0-9]{1,5})?/?$")
BASE64_IMAGE_RE = re.compile(r"data:image/[a-zA-Z0-9.+-]+;base64,|iVBORw0KGgo|/9j/4AAQSkZJRg", re.IGNORECASE)
FORBIDDEN_IMAGE_KEYS = frozenset({
