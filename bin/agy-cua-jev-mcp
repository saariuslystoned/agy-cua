def _parse_checkbox_bool_state(val: Any) -> bool | None:
    if val is None:
        return None
    if isinstance(val, bool):
        return val
    norm = str(val).strip().lower()
    if norm in {"1", "true", "checked", "on"}:
        return True
    if norm in {"0", "false", "unchecked", "off"}:
        return False
    return None

