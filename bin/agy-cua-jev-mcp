class _NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(req.full_url, code, "redirects are disabled", headers, fp)


@dataclass(frozen=True)
class JevRoute:
    kind: str  # "typesafe-hosted", "kev-local", "none"
    reason: str | None = None
    endpoint: str | None = None
    model: str = PINNED_JEV_MODEL
    api_key: str | None = None
    key_source: str | None = None
    timeout_ms: int = DEFAULT_TIMEOUT_MS
    note: str | None = None


@dataclass
class SessionAccounting:
    max_calls: int = DEFAULT_MAX_CALLS
    calls_used: int = 0
    attempts_started: int = 0
    uncertain_calls: int = 0
    input_tokens: int = 0
    output_tokens: int = 0
    halted: bool = False
    halt_reason: str | None = None
    uncertain_side_effects: int = 0
    history_log: list[dict[str, Any]] = field(default_factory=list)

    def to_dict(self) -> dict[str, Any]:
        return {
            "max_calls": self.max_calls,
            "max_attempts_per_call": MAX_ATTEMPTS_PER_CALL,
            "calls_used": self.calls_used,
            "attempts_started": self.attempts_started,
            "uncertain_calls": self.uncertain_calls,
            "uncertain_side_effects": self.uncertain_side_effects,
            "input_tokens": self.input_tokens,
            "output_tokens": self.output_tokens,
            "halted": self.halted,
            "halt_reason": self.halt_reason,
        }


def find_driver(env: Mapping[str, str] = os.environ) -> str | None:
    candidates = [
        env.get("AGY_CUA_DRIVER", ""),
        os.path.expanduser("~/.local/bin/cua-driver"),
        "/Applications/CuaDriver.app/Contents/MacOS/cua-driver",
    ]
    for candidate in candidates:
        if candidate and os.access(candidate, os.X_OK):
            return candidate
    return None


def read_keychain_secret(service: str) -> str | None:
    if sys.platform != "darwin":
        return None
    try:
        proc = subprocess.run(
            ["/usr/bin/security", "find-generic-password", "-s", service, "-w"],
            capture_output=True,
            text=True,
            timeout=3.0,
            check=False,
        )
    except Exception:
        return None
    if proc.returncode != 0:
        return None
    secret = proc.stdout.strip()
    return secret if secret else None


def clamp_timeout_ms(raw: Any) -> int:
    try:
        val = int(raw)
    except (TypeError, ValueError):
        return DEFAULT_TIMEOUT_MS
    if val < MIN_TIMEOUT_MS:
        return DEFAULT_TIMEOUT_MS
    return min(val, MAX_TIMEOUT_MS)


def clamp_driver_timeout_ms(raw: Any) -> int:
    try:
        val = int(raw)
    except (TypeError, ValueError):
        return DEFAULT_DRIVER_TIMEOUT_MS
    if val < MIN_DRIVER_TIMEOUT_MS:
        return DEFAULT_DRIVER_TIMEOUT_MS
    return min(val, MAX_DRIVER_TIMEOUT_MS)


def clamp_max_calls(raw: Any) -> int:
    try:
        val = int(raw)
    except (TypeError, ValueError):
        return DEFAULT_MAX_CALLS
    return max(1, min(val, 256))


def clamp_batch_timeout_ms(raw: Any) -> int:
    if isinstance(raw, bool):
        return DEFAULT_BATCH_TIMEOUT_MS
    try:
        val = int(raw)
    except (TypeError, ValueError):
        return DEFAULT_BATCH_TIMEOUT_MS
    if val <= 0:
        return DEFAULT_BATCH_TIMEOUT_MS
    return max(MIN_BATCH_TIMEOUT_MS, min(val, MAX_BATCH_TIMEOUT_MS))


def is_v1_compat(env: Mapping[str, str] = os.environ) -> bool:
    return (env.get("AGY_CUA_JEV_V1_COMPAT") or "").strip() == "1"


def wake_macos_app_nap(pid: int) -> None:
    if sys.platform != "darwin" or not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return
    try:
        os.kill(pid, signal.SIGCONT)
    except OSError:
        pass


def resolve_session_id(env: Mapping[str, str] = os.environ) -> str:
    raw = (env.get("AGY_CUA_SESSION_ID") or "").strip()
    if raw and SESSION_ID_RE.match(raw):
        return raw
    return f"jev-{os.getpid()}-{uuid.uuid4().hex[:8]}"


def resolve_route(
    env: Mapping[str, str] = os.environ,
    keychain_reader: Callable[[str], str | None] = read_keychain_secret,
) -> JevRoute:
    if env.get("JEV_DISABLED") == "1":
        return JevRoute(kind="none", reason="disabled")
    timeout_ms = clamp_timeout_ms(env.get("AGY_CUA_JEV_TIMEOUT_MS") or env.get("JEV_TIMEOUT_MS"))
    base_url = (env.get("TYPESAFE_BASE_URL") or "").strip()
    if base_url:
        if not LOOPBACK_RE.match(base_url):
            return JevRoute(
                kind="none",
                reason="not-configured",
                note="TYPESAFE_BASE_URL must be a loopback origin (127.0.0.1, localhost, or ::1).",
            )
        parsed = urllib.parse.urlsplit(base_url)
        origin = f"{parsed.scheme}://{parsed.netloc}"
        model = (env.get("AGY_CUA_JEV_MODEL") or env.get("JEV_MODEL") or LOCAL_KEV_MODEL).strip()
        return JevRoute(
            kind="kev-local",
            endpoint=f"{origin}/v1/systemone",
            model=model,
            key_source="loopback",
            timeout_ms=timeout_ms,
        )

    model = (env.get("AGY_CUA_JEV_MODEL") or env.get("JEV_MODEL") or PINNED_JEV_MODEL).strip()
    if model != PINNED_JEV_MODEL:
        return JevRoute(
            kind="none",
            reason="unpinned-model-refused",
            model=model,
            note=f"Hosted Jev requires pinned model {PINNED_JEV_MODEL!r}; got {model!r}.",
        )

    api_key = (env.get("TYPESAFE_API_KEY") or "").strip()
    key_source = "env"
    if not api_key:
        service = (env.get("JEV_KEYCHAIN_SERVICE") or DEFAULT_KEYCHAIN_SERVICE).strip()
        api_key = keychain_reader(service) or ""
        key_source = "keychain"
    if not api_key:
        return JevRoute(
            kind="none",
            reason="credentials-unavailable",
            model=PINNED_JEV_MODEL,
            timeout_ms=timeout_ms,
            note="Store key in macOS Keychain with `bin/agy-cua jev-key` (service 'typesafe-jev').",
        )
    return JevRoute(
        kind="typesafe-hosted",
        endpoint=HOSTED_ENDPOINT,
        model=PINNED_JEV_MODEL,
        api_key=api_key,
        key_source=key_source,
        timeout_ms=timeout_ms,
    )


def describe_status(route: JevRoute, accounting: SessionAccounting, env: Mapping[str, str] = os.environ) -> dict[str, Any]:
    driver = find_driver(env)
    v1_mode = is_v1_compat(env)
    payload: dict[str, Any] = {
        "schema": "agy_cua.jev_status_v1",
        "ready": route.kind != "none" and not accounting.halted,
        "route": route.kind,
        "pinned_model": PINNED_JEV_MODEL,
        "configured_model": route.model,
        "sdk_identity": CLIENT_IDENTITY,
        "controller_profile": "v1_compat" if v1_mode else "v2",
        "max_auto_candidates": MAX_AUTO_CANDIDATES if v1_mode else V2_MAX_AUTO_CANDIDATES,
        "default_wait_timeout_ms": 0 if v1_mode else DEFAULT_V2_WAIT_TIMEOUT_MS,
        "endpoint_origin": urllib.parse.urlsplit(route.endpoint).netloc if route.endpoint else None,
        "timeout_ms": route.timeout_ms,
        "driver_available": bool(driver),
        "driver_path": driver,
        "accounting": accounting.to_dict(),
    }
    if route.key_source:
        payload["key_source"] = route.key_source
    if route.reason:
        payload["reason"] = route.reason
    if route.note:
        payload["note"] = route.note
    return payload


def _contains_forbidden_image_key(obj: Any) -> bool:
    if isinstance(obj, Mapping):
        for k, v in obj.items():
            if str(k).strip().lower() in FORBIDDEN_IMAGE_KEYS:
                return True
            if _contains_forbidden_image_key(v):
                return True
    elif isinstance(obj, (list, tuple)):
        return any(_contains_forbidden_image_key(item) for item in obj)
    return False


def _reject_binary_or_image_payload(raw_json_or_obj: Any, obj: Any = None) -> None:
    if isinstance(raw_json_or_obj, str):
        raw_json = raw_json_or_obj
        target_obj = obj
    else:
        target_obj = raw_json_or_obj
        raw_json = json.dumps(raw_json_or_obj, ensure_ascii=False)
    if (target_obj is not None and _contains_forbidden_image_key(target_obj)) or BASE64_IMAGE_RE.search(raw_json):
        raise ValueError(
            "image_payload_forbidden_in_jev: never pass screenshots and base64 image payloads to Jev"
        )


def _fit_select_request_to_byte_budget(
    req: Mapping[str, Any],
    *,
    max_json_bytes: int,
    referenced_el_ids: set[int] | None = None,
) -> dict[str, Any]:
    """Deterministically compact optional context so valid v2 candidate sets fit max_json_bytes."""
    def _byte_len(obj: Mapping[str, Any]) -> int:
        return len(json.dumps(obj, ensure_ascii=False).encode("utf-8"))

    out = dict(req)
    if _byte_len(out) <= max_json_bytes:
        return out

    raw_els = out.get("elements")
    if isinstance(raw_els, list) and raw_els:
        stripped_els = [
            {k: v for k, v in e.items() if k != "container_path"}
            for e in raw_els
            if isinstance(e, Mapping)
        ]
        out["elements"] = stripped_els
        if _byte_len(out) <= max_json_bytes:
            return out

        if referenced_el_ids:
            ref_els = [e for e in stripped_els if e.get("element_index") in referenced_el_ids]
            if len(ref_els) < len(stripped_els):
                out["elements"] = ref_els
                if _byte_len(out) <= max_json_bytes:
                    return out
                stripped_els = ref_els

        lo_e, hi_e = 0, len(stripped_els)
        best_e = 0
        while lo_e <= hi_e:
            mid_e = (lo_e + hi_e) // 2
            out["elements"] = stripped_els[:mid_e]
            if _byte_len(out) <= max_json_bytes:
                best_e = mid_e
                lo_e = mid_e + 1
            else:
                hi_e = mid_e - 1
        out["elements"] = stripped_els[:best_e]
        if _byte_len(out) <= max_json_bytes:
            return out

    if isinstance(out.get("history"), list) and out["history"]:
        out["history"] = out["history"][-4:]
        if _byte_len(out) <= max_json_bytes:
            return out
        out["history"] = []
        if _byte_len(out) <= max_json_bytes:
            return out

    raw_cands = out.get("candidates")
    if isinstance(raw_cands, list) and raw_cands:
        base_cands = [dict(c) for c in raw_cands if isinstance(c, Mapping)]
        lo_c, hi_c = 16, 1000
        best_c = 16
        while lo_c <= hi_c:
            mid_c = (lo_c + hi_c) // 2
            out["candidates"] = [
                {
                    **c,
                    "description": (str(c.get("description") or "")[:mid_c].rstrip() or str(c.get("id") or "x")[:mid_c]),
                }
                for c in base_cands
            ]
            if _byte_len(out) <= max_json_bytes:
                best_c = mid_c
                lo_c = mid_c + 1
            else:
                hi_c = mid_c - 1
        out["candidates"] = [
            {
                **c,
                "description": (str(c.get("description") or "")[:best_c].rstrip() or str(c.get("id") or "x")[:best_c]),
            }
            for c in base_cands
        ]
    return out


def validate_select_request(
    args: Mapping[str, Any],
    *,
    max_elements: int = MAX_ELEMENTS,
    max_candidates: int = MAX_CANDIDATES,
    max_json_bytes: int = MAX_JSON_BYTES,
) -> dict[str, Any]:
    if not isinstance(args, Mapping):
        raise ValueError("request arguments must be a JSON object")
    raw_json = json.dumps(args, ensure_ascii=False)
    if len(raw_json.encode("utf-8")) > max_json_bytes:
        raise ValueError(f"request exceeds maximum size of {max_json_bytes} bytes")
    _reject_binary_or_image_payload(raw_json, args)

    allowed_keys = {"goal", "pid", "window_id", "snapshot_id", "elements", "history", "candidates"}
    extra_keys = set(args.keys()) - allowed_keys
    if extra_keys:
        raise ValueError(f"unsupported request fields: {sorted(extra_keys)}")

    goal = args.get("goal")
    if not isinstance(goal, str) or not goal.strip() or len(goal) > MAX_GOAL_CHARS:
        raise ValueError(f"goal must be a non-empty string of at most {MAX_GOAL_CHARS} characters")

    pid = args.get("pid")
    window_id = args.get("window_id")
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        raise ValueError("pid must be a positive integer")
    if not isinstance(window_id, int) or isinstance(window_id, bool) or window_id <= 0:
        raise ValueError("window_id must be a positive integer")

    snapshot_id = args.get("snapshot_id")
    if not isinstance(snapshot_id, str) or not SNAPSHOT_ID_RE.match(snapshot_id):
        raise ValueError("snapshot_id must match ^s[0-9a-f]{8,}$")

    raw_elements = args.get("elements", [])
    if not isinstance(raw_elements, list) or len(raw_elements) > max_elements:
        raise ValueError(f"elements must be a list of at most {max_elements} items")
    elements: list[dict[str, Any]] = []
    for item in raw_elements:
        if not isinstance(item, Mapping):
            raise ValueError("each element must be an object")
        el_allowed = {
            "element_index",
            "role",
            "label",
            "state",
            "enabled",
            "depth",
            "in_toolbar",
            "supported_actions",
            "container_path",
        }
        if not set(item.keys()).issubset(el_allowed):
            raise ValueError(f"element contains unsupported fields: {sorted(set(item.keys()) - el_allowed)}")
        role = item.get("role")
        label = item.get("label", "")
        if not isinstance(role, str) or not role.strip():
            raise ValueError("element role must be a non-empty string")
        if label is not None and not isinstance(label, str):
            raise ValueError("element label must be a string")
        entry: dict[str, Any] = {"role": role.strip()[:64], "label": (label or "").strip()[:200]}
        if "element_index" in item:
            idx = item["element_index"]
            if not isinstance(idx, int) or isinstance(idx, bool) or idx < 0:
                raise ValueError("element_index must be a non-negative integer")
            entry["element_index"] = idx
        if "state" in item and item["state"] is not None:
            if not isinstance(item["state"], str):
                raise ValueError("element state must be a string")
            entry["state"] = item["state"][:64]
        if "enabled" in item and item["enabled"] is not None:
            if not isinstance(item["enabled"], bool):
                raise ValueError("element enabled must be a boolean")
            entry["enabled"] = item["enabled"]
        if "depth" in item and item["depth"] is not None:
            depth_val = item["depth"]
            if not isinstance(depth_val, int) or isinstance(depth_val, bool) or depth_val < 0:
                raise ValueError("element depth must be a non-negative integer")
            entry["depth"] = depth_val
        if "in_toolbar" in item and item["in_toolbar"] is not None:
            if not isinstance(item["in_toolbar"], bool):
                raise ValueError("element in_toolbar must be a boolean")
            entry["in_toolbar"] = item["in_toolbar"]
        if "supported_actions" in item and item["supported_actions"] is not None:
            raw_sa = item["supported_actions"]
            if not isinstance(raw_sa, list) or not all(isinstance(a, str) for a in raw_sa):
                raise ValueError("element supported_actions must be a list of strings")
            entry["supported_actions"] = [a.strip()[:32] for a in raw_sa if a.strip()][:8]
        if "container_path" in item and item["container_path"] is not None:
            if not isinstance(item["container_path"], str):
                raise ValueError("element container_path must be a string")
            cp_val = item["container_path"].strip()[:256]
            if cp_val:
                entry["container_path"] = cp_val
        elements.append(entry)

    raw_history = args.get("history", [])
    if not isinstance(raw_history, list) or len(raw_history) > MAX_HISTORY:
        raise ValueError(f"history must be a list of at most {MAX_HISTORY} items")
    history: list[dict[str, str]] = []
    for item in raw_history:
        if not isinstance(item, Mapping) or not set(item.keys()).issubset({"selected_id", "outcome"}):
            raise ValueError("history items may contain only selected_id and outcome")
        selected = item.get("selected_id", "")
        outcome = item.get("outcome", "")
        if not isinstance(selected, str) or not CANDIDATE_ID_RE.match(selected):
            raise ValueError("history selected_id is invalid")
        if not isinstance(outcome, str) or not outcome.strip() or len(outcome) > 128:
            raise ValueError("history outcome must be a non-empty string <= 128 chars")
        history.append({"selected_id": selected, "outcome": outcome.strip()})

    raw_candidates = args.get("candidates")
    if not isinstance(raw_candidates, list) or len(raw_candidates) < 1:
        raise ValueError("candidates must be a non-empty list")

    candidates: list[dict[str, str]] = []
    seen_ids: set[str] = set()
    for item in raw_candidates:
        if not isinstance(item, Mapping):
            raise ValueError("each candidate must be an object")
        cid = item.get("id")
        desc = item.get("description")
        if not isinstance(cid, str) or not CANDIDATE_ID_RE.match(cid):
            raise ValueError(f"invalid candidate id: {cid!r}")
        if cid in seen_ids:
            raise ValueError(f"duplicate candidate id: {cid!r}")
        if not isinstance(desc, str) or not desc.strip() or len(desc) > 1000:
            raise ValueError(f"candidate {cid!r} description must be a non-empty string <= 1000 chars")
        seen_ids.add(cid)
        candidates.append({"id": cid, "description": desc.strip()})

    for reserved_id, reserved_desc in RESERVED_CANDIDATES.items():
        if reserved_id not in seen_ids:
            candidates.append({"id": reserved_id, "description": reserved_desc})
            seen_ids.add(reserved_id)

    if len(candidates) < 2 or len(candidates) > max_candidates:
        raise ValueError(f"total candidates (including reobserve/abstain) must be between 2 and {max_candidates}")

    executable_count = sum(1 for c in candidates if c["id"] not in RESERVED_CANDIDATES)
    if executable_count < 1:
        raise ValueError("at least one executable candidate is required besides reobserve and abstain")

    return {
        "goal": goal.strip(),
        "pid": pid,
        "window_id": window_id,
        "snapshot_id": snapshot_id,
        "elements": elements,
        "history": history,
        "candidates": candidates,
    }


def _default_urlopen(req: urllib.request.Request, timeout_s: float) -> tuple[int, str]:
    opener = urllib.request.build_opener(_NoRedirectHandler())
    with opener.open(req, timeout=timeout_s) as resp:
        status = getattr(resp, "status", 200)
        body = resp.read(4 * V2_MAX_JSON_BYTES + 1).decode("utf-8", errors="replace")
        return status, body


def evaluate_jev_choice(
    validated: Mapping[str, Any],
    route: JevRoute,
    accounting: SessionAccounting,
    http_post: Callable[[urllib.request.Request, float], tuple[int, str]] = _default_urlopen,
) -> dict[str, Any]:
    """Call Jev once (zero retries) and validate model, complete probabilities, and unique argmax."""
    started = time.perf_counter()

    def error_result(reason: str, note: str | None = None) -> dict[str, Any]:
        elapsed_ms = round((time.perf_counter() - started) * 1000, 2)
        res: dict[str, Any] = {
            "schema": "agy_cua.jev_decision_v1",
            "kind": "error",
            "reason": reason,
            "pid": validated["pid"],
            "window_id": validated["window_id"],
            "snapshot_id": validated["snapshot_id"],
            "selected_id": None,
            "requested_model": route.model,
            "returned_model": None,
            "sdk_identity": CLIENT_IDENTITY,
            "route": route.kind,
            "confidence": None,
            "probabilities": {},
            "provider_ms": elapsed_ms,
            "accounting": accounting.to_dict(),
        }
        if note:
            res["note"] = note
        return res

    if accounting.halted:
        return error_result("session_halted", f"Session halted due to prior {accounting.halt_reason}.")
    if route.kind == "none" or not route.endpoint:
        return error_result(route.reason or "route_unavailable", route.note)
    if accounting.calls_used >= accounting.max_calls:
        accounting.halted = True
        accounting.halt_reason = "call_budget_exhausted"
        return error_result("call_budget_exhausted", f"Reached max_calls={accounting.max_calls}.")

    criteria = {item["id"]: item["description"] for item in validated["candidates"]}
    wire_payload = {
        "model": route.model,
        "state": {
            "goal": validated["goal"],
            "target": {"pid": validated["pid"], "window_id": validated["window_id"]},
            "snapshot_id": validated["snapshot_id"],
            "elements": validated["elements"],
            "history": validated["history"],
        },
        "questions": {
            "candidate": {
                "type": "choice",
                "instructions": (
                    f"Immediate step goal: {validated['goal']}\n"
                    "Select the single candidate ID whose action directly satisfies the immediate step goal "
                    "(matching the exact target button/element label or index requested in the goal), "
                    "or select 'reobserve' / 'abstain' if none should be executed."
                ),
                "criteria": criteria,
            }
        },
    }

    headers = {
        "Accept": "application/json",
        "Content-Type": "application/json",
        "User-Agent": CLIENT_IDENTITY,
    }
    if route.api_key:
        headers["Authorization"] = f"Bearer {route.api_key}"

    req = urllib.request.Request(
        route.endpoint,
        data=json.dumps(wire_payload, ensure_ascii=False).encode("utf-8"),
        headers=headers,
        method="POST",
    )

    accounting.attempts_started += 1
    accounting.calls_used += 1
    try:
        status, text = http_post(req, route.timeout_ms / 1000.0)
    except urllib.error.HTTPError as err:
        code = getattr(err, "code", 0)
        # Never read or echo error body (could contain echoed key or state)
        if code in (401, 403):
            accounting.halted = True
            accounting.halt_reason = "authentication_error"
            return error_result("authentication_error", f"Provider returned HTTP {code}.")
        if code == 429:
            accounting.halted = True
            accounting.halt_reason = "rate_limited"
            return error_result("rate_limited", "Provider returned HTTP 429; automatic retries are disabled.")
        if 400 <= code < 500:
            accounting.halted = True
            accounting.halt_reason = "unsupported_input"
            return error_result("unsupported_input", f"Provider rejected request with HTTP {code}.")
        accounting.uncertain_calls += 1
        accounting.halted = True
        accounting.halt_reason = "uncertain_provider_outcome"
        return error_result("provider_http_error", f"Provider returned HTTP {code}; outcome uncertain.")
    except Exception:
        accounting.uncertain_calls += 1
        accounting.halted = True
        accounting.halt_reason = "uncertain_provider_outcome"
        return error_result("provider_transport_error", "Provider call failed or timed out; outcome uncertain.")

    if status < 200 or status >= 300:
        accounting.uncertain_calls += 1
        accounting.halted = True
        accounting.halt_reason = "uncertain_provider_outcome"
        return error_result("provider_http_error", f"Unexpected HTTP status {status}.")

    if len(text.encode("utf-8")) > 4 * V2_MAX_JSON_BYTES:
        accounting.halted = True
        accounting.halt_reason = "invalid_provider_response"
        return error_result("invalid_response", "Provider response exceeded size limit.")

    if route.api_key and route.api_key in text:
        accounting.halted = True
        accounting.halt_reason = "secret_leak_guard"
        return error_result("invalid_response", "Provider response triggered secret redaction guard.")

    try:
        parsed = json.loads(text)
    except ValueError:
        accounting.halted = True
        accounting.halt_reason = "invalid_provider_response"
        return error_result("invalid_response", "Provider response was not valid JSON.")

    if not isinstance(parsed, Mapping):
        accounting.halted = True
        accounting.halt_reason = "invalid_provider_response"
        return error_result("invalid_response", "Provider response root must be a JSON object.")

    usage = parsed.get("usage")
    if isinstance(usage, Mapping):
        in_tok = usage.get("input_tokens")
        out_tok = usage.get("output_tokens")
        if isinstance(in_tok, int) and not isinstance(in_tok, bool) and in_tok >= 0:
            accounting.input_tokens += in_tok
        if isinstance(out_tok, int) and not isinstance(out_tok, bool) and out_tok >= 0:
            accounting.output_tokens += out_tok

    returned_model = parsed.get("model")
    if not isinstance(returned_model, str) or not returned_model.strip():
        accounting.halted = True
        accounting.halt_reason = "invalid_model_identity"
        return error_result("invalid_model_identity", "Provider did not return a valid model string.")
    returned_model = returned_model.strip()
    if route.kind == "typesafe-hosted" and not (
        returned_model == route.model or returned_model.startswith(f"{route.model}-")
    ):
        accounting.halted = True
        accounting.halt_reason = "model_mismatch"
        return error_result(
            "model_mismatch",
            f"Expected pinned model {route.model!r}, but provider returned {returned_model!r}.",
        )

    answers = parsed.get("answers")
    if not isinstance(answers, Mapping) or set(answers.keys()) != {"candidate"}:
        accounting.halted = True
        accounting.halt_reason = "invalid_provider_response"
        return error_result("invalid_response", "Provider answers did not match requested question id 'candidate'.")

    ans = answers["candidate"]
    if not isinstance(ans, Mapping) or ans.get("type") != "choice":
        accounting.halted = True
        accounting.halt_reason = "invalid_provider_response"
        return error_result("invalid_response", "Provider answer type must be 'choice'.")

    raw_probs = ans.get("probabilities")
    if not isinstance(raw_probs, Mapping) or set(raw_probs.keys()) != set(criteria.keys()):
        accounting.halted = True
        accounting.halt_reason = "incomplete_candidate_scores"
        return error_result(
            "incomplete_candidate_scores",
            "Provider probabilities keys did not match the exact closed candidate set.",
        )

    probabilities: dict[str, float] = {}
    for cid in criteria:
        val = raw_probs[cid]
        if not isinstance(val, (int, float)) or isinstance(val, bool) or not math.isfinite(float(val)):
            accounting.halted = True
            accounting.halt_reason = "invalid_candidate_scores"
            return error_result("invalid_candidate_scores", f"Non-finite probability for candidate {cid!r}.")
        fval = float(val)
        if fval < 0.0 or fval > 1.0:
            accounting.halted = True
            accounting.halt_reason = "invalid_candidate_scores"
            return error_result("invalid_candidate_scores", f"Out-of-range probability for candidate {cid!r}.")
        probabilities[cid] = fval

    prob_sum = sum(probabilities.values())
    if abs(prob_sum - 1.0) > 0.02:
        accounting.halted = True
        accounting.halt_reason = "unnormalized_candidate_scores"
        return error_result(
            "unnormalized_candidate_scores",
            f"Candidate probabilities sum to {prob_sum:.4f}, outside 1.0 ± 0.02.",
        )

    top_score = max(probabilities.values())
    winners = [cid for cid in criteria if probabilities[cid] == top_score]
    if len(winners) != 1:
        return error_result("tied_top_score", f"Tied top probability among candidates: {winners}.")

    choice = ans.get("choice")
    if not isinstance(choice, str) or choice not in criteria:
        accounting.halted = True
        accounting.halt_reason = "unknown_candidate_selected"
        return error_result("unknown_candidate_selected", "Provider selected an unknown candidate ID.")
    if choice != winners[0]:
        accounting.halted = True
        accounting.halt_reason = "choice_score_mismatch"
        return error_result(
            "choice_score_mismatch",
            f"Provider choice {choice!r} disagreed with unique argmax {winners[0]!r}.",
        )

    raw_conf = ans.get("confidence", probabilities[choice])
    if not isinstance(raw_conf, (int, float)) or isinstance(raw_conf, bool) or not math.isfinite(float(raw_conf)):
        accounting.halted = True
        accounting.halt_reason = "invalid_confidence"
        return error_result("invalid_confidence", "Provider returned non-finite confidence.")
    confidence = float(raw_conf)
    if confidence < 0.0 or confidence > 1.0:
        accounting.halted = True
        accounting.halt_reason = "invalid_confidence"
        return error_result("invalid_confidence", "Provider returned confidence outside [0, 1].")

    kind = "reobserve" if choice == "reobserve" else "abstain" if choice == "abstain" else "selected"
    elapsed_ms = round((time.perf_counter() - started) * 1000, 2)
    return {
        "schema": "agy_cua.jev_decision_v1",
        "kind": kind,
        "reason": None,
        "pid": validated["pid"],
        "window_id": validated["window_id"],
        "snapshot_id": validated["snapshot_id"],
        "selected_id": choice,
        "requested_model": route.model,
        "returned_model": returned_model,
        "sdk_identity": CLIENT_IDENTITY,
        "route": route.kind,
        "confidence": confidence,
        "probabilities": probabilities,
        "provider_ms": elapsed_ms,
        "accounting": accounting.to_dict(),
    }


def _slug(text: str) -> str:
    cleaned = "".join(ch.lower() if ch.isascii() and ch.isalnum() else "-" for ch in text)
    collapsed = re.sub(r"-+", "-", cleaned).strip("-")[:24].strip("-")
    return collapsed or "item"


def _is_in_menu_bar(
    element: Mapping[str, Any],
    by_index: Mapping[int, Mapping[str, Any]],
    md_menubar_ids: set[int] | None = None,
) -> bool:
    idx = element.get("element_index")
    if isinstance(idx, int) and md_menubar_ids and idx in md_menubar_ids:
        return True
    seen: set[int] = set()
    curr: Mapping[str, Any] | None = element
    saw_window_or_content = False
    while curr is not None:
        role = str(curr.get("role") or "")
        if role in {"AXMenuBar", "AXMenuBarItem"}:
            return True
        if role in (WINDOW_ROOT_ROLES | EXPLICIT_TARGET_CONTAINER_ROLES | {"AXList", "AXToolbar"}):
            saw_window_or_content = True
        parent = curr.get("parent_index")
        if isinstance(parent, int) and md_menubar_ids and parent in md_menubar_ids:
            return True
        if not isinstance(parent, int) or parent in seen:
            break
        seen.add(parent)
        curr = by_index.get(parent)
    own_role = str(element.get("role") or "")
    if own_role in {"AXMenu", "AXMenuItem"} and not saw_window_or_content and element.get("parent_index") is None:
        return True
    return False


def _is_unlabeled_window_button(element: Mapping[str, Any], by_index: Mapping[int, Mapping[str, Any]]) -> bool:
    if element.get("role") != "AXButton":
        return False
    if (element.get("label") or "").strip() or (element.get("value") or "").strip():
        return False
    parent_idx = element.get("parent_index")
    parent = by_index.get(parent_idx) if isinstance(parent_idx, int) else None
    return bool(parent and str(parent.get("role") or "") in WINDOW_ROOT_ROLES)


_TREE_MD_LINE_RE = re.compile(r"^(\s*)-\s*(?:\[(?:e)?(\d+)\]\s*)?([A-Za-z0-9_]+)")

_LEAF_CONTROL_ROLES = frozenset({
    "AXButton",
    "AXRadioButton",
    "AXCheckBox",
    "AXPopUpButton",
    "AXTextField",
    "AXSecureTextField",
    "AXTextArea",
    "AXSearchField",
    "AXComboBox",
    "AXSlider",
    "AXIncrementor",
    "AXLink",
    "AXMenuButton",
    "AXDisclosureTriangle",
    "AXStaticText",
})


def _decode_md_escaped_str(raw: str) -> str:
    safe_raw = raw.replace("\r", "\\r").replace("\n", "\\n").replace("\t", "\\t")
    try:
        return str(json.loads(f'"{safe_raw}"')).replace("\u200e", "").strip()
    except ValueError:
        return raw.replace('\\"', '"').replace("\\n", "\n").replace("\\\\", "\\").replace("\u200e", "").strip()


def _scan_quote_to_eol(text: str, start_idx: int) -> tuple[bool, int]:
    """Scan inside a double-quoted literal starting at start_idx; return (closed, next_idx)."""
    idx = start_idx
    n = len(text)
    escaped = False
    while idx < n:
        ch = text[idx]
        if escaped:
            escaped = False
        elif ch == "\\":
            escaped = True
        elif ch == '"':
            return True, idx + 1
        idx += 1
    return False, n


def _skip_md_leading_label(rest: str) -> tuple[bool, int, str]:
    """Advance past a leading quoted or balanced-parenthesized label on a _TREE_MD_LINE_RE tail."""
    s = rest.lstrip(" \t")
    if not s or s.startswith("="):
        return False, 0, s
    if s.startswith('"'):
        closed, next_pos = _scan_quote_to_eol(s, 1)
        return (not closed), next_pos, s
    if s.startswith("("):
        idx = 1
        n = len(s)
        depth = 1
        in_q = False
        escaped = False
        while idx < n:
            ch = s[idx]
            if in_q:
                if escaped:
                    escaped = False
                elif ch == "\\":
                    escaped = True
                elif ch == '"':
                    in_q = False
            else:
                if ch == '"':
                    in_q = True
                elif ch == "(":
                    depth += 1
                elif ch == ")":
                    depth -= 1
                    if depth == 0:
                        return False, idx + 1, s
            idx += 1
        if in_q:
            return True, n, s
        eq_pos = s.find(' = "')
        return False, (eq_pos if eq_pos != -1 else n), s
    return False, 0, s


def _extract_md_node_label(rest: str) -> str:
    s = rest.strip()
    if not s or s.startswith("="):
        return ""
    if s.startswith('"'):
        m_q = re.match(r'^"((?:[^"\\]|\\.)*)"', s, flags=re.DOTALL)
        if m_q:
            return _decode_md_escaped_str(m_q.group(1))
    if s.startswith("("):
        unclosed, end_pos, trimmed = _skip_md_leading_label(s)
        if not unclosed and end_pos >= 2 and trimmed[end_pos - 1] == ")":
            return trimmed[1 : end_pos - 1].replace("\u200e", "").strip()
        head = s.split(" = ", 1)[0].strip()
        if head.startswith("(") and head.endswith(")"):
            return head[1:-1].replace("\u200e", "").strip()
        m_p = re.match(r"^\(([^)]+)\)", s)
        if m_p:
            return m_p.group(1).replace("\u200e", "").strip()
    return ""


def _extract_md_quoted_value(rest: str) -> str:
    unclosed, after_lbl, s = _skip_md_leading_label(rest)
    if unclosed:
        return ""
    m_v = re.search(r'(?:^|\s)=\s*"((?:[^"\\]|\\.)*)"', s[after_lbl:], flags=re.DOTALL)
    if not m_v:
        return ""
    return _decode_md_escaped_str(m_v.group(1))


_PW_PLACEHOLDER_RE = re.compile(
    r"^(?:enter\s+your\s+password|master\s+(?:vault\s+)?password|password|generate\s+password,\s+or\s+type\s+a\s+password)$",
    re.IGNORECASE,
)


def _md_tail_has_unclosed_value_quote(tail: str) -> bool:
    m_eq = re.search(r'(?:^|\s)=\s*"', tail)
    if m_eq:
        closed_val, _ = _scan_quote_to_eol(tail, m_eq.end())
        if not closed_val:
            return True
    return False


def _md_rest_has_unclosed_quote(rest: str) -> bool:
    """Return True iff the remainder of a _TREE_MD_LINE_RE line leaves a quoted label or '= \"...\"' value unclosed."""
    unclosed_lbl, pos, s = _skip_md_leading_label(rest)
    if unclosed_lbl:
        return True
    return _md_tail_has_unclosed_value_quote(s[pos:])


def _coalesce_multiline_md_lines(tree_md: str) -> list[str]:
    """Join physical lines split across a multiline quoted label or value in tree_markdown."""
    raw_lines = tree_md.splitlines()
    out: list[str] = []
    i = 0
    n = len(raw_lines)
    while i < n:
        cur = raw_lines[i]
        m = _TREE_MD_LINE_RE.match(cur)
        if m and _md_rest_has_unclosed_quote(cur[m.end() :]):
            j = i + 1
            parts = [cur]
            while j < n:
                nxt = raw_lines[j]
                parts.append(nxt)
                closed_here, after_idx = _scan_quote_to_eol(nxt, 0)
                if closed_here and not _md_tail_has_unclosed_value_quote(nxt[after_idx:]):
                    j += 1
                    break
                j += 1
            out.append("\n".join(parts))
            i = j
            continue
        out.append(cur)
        i += 1
    return out


def _contains_secret_or_mask(
    text: str,
    secret_values: set[str],
    *,
    strict_short: bool = False,
) -> bool:
    if not text:
        return False
    if _BULLET_MASK_RE.search(text):
        return True
    if text in secret_values:
        return True
    for sv in secret_values:
        if sv and (len(sv) >= 4 or strict_short) and sv in text:
            return True
    return False


def _container_matches_region_parts(
    clean_path_dedup: list[str],
    own_clean_label: str,
    parts: list[str],
) -> bool:
    own_norm = own_clean_label.strip().lower()
    if not own_norm or not parts or own_norm != parts[-1]:
        return False
    if len(parts) == 1:
        return True
    anc_norms = [s.strip().lower() for s in clean_path_dedup[:-1] if s.strip()]
    pos = 0
    target_anc = parts[:-1]
    for seg in anc_norms:
        if seg == target_anc[pos]:
            pos += 1
            if pos == len(target_anc):
                return True
    return False


def _parse_markdown_structure(tree_md: str) -> dict[str, Any]:
    """Parse container graph, element ancestry, static texts, and secure hints from tree_markdown."""
    md_containers: dict[tuple[str, int], dict[str, Any]] = {}
    md_anc_ckeys_by_el: dict[int, list[tuple[str, int]]] = {}
    md_all_anc_ids_by_el: dict[int, set[int]] = {}
    md_has_non_root_anc_by_el: dict[int, bool] = {}
    md_has_nontoolbar_container_anc_by_el: dict[int, bool] = {}
    md_seen_el_ids: set[int] = set()
    md_window_root_ids: set[int] = set()
    md_static_records: list[dict[str, Any]] = []
    md_all_static_texts: list[str] = []
    md_secure_ids: set[int] = set()
    md_secure_values: set[str] = set()
    has_unindexed_secure_md_node = False
    node_by_level: dict[int, dict[str, Any]] = {}

    for line_no, line in enumerate(_coalesce_multiline_md_lines(tree_md)):
        m = _TREE_MD_LINE_RE.match(line)
        if not m:
            raw_ws = len(line) - len(line.lstrip(" \t"))
            indent_cols = len(line[:raw_ws].expandtabs(2))
            anc_nodes = [node_by_level[k] for k in sorted(node_by_level.keys()) if k < indent_cols]
            anc_ckeys = [n["ckey"] for n in anc_nodes if n["ckey"] is not None]
            all_anc_ids = {n["elem_idx"] for n in anc_nodes if n["elem_idx"] is not None}
            has_non_root_anc = any(n["role"] not in WINDOW_ROOT_ROLES for n in anc_nodes) or (
                indent_cols >= 2 and bool(node_by_level)
            )
            for st_raw in re.findall(r'AXStaticText\s*=\s*"((?:[^"\\]|\\.)*)"', line, flags=re.DOTALL):
                st_clean = _decode_md_escaped_str(st_raw)
                if st_clean:
                    md_static_records.append(
                        {
                            "text": st_clean,
                            "elem_idx": None,
                            "anc_ckeys": list(anc_ckeys),
                            "all_anc_ids": set(all_anc_ids),
                            "has_non_root_anc": has_non_root_anc,
                            "proven_top_level": bool(not has_non_root_anc and not anc_ckeys),
                        }
                    )
                    if st_clean not in md_all_static_texts:
                        md_all_static_texts.append(st_clean)
            continue

        indent, idx_str, role = m.group(1), m.group(2), m.group(3)
        indent_cols = len(indent.expandtabs(2))
        for deeper in [k for k in node_by_level if k >= indent_cols]:
            del node_by_level[deeper]

        anc_nodes = [node_by_level[k] for k in sorted(node_by_level.keys())]
        all_anc_ids = {n["elem_idx"] for n in anc_nodes if n["elem_idx"] is not None}
        has_non_root_anc = any(n["role"] not in WINDOW_ROOT_ROLES for n in anc_nodes)
        anc_ckeys = [n["ckey"] for n in anc_nodes if n["ckey"] is not None]
        in_toolbar_anc = any(n["role"] == "AXToolbar" for n in anc_nodes)
        has_nontoolbar_container_anc = (
            any(n["ckey"] is not None and n["role"] != "AXToolbar" for n in anc_nodes) and not in_toolbar_anc
        )

        own_idx = int(idx_str) if idx_str is not None else None
        rest = line[m.end() :]
        own_label = _extract_md_node_label(rest)
        own_val = _extract_md_quoted_value(rest)

        if own_idx is not None:
            md_seen_el_ids.add(own_idx)
            md_anc_ckeys_by_el[own_idx] = list(anc_ckeys)
            md_all_anc_ids_by_el[own_idx] = set(all_anc_ids)
            md_has_non_root_anc_by_el[own_idx] = has_non_root_anc
            md_has_nontoolbar_container_anc_by_el[own_idx] = has_nontoolbar_container_anc
            for ck in anc_ckeys:
                if ck in md_containers:
                    md_containers[ck]["desc_el_ids"].add(own_idx)

        if role in WINDOW_ROOT_ROLES and own_idx is not None:
            md_window_root_ids.add(own_idx)

        if "secure" in role.lower():
            if own_idx is not None:
                md_secure_ids.add(own_idx)
            else:
                has_unindexed_secure_md_node = True
            if own_val and not _PW_PLACEHOLDER_RE.match(own_val):
                md_secure_values.add(own_val)

        is_container = (
            role not in WINDOW_ROOT_ROLES
            and role not in MENU_BAR_ROLES
            and role not in _LEAF_CONTROL_ROLES
        )
        own_ckey: tuple[str, int] | None = None
        if is_container:
            own_ckey = ("el", own_idx) if own_idx is not None else ("md", line_no)
            existing_c = md_containers.get(own_ckey)
            if existing_c is None:
                md_containers[own_ckey] = {
                    "ckey": own_ckey,
                    "elem_idx": own_idx,
                    "role": role,
                    "raw_label": own_label,
                    "strict_anc_ckeys": list(anc_ckeys),
                    "anc_ckeys": list(anc_ckeys) + [own_ckey],
                    "all_anc_el_ids": set(all_anc_ids),
                    "desc_el_ids": {own_idx} if own_idx is not None else set(),
                }
            else:
                if not existing_c["raw_label"] and own_label:
                    existing_c["raw_label"] = own_label
                existing_c["all_anc_el_ids"].update(all_anc_ids)

        st_texts_on_line: list[str] = []
        if role == "AXStaticText":
            primary_st = own_val if own_val else own_label
            if primary_st:
                st_texts_on_line.append(primary_st)
        for st_raw in re.findall(r'AXStaticText\s*=\s*"((?:[^"\\]|\\.)*)"', line, flags=re.DOTALL):
            st_clean = _decode_md_escaped_str(st_raw)
            if st_clean and st_clean not in st_texts_on_line:
                st_texts_on_line.append(st_clean)
        for st_clean in st_texts_on_line:
            md_static_records.append(
                {
                    "text": st_clean,
                    "elem_idx": own_idx,
                    "anc_ckeys": list(anc_ckeys),
                    "all_anc_ids": set(all_anc_ids),
                    "has_non_root_anc": has_non_root_anc,
                    "proven_top_level": bool(not has_non_root_anc and not anc_ckeys),
                }
            )
            if st_clean not in md_all_static_texts:
                md_all_static_texts.append(st_clean)

        node_by_level[indent_cols] = {"role": role, "elem_idx": own_idx, "ckey": own_ckey}

    return {
        "containers": md_containers,
        "anc_ckeys_by_el": md_anc_ckeys_by_el,
        "all_anc_ids_by_el": md_all_anc_ids_by_el,
        "has_non_root_anc_by_el": md_has_non_root_anc_by_el,
        "has_nontoolbar_container_anc_by_el": md_has_nontoolbar_container_anc_by_el,
        "seen_el_ids": md_seen_el_ids,
        "window_root_ids": md_window_root_ids,
        "static_records": md_static_records,
        "all_static_texts": md_all_static_texts,
        "secure_ids": md_secure_ids,
        "secure_values": md_secure_values,
        "has_unindexed_secure_node": has_unindexed_secure_md_node,
    }


def _parse_markdown_hierarchy(tree_md: str) -> tuple[dict[int, int], set[int]]:
    """Extract element depth and AXToolbar ancestry from tree_markdown indentation."""
    md_depth, md_toolbar_ids, _, _ = _parse_markdown_hierarchy_full(tree_md)
    return md_depth, md_toolbar_ids


def _parse_markdown_hierarchy_full(tree_md: str) -> tuple[dict[int, int], set[int], set[int], set[int]]:
    """Extract element depth, AXToolbar ancestry, AXMenuBar ancestry, and unlabeled value-only row IDs from tree_markdown."""
    md_depth: dict[int, int] = {}
    md_toolbar_ids: set[int] = set()
    md_menubar_ids: set[int] = set()
    md_unlabeled_value_ids: set[int] = set()
    role_by_level: dict[int, str] = {}
    for line in _coalesce_multiline_md_lines(tree_md):
        m = _TREE_MD_LINE_RE.match(line)
        if not m:
            continue
        indent, idx_str, role = m.group(1), m.group(2), m.group(3)
        level = len(indent.expandtabs(2)) // 2
        for deeper in [k for k in role_by_level if k > level]:
            del role_by_level[deeper]
        role_by_level[level] = role
        if idx_str is not None:
            idx = int(idx_str)
            root_at_zero = role_by_level.get(0) in WINDOW_ROOT_ROLES
            eff_depth = level if (root_at_zero or role in WINDOW_ROOT_ROLES) else level + 1
            md_depth[idx] = eff_depth
            if line[m.end() :].lstrip().startswith("="):
                md_unlabeled_value_ids.add(idx)
            if any(r == "AXToolbar" for k, r in role_by_level.items() if k <= level):
                md_toolbar_ids.add(idx)
            if any(r in {"AXMenuBar", "AXMenuBarItem"} for k, r in role_by_level.items() if k <= level):
                md_menubar_ids.add(idx)
    return md_depth, md_toolbar_ids, md_menubar_ids, md_unlabeled_value_ids


def _element_depth_and_toolbar(
    idx: int,
    element: Mapping[str, Any],
    by_index: Mapping[int, Mapping[str, Any]],
    md_depth: Mapping[int, int],
    md_toolbar_ids: set[int],
) -> tuple[int, bool]:
    """Compute element tree depth and whether it resides inside an AXToolbar."""
    seen: set[int] = {idx}
    curr: Mapping[str, Any] | None = element
    hops = 0
    in_toolbar = str(element.get("role") or "") == "AXToolbar" or (idx in md_toolbar_ids)
    has_parent_chain = False
    chain_complete = False
    root_indices = {
        k for k, v in by_index.items() if str(v.get("role") or "").strip() in WINDOW_ROOT_ROLES
    }
    while curr is not None:
        role = str(curr.get("role") or "")
        if role == "AXToolbar":
            in_toolbar = True
        parent_idx = curr.get("parent_index")
        if not isinstance(parent_idx, int) or isinstance(parent_idx, bool):
            if role in WINDOW_ROOT_ROLES:
                chain_complete = True
            break
        if parent_idx in md_toolbar_ids:
            in_toolbar = True
        if parent_idx in seen:
            break
        seen.add(parent_idx)
        hops += 1
        has_parent_chain = True
        parent = by_index.get(parent_idx)
        if parent is None:
            if parent_idx in md_depth:
                hops += md_depth[parent_idx]
                chain_complete = True
            elif root_indices and parent_idx not in root_indices:
                hops += 1
            break
        curr = parent

    explicit_depth = element.get("depth")
    if isinstance(explicit_depth, int) and not isinstance(explicit_depth, bool) and explicit_depth >= 0:
        depth = max(hops, explicit_depth) if has_parent_chain else explicit_depth
    elif has_parent_chain:
        depth = hops if chain_complete or idx not in md_depth else max(hops, md_depth[idx])
    elif idx in md_depth:
        depth = md_depth[idx]
    else:
        depth = 0 if str(element.get("role") or "") in WINDOW_ROOT_ROLES else 1
    return depth, in_toolbar


def _normalized_actions(element: Mapping[str, Any]) -> tuple[set[str], bool]:
    raw = element.get("actions")
    if not isinstance(raw, list):
        return set(), False
    return {str(a).strip() for a in raw if isinstance(a, str) and str(a).strip()}, True


def _supports_press_action(actions: set[str]) -> bool:
    lowered = {a.lower() for a in actions}
    return bool({"axpress", "press"} & lowered)


def _supports_interactive_click_action(actions: set[str]) -> bool:
    lowered = {a.lower() for a in actions}
    return bool({"axpress", "press", "axshowmenu", "showmenu", "axconfirm", "confirm", "axopen", "open"} & lowered)


def _element_can_auto_click(role: str, actions: set[str], has_explicit_actions: bool) -> bool:
    """Return True only when an actionable element supports an automatic click/focus-click candidate."""
    if role not in EXPLICIT_TARGET_CONTAINER_ROLES and _supports_press_action(actions):
        return True
    if role == "AXCell":
        return False
    if role == "AXLink":
        return not has_explicit_actions
    if role in TEXT_INPUT_AX_ROLES:
        if not has_explicit_actions or not actions:
            return True
        # Driver's element click uses AXPress here. AXShowMenu on a native
        # TextEdit text area only opens its contextual menu; it cannot focus
        # the field through AXPress. Keep value/type actions available.
        return _supports_press_action(actions)
    if role in {
        "AXButton",
        "AXRadioButton",
        "AXCheckBox",
        "AXPopUpButton",
        "AXMenuButton",
        "AXMenuItem",
        "AXDisclosureTriangle",
        "AXTabGroup",
        "AXRow",
    }:
        if has_explicit_actions:
            return bool(actions) and _supports_interactive_click_action(actions)
        return True
    return False


def _element_can_explicit_click(role: str, actions: set[str], has_explicit_actions: bool) -> bool:
    """Return True when an enabled element supports an explicit click candidate."""
    if _element_can_auto_click(role, actions, has_explicit_actions):
        return True
    if role in {"AXSlider", "AXIncrementor"}:
        if not has_explicit_actions or not actions:
            return True
        lowered = {a.lower() for a in actions}
        return bool({"axpress", "press", "axincrement", "axdecrement", "increment", "decrement"} & lowered)
    return False


EXPLICIT_TARGET_CONTAINER_ROLES = frozenset({
    "AXScrollArea",
    "AXWebArea",
    "AXTable",
    "AXOutline",
    "AXGroup",
})

_BULLET_MASK_RE = re.compile(r"(?:\uf79a|\u2022{4,}|\u25cf{4,}|\u2731{4,})")
_SECRET_FIELD_NAME_RE = re.compile(
    r"\b(?:password|passphrase|credential|secret(?:\s+key)?|api[_\s-]*key|private[_\s-]*key|"
    r"one-time\s+password|totp|otp|recovery\s+(?:code|key)|seed\s+phrase|cvv|cvc|pin|"
    r"webhook\s+secret|client[_\s-]*secret|auth[_\s-]*token|access[_\s-]*token|bearer[_\s-]*token)\b",
    re.IGNORECASE,
)
_REORDER_HANDLE_RE = re.compile(r"^Reorder drag handle for (.+?) field$", re.IGNORECASE)
_MORE_ACTIONS_RE = re.compile(r"^(.+?)\.\s*More Actions$", re.IGNORECASE)


# cua-driver invoke_menu schema: {pid, window_id, path[1..16], session}, additionalProperties=false.
INVOKE_MENU_ARG_KEYS = frozenset({"pid", "window_id", "path", "session"})
INVOKE_MENU_MAX_PATH = 16

_KEY_ALIASES = {
    "command": "cmd",
    "meta": "cmd",
    "super": "cmd",
    "backspace": "delete",
    "forwarddelete": "delete",
    "forward_delete": "delete",
    "opt": "option",
    "alt": "option",
    "control": "ctrl",
    "kp_enter": "enter",
    "keypad_enter": "enter",
}
# Keys that activate a focused button/control (AXPress equivalent) when delivered to an element.
_ACTIVATION_KEYS = frozenset({"return", "enter", "space"})


def _target_role(observation: Mapping[str, Any] | None, args: Mapping[str, Any]) -> str | None:
    """Resolve the AX role addressed by args.element_index / element_token in observation, if any."""
    idx = args.get("element_index")
    if idx is None:
        tok = args.get("element_token")
        if isinstance(tok, str) and ":" in tok and tok.rsplit(":", 1)[1].isdigit():
            idx = int(tok.rsplit(":", 1)[1])
    if not isinstance(idx, int) or isinstance(idx, bool) or not observation:
        return None
    for key in ("all_elements", "elements"):
        for el in observation.get(key) or []:
            if isinstance(el, Mapping) and el.get("element_index") == idx:
                return str(el.get("role") or "") or None
    return None


def _check_commit_safety_gate(
    observation: Mapping[str, Any] | None,
    label_or_desc: str,
    tool: str,
    args: Mapping[str, Any],
) -> str | None:
    """Return refusal reason if an action attempts a consequential commit (Send, Delete, Empty Trash, Secret Exfiltration) without human gate."""
    app_name = str((observation or {}).get("app_name") or "").lower()
    win_title = str((observation or {}).get("window_title") or "").lower()
    is_mail_ctx = "mail" in app_name or "mail" in win_title
    is_messages_ctx = app_name == "messages" or (not app_name and "messages" in win_title)
    is_1password_ctx = "1password" in app_name or "1password" in win_title
    is_destructive_app_ctx = is_mail_ctx or is_1password_ctx or any(
        k in app_name or k in win_title for k in ("finder", "messages")
    )
    norm_desc = re.sub(r"https?://[^\s)\"']+", "", label_or_desc.strip().lower())

    if tool == "invoke_menu":
        raw_path = args.get("path")
        if isinstance(raw_path, list):
            segments = [str(p).strip().lower() for p in raw_path if isinstance(p, str)]
            joined = " > ".join(segments)
            for seg in segments:
                if re.search(r"\bsend(?:\s+(?:message|email|mail|again|now))?\b", seg) and "draft" not in seg:
                    return (
                        "commit_action_forbidden_by_safety_policy (mail_send_forbidden_by_safety_policy): "
                        f"invoke_menu path {raw_path!r} attempts Send without WAITING_FOR_HUMAN confirmation"
                    )
            if re.search(
                r"\b(?:reveal(?:\s+(?:secure\s+fields|password))?|show\s+in\s+large\s+type|"
                r"copy\s+(?:password|one-time\s+password|secret(?:\s+key)?|private\s+(?:key|link)|recovery\s+(?:code|key)))\b",
                joined,
            ) or (is_1password_ctx and re.search(r"\b(?:export|share)\b", joined)):
                return (
                    "commit_action_forbidden_by_safety_policy (secret_exfiltration_forbidden_by_safety_policy): "
                    f"invoke_menu path {raw_path!r} attempts secret reveal/copy/export/share without WAITING_FOR_HUMAN confirmation"
                )
            if re.search(
                r"\b(?:delete|erase\s+deleted|empty\s+trash|move\s+to\s+trash|archive\s+item)\b",
                joined,
            ):
                return (
                    "commit_action_forbidden_by_safety_policy: "
                    f"invoke_menu path {raw_path!r} attempts destructive delete/trash without WAITING_FOR_HUMAN confirmation"
                )

    is_element_addressed = "element_index" in args or "element_token" in args

    if tool in {"hotkey", "press_key"}:
        if tool == "hotkey":
            raw_key_list = args.get("keys") or []
        else:
            # press_key accepts `modifiers` (and legacy `modifier`) alongside `key`; treat the
            # combined chord exactly like a hotkey so modifiers cannot bypass the gate.
            raw_mods = args.get("modifiers")
            if raw_mods is None:
                raw_mods = args.get("modifier")
            if isinstance(raw_mods, str):
                raw_mods = [raw_mods]
            raw_key_list = list(raw_mods or []) + [args.get("key")]
        if not isinstance(raw_key_list, (list, tuple)):
            raw_key_list = [raw_key_list]
        raw_keys = [str(k).strip().lower() for k in raw_key_list if k is not None]
        norm_keys = {_KEY_ALIASES.get(k, k) for k in raw_keys}
        if (
            is_element_addressed
            and norm_keys & _ACTIVATION_KEYS
            and "draft" not in norm_desc
            and (
                (is_mail_ctx and re.search(r"\bsend\b", norm_desc))
                or re.search(r"\bsend\s+(?:message|email|mail)(?:\s+now)?\b", norm_desc)
            )
        ):
            return (
                "commit_action_forbidden_by_safety_policy (mail_send_forbidden_by_safety_policy): "
                f"{tool} activation key on {label_or_desc!r} targets Send control without WAITING_FOR_HUMAN confirmation"
            )
        if (
            is_element_addressed
            and norm_keys & _ACTIVATION_KEYS
            and is_destructive_app_ctx
            and re.search(r"\b(?:delete|empty\s+trash|erase|move\s+to\s+trash)\b", norm_desc)
        ):
            return (
                "commit_action_forbidden_by_safety_policy: "
                f"{tool} activation key on {label_or_desc!r} targets destructive delete/trash control without WAITING_FOR_HUMAN confirmation"
            )
        if (
            is_element_addressed
            and norm_keys & _ACTIVATION_KEYS
            and (
                re.search(
                    r"\b(?:reveal(?:\s+(?:password|secure\s+fields))?|show\s+in\s+large\s+type|"
                    r"copy\s+(?:password|one-time\s+password|secret(?:\s+key)?|private\s+(?:key|link)|credential|api[_\s-]*key|recovery\s+(?:code|key)))\b",
                    norm_desc,
                )
                or (is_1password_ctx and re.search(r"\b(?:share|export)\b", norm_desc))
            )
        ):
            return (
                "commit_action_forbidden_by_safety_policy (secret_exfiltration_forbidden_by_safety_policy): "
                f"{tool} activation key on {label_or_desc!r} targets secret reveal/copy/share control without WAITING_FOR_HUMAN confirmation"
            )
        if is_1password_ctx and "cmd" in norm_keys and (
            ("option" in norm_keys and ("c" in norm_keys or "r" in norm_keys))
            or ("shift" in norm_keys and "c" in norm_keys)
        ):
            chord = "cmd+shift+c" if "shift" in norm_keys else f"cmd+option+{'c' if 'c' in norm_keys else 'r'}"
            return (
                "commit_action_forbidden_by_safety_policy (secret_exfiltration_forbidden_by_safety_policy): "
                f"{tool} {chord} attempts 1Password secret copy/reveal without WAITING_FOR_HUMAN confirmation"
            )
        if "cmd" in norm_keys and "shift" in norm_keys and "d" in norm_keys:
            return (
                "commit_action_forbidden_by_safety_policy (mail_send_forbidden_by_safety_policy): "
                "hotkey cmd+shift+d attempts Mail Send without WAITING_FOR_HUMAN confirmation"
            )
        if (
            "cmd" in norm_keys
            and ("return" in norm_keys or "enter" in norm_keys)
            and (is_mail_ctx or "send" in norm_desc)
        ):
            return (
                "commit_action_forbidden_by_safety_policy (mail_send_forbidden_by_safety_policy): "
                "hotkey cmd+return attempts Send without WAITING_FOR_HUMAN confirmation"
            )
        if "cmd" in norm_keys and "delete" in norm_keys:
            return (
                "commit_action_forbidden_by_safety_policy: "
                "hotkey cmd+delete / cmd+shift+delete attempts destructive delete/trash without WAITING_FOR_HUMAN confirmation"
            )
        if is_messages_ctx and norm_keys & {"return", "enter"}:
            return (
                "commit_action_forbidden_by_safety_policy (mail_send_forbidden_by_safety_policy): "
                f"{tool} return/enter in Messages sends the conversation without WAITING_FOR_HUMAN confirmation"
            )
        if (
            is_destructive_app_ctx
            and "delete" in norm_keys
            and _target_role(observation, args) not in TEXT_INPUT_AX_ROLES
        ):
            return (
                "commit_action_forbidden_by_safety_policy: "
                f"{tool} delete key outside a text input in {app_name or win_title!r} may trash the selection "
                "without WAITING_FOR_HUMAN confirmation"
            )

    if tool == "type_text" and is_messages_ctx:
        text_val = args.get("text")
        if isinstance(text_val, str) and ("\n" in text_val or "\r" in text_val):
            return (
                "commit_action_forbidden_by_safety_policy (mail_send_forbidden_by_safety_policy): "
                "type_text newline in Messages sends the conversation without WAITING_FOR_HUMAN confirmation"
            )

    is_browser_ctx = bool((observation or {}).get("is_browser") or tool.startswith("browser_"))

    if tool in {
        "click",
        "double_click",
        "right_click",
        "check",
        "uncheck",
        "set_value",
        "browser_click",
        "browser_type",
        "browser_navigate",
    }:
        if tool in {"click", "double_click", "right_click", "check", "uncheck"} and is_destructive_app_ctx and not is_element_addressed:
            # Coordinate clicks have no AX label to gate on; the caller-supplied description is not
            # authority, so refuse them where Send/Delete controls may sit under the pointer.
            return (
                "commit_action_forbidden_by_safety_policy: "
                f"coordinate {tool} in {app_name or win_title!r} cannot be label-gated; use an element_index target"
            )
        if "draft" not in norm_desc:
            if (
                (is_mail_ctx or is_browser_ctx)
                and re.search(r"\bsend(?:\s+(?:message|email|mail|money|payment|invite)(?:\s+now)?)?\b", norm_desc)
            ) or re.search(r"\bsend\s+(?:message|email|mail|money|payment|invite)(?:\s+now)?\b", norm_desc):
                return (
                    "commit_action_forbidden_by_safety_policy (mail_send_forbidden_by_safety_policy): "
                    f"action {label_or_desc!r} targets Send control without WAITING_FOR_HUMAN confirmation"
                )
        if re.search(
            r"\b(?:place\s+order|complete\s+purchase|buy\s+now|pay\s+now|confirm\s+(?:purchase|payment|order|transfer)|"
            r"submit\s+(?:payment|order)|wire\s+transfer|authorize\s+payment|checkout\s+now)\b",
            norm_desc,
        ):
            return (
                "commit_action_forbidden_by_safety_policy: "
                f"action {label_or_desc!r} targets consequential purchase/payment control without WAITING_FOR_HUMAN confirmation"
            )
        if re.search(
            r"\b(?:reveal(?:\s+(?:password|secure\s+fields))?|show\s+in\s+large\s+type|"
            r"copy\s+(?:password|one-time\s+password|secret(?:\s+key)?|private\s+(?:key|link)|credential|api[_\s-]*key|recovery\s+(?:code|key)))\b",
            norm_desc,
        ) or (is_1password_ctx and re.search(r"\b(?:share|export)\b", norm_desc)):
            return (
                "commit_action_forbidden_by_safety_policy (secret_exfiltration_forbidden_by_safety_policy): "
                f"action {label_or_desc!r} targets secret reveal/copy/share control without WAITING_FOR_HUMAN confirmation"
            )
        if re.search(
            r"\b(?:empty\s+trash|erase\s+deleted(?:\s+items)?|delete\s+(?:message|messages|mail|mailbox|item|items|account|vault|forever|immediately)|move\s+to\s+trash)\b",
            norm_desc,
        ) or (
            is_destructive_app_ctx
            and "calculator" not in app_name
            and "calculator" not in win_title
            and re.search(r"\b(?:delete|empty\s+trash|erase)\b", norm_desc)
        ):
            return (
                "commit_action_forbidden_by_safety_policy: "
                f"action {label_or_desc!r} targets destructive delete/trash control without WAITING_FOR_HUMAN confirmation"
            )

    return None


def _is_forbidden_mail_send(
    observation: Mapping[str, Any] | None,
    label_or_desc: str,
    tool: str,
    args: Mapping[str, Any],
) -> bool:
    return _check_commit_safety_gate(observation, label_or_desc, tool, args) is not None


_WEBSITE_FIELD_NAME_RE = re.compile(
    r"\b(?:website|url|uri|domain|host(?:name)?|login\s+url|homepage|web\s+address)\b",
    re.IGNORECASE,
)


def _analyze_window_elements(
    by_index: Mapping[int, Mapping[str, Any]],
    obs_context: Mapping[str, Any],
    raw_static_texts: list[str],
    md_unlabeled_value_ids: set[int] | None = None,
) -> tuple[dict[int, str], set[int], set[str], dict[int, int]]:
    """Infer contextual labels, secret/masked controls, redacted static texts, and secondary sidebar IDs."""
    synthesized_labels: dict[int, str] = {}
    extra_secure_ids: set[int] = set()
    redacted_static_values: set[str] = set()
    unlabeled_val_ids = md_unlabeled_value_ids or set()

    sorted_ids = sorted(by_index.keys())
    app_name = str(obs_context.get("app_name") or "").lower()
    win_title = str(obs_context.get("window_title") or "").lower()
    is_1password_ctx = "1password" in app_name or "1password" in win_title

    def _el_val(el: Mapping[str, Any]) -> str:
        return "" if el.get("value") is None else str(el.get("value") or "").replace("\u200e", "").strip()

    def _el_label(el: Mapping[str, Any]) -> str:
        raw = (
            el.get("label")
            if el.get("label") not in (None, "")
            else (el.get("title") if el.get("title") not in (None, "") else el.get("description"))
        )
        lbl_str = str(raw or "").replace("\u200e", "").strip()
        role_str = str(el.get("role") or "").strip()
        idx_val = el.get("element_index")
        if (
            (role_str in TEXT_INPUT_AX_ROLES or "secure" in role_str.lower())
            and (idx_val in unlabeled_val_ids or is_1password_ctx or "secure" in role_str.lower())
            and lbl_str
            and lbl_str == _el_val(el)
        ):
            alt = el.get("title") if el.get("title") not in (None, "") else el.get("description")
            alt_str = str(alt or "").replace("\u200e", "").strip()
            return alt_str if (alt_str and alt_str != lbl_str) else ""
        return lbl_str

    # Pass 1: Sibling Tooltip triples ([i] Control, [i+1] AXStaticText="Tooltip:", [i+2] AXStaticText="<tip>")
    for pos, idx in enumerate(sorted_ids):
        if pos + 2 >= len(sorted_ids):
            continue
        el = by_index[idx]
        el1 = by_index[sorted_ids[pos + 1]]
        el2 = by_index[sorted_ids[pos + 2]]
        if (
            str(el.get("role") or "") != "AXStaticText"
            and str(el1.get("role") or "") == "AXStaticText"
            and str(el2.get("role") or "") == "AXStaticText"
        ):
            t1 = (_el_val(el1) or _el_label(el1)).strip()
            t2 = (_el_val(el2) or _el_label(el2)).strip()
            if t1.lower() == "tooltip:" and t2:
                curr_lbl = _el_label(el)
                if not curr_lbl or curr_lbl.lower() in {"delete", "button", "checkbox", "open"}:
                    synthesized_labels[idx] = t2
                if re.search(r"\b(?:reveal|hide)\s+(?:password|secure)", t2, re.IGNORECASE):
                    extra_secure_ids.add(idx)

    _pw_placeholder_re = re.compile(
        r"^(?:enter\s+your\s+password|master\s+(?:vault\s+)?password|password|generate\s+password,\s+or\s+type\s+a\s+password)$",
        re.IGNORECASE,
    )

    # Pass 2: Lock Screen detection, Touch ID button labeling, and labeled/secure text inputs
    touch_id_caption = next(
        (t for t in raw_static_texts if re.search(r"\bunlock\s+(?:using|with)\s+touch\s+id\b", t, re.IGNORECASE)),
        None,
    )
    is_lock_screen = "lock screen" in win_title or touch_id_caption is not None
    for pos, idx in enumerate(sorted_ids):
        el = by_index[idx]
        role = str(el.get("role") or "").strip()
        subrole = str(el.get("subrole") or "").strip()
        lbl = synthesized_labels.get(idx) or _el_label(el)
        title_or_desc = f"{el.get('title') or ''} {el.get('description') or ''}".strip()
        combined_lbl = f"{lbl} {title_or_desc}".strip()
        val = _el_val(el)
        is_val_placeholder = bool(val and _pw_placeholder_re.match(val))
        is_pw_hint = bool(
            re.search(
                r"\b(?:enter\s+your\s+password|master\s+(?:vault\s+)?password)\b",
                f"{combined_lbl} {val}",
                re.IGNORECASE,
            )
            or re.search(r"\bgenerate\s+password,\s+or\s+type\s+a\s+password\b", combined_lbl, re.IGNORECASE)
        )
        is_secret_input = (
            "secure" in role.lower()
            or "secure" in subrole.lower()
            or (
                role in TEXT_INPUT_AX_ROLES
                and (
                    is_lock_screen
                    or is_pw_hint
                    or bool(combined_lbl and _SECRET_FIELD_NAME_RE.search(combined_lbl))
                    or bool(_BULLET_MASK_RE.search(val))
                )
            )
        )
        if is_secret_input:
            extra_secure_ids.add(idx)
            if val and not is_val_placeholder:
                redacted_static_values.add(val)
            if not lbl:
                synthesized_labels[idx] = (
                    val if is_val_placeholder else (title_or_desc if title_or_desc else "Password")
                )
            if is_lock_screen:
                for look_pos in range(pos + 1, min(pos + 7, len(sorted_ids))):
                    cand_idx = sorted_ids[look_pos]
                    cand_el = by_index[cand_idx]
                    if (
                        str(cand_el.get("role") or "").strip() == "AXButton"
                        and not _el_label(cand_el)
                        and not _el_val(cand_el)
                        and not _is_unlabeled_window_button(cand_el, by_index)
                    ):
                        synthesized_labels[cand_idx] = touch_id_caption or "Unlock using Touch ID"
                        break

    # Pass 3: 1Password Detail Pane field spans ending at "<field>. More Actions"
    # Handles both 4-tuples ([field, val, Copy, More Actions]) and multi-node spans with
    # Watchtower badges, inline Reveal/Hide/Tooltip triples, or Website Open/Open-and-Fill controls.
    for pos, idx in enumerate(sorted_ids):
        el = by_index[idx]
        role = str(el.get("role") or "").strip()
        lbl = _el_label(el)
        m_more = _MORE_ACTIONS_RE.match(lbl) if role == "AXPopUpButton" else None
        if not m_more:
            continue
        field_name = m_more.group(1).strip()
        field_is_secret = bool(_SECRET_FIELD_NAME_RE.search(field_name))
        field_is_website = bool(_WEBSITE_FIELD_NAME_RE.search(field_name))

        boundary_pos = max(0, pos - 10)
        for scan_pos in range(pos - 1, max(-1, pos - 11), -1):
            scan_el = by_index[sorted_ids[scan_pos]]
            scan_role = str(scan_el.get("role") or "").strip()
            scan_lbl = _el_label(scan_el)
            if (scan_role == "AXPopUpButton" and _MORE_ACTIONS_RE.match(scan_lbl)) or scan_role in {
                "AXSplitter",
                "AXToolbar",
                "AXList",
            }:
                boundary_pos = scan_pos + 1
                break
        matched_header_pos: int | None = None
        for fwd_pos in range(boundary_pos, pos):
            fwd_el = by_index[sorted_ids[fwd_pos]]
            if str(fwd_el.get("role") or "").strip() == "AXStaticText":
                fwd_txt = (_el_val(fwd_el) or _el_label(fwd_el)).strip()
                if fwd_txt.rstrip(":").strip().lower() == field_name.lower():
                    matched_header_pos = fwd_pos
                    break
        start_pos = matched_header_pos if matched_header_pos is not None else boundary_pos

        span_positions = list(range(start_pos, pos))
        tooltip_positions: set[int] = set()
        for p in span_positions:
            p_idx = sorted_ids[p]
            p_el = by_index[p_idx]
            p_role = str(p_el.get("role") or "").strip()
            if p_role == "AXStaticText":
                p_txt = (_el_val(p_el) or _el_label(p_el)).strip()
                if p_txt.lower() == "tooltip:":
                    tooltip_positions.add(p)
                    if p + 1 < pos:
                        tooltip_positions.add(p + 1)
                        tip_el = by_index[sorted_ids[p + 1]]
                        tip_txt = (_el_val(tip_el) or _el_label(tip_el)).strip()
                        if re.search(r"\b(?:reveal|hide)\s+(?:password|secure)", tip_txt, re.IGNORECASE):
                            field_is_secret = True
                elif p not in tooltip_positions and _BULLET_MASK_RE.search(p_txt):
                    field_is_secret = True
            elif p_idx in extra_secure_ids or _el_label(p_el).strip().lower() in {"reveal", "hide"}:
                field_is_secret = True

        if field_is_secret:
            watchtower_badges = {"vulnerable", "weak", "compromised", "reused", "watchtower", "terrible"}
            for p in span_positions:
                s_idx = sorted_ids[p]
                s_el = by_index[s_idx]
                s_role = str(s_el.get("role") or "").strip()
                if s_role == "AXStaticText":
                    s_txt = (_el_val(s_el) or _el_label(s_el)).strip()
                    if (
                        p != matched_header_pos
                        and p not in tooltip_positions
                        and s_txt
                        and s_txt.lower() not in watchtower_badges
                    ):
                        redacted_static_values.add(s_txt)
                        extra_secure_ids.add(s_idx)
                else:
                    if s_role == "AXButton" and _el_label(s_el).lower() == "copy":
                        synthesized_labels[s_idx] = f"Copy {field_name}"
                    extra_secure_ids.add(s_idx)
            extra_secure_ids.add(idx)
        else:
            url_val = ""
            for p in span_positions:
                if p == matched_header_pos or p in tooltip_positions:
                    continue
                s_idx = sorted_ids[p]
                s_el = by_index[s_idx]
                s_role = str(s_el.get("role") or "").strip()
                s_txt = (_el_val(s_el) or _el_label(s_el)).strip()
                if (
                    s_role in {"AXStaticText", "AXLink"}
                    and s_txt
                    and s_txt.rstrip(":").strip().lower() != field_name.lower()
                    and s_txt.lower() not in {"open", "open and fill", "copy", "tooltip:"}
                    and (field_is_website or re.match(r"^https?://", s_txt, re.IGNORECASE))
                ):
                    url_val = s_txt
                    break
            for p in span_positions:
                s_idx = sorted_ids[p]
                s_el = by_index[s_idx]
                s_role = str(s_el.get("role") or "").strip()
                s_lbl = _el_label(s_el)
                s_synth = synthesized_labels.get(s_idx, "")
                if s_role == "AXButton" and s_lbl.lower() == "copy":
                    synthesized_labels[s_idx] = f"Copy {field_name}"
                elif s_role == "AXButton" and (
                    s_lbl.lower() in {"open", "open and fill"}
                    or s_synth.lower() in {"open", "open and fill"}
                ):
                    synthesized_labels[s_idx] = f"Open and Fill ({url_val})" if url_val else "Open and Fill"
                elif s_role == "AXLink" and (field_is_website or url_val):
                    target_url = url_val or s_lbl or _el_val(s_el)
                    if target_url and "open and fill" not in target_url.lower():
                        synthesized_labels[s_idx] = f"Open and Fill ({target_url})"

    # Pass 4: 1Password Edit Mode field rows
    for pos, idx in enumerate(sorted_ids):
        el = by_index[idx]
        role = str(el.get("role") or "").strip()
        lbl = _el_label(el)
        val = _el_val(el)
        m_drag = _REORDER_HANDLE_RE.match(lbl) if role == "AXButton" else None
        if m_drag and pos + 2 < len(sorted_ids):
            field_name = m_drag.group(1).strip()
            field_is_secret = bool(_SECRET_FIELD_NAME_RE.search(field_name))
            idx1 = sorted_ids[pos + 1]
            idx2 = sorted_ids[pos + 2]
            el1 = by_index[idx1]
            el2 = by_index[idx2]
            role1 = str(el1.get("role") or "").strip()
            role2 = str(el2.get("role") or "").strip()
            val1 = _el_val(el1)
            val2 = _el_val(el2)
            if role1 in TEXT_INPUT_AX_ROLES and role2 in TEXT_INPUT_AX_ROLES:
                if not _el_label(el1):
                    synthesized_labels.setdefault(idx1, f"Field label ({field_name})")
                synthesized_labels[idx2] = field_name
                if field_is_secret or _SECRET_FIELD_NAME_RE.search(val1) or _BULLET_MASK_RE.search(val2):
                    extra_secure_ids.add(idx2)
                    if val2 and not _pw_placeholder_re.match(val2):
                        redacted_static_values.add(val2)
            elif role1 == "AXStaticText" and role2 in TEXT_INPUT_AX_ROLES:
                synthesized_labels[idx2] = field_name
                if field_is_secret or _SECRET_FIELD_NAME_RE.search(val1) or _BULLET_MASK_RE.search(val2):
                    extra_secure_ids.add(idx2)
                    if val2 and not _pw_placeholder_re.match(val2):
                        redacted_static_values.add(val2)
        elif role in TEXT_INPUT_AX_ROLES and not lbl and idx not in synthesized_labels:
            next_el = by_index[sorted_ids[pos + 1]] if pos + 1 < len(sorted_ids) else None
            next_btn_lbl = (
                _el_label(next_el).strip().lower()
                if next_el is not None and str(next_el.get("role") or "").strip() == "AXButton"
                else ""
            )
            if is_1password_ctx and (val.lower().startswith("search in ") or next_btn_lbl == "clear"):
                synthesized_labels[idx] = "Search"
            elif val.lower().startswith("search ") or next_btn_lbl == "search":
                synthesized_labels[idx] = val.strip() if val.lower().startswith("search ") else "Search"
            elif is_1password_ctx and pos >= 1:
                prev_el = by_index[sorted_ids[pos - 1]]
                prev_role = str(prev_el.get("role") or "").strip()
                prev_lbl = _el_label(prev_el)
                prev_txt = (_el_val(prev_el) or prev_lbl).rstrip(":").strip()
                if prev_role == "AXPopUpButton" and "modify the custom icon" in prev_lbl.lower():
                    synthesized_labels[idx] = "Item Title"
                elif prev_role == "AXStaticText" and prev_txt and len(prev_txt) <= 32:
                    synthesized_labels[idx] = prev_txt
                    if _SECRET_FIELD_NAME_RE.search(prev_txt):
                        extra_secure_ids.add(idx)
                        if val and not _pw_placeholder_re.match(val):
                            redacted_static_values.add(val)

    # Pass 5: 1Password sidebar tiering (before first AXSplitter: core nav = tier 2, vault/tag lists = tier 3)
    sidebar_tier_by_id: dict[int, int] = {}
    if is_1password_ctx and not is_lock_screen:
        first_splitter_idx = next(
            (i for i in sorted_ids if str(by_index[i].get("role") or "").strip() == "AXSplitter"),
            None,
        )
        vaults_header_idx = next(
            (
                i
                for i in sorted_ids
                if str(by_index[i].get("role") or "").strip() == "AXButton"
                and _el_label(by_index[i]).strip().upper() == "VAULTS"
            ),
            None,
        )
        if first_splitter_idx is not None:
            core_sidebar_labels = {
                "all items",
                "favorites",
                "watchtower",
                "developer",
                "vaults",
                "new vault",
                "tags",
                "archive",
                "recently deleted",
                "profile",
            }
            for idx in sorted_ids:
                if idx >= first_splitter_idx:
                    break
                el = by_index[idx]
                role_s = str(el.get("role") or "").strip()
                lbl_low = _el_label(el).strip().lower()
                if role_s == "AXButton" and (
                    ", tooltip:" in lbl_low
                    or (
                        vaults_header_idx is not None
                        and idx > vaults_header_idx
                        and lbl_low not in core_sidebar_labels
                    )
                ):
                    sidebar_tier_by_id[idx] = 3
                else:
                    sidebar_tier_by_id[idx] = 2

    return synthesized_labels, extra_secure_ids, redacted_static_values, sidebar_tier_by_id


def _observation_window_size(observation: Mapping[str, Any] | None) -> tuple[float | None, float | None]:
    if not isinstance(observation, Mapping):
        return None, None
    widths: list[float] = []
    heights: list[float] = []
    for w_key, h_key in (("screenshot_width", "screenshot_height"), ("width", "height")):
        w_val = observation.get(w_key)
        h_val = observation.get(h_key)
        if (
            isinstance(w_val, (int, float))
            and not isinstance(w_val, bool)
            and w_val > 0
            and isinstance(h_val, (int, float))
            and not isinstance(h_val, bool)
            and h_val > 0
        ):
            widths.append(float(w_val))
            heights.append(float(h_val))
    for b_key in ("window_bounds", "bounds", "image_size", "screenshot"):
        b_val = observation.get(b_key)
        if isinstance(b_val, Mapping):
            for w_key, h_key in (("screenshot_width", "screenshot_height"), ("width", "height"), ("w", "h")):
                bw = b_val.get(w_key)
                bh = b_val.get(h_key)
                if (
                    isinstance(bw, (int, float))
                    and not isinstance(bw, bool)
                    and bw > 0
                    and isinstance(bh, (int, float))
                    and not isinstance(bh, bool)
                    and bh > 0
                ):
                    widths.append(float(bw))
                    heights.append(float(bh))
    if widths and heights:
        return max(widths), max(heights)
    return None, None


def extract_window_observation(
    driver_result: Mapping[str, Any],
    *,
    expected_pid: int,
    expected_window_id: int,
    query: str | None = None,
    baseline_observation: Mapping[str, Any] | None = None,
    previous_observation: Mapping[str, Any] | None = None,
    skeleton: bool = False,
    region: str | None = None,
    root_element_index: int | None = None,
    max_elements_cap: int = MAX_ELEMENTS,
    max_auto_candidates: int = MAX_AUTO_CANDIDATES,
    enrich_descriptions: bool = False,
) -> dict[str, Any]:
    """Validate and extract structured AX elements and static texts from get_window_state."""
    if baseline_observation is None and previous_observation is not None:
        baseline_observation = previous_observation
    sc = driver_result.get("structuredContent")
    if not isinstance(sc, Mapping):
        raise ValueError("Driver get_window_state did not return structuredContent")
    got_pid = sc.get("pid")
    got_wid = sc.get("window_id")
    if got_pid != expected_pid or got_wid != expected_window_id:
        raise ValueError(
            f"window_mismatch: expected (pid={expected_pid}, window_id={expected_window_id}), "
            f"got (pid={got_pid}, window_id={got_wid})"
        )
    snapshot_id = sc.get("snapshot_id")
    if not isinstance(snapshot_id, str) or not SNAPSHOT_ID_RE.match(snapshot_id):
        raise ValueError(f"Driver get_window_state returned invalid snapshot_id: {snapshot_id!r}")

    is_diff_payload = (
        sc.get("is_diff") is True
        or "diff_from_snapshot_id" in sc
        or "removed_element_indices" in sc
        or "updated_elements" in sc
        or "added_elements" in sc
    )
    if is_diff_payload:
        if not isinstance(baseline_observation, Mapping):
            raise ValueError("invalid_diff_baseline: fresh full get_window_state read required (missing baseline)")
        if (
            baseline_observation.get("pid") != expected_pid
            or baseline_observation.get("window_id") != expected_window_id
        ):
            raise ValueError("invalid_diff_baseline: fresh full get_window_state read required (target mismatch)")
        diff_from = sc.get("diff_from_snapshot_id")
        if not isinstance(diff_from, str) or not diff_from or baseline_observation.get("snapshot_id") != diff_from:
            raise ValueError("invalid_diff_baseline: fresh full get_window_state read required (snapshot mismatch)")
        base_is_incomplete = bool(
            baseline_observation.get("truncated", False)
            or baseline_observation.get("observation_truncated", False)
            or baseline_observation.get("query") is not None
            or (
                not baseline_observation.get("elements_complete", True)
                and baseline_observation.get("truncated") is not False
            )
        )
        if base_is_incomplete:
            raise ValueError("invalid_diff_baseline: fresh full get_window_state read required (incomplete baseline)")

        base_raw = baseline_observation.get("_raw_elements")
        if not isinstance(base_raw, list) or not base_raw:
            base_raw = baseline_observation.get("all_elements") or baseline_observation.get("elements")
        if not isinstance(base_raw, list) or not base_raw:
            raise ValueError("invalid_diff_baseline: fresh full get_window_state read required (empty baseline)")

        base_by_idx: dict[int, dict[str, Any]] = {}
        for b_el in base_raw:
            if not isinstance(b_el, Mapping):
                raise ValueError("invalid_diff_baseline: fresh full get_window_state read required")
            b_idx = b_el.get("element_index")
            if not isinstance(b_idx, int) or isinstance(b_idx, bool) or b_idx < 0:
                raise ValueError("invalid_diff_baseline: fresh full get_window_state read required")
            base_by_idx[b_idx] = dict(b_el)

        has_diff_ops = False
        if "removed_element_indices" in sc:
            has_diff_ops = True
            rem_list = sc.get("removed_element_indices")
            if not isinstance(rem_list, list):
                raise ValueError("invalid_diff_baseline: fresh full get_window_state read required")
            for r_idx in rem_list:
                if not isinstance(r_idx, int) or isinstance(r_idx, bool) or r_idx not in base_by_idx:
                    raise ValueError("invalid_diff_baseline: fresh full get_window_state read required")
                base_by_idx.pop(r_idx, None)

        if "updated_elements" in sc:
            has_diff_ops = True
            upd_list = sc.get("updated_elements")
            if not isinstance(upd_list, list):
                raise ValueError("invalid_diff_baseline: fresh full get_window_state read required")
            for u_el in upd_list:
                if not isinstance(u_el, Mapping):
                    raise ValueError("invalid_diff_baseline: fresh full get_window_state read required")
                u_idx = u_el.get("element_index")
                if not isinstance(u_idx, int) or isinstance(u_idx, bool) or u_idx not in base_by_idx:
                    raise ValueError("invalid_diff_baseline: fresh full get_window_state read required")
                merged = dict(base_by_idx[u_idx])
                merged.update(u_el)
                base_by_idx[u_idx] = merged

        if "added_elements" in sc:
            has_diff_ops = True
            add_list = sc.get("added_elements")
            if not isinstance(add_list, list):
                raise ValueError("invalid_diff_baseline: fresh full get_window_state read required")
            for a_el in add_list:
                if not isinstance(a_el, Mapping):
                    raise ValueError("invalid_diff_baseline: fresh full get_window_state read required")
                a_idx = a_el.get("element_index")
                if (
                    not isinstance(a_idx, int)
                    or isinstance(a_idx, bool)
                    or a_idx < 0
                    or a_idx in base_by_idx
                    or not a_el.get("role")
                ):
                    raise ValueError("invalid_diff_baseline: fresh full get_window_state read required")
                base_by_idx[a_idx] = dict(a_el)

        if not has_diff_ops and "elements" in sc:
            patch_els = sc.get("elements")
            if not isinstance(patch_els, list) or not patch_els:
                raise ValueError("invalid_diff_baseline: fresh full get_window_state read required")
            for p_el in patch_els:
                if not isinstance(p_el, Mapping):
                    raise ValueError("invalid_diff_baseline: fresh full get_window_state read required")
                p_idx = p_el.get("element_index")
                if not isinstance(p_idx, int) or isinstance(p_idx, bool) or p_idx < 0:
                    raise ValueError("invalid_diff_baseline: fresh full get_window_state read required")
                if p_el.get("removed") is True:
                    if p_idx not in base_by_idx:
                        raise ValueError("invalid_diff_baseline: fresh full get_window_state read required")
                    base_by_idx.pop(p_idx, None)
                elif p_idx in base_by_idx:
                    merged = dict(base_by_idx[p_idx])
                    merged.update(p_el)
                    base_by_idx[p_idx] = merged
                else:
                    if not p_el.get("role"):
                        raise ValueError("invalid_diff_baseline: fresh full get_window_state read required")
                    base_by_idx[p_idx] = dict(p_el)

        raw_elements: list[Any] = [base_by_idx[k] for k in sorted(base_by_idx.keys())]
    else:
        raw_elements = sc.get("elements")  # type: ignore[assignment]
        if not isinstance(raw_elements, list):
            raise ValueError("Driver get_window_state returned malformed elements list")

    text_blocks = "".join(
        c.get("text", "")
        for c in (driver_result.get("content") or [])
        if isinstance(c, Mapping) and c.get("type") == "text"
    )
    fallback_tree_md = (
        str(baseline_observation.get("_tree_markdown") or "")
        if (is_diff_payload and isinstance(baseline_observation, Mapping))
        else ""
    )
    using_fallback_tree_md = bool(not sc.get("tree_markdown") and not text_blocks and fallback_tree_md)
    tree_md = str(sc.get("tree_markdown") or text_blocks or fallback_tree_md or "")
    md_depth, md_toolbar_ids, md_menubar_ids, md_unlabeled_value_ids = _parse_markdown_hierarchy_full(tree_md)
    md_struct = _parse_markdown_structure(tree_md)

    by_index: dict[int, Mapping[str, Any]] = {}
    for item in raw_elements:
        if isinstance(item, Mapping) and isinstance(item.get("element_index"), int):
            by_index[item["element_index"]] = item

    def _raw_el_static_text(el_map: Mapping[str, Any]) -> str:
        st_val = el_map.get("value") if el_map.get("value") not in (None, "") else el_map.get("label")
        return st_val.replace("\u200e", "").strip() if isinstance(st_val, str) else ""

    raw_static_texts: list[str] = []
    base_md_static_records: list[dict[str, Any]] = []
    for rec in md_struct["static_records"]:
        rec_idx = rec["elem_idx"]
        if using_fallback_tree_md and rec_idx is not None:
            cur_el = by_index.get(rec_idx)
            if cur_el is None or str(cur_el.get("role") or "").strip() != "AXStaticText":
                continue
            if _raw_el_static_text(cur_el) != rec["text"]:
                continue
        base_md_static_records.append(
            {
                "text": rec["text"],
                "elem_idx": rec_idx,
                "anc_ckeys": list(rec["anc_ckeys"]),
                "all_anc_ids": set(rec["all_anc_ids"]),
                "has_non_root_anc": bool(rec["has_non_root_anc"]),
                "proven_top_level": bool(rec.get("proven_top_level", False)),
            }
        )
        if rec["text"] not in raw_static_texts:
            raw_static_texts.append(rec["text"])

    for raw_el in raw_elements:
        if isinstance(raw_el, Mapping) and str(raw_el.get("role") or "").strip() == "AXStaticText":
            st_clean = _raw_el_static_text(raw_el)
            if st_clean and st_clean not in raw_static_texts:
                raw_static_texts.append(st_clean)

    containers: dict[tuple[str, int], dict[str, Any]] = {
        ck: {
            "ckey": ck,
            "elem_idx": cv["elem_idx"],
            "role": cv["role"],
            "raw_label": cv["raw_label"],
            "strict_anc_ckeys": list(cv["strict_anc_ckeys"]),
            "anc_ckeys": list(cv["anc_ckeys"]),
            "all_anc_el_ids": set(cv["all_anc_el_ids"]),
            "desc_el_ids": set(cv["desc_el_ids"]),
        }
        for ck, cv in md_struct["containers"].items()
    }
    window_root_ids: set[int] = set(md_struct["window_root_ids"])
    known_container_indices: set[int] = {
        cv["elem_idx"] for cv in containers.values() if cv["elem_idx"] is not None
    } | set(window_root_ids)

    def _raw_el_label(el_map: Mapping[str, Any]) -> str:
        return str(
            el_map.get("label")
            if el_map.get("label") not in (None, "")
            else (
                el_map.get("title")
                if el_map.get("title") not in (None, "")
                else el_map.get("description") or ""
            )
        ).replace("\u200e", "").strip()

    for idx_k, el_k in by_index.items():
        k_role = str(el_k.get("role") or "").strip()
        if k_role in WINDOW_ROOT_ROLES:
            window_root_ids.add(idx_k)
            known_container_indices.add(idx_k)
        elif (
            k_role
            and k_role not in MENU_BAR_ROLES
            and k_role not in _LEAF_CONTROL_ROLES
        ):
            known_container_indices.add(idx_k)
            ck_el = ("el", idx_k)
            k_lbl = _raw_el_label(el_k)
            if ck_el not in containers:
                containers[ck_el] = {
                    "ckey": ck_el,
                    "elem_idx": idx_k,
                    "role": k_role,
                    "raw_label": k_lbl,
                    "strict_anc_ckeys": [],
                    "anc_ckeys": [ck_el],
                    "all_anc_el_ids": set(),
                    "desc_el_ids": {idx_k},
                }
            elif not containers[ck_el]["raw_label"] and k_lbl:
                containers[ck_el]["raw_label"] = k_lbl

    def _dedup_ckeys(seq: list[tuple[str, int]]) -> list[tuple[str, int]]:
        out_cks: list[tuple[str, int]] = []
        seen_cks: set[tuple[str, int]] = set()
        for ck in seq:
            if ck not in seen_cks:
                seen_cks.add(ck)
                out_cks.append(ck)
        return out_cks

    def _parent_chain_info(
        el_map: Mapping[str, Any],
    ) -> tuple[list[tuple[str, int]], set[int], bool, bool]:
        seen_p: set[int] = set()
        curr_p = el_map.get("parent_index")
        all_p_ids: set[int] = set()
        has_non_root_p = False
        in_toolbar_p = False
        has_nontoolbar_cont_p = False
        rev_ckeys: list[tuple[str, int]] = []
        while isinstance(curr_p, int) and not isinstance(curr_p, bool) and curr_p not in seen_p:
            seen_p.add(curr_p)
            all_p_ids.add(curr_p)
            p_el = by_index.get(curr_p)
            md_p_cks = md_struct["anc_ckeys_by_el"].get(curr_p, [])
            md_p_ids = md_struct["all_anc_ids_by_el"].get(curr_p, set())
            if md_p_ids:
                all_p_ids.update(md_p_ids)
            if md_struct["has_non_root_anc_by_el"].get(curr_p, False):
                has_non_root_p = True
            if md_struct["has_nontoolbar_container_anc_by_el"].get(curr_p, False):
                has_nontoolbar_cont_p = True
            if p_el is None:
                if curr_p not in window_root_ids:
                    has_non_root_p = True
                if curr_p in md_toolbar_ids:
                    in_toolbar_p = True
                ck_missing = ("el", curr_p)
                if ck_missing in containers:
                    c_miss = containers[ck_missing]
                    for m_ck in reversed(c_miss["anc_ckeys"]):
                        rev_ckeys.append(m_ck)
                    all_p_ids.update(c_miss["all_anc_el_ids"])
                    if c_miss["role"] != "AXToolbar" and curr_p not in md_toolbar_ids:
                        has_nontoolbar_cont_p = True
                elif md_p_cks:
                    for m_ck in reversed(md_p_cks):
                        rev_ckeys.append(m_ck)
                elif curr_p not in window_root_ids and curr_p not in md_toolbar_ids:
                    has_nontoolbar_cont_p = True
                break
            p_role = str(p_el.get("role") or "").strip()
            if p_role not in WINDOW_ROOT_ROLES:
                has_non_root_p = True
            if p_role == "AXToolbar" or curr_p in md_toolbar_ids:
                in_toolbar_p = True
            ck_p = ("el", curr_p)
            if ck_p in containers:
                rev_ckeys.append(ck_p)
                if p_role != "AXToolbar" and curr_p not in md_toolbar_ids:
                    has_nontoolbar_cont_p = True
            for m_ck in reversed(md_p_cks):
                rev_ckeys.append(m_ck)
            curr_p = p_el.get("parent_index")
        return (
            _dedup_ckeys(list(reversed(rev_ckeys))),
            all_p_ids,
            has_non_root_p,
            bool(has_nontoolbar_cont_p and not in_toolbar_p),
        )

    el_anc_ckeys: dict[int, list[tuple[str, int]]] = {
        k: list(v) for k, v in md_struct["anc_ckeys_by_el"].items()
    }
    ancestor_indices_by_el: dict[int, set[int]] = {
        k: set(v) for k, v in md_struct["all_anc_ids_by_el"].items()
    }
    has_non_root_anc_by_el: dict[int, bool] = dict(md_struct["has_non_root_anc_by_el"])
    has_nontoolbar_container_anc_by_el: dict[int, bool] = dict(
        md_struct["has_nontoolbar_container_anc_by_el"]
    )

    for idx_k, el_k in by_index.items():
        p_ckeys, p_all_ids, p_has_non_root, p_has_nt_cont = _parent_chain_info(el_k)
        ancestor_indices_by_el.setdefault(idx_k, set()).update(p_all_ids)
        merged_cks = _dedup_ckeys(el_anc_ckeys.get(idx_k, []) + p_ckeys)
        if merged_cks:
            el_anc_ckeys[idx_k] = merged_cks
        exp_depth = el_k.get("depth")
        depth_nested = (
            isinstance(exp_depth, int) and not isinstance(exp_depth, bool) and exp_depth >= 2
        ) or (md_depth.get(idx_k, 1) >= 2 and str(el_k.get("role") or "") not in WINDOW_ROOT_ROLES)
        has_non_root_anc_by_el[idx_k] = bool(
            has_non_root_anc_by_el.get(idx_k, False) or p_has_non_root or depth_nested
        )
        has_nontoolbar_container_anc_by_el[idx_k] = bool(
            has_nontoolbar_container_anc_by_el.get(idx_k, False) or p_has_nt_cont
        )
        for ck in merged_cks:
            if ck in containers:
                containers[ck]["desc_el_ids"].add(idx_k)
        ck_own = ("el", idx_k)
        if ck_own in containers:
            c_own = containers[ck_own]
            c_own["strict_anc_ckeys"] = _dedup_ckeys(
                [ck for ck in (c_own["strict_anc_ckeys"] + merged_cks) if ck != ck_own]
            )
            c_own["anc_ckeys"] = c_own["strict_anc_ckeys"] + [ck_own]
            c_own["all_anc_el_ids"].update(ancestor_indices_by_el[idx_k])

    # Alias unindexed markdown containers ("md", line_no) to unreferenced ("el", c_idx) containers
    # on the same descendant spine (1-to-1, never collapsing disjoint or co-indexed containers).
    unseen_el_ckeys = [
        ck
        for ck, cn in containers.items()
        if ck[0] == "el" and cn["elem_idx"] not in md_struct["seen_el_ids"]
    ]
    md_only_ckeys = sorted(
        [ck for ck in containers if ck[0] == "md"],
        key=lambda ck: len(containers[ck]["strict_anc_ckeys"]),
        reverse=True,
    )
    alias_map: dict[tuple[str, int], tuple[str, int]] = {}
    used_el_targets: set[tuple[str, int]] = set()
    for m_ck in md_only_ckeys:
        m_node = containers[m_ck]
        if not m_node["desc_el_ids"]:
            continue
        best_e: tuple[str, int] | None = None
        for e_ck in unseen_el_ckeys:
            if e_ck in used_el_targets:
                continue
            e_node = containers[e_ck]
            e_idx = e_node["elem_idx"]
            m_desc = m_node["desc_el_ids"] - ({e_idx} if e_idx is not None else set())
            e_desc = e_node["desc_el_ids"] - ({e_idx} if e_idx is not None else set())
            if m_node["role"] != e_node["role"] or m_node["raw_label"] != e_node["raw_label"]:
                continue
            if m_desc and m_desc == e_desc:
                best_e = e_ck
                break
        if best_e is not None:
            alias_map[m_ck] = best_e
            used_el_targets.add(best_e)

    if alias_map:
        for m_ck, e_ck in alias_map.items():
            m_node = containers.pop(m_ck)
            e_node = containers[e_ck]
            if not e_node["raw_label"] and m_node["raw_label"]:
                e_node["raw_label"] = m_node["raw_label"]
            e_node["strict_anc_ckeys"] = _dedup_ckeys(
                [alias_map.get(ck, ck) for ck in (m_node["strict_anc_ckeys"] + e_node["strict_anc_ckeys"]) if alias_map.get(ck, ck) != e_ck]
            )
            e_node["all_anc_el_ids"].update(m_node["all_anc_el_ids"])
            e_node["desc_el_ids"].update(m_node["desc_el_ids"])
        for ck, cn in containers.items():
            cn["strict_anc_ckeys"] = _dedup_ckeys(
                [alias_map.get(ak, ak) for ak in cn["strict_anc_ckeys"] if alias_map.get(ak, ak) != ck]
            )
            cn["anc_ckeys"] = cn["strict_anc_ckeys"] + [ck]
        for idx_e, cks_e in list(el_anc_ckeys.items()):
            el_anc_ckeys[idx_e] = _dedup_ckeys([alias_map.get(ak, ak) for ak in cks_e])
        for s_rec in base_md_static_records:
            s_rec["anc_ckeys"] = _dedup_ckeys([alias_map.get(ak, ak) for ak in s_rec["anc_ckeys"]])

    # Propagate transitive container ancestry and descendant element sets across merged chains.
    for _ in range(min(16, len(containers) + 1)):
        changed = False
        for ck, cn in containers.items():
            expanded: list[tuple[str, int]] = []
            for ak in cn["strict_anc_ckeys"]:
                if ak in containers:
                    expanded.extend(containers[ak]["strict_anc_ckeys"])
                expanded.append(ak)
            dedup_strict = _dedup_ckeys([ak for ak in expanded if ak != ck and ak in containers])
            if dedup_strict != cn["strict_anc_ckeys"]:
                cn["strict_anc_ckeys"] = dedup_strict
                cn["anc_ckeys"] = dedup_strict + [ck]
                changed = True
            for ak in cn["strict_anc_ckeys"]:
                before_n = len(containers[ak]["desc_el_ids"])
                containers[ak]["desc_el_ids"].update(cn["desc_el_ids"])
                if len(containers[ak]["desc_el_ids"]) != before_n:
                    changed = True
                if containers[ak]["elem_idx"] is not None:
                    cn["all_anc_el_ids"].add(containers[ak]["elem_idx"])
        if not changed:
            break

    for idx_e, cks_e in list(el_anc_ckeys.items()):
        expanded_el: list[tuple[str, int]] = []
        for ak in cks_e:
            if ak in containers:
                expanded_el.extend(containers[ak]["anc_ckeys"])
        el_anc_ckeys[idx_e] = _dedup_ckeys(expanded_el)

    static_records: list[dict[str, Any]] = list(base_md_static_records)
    for s_rec in static_records:
        exp_st: list[tuple[str, int]] = []
        for ak in s_rec["anc_ckeys"]:
            if ak in containers:
                exp_st.extend(containers[ak]["anc_ckeys"])
        s_rec["anc_ckeys"] = _dedup_ckeys(exp_st)

    has_any_hierarchy_ctx = bool(tree_md.strip() or containers)
    for raw_el in raw_elements:
        if isinstance(raw_el, Mapping) and str(raw_el.get("role") or "").strip() == "AXStaticText":
            st_clean = _raw_el_static_text(raw_el)
            if not st_clean:
                continue
            st_idx = raw_el.get("element_index")
            st_idx_int = st_idx if (isinstance(st_idx, int) and not isinstance(st_idx, bool)) else None
            p_ckeys, p_all_ids, p_has_non_root, _ = _parent_chain_info(raw_el)
            if st_idx_int is not None:
                p_ckeys = _dedup_ckeys(el_anc_ckeys.get(st_idx_int, []) + p_ckeys)
                p_all_ids = p_all_ids | ancestor_indices_by_el.get(st_idx_int, set())
                p_has_non_root = bool(p_has_non_root or has_non_root_anc_by_el.get(st_idx_int, False))
            for anc_id in list(p_all_ids):
                if anc_id in el_anc_ckeys:
                    p_ckeys = _dedup_ckeys(el_anc_ckeys[anc_id] + p_ckeys)
                if has_non_root_anc_by_el.get(anc_id, False):
                    p_has_non_root = True
            exp_raw_cks: list[tuple[str, int]] = []
            for ak in p_ckeys:
                ak_norm = alias_map.get(ak, ak)
                if ak_norm in containers:
                    exp_raw_cks.extend(containers[ak_norm]["anc_ckeys"])
                else:
                    exp_raw_cks.append(ak_norm)
            p_ckeys = _dedup_ckeys(exp_raw_cks)
            exp_st_depth = raw_el.get("depth")
            if isinstance(exp_st_depth, int) and not isinstance(exp_st_depth, bool) and exp_st_depth >= 2:
                p_has_non_root = True
            if p_ckeys:
                p_has_non_root = True
            raw_parent = raw_el.get("parent_index")
            proven_raw_top = bool(
                not p_has_non_root
                and not p_ckeys
                and (
                    (isinstance(raw_parent, int) and not isinstance(raw_parent, bool) and raw_parent in window_root_ids)
                    or (isinstance(exp_st_depth, int) and not isinstance(exp_st_depth, bool) and exp_st_depth == 1)
                    or not has_any_hierarchy_ctx
                )
            )
            matched_existing = False
            if st_idx_int is not None:
                for s_rec in static_records:
                    if s_rec["elem_idx"] == st_idx_int and s_rec["text"] == st_clean:
                        s_rec["anc_ckeys"] = _dedup_ckeys(s_rec["anc_ckeys"] + p_ckeys)
                        s_rec["all_anc_ids"].update(p_all_ids)
                        s_rec["has_non_root_anc"] = bool(s_rec["has_non_root_anc"] or p_has_non_root)
                        s_rec["proven_top_level"] = bool(
                            (s_rec.get("proven_top_level", False) or proven_raw_top)
                            and not s_rec["has_non_root_anc"]
                            and not s_rec["anc_ckeys"]
                        )
                        matched_existing = True
                        break
                if not matched_existing:
                    unindexed_matches = [
                        s_rec
                        for s_rec in static_records
                        if s_rec["elem_idx"] is None and s_rec["text"] == st_clean
                    ]
                    chosen_rec: dict[str, Any] | None = None
                    if p_ckeys:
                        chosen_rec = next(
                            (sr for sr in unindexed_matches if sr["anc_ckeys"] == p_ckeys),
                            None,
                        )
                    if chosen_rec is None and proven_raw_top:
                        chosen_rec = next(
                            (sr for sr in unindexed_matches if sr.get("proven_top_level", False)),
                            None,
                        )
                    if chosen_rec is None and len(unindexed_matches) == 1:
                        chosen_rec = unindexed_matches[0]
                    if chosen_rec is not None:
                        chosen_rec["elem_idx"] = st_idx_int
                        chosen_rec["anc_ckeys"] = _dedup_ckeys(chosen_rec["anc_ckeys"] + p_ckeys)
                        chosen_rec["all_anc_ids"].update(p_all_ids)
                        chosen_rec["has_non_root_anc"] = bool(chosen_rec["has_non_root_anc"] or p_has_non_root)
                        chosen_rec["proven_top_level"] = bool(
                            (chosen_rec.get("proven_top_level", False) or proven_raw_top)
                            and not chosen_rec["has_non_root_anc"]
                            and not chosen_rec["anc_ckeys"]
                        )
                        matched_existing = True
            else:
                for s_rec in static_records:
                    if (
                        s_rec["elem_idx"] is None
                        and s_rec["text"] == st_clean
                        and s_rec["anc_ckeys"] == p_ckeys
                        and s_rec["has_non_root_anc"] == p_has_non_root
                    ):
                        s_rec["all_anc_ids"].update(p_all_ids)
                        s_rec["proven_top_level"] = bool(
                            (s_rec.get("proven_top_level", False) or proven_raw_top)
                            and not s_rec["has_non_root_anc"]
                            and not s_rec["anc_ckeys"]
                        )
                        matched_existing = True
                        break
            if not matched_existing:
                static_records.append(
                    {
                        "text": st_clean,
                        "elem_idx": st_idx_int,
                        "anc_ckeys": p_ckeys,
                        "all_anc_ids": p_all_ids,
                        "has_non_root_anc": p_has_non_root,
                        "proven_top_level": proven_raw_top,
                    }
                )

    win_root_label = ""
    for raw_el in raw_elements:
        if isinstance(raw_el, Mapping) and str(raw_el.get("role") or "") in WINDOW_ROOT_ROLES and raw_el.get("label"):
            win_root_label = str(raw_el.get("label") or "")
            break
    obs_context: dict[str, Any] = {
        "app_name": sc.get("app_name") or (baseline_observation.get("app_name") if isinstance(baseline_observation, Mapping) else None),
        "window_title": sc.get("window_title") or win_root_label or (baseline_observation.get("window_title") if isinstance(baseline_observation, Mapping) else None),
    }
    is_1password_ctx = "1password" in str(obs_context.get("app_name") or "").lower() or "1password" in str(
        obs_context.get("window_title") or ""
    ).lower()
    synthesized_labels, extra_secure_ids, redacted_static_values, sidebar_secondary_ids = _analyze_window_elements(
        by_index, obs_context, raw_static_texts, md_unlabeled_value_ids
    )

    all_secure_ids: set[int] = set(extra_secure_ids) | set(md_struct["secure_ids"])
    all_secret_values: set[str] = {
        sv for sv in (redacted_static_values | md_struct["secure_values"]) if sv
    }
    for idx_s, el_s in by_index.items():
        s_role = str(el_s.get("role") or "").strip()
        s_subrole = str(el_s.get("subrole") or "").strip()
        s_val = (
            ""
            if el_s.get("value") is None
            else str(el_s.get("value") or "").replace("\u200e", "").strip()
        )
        s_lbl = _raw_el_label(el_s)
        if (
            "secure" in s_role.lower()
            or "secure" in s_subrole.lower()
            or idx_s in all_secure_ids
            or bool(_BULLET_MASK_RE.search(s_val))
            or bool(_BULLET_MASK_RE.search(s_lbl))
        ):
            all_secure_ids.add(idx_s)
            if s_val and not _PW_PLACEHOLDER_RE.match(s_val):
                all_secret_values.add(s_val)

    if isinstance(obs_context.get("window_title"), str) and _contains_secret_or_mask(
        obs_context["window_title"], all_secret_values
    ):
        obs_context["window_title"] = obs_context.get("app_name") or ""

    def _dedup_consecutive_labels(labels: list[str]) -> list[str]:
        deduped: list[str] = []
        for lbl_item in labels:
            if lbl_item and (not deduped or deduped[-1] != lbl_item):
                deduped.append(lbl_item)
        return deduped

    for ck, cn in containers.items():
        c_idx = cn["elem_idx"]
        c_el = by_index.get(c_idx) if c_idx is not None else None
        c_subrole = str((c_el or {}).get("subrole") or "")
        c_val = (
            ""
            if not c_el or c_el.get("value") is None
            else str(c_el.get("value") or "").replace("\u200e", "").strip()
        )
        c_has_sec_desc = bool(cn["desc_el_ids"] & all_secure_ids)
        c_is_sec = (
            (c_idx is not None and c_idx in all_secure_ids)
            or ("secure" in cn["role"].lower())
            or ("secure" in c_subrole.lower())
            or _contains_secret_or_mask(c_val, all_secret_values, strict_short=c_has_sec_desc)
        )
        raw_c_lbl = cn["raw_label"]
        cn["clean_label"] = (
            ""
            if (c_is_sec or _contains_secret_or_mask(raw_c_lbl, all_secret_values, strict_short=c_has_sec_desc))
            else raw_c_lbl
        )

    for ck, cn in containers.items():
        cn["clean_path_dedup"] = _dedup_consecutive_labels(
            [containers[ak]["clean_label"] for ak in cn["anc_ckeys"] if ak in containers and containers[ak]["clean_label"]]
        )

    container_segments_by_el: dict[int, list[str]] = {}
    for idx_e, cks_e in el_anc_ckeys.items():
        segs_e = _dedup_consecutive_labels(
            [containers[ak]["clean_label"] for ak in cks_e if ak in containers and containers[ak]["clean_label"]]
        )
        if segs_e:
            container_segments_by_el[idx_e] = segs_e

    native_root_token = (
        str(sc["root_element_token"]).strip()
        if isinstance(sc.get("root_element_token"), str) and str(sc["root_element_token"]).strip()
        else None
    )
    reported_region = region.strip() if isinstance(region, str) and region.strip() else None
    reported_root_element_index = root_element_index
    if native_root_token is not None:
        if 0 in all_secure_ids:
            raise ValueError("secure_root_element_refused: native root_element_token targets a secure element")
        if reported_region is not None and (">" in reported_region or reported_root_element_index is not None):
            eff_region = reported_region
        else:
            eff_region = None
        if reported_region is None or reported_root_element_index is None:
            root_element_index = None
    else:
        eff_region = reported_region
    if root_element_index is not None:
        if (
            root_element_index not in by_index
            and root_element_index not in known_container_indices
            and root_element_index not in md_struct["seen_el_ids"]
        ):
            raise ValueError(
                f"unknown_root_element_index: element_index={root_element_index} not found in snapshot {snapshot_id}"
            )
        if root_element_index in all_secure_ids:
            raise ValueError(
                f"secure_root_element_refused: element_index={root_element_index} targets a secure element"
            )

    target_region_ckey: tuple[str, int] | None = None
    if eff_region is not None:
        reg_parts = [p.strip().lower() for p in eff_region.split(">") if p.strip()]
        if not reg_parts:
            raise ValueError(f"unknown_region: region={eff_region!r} not found in window hierarchy")
        matched_ckeys = [
            ck
            for ck, cn in containers.items()
            if _container_matches_region_parts(cn["clean_path_dedup"], cn["clean_label"], reg_parts)
            and (
                root_element_index is None
                or cn["elem_idx"] == root_element_index
                or root_element_index in cn["all_anc_el_ids"]
            )
        ]
        if not matched_ckeys:
            raise ValueError(f"unknown_region: region={eff_region!r} not found in window hierarchy")
        matched_roots = [
            ck
            for ck in matched_ckeys
            if not any(
                other != ck
                and other in containers[ck]["strict_anc_ckeys"]
                and containers[other]["clean_path_dedup"] == containers[ck]["clean_path_dedup"]
                for other in matched_ckeys
            )
        ]
        if len(matched_roots) > 1:
            raise ValueError(
                f"ambiguous_region: region={eff_region!r} matches {len(matched_roots)} distinct containers; "
                "disambiguate with 'Parent > Child' or root_element_index"
            )
        target_region_ckey = matched_roots[0]

    eff_query: str | None = None
    if isinstance(query, str) and query.strip():
        eff_query = query.strip()
    elif isinstance(sc.get("query"), str) and str(sc.get("query")).strip():
        eff_query = str(sc.get("query")).strip()

    compact_elements: list[dict[str, Any]] = []
    explicit_target_elements: list[dict[str, Any]] = []
    window_secure_control_ids: set[int] = set()

    for idx in sorted(by_index.keys()):
        el = by_index[idx]
        role = str(el.get("role") or "").strip()
        if not role or role in WINDOW_ROOT_ROLES:
            continue
        if _is_in_menu_bar(el, by_index, md_menubar_ids) or _is_unlabeled_window_button(el, by_index):
            continue
        if el.get("enabled") is False:
            continue
        raw_label = (
            el.get("label")
            if el.get("label") not in (None, "")
            else (el.get("title") if el.get("title") not in (None, "") else el.get("description"))
        )
        label = str(raw_label or "").replace("\u200e", "").strip()
        synth_label = synthesized_labels.get(idx, "")
        subrole = str(el.get("subrole") or "").strip()
        raw_val_str = (
            ""
            if el.get("value") is None
            else str(el.get("value") or "").replace("\u200e", "").strip()
        )
        is_secure = (
            "secure" in role.lower()
            or "secure" in subrole.lower()
            or _contains_secret_or_mask(raw_val_str, all_secret_values)
            or _contains_secret_or_mask(label, all_secret_values)
            or (idx in all_secure_ids)
        )
        if _contains_secret_or_mask(label, all_secret_values):
            label = ""
        if _contains_secret_or_mask(synth_label, all_secret_values):
            synth_label = ""
        if (
            (role in TEXT_INPUT_AX_ROLES or is_secure)
            and (idx in md_unlabeled_value_ids or is_1password_ctx or is_secure)
            and label
            and label == raw_val_str
        ):
            alt = el.get("title") if el.get("title") not in (None, "") else el.get("description")
            alt_str = str(alt or "").replace("\u200e", "").strip()
            if (
                alt_str
                and alt_str != raw_val_str
                and not _contains_secret_or_mask(alt_str, all_secret_values)
            ):
                label = alt_str
            else:
                label = ""
        raw_val_state = (
            ""
            if el.get("value_state") is None
            else str(el.get("value_state") or "").replace("\u200e", "").strip()
        )
        if is_secure:
            value = None
        elif el.get("value") is not None:
            value = raw_val_str
        elif (
            raw_val_state
            and role in {"AXCheckBox", "AXRadioButton", "AXPopUpButton", "AXSlider", "AXIncrementor"}
            and not _contains_secret_or_mask(raw_val_state, all_secret_values)
        ):
            value = raw_val_state
        else:
            value = None
        actions, has_explicit_actions = _normalized_actions(el)
        supports_press = _supports_press_action(actions)

        if (
            role not in ACTIONABLE_AX_ROLES
            and role not in EXPLICIT_TARGET_CONTAINER_ROLES
            and not supports_press
        ):
            continue
        if is_secure:
            window_secure_control_ids.add(idx)
        depth, in_toolbar = _element_depth_and_toolbar(idx, el, by_index, md_depth, md_toolbar_ids)
        if in_toolbar and role in TEXT_INPUT_AX_ROLES and not label and not synth_label and not is_secure:
            synth_label = "Search"

        eff_label = synth_label or label
        can_auto_click = (
            (not is_secure)
            and not (role == "AXMenuItem" and in_toolbar)
            and _element_can_auto_click(role, actions, has_explicit_actions)
        )
        can_click = (not is_secure) and _element_can_explicit_click(role, actions, has_explicit_actions)
        can_set_value = (not is_secure) and (role in VALUE_SETTABLE_AX_ROLES)
        supported_actions: list[str] = []
        if can_click:
            supported_actions.append("click")
            if role == "AXCheckBox" and _parse_checkbox_bool_state(value) is not None:
                supported_actions.extend(["check", "uncheck"])
        if can_set_value:
            supported_actions.append("set_value")
        if (not is_secure) and (role in TEXT_INPUT_AX_ROLES):
            supported_actions.append("type_text")

        has_label_or_value = bool(eff_label or value or is_secure or role in TEXT_INPUT_AX_ROLES)
        is_actionable_control = (
            has_label_or_value
            and (role in ACTIONABLE_AX_ROLES or supports_press)
            and (can_click or can_set_value or is_secure)
        )

        is_text_input = role in TEXT_INPUT_AX_ROLES or is_secure
        state_str = "enabled (secure)" if is_secure else ("enabled (has_value)" if value else "enabled")
        if (in_toolbar or eff_label == "Search") and role in TEXT_INPUT_AX_ROLES and not label and raw_val_str.lower().startswith("search"):
            display_label = raw_val_str
        else:
            display_label = eff_label or (value if not is_text_input else "") or role
        raw_label_val = eff_label or (value if not is_text_input else "")
        is_open_and_fill_ctrl = is_1password_ctx and bool(
            re.search(r"\b(?:open\s+and\s+fill|autofill)\b", display_label, re.IGNORECASE)
        )
        priority_tier = 0 if (in_toolbar or is_open_and_fill_ctrl) else sidebar_secondary_ids.get(idx, 1)

        el_segs = container_segments_by_el.get(idx) or []
        compact_el: dict[str, Any] = {
            "element_index": idx,
            "role": role,
            "label": display_label,
            "raw_label": raw_label_val,
            "state": state_str,
            "depth": depth,
            "in_toolbar": in_toolbar,
            "priority_tier": priority_tier,
            "can_click": can_click,
            "can_auto_click": can_auto_click,
            "supported_actions": supported_actions,
        }
        if value is not None:
            compact_el["value"] = value
        if el_segs and (enrich_descriptions or skeleton or eff_region is not None or root_element_index is not None):
            compact_el["container_path"] = " > ".join(el_segs)[:240]

        matches_query = True
        if eff_query is not None:
            q_low = eff_query.lower()
            raw_title_str = str(el.get("title") or "").replace("\u200e", "").strip()
            raw_desc_str = str(el.get("description") or "").replace("\u200e", "").strip()
            safe_title_str = (
                "" if (is_secure or _contains_secret_or_mask(raw_title_str, all_secret_values)) else raw_title_str
            )
            safe_desc_str = (
                "" if (is_secure or _contains_secret_or_mask(raw_desc_str, all_secret_values)) else raw_desc_str
            )
            haystack = " ".join([
                display_label,
                raw_label_val,
                role,
                value or "",
                " > ".join(el_segs),
                safe_title_str,
                safe_desc_str,
            ]).lower()
            matches_query = q_low in haystack

        if is_actionable_control and matches_query:
            compact_elements.append(compact_el)
        else:
            explicit_target_elements.append(compact_el)

    window_total_actionable = len(compact_elements)

    region_buckets: dict[tuple[str, int], dict[str, Any]] = {}
    for cel in compact_elements:
        c_idx = cel["element_index"]
        if (
            c_idx in all_secure_ids
            or "secure" in str(cel.get("state") or "")
            or not cel.get("supported_actions")
        ):
            continue
        anc_cks = el_anc_ckeys.get(c_idx, [])
        top_ck = next(
            (ak for ak in anc_cks if ak in containers and containers[ak]["clean_label"]),
            None,
        )
        if top_ck is None:
            continue
        top_node = containers[top_ck]
        top_reg = top_node["clean_label"]
        bucket = region_buckets.get(top_ck)
        if bucket is None:
            bucket = {
                "region": top_reg,
                "actionable_count": 0,
                "subregions": [],
                "sample_labels": [],
            }
            if top_node["elem_idx"] is not None:
                bucket["element_index"] = top_node["elem_idx"]
            region_buckets[top_ck] = bucket
        bucket["actionable_count"] += 1
        top_pos = anc_cks.index(top_ck)
        next_sub = next(
            (
                containers[ak]["clean_label"]
                for ak in anc_cks[top_pos + 1 :]
                if ak in containers
                and containers[ak]["clean_label"]
                and containers[ak]["clean_label"] != top_reg
            ),
            None,
        )
        if next_sub and next_sub not in bucket["subregions"] and len(bucket["subregions"]) < 8:
            bucket["subregions"].append(next_sub)
        c_lbl = str(cel.get("label") or "").strip()
        if (
            c_lbl
            and not _contains_secret_or_mask(c_lbl, all_secret_values)
            and c_lbl not in bucket["sample_labels"]
            and len(bucket["sample_labels"]) < 4
        ):
            bucket["sample_labels"].append(c_lbl)
    native_regions: list[dict[str, Any]] = []
    raw_sc_regions = sc.get("regions")
    if isinstance(raw_sc_regions, list):
        for r_entry in raw_sc_regions:
            if not isinstance(r_entry, Mapping):
                continue
            r_lbl = str(r_entry.get("label") or "").replace("\u200e", "").strip()
            r_tok = r_entry.get("region_token")
            r_role = str(r_entry.get("role") or "").strip()
            r_depth = r_entry.get("depth")
            if (
                not r_lbl
                or _contains_secret_or_mask(r_lbl, all_secret_values)
                or not isinstance(r_tok, str)
                or not r_tok
            ):
                continue
            nr_obj: dict[str, Any] = {
                "label": r_lbl,
                "region_token": r_tok,
                "role": r_role,
                "depth": int(r_depth) if isinstance(r_depth, int) and not isinstance(r_depth, bool) else 1,
            }
            r_eidx = r_entry.get("element_index")
            if isinstance(r_eidx, int) and not isinstance(r_eidx, bool) and r_eidx not in all_secure_ids:
                nr_obj["element_index"] = r_eidx
            native_regions.append(nr_obj)

    active_surfaces: list[dict[str, Any]] = []
    raw_sc_surfaces = sc.get("surfaces")
    if isinstance(raw_sc_surfaces, list):
        for s_entry in raw_sc_surfaces:
            if not isinstance(s_entry, Mapping):
                continue
            s_kind = str(s_entry.get("kind") or "").strip()
            s_role = str(s_entry.get("role") or "").strip()
            if not s_kind or not s_role:
                continue
            s_obj: dict[str, Any] = {"kind": s_kind, "role": s_role}
            s_title = str(s_entry.get("title") or "").replace("\u200e", "").strip()
            if s_title and not _contains_secret_or_mask(s_title, all_secret_values):
                s_obj["title"] = s_title
            for opt_k in ("subrole", "element_index", "window_id"):
                if s_entry.get(opt_k) is not None:
                    s_obj[opt_k] = s_entry[opt_k]
            active_surfaces.append(s_obj)

    drill_regions: list[dict[str, Any]] = list(region_buckets.values())
    if native_regions:
        nr_by_norm: dict[str, list[dict[str, Any]]] = {}
        for nr in native_regions:
            nr_key = nr["label"].lower()
            nr_by_norm.setdefault(nr_key, []).append(nr)
        used_nr_tokens: set[str] = set()
        seen_drill_el_ids: set[int] = {
            b["element_index"]
            for b in drill_regions
            if isinstance(b.get("element_index"), int) and not isinstance(b.get("element_index"), bool)
        }
        for b_item in drill_regions:
            norm_b = str(b_item["region"]).strip().lower()
            cand_nrs = nr_by_norm.get(norm_b) or []
            matched_nr: dict[str, Any] | None = None
            if "element_index" in b_item:
                for c_nr in cand_nrs:
                    if c_nr["region_token"] not in used_nr_tokens and c_nr.get("element_index") == b_item["element_index"]:
                        matched_nr = c_nr
                        break
            elif len(cand_nrs) == 1:
                c0 = cand_nrs[0]
                if c0["region_token"] not in used_nr_tokens and (
                    c0.get("element_index") is None or c0.get("element_index") not in seen_drill_el_ids
                ):
                    matched_nr = c0
            if matched_nr is not None:
                b_item["region_token"] = matched_nr["region_token"]
                used_nr_tokens.add(matched_nr["region_token"])
        if native_root_token is None and (bool(sc.get("truncated", False)) or skeleton):
            for nr in native_regions:
                if (
                    nr["depth"] <= 2
                    and nr["region_token"] not in used_nr_tokens
                    and (nr.get("element_index") is None or nr.get("element_index") not in seen_drill_el_ids)
                ):
                    used_nr_tokens.add(nr["region_token"])
                    unwalked_item: dict[str, Any] = {
                        "region": nr["label"],
                        "region_token": nr["region_token"],
                        "actionable_count": 0,
                        "subregions": [],
                        "sample_labels": [],
                        "unwalked_region": True,
                    }
                    if "element_index" in nr:
                        unwalked_item["element_index"] = nr["element_index"]
                        seen_drill_el_ids.add(nr["element_index"])
                    drill_regions.append(unwalked_item)
    top_name_counts: dict[str, int] = {}
    for b_item in drill_regions:
        norm_r = str(b_item["region"]).strip().lower()
        top_name_counts[norm_r] = top_name_counts.get(norm_r, 0) + 1
    used_drill_cids: set[str] = set()
    for r_pos, b_item in enumerate(drill_regions):
        if top_name_counts.get(str(b_item["region"]).strip().lower(), 0) > 1:
            b_item["ambiguous_region"] = True
        base_dcid = f"drill.{r_pos}.{_slug(str(b_item.get('region') or 'region'))}"
        dcid = base_dcid
        sfx = 2
        while dcid in used_drill_cids:
            dcid = f"{base_dcid}-{sfx}"
            sfx += 1
        used_drill_cids.add(dcid)
        b_item["candidate_id"] = dcid

    def _el_in_subtree_scope(cel: Mapping[str, Any]) -> bool:
        c_idx = cel["element_index"]
        c_anc_cks = el_anc_ckeys.get(c_idx, [])
        c_anc_ids = ancestor_indices_by_el.get(c_idx, set())
        if target_region_ckey is not None and target_region_ckey not in c_anc_cks:
            return False
        if (
            root_element_index is not None
            and c_idx != root_element_index
            and root_element_index not in c_anc_ids
            and ("el", root_element_index) not in c_anc_cks
        ):
            return False
        return True

    def _el_in_skeleton_scope(cel: Mapping[str, Any]) -> bool:
        if cel.get("in_toolbar"):
            return True
        c_idx = cel["element_index"]
        if has_nontoolbar_container_anc_by_el.get(c_idx, False) or el_anc_ckeys.get(c_idx):
            return False
        return bool(cel.get("depth", 1) <= SKELETON_SHALLOW_MAX_DEPTH)

    if target_region_ckey is not None or root_element_index is not None:
        scoped_compact_elements = [e for e in compact_elements if _el_in_subtree_scope(e)]
        scoped_explicit_elements = [e for e in explicit_target_elements if _el_in_subtree_scope(e)]
    elif skeleton:
        scoped_compact_elements = [e for e in compact_elements if _el_in_skeleton_scope(e)]
        scoped_explicit_elements = [e for e in explicit_target_elements if _el_in_skeleton_scope(e)]
    else:
        scoped_compact_elements = compact_elements
        scoped_explicit_elements = explicit_target_elements

    all_clean_static_texts = [
        t
        for t in raw_static_texts
        if t and not _contains_secret_or_mask(t, all_secret_values)
    ]
    if not skeleton and target_region_ckey is None and root_element_index is None:
        static_texts = all_clean_static_texts
    else:
        scoped_st: list[str] = []
        for s_rec in static_records:
            st_txt = s_rec["text"]
            st_elem_idx = s_rec["elem_idx"]
            if (
                not st_txt
                or st_txt in scoped_st
                or (st_elem_idx is not None and st_elem_idx in all_secure_ids)
                or _contains_secret_or_mask(st_txt, all_secret_values)
            ):
                continue
            is_top_level_st = (
                bool(s_rec.get("proven_top_level", False))
                and (not s_rec["has_non_root_anc"])
                and (not s_rec["anc_ckeys"])
            )
            if target_region_ckey is not None or root_element_index is not None:
                in_reg = target_region_ckey is None or (target_region_ckey in s_rec["anc_ckeys"])
                in_root = root_element_index is None or (
                    st_elem_idx == root_element_index
                    or root_element_index in s_rec["all_anc_ids"]
                    or ("el", root_element_index) in s_rec["anc_ckeys"]
                )
                if is_top_level_st or (in_reg and in_root):
                    scoped_st.append(st_txt)
            elif skeleton:
                if is_top_level_st:
                    scoped_st.append(st_txt)
        static_texts = scoped_st

    # Prioritize toolbar controls first, then primary content controls, then secondary sidebar lists, breaking ties by depth and element_index
    prioritized_elements = sorted(
        scoped_compact_elements,
        key=lambda e: (
            e.get("priority_tier", 1),
            max(1, e.get("depth", 1) - 1) if e.get("role") == "AXMenuItem" else e.get("depth", 1),
            e["element_index"],
        ),
    )

    auto_candidates: list[dict[str, Any]] = []
    used_ids: set[str] = set()
    total_click_candidates = 0

    for compact_el in prioritized_elements:
        if not compact_el.get("can_auto_click", compact_el.get("can_click", True)):
            continue
        display_label = compact_el["label"]
        if _check_commit_safety_gate(
            obs_context, display_label, "click", {"element_index": compact_el["element_index"]}
        ) is not None:
            continue
        total_click_candidates += 1
        if len(auto_candidates) >= max_auto_candidates:
            continue
        idx = compact_el["element_index"]
        role = compact_el["role"]
        base_id = f"ax.{idx}.{_slug(display_label)}"
        cid = base_id
        suffix = 2
        while cid in used_ids:
            cid = f"{base_id}-{suffix}"
            suffix += 1
        used_ids.add(cid)
        desc = f"Click [{idx}] {role} {json.dumps(display_label, ensure_ascii=False)}"
        if enrich_descriptions:
            c_path = compact_el.get("container_path")
            if isinstance(c_path, str) and c_path:
                desc += f" in {c_path[:160]}"
            if (
                role in {"AXPopUpButton", "AXCheckBox", "AXRadioButton"}
                and "value" in compact_el
                and compact_el["value"] not in (None, "")
                and len(str(compact_el["value"])) <= 40
            ):
                desc += f" (current={json.dumps(str(compact_el['value']), ensure_ascii=False)})"
        auto_candidates.append({
            "id": cid,
            "description": desc,
            "pid": expected_pid,
            "window_id": expected_window_id,
            "snapshot_id": snapshot_id,
            "tool": "click",
            "arguments": {
                "pid": expected_pid,
                "window_id": expected_window_id,
                "snapshot_id": snapshot_id,
                "element_index": idx,
                "element_token": f"{snapshot_id}:{idx}",
                "delivery_mode": "background",
            },
        })
        if enrich_descriptions and role == "AXCheckBox":
            cb_bool = _parse_checkbox_bool_state(compact_el.get("value"))
            if cb_bool is not None:
                c_path = compact_el.get("container_path")
                in_path = f" in {c_path[:160]}" if isinstance(c_path, str) and c_path else ""
                state_word = "checked" if cb_bool else "unchecked"
                for chk_prefix, chk_tool, chk_verb, chk_goal_word in (
                    ("chk", "check", "Check", "checked"),
                    ("unchk", "uncheck", "Uncheck", "unchecked"),
                ):
                    if len(auto_candidates) >= max_auto_candidates:
                        break
                    chk_base = f"{chk_prefix}.{idx}.{_slug(display_label)}"
                    chk_cid = chk_base
                    chk_suf = 2
                    while chk_cid in used_ids:
                        chk_cid = f"{chk_base}-{chk_suf}"
                        chk_suf += 1
                    used_ids.add(chk_cid)
                    chk_desc = (
                        f"{chk_verb} [{idx}] AXCheckBox {json.dumps(display_label, ensure_ascii=False)}"
                        f"{in_path} (idempotent: ensure {chk_goal_word}; currently {state_word})"
                    )
                    auto_candidates.append({
                        "id": chk_cid,
                        "description": chk_desc,
                        "pid": expected_pid,
                        "window_id": expected_window_id,
                        "snapshot_id": snapshot_id,
                        "tool": chk_tool,
                        "arguments": {
                            "pid": expected_pid,
                            "window_id": expected_window_id,
                            "snapshot_id": snapshot_id,
                            "element_index": idx,
                            "element_token": f"{snapshot_id}:{idx}",
                            "delivery_mode": "background",
                        },
                    })

    bounded_elements = prioritized_elements[:max_elements_cap]
    all_elements = prioritized_elements + scoped_explicit_elements
    total_actionable_elements = (
        window_total_actionable
        if (skeleton and eff_region is None and root_element_index is None)
        else len(prioritized_elements)
    )
    matched_elements_count = len(prioritized_elements)
    omitted_elements_count = max(0, total_actionable_elements - len(bounded_elements))
    omitted_candidates_count = max(0, total_click_candidates - len(auto_candidates))
    elements_complete = bool(sc.get("elements_complete", True))
    driver_truncated = bool(sc.get("truncated", False))
    walk_truncated = bool(
        driver_truncated
        or omitted_elements_count > 0
        or omitted_candidates_count > 0
        or (not elements_complete and sc.get("truncated") is not False)
    )
    observation_truncated = walk_truncated
    search_complete = bool(not walk_truncated)
    query_incomplete = bool(eff_query is not None and walk_truncated)
    if eff_query is not None:
        if matched_elements_count > 0:
            query_status = "matched_partial_scope" if walk_truncated else "matched"
        else:
            query_status = (
                "no_matches_in_truncated_scope"
                if walk_truncated
                else "no_matches_in_complete_scope"
            )
    else:
        query_status = "unfiltered_truncated" if observation_truncated else "unfiltered_complete"
    visual_fallback_recommended = bool(
        window_total_actionable == 0
        and matched_elements_count == 0
        and not driver_truncated
        and not walk_truncated
        and eff_query is None
        and not skeleton
        and eff_region is None
        and root_element_index is None
    )

    win_w, win_h = _observation_window_size(sc)
    if (win_w is None or win_h is None) and isinstance(baseline_observation, Mapping):
        win_w, win_h = _observation_window_size(baseline_observation)
    window_bounds: dict[str, Any] | None = None
    if win_w is not None and win_h is not None:
        window_bounds = {"width": win_w, "height": win_h}
        raw_b = sc.get("window_bounds") if isinstance(sc.get("window_bounds"), Mapping) else sc.get("bounds")
        if isinstance(raw_b, Mapping):
            for coord_k in ("x", "y"):
                if isinstance(raw_b.get(coord_k), (int, float)) and not isinstance(raw_b.get(coord_k), bool):
                    window_bounds[coord_k] = raw_b[coord_k]
            raw_bw = raw_b.get("width", raw_b.get("w"))
            raw_bh = raw_b.get("height", raw_b.get("h"))
            if isinstance(raw_bw, (int, float)) and not isinstance(raw_bw, bool) and raw_bw > 0:
                window_bounds["logical_width"] = float(raw_bw)
            if isinstance(raw_bh, (int, float)) and not isinstance(raw_bh, bool) and raw_bh > 0:
                window_bounds["logical_height"] = float(raw_bh)

    obs_dict: dict[str, Any] = {
        "pid": expected_pid,
        "window_id": expected_window_id,
        "snapshot_id": snapshot_id,
        "app_name": obs_context["app_name"],
        "window_title": obs_context["window_title"],
        "window_bounds": window_bounds,
        "query": eff_query,
        "matched_elements_count": matched_elements_count,
        "query_status": query_status,
        "query_incomplete": query_incomplete,
        "search_complete": search_complete,
        "visual_fallback_recommended": visual_fallback_recommended,
        "elements_complete": elements_complete,
        "truncated": driver_truncated,
        "total_actionable_elements": total_actionable_elements,
        "omitted_elements_count": omitted_elements_count,
        "omitted_candidates_count": omitted_candidates_count,
        "elements_omitted": omitted_elements_count,
        "candidates_omitted": omitted_candidates_count,
        "observation_truncated": observation_truncated,
        "reconstructed_from_diff": bool(is_diff_payload),
        "skeleton": bool(skeleton),
        "region": reported_region,
        "root_element_index": reported_root_element_index,
        "native_root_element_token": native_root_token,
        "native_regions": native_regions,
        "active_surfaces": active_surfaces,
        "drill_regions": drill_regions,
        "static_texts": static_texts,
        "indexed_element_ids": {e["element_index"] for e in all_elements},
        "secure_element_ids": window_secure_control_ids | extra_secure_ids | set(md_struct["secure_ids"]),
        "elements": bounded_elements,
        "all_elements": all_elements,
        "auto_candidates": auto_candidates,
        "_container_paths": {
            idx: " > ".join(segs)[:240]
            for idx, segs in container_segments_by_el.items()
            if segs
        },
        "_has_unindexed_secure_node": bool(md_struct["has_unindexed_secure_node"]),
        "_raw_elements": [dict(e) for e in raw_elements if isinstance(e, Mapping)],
        "_tree_markdown": tree_md,
    }
    if win_w is not None and win_h is not None:
        obs_dict["width"] = win_w
        obs_dict["height"] = win_h
    return obs_dict


def build_bound_candidates(
    raw_candidates: list[Mapping[str, Any]] | None,
    observation: Mapping[str, Any],
    *,
    action_value: str | None = None,
    source_snapshot_id: str | None = None,
    max_auto_candidates: int = MAX_AUTO_CANDIDATES,
    enrich_descriptions: bool = False,
) -> list[dict[str, Any]]:
    """Build or validate caller-supplied executable candidates bound to (pid, window_id, snapshot_id)."""
    pid = observation["pid"]
    window_id = observation["window_id"]
    snapshot_id = observation["snapshot_id"]
    valid_indices: set[int] = observation["indexed_element_ids"]
    secure_indices: set[int] = set(observation.get("secure_element_ids") or set())
    source_elements = (
        observation.get("all_elements")
        if "all_elements" in observation
        else (observation.get("elements") or [])
    )
    el_by_idx: dict[int, Mapping[str, Any]] = {
        e["element_index"]: e
        for e in source_elements
        if isinstance(e, Mapping) and isinstance(e.get("element_index"), int)
    }

    if not raw_candidates:
        drill_cands: list[dict[str, Any]] = []
        if (
            enrich_descriptions
            and observation.get("query") is None
            and observation.get("region") is None
            and observation.get("root_element_index") is None
            and (
                observation.get("skeleton")
                or observation.get("observation_truncated")
                or observation.get("truncated")
            )
            and observation.get("drill_regions")
        ):
            used_dcids: set[str] = set()
            for r_pos, d_reg in enumerate(observation.get("drill_regions") or []):
                if not isinstance(d_reg, Mapping):
                    continue
                reg_lbl = str(d_reg.get("region") or "Region").strip() or "Region"
                base_dcid = str(d_reg.get("candidate_id") or f"drill.{r_pos}.{_slug(reg_lbl)}")
                dcid = base_dcid
                sfx = 2
                while dcid in used_dcids:
                    dcid = f"{base_dcid}-{sfx}"
                    sfx += 1
                used_dcids.add(dcid)
                samples = ", ".join(str(s) for s in (d_reg.get("sample_labels") or [])[:4])
                subregs = ", ".join(str(s) for s in (d_reg.get("subregions") or [])[:4])
                unwalked_tag = (
                    " (unwalked truncated region)"
                    if d_reg.get("unwalked_region")
                    else f" ({d_reg.get('actionable_count', 0)} controls)"
                )
                detail_parts: list[str] = []
                if d_reg.get("ambiguous_region"):
                    if isinstance(d_reg.get("element_index"), int) and not isinstance(d_reg.get("element_index"), bool):
                        detail_parts.append(f"pane #{r_pos + 1}, root_element_index={d_reg['element_index']}")
                    elif isinstance(d_reg.get("region_token"), str) and d_reg["region_token"]:
                        detail_parts.append(f"pane #{r_pos + 1}, token={d_reg['region_token']}")
                    else:
                        detail_parts.append(f"pane #{r_pos + 1}")
                if subregs:
                    detail_parts.append(f"subregions: {subregs}")
                if samples:
                    detail_parts.append(f"samples: {samples}")
                detail_str = f" [{'; '.join(detail_parts)}]" if detail_parts else ""
                d_args: dict[str, Any] = {
                    "pid": pid,
                    "window_id": window_id,
                    "snapshot_id": snapshot_id,
                }
                if not d_reg.get("ambiguous_region"):
                    d_args["region"] = reg_lbl
                if isinstance(d_reg.get("element_index"), int) and not isinstance(d_reg.get("element_index"), bool):
                    d_args["root_element_index"] = d_reg["element_index"]
                if isinstance(d_reg.get("region_token"), str) and ":" in d_reg["region_token"]:
                    d_args["region_token"] = d_reg["region_token"]
                drill_cands.append(
                    {
                        "id": dcid,
                        "description": (
                            f"Drill into region {json.dumps(reg_lbl, ensure_ascii=False)}"
                            f"{unwalked_tag}{detail_str} to inspect and act on its controls"
                        )[:1000],
                        "pid": pid,
                        "window_id": window_id,
                        "snapshot_id": snapshot_id,
                        "tool": "drill_region",
                        "arguments": d_args,
                    }
                )
            drill_cands = drill_cands[: min(16, max_auto_candidates)]

        if action_value is not None:
            if not isinstance(action_value, str):
                raise ValueError("value must be a string when auto-building set_value candidates")
            is_bool_action_val = action_value.strip().lower() in {"0", "1", "true", "false", "on", "off", "yes", "no"}
            sv_candidates: list[dict[str, Any]] = []
            used_sv_ids: set[str] = set()
            sv_cap = max(0, max_auto_candidates - len(drill_cands))
            for el in (observation.get("elements") or []):
                if not isinstance(el, Mapping):
                    continue
                idx = el.get("element_index")
                role = str(el.get("role") or "")
                state = str(el.get("state") or "")
                label = str(el.get("label") or role)
                if (
                    not isinstance(idx, int)
                    or idx in secure_indices
                    or "secure" in state
                    or role not in VALUE_SETTABLE_AX_ROLES
                    or (role == "AXCheckBox" and not is_bool_action_val)
                ):
                    continue
                if len(sv_candidates) >= sv_cap:
                    break
                base_id = f"sv.{idx}.{_slug(label)}"
                cid = base_id
                suffix = 2
                while cid in used_sv_ids:
                    cid = f"{base_id}-{suffix}"
                    suffix += 1
                used_sv_ids.add(cid)
                sv_desc = f"Set [{idx}] {role} {json.dumps(label, ensure_ascii=False)}"
                if enrich_descriptions and isinstance(el.get("container_path"), str) and el.get("container_path"):
                    sv_desc += f" in {str(el['container_path'])[:160]}"
                sv_desc += " to value"
                sv_candidates.append({
                    "id": cid,
                    "description": sv_desc,
                    "pid": pid,
                    "window_id": window_id,
                    "snapshot_id": snapshot_id,
                    "tool": "set_value",
                    "arguments": {
                        "pid": pid,
                        "window_id": window_id,
                        "snapshot_id": snapshot_id,
                        "element_index": idx,
                        "element_token": f"{snapshot_id}:{idx}",
                        "value": action_value,
                    },
                })
            combined_sv = sv_candidates + drill_cands
            if not combined_sv:
                if (
                    observation.get("query_incomplete")
                    or observation.get("observation_truncated")
                    or observation.get("truncated")
                    or (not observation.get("elements_complete", True) and observation.get("truncated") is not False)
                ):
                    raise ValueError(
                        "no_matching_candidates_in_truncated_scope: search scope was truncated or incomplete; "
                        "request a targeted query or deeper observation"
                    )
                raise ValueError("no value-settable AX elements found in window to build set_value candidates")
            return combined_sv

        auto = [
            c
            for c in observation["auto_candidates"]
            if _check_commit_safety_gate(
                observation,
                str(c.get("description") or ""),
                str(c.get("tool") or "click"),
                c.get("arguments") or {},
            )
            is None
        ]
        if drill_cands:
            auto = auto[: max(0, max_auto_candidates - len(drill_cands))] + drill_cands
        if not auto:
            if (
                observation.get("query_incomplete")
                or observation.get("observation_truncated")
                or observation.get("truncated")
                or (not observation.get("elements_complete", True) and observation.get("truncated") is not False)
            ):
                raise ValueError(
                    "no_matching_candidates_in_truncated_scope: search scope was truncated or incomplete; "
                    "request a targeted query or deeper observation"
                )
            raise ValueError(
                "no actionable AX elements found in window to build candidates (visual_fallback_recommended=true)"
            )
        return auto

    if not isinstance(raw_candidates, list) or len(raw_candidates) < 1 or len(raw_candidates) > max_auto_candidates:
        raise ValueError(f"candidates must be a list of 1 to {max_auto_candidates} items")

    _reject_binary_or_image_payload(json.dumps(raw_candidates, ensure_ascii=False), raw_candidates)
    win_w, win_h = _observation_window_size(observation)

    bound: list[dict[str, Any]] = []
    seen: set[str] = set()
    for item in raw_candidates:
        if not isinstance(item, Mapping):
            raise ValueError("each candidate must be an object")
        cid = item.get("id")
        desc = item.get("description")
        if not isinstance(cid, str) or not CANDIDATE_ID_RE.match(cid) or cid in RESERVED_CANDIDATES:
            raise ValueError(f"invalid or reserved executable candidate id: {cid!r}")
        if cid in seen:
            raise ValueError(f"duplicate candidate id: {cid!r}")
        seen.add(cid)
        if not isinstance(desc, str) or not desc.strip() or len(desc) > 1000:
            raise ValueError(f"candidate {cid!r} must have a non-empty description <= 1000 chars")

        sub_args = item.get("arguments") if isinstance(item.get("arguments"), Mapping) else item
        is_coord_only = (
            "element_index" not in item
            and "element_token" not in item
            and "element_index" not in sub_args
            and "element_token" not in sub_args
            and ("x" in sub_args or "y" in sub_args)
        )
        allowed_snaps = {snapshot_id}
        if is_coord_only and source_snapshot_id is not None:
            allowed_snaps.add(source_snapshot_id)

        cand_snap = item.get("snapshot_id", snapshot_id)
        if cand_snap not in allowed_snaps:
            raise ValueError(
                f"stale_snapshot_id: candidate {cid!r} bound to {cand_snap!r}, "
                f"current observation is {snapshot_id!r}"
            )
        cand_pid = item.get("pid", pid)
        cand_wid = item.get("window_id", window_id)
        if cand_pid != pid or cand_wid != window_id:
            raise ValueError(
                f"out_of_scope_target: candidate {cid!r} targets (pid={cand_pid}, window_id={cand_wid}), "
                f"expected (pid={pid}, window_id={window_id})"
            )

        tool = item.get("tool", "click")
        if tool == "drag":
            raise ValueError(
                "background_drag_unavailable_on_macos: cua-driver on macOS requires foreground delivery for drag, "
                "which violates background-only execution"
            )
        if not isinstance(tool, str) or tool in FORBIDDEN_TOOLS or tool not in ALLOWED_BACKGROUND_TOOLS:
            raise ValueError(f"forbidden_or_unsupported_tool: {tool!r}")

        raw_args = item.get("arguments")
        if raw_args is None:
            # Shorthand candidate: {id, description, element_index, tool?, text?, key?, keys?, value?, path?, direction?, ...}
            raw_args = {}
            for k in (
                "element_index",
                "element_token",
                "text",
                "key",
                "keys",
                "modifiers",
                "modifier",
                "value",
                "path",
                "action",
                "button",
                "direction",
                "amount",
                "by",
                "x",
                "y",
                "from_x",
                "from_y",
                "to_x",
                "to_y",
                "duration_ms",
                "steps",
            ):
                if k in item:
                    raw_args[k] = item[k]
        if not isinstance(raw_args, Mapping):
            raise ValueError(f"candidate {cid!r} arguments must be an object")

        args_dict = dict(raw_args)
        if "pid" in args_dict and args_dict["pid"] != pid:
            raise ValueError(f"out_of_scope_target: candidate {cid!r} arguments.pid={args_dict['pid']} != {pid}")
        if "window_id" in args_dict and args_dict["window_id"] != window_id:
            raise ValueError(
                f"out_of_scope_target: candidate {cid!r} arguments.window_id={args_dict['window_id']} != {window_id}"
            )
        if "snapshot_id" in args_dict and args_dict["snapshot_id"] not in allowed_snaps:
            raise ValueError(
                f"stale_snapshot_id: candidate {cid!r} arguments.snapshot_id={args_dict['snapshot_id']!r} != {snapshot_id!r}"
            )
        if args_dict.get("delivery_mode", "background") != "background" or args_dict.get("scope", "window") != "window":
            raise ValueError(f"foreground_or_global_input_forbidden: candidate {cid!r} requested non-background delivery")

        args_dict["pid"] = pid
        args_dict["window_id"] = window_id
        if tool in {"click", "double_click", "right_click", "check", "uncheck", "type_text", "press_key", "hotkey", "scroll"}:
            args_dict.setdefault("delivery_mode", "background")

        if tool == "invoke_menu":
            menu_path = args_dict.get("path")
            if (
                not isinstance(menu_path, list)
                or len(menu_path) < 1
                or len(menu_path) > INVOKE_MENU_MAX_PATH
                or not all(isinstance(p, str) and p.strip() for p in menu_path)
            ):
                raise ValueError(
                    f"missing_or_invalid_menu_path: candidate {cid!r} for invoke_menu requires a non-empty path list of strings"
                )
            # cua-driver invoke_menu accepts only {pid, window_id, path, session} (additionalProperties=false)
            # and is always window-scoped AX menu resolution; drop the validated background defaults and
            # refuse element / coordinate targets that the driver would reject.
            args_dict.pop("delivery_mode", None)
            args_dict.pop("scope", None)
            extra = sorted(set(args_dict) - INVOKE_MENU_ARG_KEYS)
            if extra:
                raise ValueError(
                    f"unsupported_menu_arguments: candidate {cid!r} for invoke_menu cannot pass {extra!r}"
                )
            args_dict["path"] = [p.strip() for p in menu_path]

        if "element_token" in args_dict:
            tok = args_dict["element_token"]
            if not isinstance(tok, str) or ":" not in tok:
                raise ValueError(f"invalid_element_token: candidate {cid!r} has malformed element_token={tok!r}")
            tok_snap, tok_idx_str = tok.split(":", 1)
            if tok_snap != snapshot_id:
                raise ValueError(f"stale_snapshot_id: candidate {cid!r} element_token bound to {tok_snap!r} != {snapshot_id!r}")
            if not tok_idx_str.isdigit():
                raise ValueError(f"invalid_element_token: candidate {cid!r} has non-integer index in {tok!r}")
            tok_idx = int(tok_idx_str)
            if "element_index" in args_dict and args_dict["element_index"] != tok_idx:
                raise ValueError(
                    f"invalid_element_token: candidate {cid!r} element_token={tok!r} conflicts with element_index={args_dict['element_index']!r}"
                )
            args_dict["element_index"] = tok_idx

        if "element_index" in args_dict:
            el_idx = args_dict["element_index"]
            if not isinstance(el_idx, int) or isinstance(el_idx, bool) or el_idx not in valid_indices:
                raise ValueError(f"unknown_element_index: candidate {cid!r} references element_index={el_idx!r} not in snapshot {snapshot_id}")
            target_el = el_by_idx.get(el_idx)
            if el_idx in secure_indices or (target_el is not None and "secure" in str(target_el.get("state") or "")):
                raise ValueError(f"secure_element_refused: candidate {cid!r} cannot target secure element_index={el_idx}")
            if target_el is not None:
                target_role = str(target_el.get("role") or "").strip()
                if tool == "set_value" and target_role and target_role not in VALUE_SETTABLE_AX_ROLES:
                    raise ValueError(
                        f"incompatible_tool_for_role: candidate {cid!r} cannot use set_value on role {target_role!r}"
                    )
                if (
                    tool == "type_text"
                    and target_role
                    and target_role not in (TEXT_INPUT_AX_ROLES | {"AXWebArea"})
                ):
                    raise ValueError(
                        f"incompatible_tool_for_role: candidate {cid!r} cannot use type_text on role {target_role!r}"
                    )
                if tool == "click" and target_el.get("can_click") is False:
                    raise ValueError(
                        f"unsupported_element_action: candidate {cid!r} cannot click role {target_role!r} without AXPress support"
                    )
                if tool in {"check", "uncheck"}:
                    if target_role != "AXCheckBox":
                        raise ValueError(
                            f"incompatible_tool_for_role: candidate {cid!r} cannot use {tool} on role {target_role!r}"
                        )
                    if target_el.get("can_click") is False:
                        raise ValueError(
                            f"unsupported_element_action: candidate {cid!r} cannot {tool} AXCheckBox without AXPress support"
                        )
                    if _parse_checkbox_bool_state(target_el.get("value")) is None:
                        raise ValueError(
                            f"indeterminate_checkbox_state: candidate {cid!r} cannot {tool} AXCheckBox without unambiguous boolean value"
                        )
                el_gate = _check_commit_safety_gate(observation, str(target_el.get("label") or ""), tool, args_dict)
                if el_gate is not None:
                    raise ValueError(f"{el_gate} (candidate={cid!r})")
            args_dict["snapshot_id"] = snapshot_id
            args_dict["element_token"] = f"{snapshot_id}:{el_idx}"
        elif tool in {"set_value", "check", "uncheck"}:
            raise ValueError(f"missing_target_address: candidate {cid!r} for {tool} requires element_index")
        elif tool in {"click", "double_click", "right_click"}:
            if "x" not in args_dict or "y" not in args_dict:
                raise ValueError(f"missing_target_address: candidate {cid!r} for {tool} requires element_index (or x, y)")
            x_val = args_dict.get("x")
            y_val = args_dict.get("y")
            if (
                not isinstance(x_val, (int, float))
                or isinstance(x_val, bool)
                or not math.isfinite(float(x_val))
                or not isinstance(y_val, (int, float))
                or isinstance(y_val, bool)
                or not math.isfinite(float(y_val))
            ):
                raise ValueError(f"out_of_bounds_coordinates: candidate {cid!r} requires finite numeric x, y")
            if float(x_val) < 0 or float(y_val) < 0:
                raise ValueError(
                    f"out_of_bounds_coordinates: candidate {cid!r} has negative coordinates ({x_val}, {y_val})"
                )
            if win_w is not None and win_h is not None and (float(x_val) >= win_w or float(y_val) >= win_h):
                raise ValueError(
                    f"out_of_bounds_coordinates: candidate {cid!r} coordinates ({x_val}, {y_val}) "
                    f"exceed window bounds ({win_w}x{win_h})"
                )
            args_dict["snapshot_id"] = snapshot_id

        if tool == "scroll" and "direction" not in args_dict:
            raise ValueError(f"missing_scroll_direction: candidate {cid!r} for scroll requires direction")

        desc_gate = _check_commit_safety_gate(observation, desc, tool, args_dict)
        if desc_gate is not None:
            raise ValueError(f"{desc_gate} (candidate={cid!r})")

        bound_entry: dict[str, Any] = {
            "id": cid,
            "description": desc.strip(),
            "pid": pid,
            "window_id": window_id,
            "snapshot_id": snapshot_id,
            "tool": tool,
            "arguments": args_dict,
        }
        if is_coord_only and source_snapshot_id is not None:
            bound_entry["source_snapshot_id"] = source_snapshot_id
        bound.append(bound_entry)
    return bound


def authorize_candidate_dispatch(
    decision: Mapping[str, Any],
    bound_candidates: list[Mapping[str, Any]],
    *,
    expected_pid: int,
    expected_window_id: int,
    current_snapshot_id: str,
    valid_element_indices: set[int],
    observation: Mapping[str, Any] | None = None,
) -> dict[str, Any]:
    """Validate scope, freshness, background delivery, and selected candidate before Driver dispatch."""
    if decision.get("kind") != "selected":
        raise ValueError(f"non_actionable_decision: decision kind is {decision.get('kind')!r}")
    if decision.get("snapshot_id") != current_snapshot_id:
        raise ValueError(
            f"stale_snapshot_id: decision snapshot {decision.get('snapshot_id')!r} != current {current_snapshot_id!r}"
        )
    if decision.get("pid") != expected_pid or decision.get("window_id") != expected_window_id:
        raise ValueError("out_of_scope_target: decision target does not match expected (pid, window_id)")

    selected_id = decision.get("selected_id")
    if not isinstance(selected_id, str) or selected_id in RESERVED_CANDIDATES:
        raise ValueError(f"non_actionable_selection: {selected_id!r}")

    matches = [c for c in bound_candidates if c.get("id") == selected_id]
    if len(matches) != 1:
        raise ValueError(f"invented_selection: selected_id {selected_id!r} not in offered candidate table")

    candidate = matches[0]
    if candidate.get("snapshot_id") != current_snapshot_id:
        raise ValueError("stale_snapshot_id: candidate snapshot does not match current observation")
    if candidate.get("pid") != expected_pid or candidate.get("window_id") != expected_window_id:
        raise ValueError("out_of_scope_target: candidate target does not match expected (pid, window_id)")

    tool = str(candidate.get("tool") or "")
    if tool == "drag":
        raise ValueError(
            "background_drag_unavailable_on_macos: cua-driver on macOS requires foreground delivery for drag, "
            "which violates background-only execution"
        )
    if tool in FORBIDDEN_TOOLS or tool not in ALLOWED_BACKGROUND_TOOLS:
        raise ValueError(f"forbidden_or_unsupported_tool: {tool!r}")

    args = dict(candidate.get("arguments") or {})
    if args.get("pid") != expected_pid or args.get("window_id") != expected_window_id:
        raise ValueError("out_of_scope_target: candidate arguments mismatch expected (pid, window_id)")
    if args.get("delivery_mode", "background") != "background" or args.get("scope", "window") != "window":
        raise ValueError("foreground_or_global_input_forbidden: candidate requires foreground or desktop scope")
    if tool == "invoke_menu":
        menu_path = args.get("path")
        if (
            not isinstance(menu_path, list)
            or len(menu_path) < 1
            or len(menu_path) > INVOKE_MENU_MAX_PATH
            or not all(isinstance(p, str) and p.strip() for p in menu_path)
        ):
            raise ValueError(
                f"missing_or_invalid_menu_path: candidate {selected_id!r} for invoke_menu requires a non-empty path list of strings"
            )
        extra = sorted(set(args) - INVOKE_MENU_ARG_KEYS)
        if extra:
            raise ValueError(
                f"unsupported_menu_arguments: candidate {selected_id!r} for invoke_menu cannot pass {extra!r}"
            )
    if "element_index" in args:
        if args.get("snapshot_id") != current_snapshot_id:
            raise ValueError("stale_snapshot_id: element action missing current snapshot_id")
        if args["element_index"] not in valid_element_indices:
            raise ValueError(f"unknown_element_index: {args['element_index']!r}")
        if observation is not None and args["element_index"] in (observation.get("secure_element_ids") or set()):
            raise ValueError(
                f"secure_element_refused: candidate {selected_id!r} cannot target secure element_index={args['element_index']}"
            )
        if tool in {"check", "uncheck"} and observation is not None:
            obs_els_chk = observation.get("all_elements") or observation.get("elements") or []
            matched_chk_el = next(
                (
                    oe
                    for oe in obs_els_chk
                    if isinstance(oe, Mapping) and oe.get("element_index") == args["element_index"]
                ),
                None,
            )
            if matched_chk_el is not None:
                chk_role = str(matched_chk_el.get("role") or "").strip()
                if chk_role != "AXCheckBox":
                    raise ValueError(
                        f"incompatible_tool_for_role: candidate {selected_id!r} cannot use {tool} on role {chk_role!r}"
                    )
                if matched_chk_el.get("can_click") is False:
                    raise ValueError(
                        f"unsupported_element_action: candidate {selected_id!r} cannot {tool} AXCheckBox without AXPress support"
                    )
                chk_raw_val = (
                    matched_chk_el.get("value")
                    if matched_chk_el.get("value") is not None
                    else matched_chk_el.get("value_state")
                )
                if _parse_checkbox_bool_state(chk_raw_val) is None:
                    raise ValueError(
                        f"indeterminate_checkbox_state: candidate {selected_id!r} cannot {tool} AXCheckBox without unambiguous boolean value"
                    )
    elif tool in {"set_value", "check", "uncheck"}:
        raise ValueError(f"missing_target_address: candidate {selected_id!r} for {tool} requires element_index")
    elif tool in {"click", "double_click", "right_click"} and ("x" in args or "y" in args):
        x_val = args.get("x")
        y_val = args.get("y")
        if (
            not isinstance(x_val, (int, float))
            or isinstance(x_val, bool)
            or not math.isfinite(float(x_val))
            or not isinstance(y_val, (int, float))
            or isinstance(y_val, bool)
            or not math.isfinite(float(y_val))
            or float(x_val) < 0
            or float(y_val) < 0
        ):
            raise ValueError(f"out_of_bounds_coordinates: candidate {selected_id!r} has invalid coordinates")
        win_w, win_h = _observation_window_size(observation)
        if win_w is not None and win_h is not None and (float(x_val) >= win_w or float(y_val) >= win_h):
            raise ValueError(
                f"out_of_bounds_coordinates: candidate {selected_id!r} coordinates ({x_val}, {y_val}) "
                f"exceed window bounds ({win_w}x{win_h})"
            )

    gate_labels = [str(candidate.get("description") or "")]
    if "element_index" in args and observation is not None:
        obs_els = observation.get("all_elements") or observation.get("elements") or []
        for obs_el in obs_els:
            if isinstance(obs_el, Mapping) and obs_el.get("element_index") == args["element_index"]:
                for lbl_k in ("label", "raw_label"):
                    el_lbl = str(obs_el.get(lbl_k) or "").strip()
                    if el_lbl and el_lbl not in gate_labels:
                        gate_labels.append(el_lbl)
                break
    for gate_lbl in gate_labels:
        action_gate = _check_commit_safety_gate(
            observation,
            gate_lbl,
            tool,
            args,
        )
        if action_gate is not None:
            raise ValueError(f"{action_gate} (candidate={selected_id!r})")

    return {"id": selected_id, "tool": tool, "arguments": args, "description": candidate.get("description")}


_NUMERIC_GROUPED_RE = re.compile(r"^[+-]?(?:\d+|\d{1,3}(?:,\d{3})+)(?:\.\d+)?$")


def _normalize_numeric_grouped(text: str) -> str | None:
    stripped = text.strip()
    if not _NUMERIC_GROUPED_RE.match(stripped):
        return None
    return stripped.replace(",", "")


def _normalize_math_ops(text: str) -> str:
    return text.replace("\u00d7", "*").replace("\u00f7", "/").replace("\u2212", "-")


def _static_text_exact_match(expected_val: str, candidate_text: str) -> bool:
    if candidate_text == expected_val:
        return True
    if _normalize_math_ops(candidate_text) == _normalize_math_ops(expected_val):
        return True
    norm_exp = _normalize_numeric_grouped(expected_val)
    norm_cand = _normalize_numeric_grouped(candidate_text)
    if norm_exp is not None and norm_cand is not None:
        return norm_exp == norm_cand
    return False


def _select_static_texts(
    post_texts: list[str],
    expected: Mapping[str, Any],
) -> tuple[list[str] | None, str | None]:
    if "static_text_index" not in expected:
        return post_texts, None
    idx = expected["static_text_index"]
    if not isinstance(idx, int) or isinstance(idx, bool):
        return None, "invalid_static_text_index"
    try:
        return [post_texts[idx]], None
    except IndexError:
        return None, f"static_text_index_out_of_range={idx!r} (len={len(post_texts)})"


def check_postcondition(
    expected: Mapping[str, Any] | None,
    pre_obs: Mapping[str, Any],
    post_obs: Mapping[str, Any],
    *,
    target_element_index: int | None = None,
) -> tuple[bool, bool, str]:
    """Return (state_changed, postcondition_met, verification_reason) from fresh post-dispatch observation."""
    pre_texts = list(pre_obs.get("static_texts") or [])
    post_texts = list(post_obs.get("static_texts") or [])
    pre_source_els = (
        pre_obs.get("all_elements") if "all_elements" in pre_obs else (pre_obs.get("elements") or [])
    )
    post_source_els = (
        post_obs.get("all_elements") if "all_elements" in post_obs else (post_obs.get("elements") or [])
    )
    pre_els = sorted(
        (
            (e.get("element_index"), e.get("role"), e.get("label"), e.get("value"), e.get("state"))
            for e in pre_source_els
            if isinstance(e, Mapping)
        ),
        key=lambda item: (item[0] if isinstance(item[0], int) else -1),
    )
    post_els = sorted(
        (
            (e.get("element_index"), e.get("role"), e.get("label"), e.get("value"), e.get("state"))
            for e in post_source_els
            if isinstance(e, Mapping)
        ),
        key=lambda item: (item[0] if isinstance(item[0], int) else -1),
    )
    state_changed = (pre_texts != post_texts) or (pre_els != post_els)

    if post_obs.get("snapshot_id") == pre_obs.get("snapshot_id"):
        return state_changed, False, "post_snapshot_id_unchanged"

    if expected is None:
        return state_changed, False, ("observable_state_changed" if state_changed else "no_observable_state_change")

    if not isinstance(expected, Mapping) or not expected:
        return state_changed, False, "empty_expected_postcondition"

    allowed_keys = {
        "static_text_equals",
        "static_text_contains",
        "static_text_index",
        "element_index",
        "element_value_equals",
        "element_label_equals",
        "element_label_contains",
    }
    unknown_keys = sorted(set(expected.keys()) - allowed_keys)
    if unknown_keys:
        return state_changed, False, f"unsupported_postcondition_keys={unknown_keys!r}"

    predicate_keys = {
        "static_text_equals",
        "static_text_contains",
        "element_value_equals",
        "element_label_equals",
        "element_label_contains",
    }
    if not (set(expected.keys()) & predicate_keys):
        return state_changed, False, "empty_expected_postcondition"

    if "static_text_index" in expected and "static_text_equals" not in expected and "static_text_contains" not in expected:
        return state_changed, False, "static_text_index_without_static_text_predicate"

    if "static_text_equals" in expected:
        raw_exact = expected["static_text_equals"]
        if not isinstance(raw_exact, str) or not raw_exact:
            return state_changed, False, "invalid_empty_static_text_equals"
        scoped_texts, idx_err = _select_static_texts(post_texts, expected)
        if idx_err is not None or scoped_texts is None:
            return state_changed, False, idx_err or "invalid_static_text_index"
        if not any(_static_text_exact_match(raw_exact, t) for t in scoped_texts):
            return state_changed, False, f"expected static_text_equals={raw_exact!r}, got {scoped_texts!r}"

    if "static_text_contains" in expected:
        raw_needle = expected["static_text_contains"]
        if not isinstance(raw_needle, str) or not raw_needle:
            return state_changed, False, "invalid_empty_static_text_contains"
        scoped_texts, idx_err = _select_static_texts(post_texts, expected)
        if idx_err is not None or scoped_texts is None:
            return state_changed, False, idx_err or "invalid_static_text_index"
        needle = raw_needle
        if not any(
            needle in t or (_normalize_numeric_grouped(t) is not None and needle in (_normalize_numeric_grouped(t) or ""))
            for t in scoped_texts
        ):
            return state_changed, False, f"expected static_text_contains={needle!r}, got {scoped_texts!r}"

    has_element_pred = any(
        k in expected for k in ("element_value_equals", "element_label_equals", "element_label_contains")
    )
    if "element_index" in expected and not has_element_pred:
        return state_changed, False, "element_index_without_element_predicate"

    if has_element_pred:
        bound_idx: Any = expected.get("element_index", target_element_index)
        if bound_idx is None:
            return (
                state_changed,
                False,
                "unbound_element_postcondition: element predicates require element_index or an element-addressed candidate",
            )
        if not isinstance(bound_idx, int) or isinstance(bound_idx, bool) or bound_idx < 0:
            return state_changed, False, f"invalid_element_index={bound_idx!r}"

        pre_by_idx = {
            e.get("element_index"): e
            for e in pre_source_els
            if isinstance(e, Mapping) and isinstance(e.get("element_index"), int)
        }
        post_by_idx = {
            e.get("element_index"): e
            for e in post_source_els
            if isinstance(e, Mapping) and isinstance(e.get("element_index"), int)
        }
        if bound_idx not in pre_by_idx:
            return state_changed, False, f"target_element_missing_in_pre_obs: element_index={bound_idx}"
        if bound_idx not in post_by_idx:
            return state_changed, False, f"target_element_missing: element_index={bound_idx} not in post_obs"

        pre_el = pre_by_idx[bound_idx]
        post_el = post_by_idx[bound_idx]
        pre_role = str(pre_el.get("role") or "").strip()
        post_role = str(post_el.get("role") or "").strip()
        if not pre_role or not post_role or pre_role != post_role:
            return (
                state_changed,
                False,
                f"target_element_role_mismatch: element_index={bound_idx} pre_role={pre_role!r} != post_role={post_role!r}",
            )

        if "element_value_equals" in expected:
            raw_val = expected["element_value_equals"]
            if not isinstance(raw_val, str):
                return state_changed, False, "invalid_element_value_equals"
            if "element_label_equals" not in expected and "element_label_contains" not in expected:
                pre_lbl = str(
                    (pre_el.get("raw_label") if "raw_label" in pre_el else pre_el.get("label")) or ""
                ).strip()
                post_lbl = str(
                    (post_el.get("raw_label") if "raw_label" in post_el else post_el.get("label")) or ""
                ).strip()
                if (pre_lbl or post_lbl) and pre_lbl != post_lbl:
                    return (
                        state_changed,
                        False,
                        f"target_element_label_mismatch: element_index={bound_idx} pre_label={pre_lbl!r} != post_label={post_lbl!r}",
                    )
            if "value" not in post_el or post_el["value"] is None:
                return (
                    state_changed,
                    False,
                    f"expected element_value_equals={raw_val!r} on element_index={bound_idx}, but element has no observable value",
                )
            actual_val = str(post_el["value"])
            if actual_val != raw_val:
                return (
                    state_changed,
                    False,
                    f"expected element_value_equals={raw_val!r} on element_index={bound_idx}, got {actual_val!r}",
                )

        actual_lbl = str(
            (post_el.get("raw_label") if "raw_label" in post_el else post_el.get("label")) or ""
        )

        if "element_label_equals" in expected:
            raw_lbl_eq = expected["element_label_equals"]
            if not isinstance(raw_lbl_eq, str) or not raw_lbl_eq:
                return state_changed, False, "invalid_empty_element_label_equals"
            if actual_lbl != raw_lbl_eq:
                return (
                    state_changed,
                    False,
                    f"expected element_label_equals={raw_lbl_eq!r} on element_index={bound_idx}, got {actual_lbl!r}",
                )

        if "element_label_contains" in expected:
            raw_lbl = expected["element_label_contains"]
            if not isinstance(raw_lbl, str) or not raw_lbl:
                return state_changed, False, "invalid_empty_element_label_contains"
            if raw_lbl not in actual_lbl:
                return (
                    state_changed,
                    False,
                    f"expected element_label_contains={raw_lbl!r} on element_index={bound_idx}, got {actual_lbl!r}",
                )

    return state_changed, True, "expected_postcondition_verified"


def _obs_state_signature(obs: Mapping[str, Any]) -> tuple[Any, ...]:
    static_texts = tuple(obs.get("static_texts") or [])
    source_els = obs.get("all_elements") if "all_elements" in obs else (obs.get("elements") or [])
    elements = tuple(
        sorted(
            (
                (e.get("element_index"), e.get("role"), e.get("label"), e.get("value"), e.get("state"))
                for e in source_els
                if isinstance(e, Mapping)
            ),
            key=lambda item: (item[0] if isinstance(item[0], int) else -1),
        )
    )
    return (static_texts, elements)


def _validate_batch_postcondition_spec(expected: Any, has_element_candidate: bool) -> str | None:
    if not isinstance(expected, Mapping) or not expected:
        return "missing_or_empty_expected_postcondition"
    allowed_keys = {
        "static_text_equals",
        "static_text_contains",
        "static_text_index",
        "element_index",
        "element_value_equals",
        "element_label_equals",
        "element_label_contains",
    }
    unknown = sorted(set(expected.keys()) - allowed_keys)
    if unknown:
        return f"unsupported_postcondition_keys={unknown!r}"
    predicate_keys = {
        "static_text_equals",
        "static_text_contains",
        "element_value_equals",
        "element_label_equals",
        "element_label_contains",
    }
    if not (set(expected.keys()) & predicate_keys):
        return "empty_expected_postcondition"
    if "static_text_index" in expected:
        idx = expected["static_text_index"]
        if not isinstance(idx, int) or isinstance(idx, bool):
            return "invalid_static_text_index"
        if "static_text_equals" not in expected and "static_text_contains" not in expected:
            return "static_text_index_without_static_text_predicate"
    if "static_text_equals" in expected:
        val = expected["static_text_equals"]
        if not isinstance(val, str) or not val:
            return "invalid_empty_static_text_equals"
    if "static_text_contains" in expected:
        val = expected["static_text_contains"]
        if not isinstance(val, str) or not val:
            return "invalid_empty_static_text_contains"
    has_el_pred = any(
        k in expected for k in ("element_value_equals", "element_label_equals", "element_label_contains")
    )
    if "element_index" in expected:
        el_idx = expected["element_index"]
        if not isinstance(el_idx, int) or isinstance(el_idx, bool) or el_idx < 0:
            return f"invalid_element_index={el_idx!r}"
        if not has_el_pred:
            return "element_index_without_element_predicate"
    if has_el_pred and "element_index" not in expected and not has_element_candidate:
        return "unbound_element_postcondition"
    if "element_value_equals" in expected and not isinstance(expected["element_value_equals"], str):
        return "invalid_element_value_equals"
    if "element_label_equals" in expected:
        lbl = expected["element_label_equals"]
        if not isinstance(lbl, str) or not lbl:
            return "invalid_empty_element_label_equals"
    if "element_label_contains" in expected:
        lbl = expected["element_label_contains"]
        if not isinstance(lbl, str) or not lbl:
            return "invalid_empty_element_label_contains"
    return None


SESSION_SCOPED_DRIVER_TOOLS = frozenset({
    "get_window_state",
    "click",
    "double_click",
    "right_click",
    "type_text",
    "press_key",
    "hotkey",
    "set_value",
    "scroll",
    "invoke_menu",
    "start_session",
    "set_agent_cursor_enabled",
    "end_session",
    "get_browser_state",
    "browser_prepare",
    "browser_navigate",
    "browser_click",
    "browser_type",
})


def _discover_same_pid_windows(
    driver: "DriverClient",
    pid: int,
    current_window_id: int,
    *,
    timeout_s: float | None = None,
    deadline_monotonic: float | None = None,
) -> list[dict[str, Any]]:
    """Query cua-driver list_windows for same-PID windows so modal sheets/dialogs can be discovered."""
    try:
        res = driver.call_tool(
            "list_windows",
            {"pid": pid},
            timeout_s=timeout_s,
            deadline_monotonic=deadline_monotonic,
        )
        if res.get("isError"):
            return []
        sc = res.get("structuredContent")
        raw_windows: Any = None
        if isinstance(sc, Mapping):
            raw_windows = sc.get("windows")
        if not isinstance(raw_windows, list):
            txt = "".join(c.get("text", "") for c in (res.get("content") or []) if isinstance(c, Mapping)).strip()
            if txt.startswith("{") or txt.startswith("["):
                try:
                    parsed = json.loads(txt)
                    if isinstance(parsed, Mapping):
                        raw_windows = parsed.get("windows")
                    elif isinstance(parsed, list):
                        raw_windows = parsed
                except ValueError:
                    pass
        if not isinstance(raw_windows, list):
            return []
        discovered: list[dict[str, Any]] = []
        for item in raw_windows:
            if not isinstance(item, Mapping):
                continue
            w_pid = item.get("pid", pid)
            if w_pid != pid:
                continue
            w_id = item.get("window_id", item.get("id"))
            if not isinstance(w_id, int) or isinstance(w_id, bool) or w_id <= 0:
                continue
            entry: dict[str, Any] = {
                "pid": pid,
                "window_id": w_id,
                "title": str(item.get("title") or item.get("name") or "").strip(),
                "role": str(item.get("role") or "AXWindow").strip(),
                "subrole": str(item.get("subrole") or "").strip(),
                "is_current_target": w_id == current_window_id,
            }
            if isinstance(item.get("bounds"), Mapping):
                entry["bounds"] = dict(item["bounds"])
            discovered.append(entry)
        return discovered
    except Exception:
        return []


def is_allowed_synthetic_browser_url(url: str) -> bool:
    if not isinstance(url, str) or not url.strip():
        return False
    raw = url.strip()
    if raw.lower() == "about:blank":
        return True
    try:
        parsed = urllib.parse.urlsplit(raw)
    except Exception:
        return False
    if parsed.username or parsed.password:
        return False
    scheme = (parsed.scheme or "").lower()
    if scheme in {"http", "https"}:
        host = (parsed.hostname or "").lower()
        if host in {"127.0.0.1", "localhost", "::1"}:
            return True
    return False


def validate_browser_prepare_args(args: Mapping[str, Any]) -> dict[str, Any]:
    if not isinstance(args, Mapping):
        raise ValueError("browser_prepare arguments must be an object")
    _reject_binary_or_image_payload(args, "browser_prepare")
    if str(args.get("delivery_mode") or "background").strip().lower() == "foreground":
        raise ValueError("foreground_or_global_input_forbidden: delivery_mode='foreground' is forbidden")
    strategy = args.get("strategy")
    if isinstance(strategy, Mapping):
        strat_kind = str(strategy.get("kind") or "").strip().lower()
        if strat_kind and strat_kind not in {"isolated", "isolated_new", "isolated_named"}:
            raise ValueError(
                f"browser_mode_refused (browser_mode_forbidden): strategy.kind={strat_kind!r} is forbidden; "
                "only isolated browser profiles are allowed"
            )
    elif isinstance(strategy, str) and strategy.strip().lower() not in {"isolated", "isolated_new", "isolated_named"}:
        raise ValueError(
            f"browser_mode_refused (browser_mode_forbidden): strategy={strategy!r} is forbidden; "
            "only isolated browser profiles are allowed"
        )

    mode = str(args.get("mode") or "isolated").strip()
    if mode not in {"isolated", "isolated_new", "isolated_named"}:
        raise ValueError(
            f"browser_mode_refused (browser_mode_forbidden): mode={mode!r} is forbidden; only mode='isolated' is allowed"
        )
    if "profile_dir" in args and args["profile_dir"] is not None:
        raise ValueError("browser_profile_override_forbidden: custom profile_dir is forbidden in scoped browser lane")

    raw_prof = args.get("profile")
    profile_dict: dict[str, Any] = {"mode": "isolated_new"}
    if isinstance(raw_prof, Mapping):
        extra_prof_keys = set(raw_prof.keys()) - {"mode", "name"}
        if extra_prof_keys:
            raise ValueError(f"browser_profile_override_forbidden: unsupported profile keys {sorted(extra_prof_keys)}")
        pmode = str(raw_prof.get("mode") or "isolated_new").strip()
        if pmode == "isolated":
            pmode = "isolated_new"
        if pmode not in {"isolated_new", "isolated_named"}:
            raise ValueError(
                f"browser_mode_refused (browser_mode_forbidden): profile.mode={pmode!r} is forbidden; "
                "only isolated_new or isolated_named is allowed"
            )
        if pmode == "isolated_named":
            pname = str(raw_prof.get("name") or args.get("profile_name") or "").strip()
            if not pname:
                raise ValueError("isolated_named profile requires a non-empty profile name")
            profile_dict = {"mode": "isolated_named", "name": pname}
        else:
            profile_dict = {"mode": "isolated_new"}
    elif args.get("profile_name") is not None or mode == "isolated_named":
        pname = str(args.get("profile_name") or "").strip()
        if not pname:
            raise ValueError("isolated_named profile requires a non-empty profile_name")
        profile_dict = {"mode": "isolated_named", "name": pname}

    out: dict[str, Any] = {
        "mode": "isolated",
        "allow_launch": True,
        "profile": profile_dict,
    }
    if "browser" in args and args["browser"] is not None:
        browser = str(args["browser"]).strip()
        if not browser:
            raise ValueError("invalid browser value")
        out["browser"] = browser
    if "url" in args and args["url"] is not None:
        url = str(args["url"]).strip()
        if not is_allowed_synthetic_browser_url(url):
            raise ValueError(
                f"external_browser_url_forbidden (browser_origin_forbidden): url={url!r} is not an allowed "
                "loopback/synthetic fixture URL (only http(s)://127.0.0.1, localhost, [::1], or about:blank allowed)"
            )
        out["url"] = url
    return out


def extract_browser_observation(
    driver_result: Mapping[str, Any],
    *,
    expected_target_id: str | None = None,
    expected_tab_id: str | None = None,
    max_elements_cap: int = MAX_ELEMENTS,
    max_auto_candidates: int = MAX_AUTO_CANDIDATES,
) -> dict[str, Any]:
    if not isinstance(driver_result, Mapping):
        raise ValueError("get_browser_state result must be a JSON object")
    sc = driver_result.get("structuredContent")
    if not isinstance(sc, Mapping):
        txt = "".join(
            c.get("text", "") for c in (driver_result.get("content") or []) if isinstance(c, Mapping)
        ).strip()
        if txt.startswith("{"):
            try:
                sc = json.loads(txt)
            except ValueError:
                sc = None
    if not isinstance(sc, Mapping):
        raise ValueError("get_browser_state result missing structuredContent")

    tabs = sc.get("tabs") if isinstance(sc.get("tabs"), list) else []
    first_tab_id = tabs[0].get("tab_id") if (tabs and isinstance(tabs[0], Mapping)) else None
    target_id = str(sc.get("target_id") or sc.get("browser_target_id") or expected_target_id or "isolated").strip()
    tab_id = str(sc.get("tab_id") or sc.get("active_tab_id") or first_tab_id or expected_tab_id or "tab-1").strip()
    if expected_target_id is not None and target_id != expected_target_id:
        raise ValueError(f"browser target_id mismatch: expected {expected_target_id!r}, got {target_id!r}")
    if expected_tab_id is not None and tab_id != expected_tab_id:
        raise ValueError(f"browser tab_id mismatch: expected {expected_tab_id!r}, got {tab_id!r}")

    snap_obj = sc.get("snapshot") if isinstance(sc.get("snapshot"), Mapping) else {}
    page_obj = sc.get("page") if isinstance(sc.get("page"), Mapping) else {}
    snap = sc.get("snapshot_id") or sc.get("page_snapshot_id") or snap_obj.get("id") or snap_obj.get("snapshot_id")
    if not isinstance(snap, str) or not BROWSER_SNAPSHOT_ID_RE.match(snap):
        raise ValueError(f"get_browser_state returned invalid snapshot_id: {snap!r}")

    url = str(sc.get("url") or page_obj.get("url") or "").strip()
    title = str(sc.get("title") or page_obj.get("title") or "").strip()
    if url and not is_allowed_synthetic_browser_url(url):
        raise ValueError(
            f"browser_origin_forbidden (external_browser_url_forbidden): tab url={url!r} is not an allowed loopback/synthetic origin"
        )

    raw_els = sc.get("elements") if isinstance(sc.get("elements"), list) else (
        sc.get("refs") if isinstance(sc.get("refs"), list) else []
    )
    has_named_refs = any(
        isinstance(it, Mapping)
        and bool(str(it.get("label") or it.get("text") or it.get("name") or "").strip())
        for it in raw_els
    )
    outline = sc.get("outline")
    outline_values: dict[tuple[str, str], str] = {}
    if isinstance(outline, str):
        for line in outline.splitlines():
            m_out = re.match(
                r'^\s*-\s*([a-zA-Z0-9_-]+)\s+"([^"]+)":\s*(.+?)(?:\s+\[[^\]]*\])?\s*$',
                line,
            )
            if m_out:
                o_role = m_out.group(1).strip().lower()
                o_label = m_out.group(2).replace("\u200e", "").strip()
                o_val = m_out.group(3).replace("\u200e", "").strip()
                if o_label and o_val:
                    outline_values[(o_role, o_label)] = o_val

    elements: list[dict[str, Any]] = []
    valid_refs: set[str] = set()
    secure_refs: set[str] = set()
    extra_static_texts: list[str] = []
    for idx, item in enumerate(raw_els):
        if not isinstance(item, Mapping):
            continue
        ref = str(item.get("ref") or item.get("id") or f"ref_{idx}").strip()
        if not BROWSER_REF_RE.match(ref):
            continue
        raw_name = item.get("label") if item.get("label") not in (None, "") else (
            item.get("text") if item.get("text") not in (None, "") else item.get("name")
        )
        label = str(raw_name or "").replace("\u200e", "").strip()
        role = str(item.get("role") or item.get("tag") or "element").strip()
        role_lower = role.lower()
        visibility = str(item.get("visibility") or "").strip().lower()
        if has_named_refs and not label and visibility == "unknown" and role_lower in {"generic", "element", "group", "div", "span"}:
            continue
        val = item.get("value")
        raw_val_str = "" if val is None else str(val).replace("\u200e", "").strip()
        if role_lower in {"statictext", "labeltext", "heading", "rootwebarea"}:
            if label and not _BULLET_MASK_RE.search(label):
                extra_static_texts.append(label)
            if raw_val_str and not _BULLET_MASK_RE.search(raw_val_str):
                extra_static_texts.append(raw_val_str)
            continue
        if not raw_val_str and label and (role_lower, label) in outline_values:
            raw_val_str = outline_values[(role_lower, label)]
            val = raw_val_str
        input_type = str(item.get("type") or item.get("input_type") or "").strip().lower()
        is_secure = (
            input_type == "password"
            or "password" in role_lower
            or "secure" in role_lower
            or bool(_BULLET_MASK_RE.search(raw_val_str))
            or bool(_BULLET_MASK_RE.search(label))
            or (role_lower in {"textbox", "input", "axtextfield", "axsecuretextfield"} and bool(_SECRET_FIELD_NAME_RE.search(label)))
        )
        if _BULLET_MASK_RE.search(label):
            label = ""
        enabled = bool(item.get("enabled", True))
        valid_refs.add(ref)
        if is_secure:
            secure_refs.add(ref)
        state_str = "enabled (secure)" if is_secure else ("enabled" if enabled else "disabled")
        raw_acts = item.get("actions") if isinstance(item.get("actions"), list) else []
        act_set = {str(a).strip().lower() for a in raw_acts if isinstance(a, str)}
        supp_actions: list[str] = []
        if not is_secure and enabled:
            if not act_set or ("pointer" in act_set or "click" in act_set or "press" in act_set):
                supp_actions.append("browser_click")
            if "type" in act_set or role_lower in {"input", "textbox", "searchbox", "textarea", "combobox", "axtextfield"}:
                supp_actions.append("browser_type")
        el_entry: dict[str, Any] = {
            "element_index": len(elements),
            "ref": ref,
            "role": role,
            "label": label or role,
            "state": state_str,
            "enabled": enabled,
            "supported_actions": supp_actions,
        }
        if not is_secure and isinstance(val, (str, int, float)) and not isinstance(val, bool) and not _BULLET_MASK_RE.search(raw_val_str):
            el_entry["value"] = raw_val_str
        elements.append(el_entry)

    static_texts: list[str] = []

    def _add_static_text(candidate_txt: Any) -> None:
        if not isinstance(candidate_txt, str):
            return
        cleaned = candidate_txt.replace("\u200e", "").strip()
        if not cleaned or _BULLET_MASK_RE.search(cleaned):
            return
        if cleaned not in static_texts:
            static_texts.append(cleaned)

    if title:
        _add_static_text(title)
    for t in extra_static_texts:
        _add_static_text(t)
    for t in (sc.get("static_texts") or sc.get("texts") or []):
        _add_static_text(t)
    for cref in (sc.get("content_refs") or []):
        if isinstance(cref, Mapping):
            _add_static_text(cref.get("name") or cref.get("text") or cref.get("label") or cref.get("value"))
        elif isinstance(cref, str):
            _add_static_text(cref)
    if isinstance(outline, list):
        for o_item in outline:
            if isinstance(o_item, Mapping):
                _add_static_text(o_item.get("name") or o_item.get("text") or o_item.get("title") or o_item.get("label"))
            elif isinstance(o_item, str):
                _add_static_text(o_item)
    elif isinstance(outline, str):
        for line in outline.splitlines():
            _add_static_text(line)
    for e in elements:
        if e.get("label"):
            _add_static_text(str(e["label"]))
        if "value" in e:
            _add_static_text(str(e["value"]))

    return {
        "is_browser": True,
        "target_id": target_id,
        "tab_id": tab_id,
        "snapshot_id": snap,
        "url": url,
        "title": title,
        "elements": elements[:max_elements_cap],
        "all_elements": elements,
        "valid_refs": valid_refs,
        "secure_refs": secure_refs,
        "static_texts": static_texts,
        "total_actionable_elements": len(elements),
        "omitted_elements_count": max(0, len(elements) - len(elements[:max_elements_cap])),
        "omitted_candidates_count": max(0, len(elements) - max_auto_candidates),
        "observation_truncated": len(elements) > max_elements_cap or len(elements) > max_auto_candidates,
    }


def build_bound_browser_candidates(
    raw_candidates: Any,
    observation: Mapping[str, Any],
    *,
    action_value: str | None = None,
    source_snapshot_id: str | None = None,
    max_auto_candidates: int = MAX_AUTO_CANDIDATES,
) -> list[dict[str, Any]]:
    target_id = str(observation["target_id"])
    tab_id = str(observation["tab_id"])
    snap = str(observation["snapshot_id"])
    valid_refs: set[str] = set(observation.get("valid_refs") or set())
    secure_refs: set[str] = set(observation.get("secure_refs") or set())
    all_els = observation.get("all_elements") or observation.get("elements") or []
    by_ref = {str(e.get("ref")): e for e in all_els if isinstance(e, Mapping) and e.get("ref")}

    if raw_candidates is None:
        built: list[dict[str, Any]] = []
        for e in (observation.get("elements") or [])[:max_auto_candidates]:
            ref = str(e["ref"])
            if ref in secure_refs or "secure" in str(e.get("state") or ""):
                continue
            role = str(e.get("role") or "element")
            label = str(e.get("label") or role)
            slug = re.sub(r"[^a-z0-9]+", "_", label.lower()).strip("_")[:18] or "el"
            supp = set(e.get("supported_actions") or [])
            if action_value is not None and (
                "browser_type" in supp
                or role.lower() in {"input", "textbox", "searchbox", "textarea", "combobox", "axtextfield"}
            ):
                cand_args = {
                    "target_id": target_id,
                    "tab_id": tab_id,
                    "snapshot_id": snap,
                    "ref": ref,
                    "text": action_value,
                    "replace": True,
                }
                gate_err = _check_commit_safety_gate(
                    observation, f'Type into [{ref}] {role} "{label}"', "browser_type", cand_args
                )
                if gate_err is not None:
                    raise ValueError(gate_err)
                built.append({
                    "id": f"browser.type.{ref.replace(':', '_')}.{slug}"[:64],
                    "description": f'Type value into [{ref}] {role} "{label}"',
                    "tool": "browser_type",
                    "arguments": cand_args,
                })
            else:
                cand_args = {
                    "target_id": target_id,
                    "tab_id": tab_id,
                    "snapshot_id": snap,
                    "ref": ref,
                    "delivery_mode": "background",
                    "input_route": "dom_event",
                }
                gate_err = _check_commit_safety_gate(
                    observation, f'Click [{ref}] {role} "{label}"', "browser_click", cand_args
                )
                if gate_err is not None:
                    continue
                built.append({
                    "id": f"browser.click.{ref.replace(':', '_')}.{slug}"[:64],
                    "description": f'Click [{ref}] {role} "{label}"',
                    "tool": "browser_click",
                    "arguments": cand_args,
                })
        if not built:
            raise ValueError("no actionable browser elements found in page snapshot")
        return built

    if not isinstance(raw_candidates, list) or len(raw_candidates) == 0:
        raise ValueError("browser candidates must be a non-empty list when provided")
    if len(raw_candidates) > max_auto_candidates:
        raise ValueError(f"at most {max_auto_candidates} browser candidates allowed")

    validated: list[dict[str, Any]] = []
    seen_ids: set[str] = set()
    for idx, item in enumerate(raw_candidates):
        if not isinstance(item, Mapping):
            raise ValueError(f"candidates[{idx}] must be an object")
        _reject_binary_or_image_payload(item, f"candidates[{idx}]")
        cid = str(item.get("id") or "").strip()
        if not CANDIDATE_ID_RE.match(cid):
            raise ValueError(f"candidates[{idx}].id invalid: {cid!r}")
        if cid in RESERVED_CANDIDATES or cid in seen_ids:
            raise ValueError(f"candidates[{idx}].id duplicate or reserved: {cid!r}")
        seen_ids.add(cid)

        tool = str(item.get("tool") or "browser_click").strip()
        if tool in FORBIDDEN_TOOLS:
            raise ValueError(f"candidates[{idx}] uses forbidden tool {tool!r}")
        if tool not in ALLOWED_BROWSER_STEP_TOOLS:
            raise ValueError(f"candidates[{idx}] tool {tool!r} is not in ALLOWED_BROWSER_STEP_TOOLS")

        raw_args = item.get("arguments") if isinstance(item.get("arguments"), Mapping) else item
        if str(raw_args.get("delivery_mode") or "background").strip().lower() == "foreground":
            raise ValueError("foreground_or_global_input_forbidden: delivery_mode='foreground' is forbidden")
        cand_target = str(raw_args.get("target_id") or target_id).strip()
        cand_tab = str(raw_args.get("tab_id") or tab_id).strip()
        if cand_target != target_id:
            raise ValueError(f"candidates[{idx}] target_id={cand_target!r} does not match {target_id!r}")
        if cand_tab != tab_id:
            raise ValueError(f"candidates[{idx}] tab_id={cand_tab!r} does not match {tab_id!r}")

        cand_snap = str(raw_args.get("snapshot_id") or source_snapshot_id or snap).strip()
        if cand_snap != snap:
            raise ValueError(f"stale_snapshot: candidate snapshot_id={cand_snap!r} != current {snap!r}")

        args_out: dict[str, Any] = {
            "target_id": target_id,
            "tab_id": tab_id,
            "snapshot_id": snap,
        }
        target_el: Mapping[str, Any] | None = None
        if tool in {"browser_click", "browser_type"}:
            ref = str(raw_args.get("ref") or "").strip()
            if not ref or ref not in valid_refs:
                raise ValueError(f"candidates[{idx}] ref={ref!r} not present in current browser snapshot {snap}")
            target_el = by_ref.get(ref)
            if ref in secure_refs or (isinstance(target_el, Mapping) and "secure" in str(target_el.get("state") or "")):
                raise ValueError(f"secure_element_refused: browser ref {ref!r} is a secure/password field")
            args_out["ref"] = ref
            if tool == "browser_click":
                args_out["delivery_mode"] = str(raw_args.get("delivery_mode") or "background").strip()
                args_out["input_route"] = str(raw_args.get("input_route") or "dom_event").strip()
            elif tool == "browser_type":
                text_val = raw_args.get("text", raw_args.get("value", action_value))
                if not isinstance(text_val, str) or not text_val:
                    raise ValueError(f"candidates[{idx}] browser_type requires non-empty text")
                args_out["text"] = text_val
                args_out["replace"] = bool(raw_args.get("replace", True))
                if "submit" in raw_args and isinstance(raw_args.get("submit"), bool):
                    args_out["submit"] = raw_args["submit"]
        elif tool == "browser_navigate":
            url = str(raw_args.get("url") or "").strip()
            if not is_allowed_synthetic_browser_url(url):
                raise ValueError(
                    f"external_browser_url_forbidden (browser_origin_forbidden): candidates[{idx}] url={url!r} is not an allowed local/synthetic URL"
                )
            args_out["url"] = url

        desc = str(item.get("description") or f"{tool} on {args_out.get('ref') or args_out.get('url')}").strip()
        target_lbl = str(target_el.get("label") or "") if isinstance(target_el, Mapping) else ""
        safety_desc = f"{desc} {target_lbl}".strip()
        gate_err = _check_commit_safety_gate(observation, safety_desc, tool, args_out)
        if gate_err is not None:
            raise ValueError(gate_err)
        validated.append({
            "id": cid,
            "description": desc[:1000],
            "tool": tool,
            "arguments": args_out,
        })
    return validated


def authorize_browser_candidate_dispatch(
    decision: Mapping[str, Any],
    bound_candidates: list[dict[str, Any]],
    *,
    expected_target_id: str,
    expected_tab_id: str,
    current_snapshot_id: str,
    valid_refs: set[str],
) -> dict[str, Any]:
    if decision.get("kind") != "selected":
        raise ValueError(f"cannot authorize non-selected decision kind={decision.get('kind')!r}")
    selected_id = decision.get("selected_id")
    if not isinstance(selected_id, str) or selected_id in RESERVED_CANDIDATES:
        raise ValueError(f"cannot dispatch reserved or empty selected_id={selected_id!r}")
    by_id = {c["id"]: c for c in bound_candidates}
    if selected_id not in by_id:
        raise ValueError(f"selected_id {selected_id!r} not in bound browser candidate table")
    cand = by_id[selected_id]
    tool = cand.get("tool")
    if tool not in ALLOWED_BROWSER_STEP_TOOLS:
        raise ValueError(f"tool {tool!r} is not allowed in browser step")
    args = cand.get("arguments")
    if not isinstance(args, Mapping):
        raise ValueError("candidate arguments must be a mapping")
    if args.get("target_id") != expected_target_id or args.get("tab_id") != expected_tab_id:
        raise ValueError("browser candidate scope mismatch")
    if args.get("snapshot_id") != current_snapshot_id:
        raise ValueError("stale_snapshot: browser candidate snapshot_id mismatch")
    if tool in {"browser_click", "browser_type"}:
        ref = args.get("ref")
        if not isinstance(ref, str) or ref not in valid_refs:
            raise ValueError(f"stale_or_invalid_browser_ref: ref={ref!r} not in snapshot {current_snapshot_id}")
    elif tool == "browser_navigate":
        url = str(args.get("url") or "")
        if not is_allowed_synthetic_browser_url(url):
            raise ValueError(f"external_browser_url_forbidden: url={url!r}")
    return cand


def check_browser_postcondition(
    expected: Mapping[str, Any] | None,
    pre_obs: Mapping[str, Any],
    post_obs: Mapping[str, Any],
    *,
    target_ref: str | None = None,
) -> tuple[bool, bool, str]:
    pre_sig = (
        pre_obs.get("url"),
        pre_obs.get("title"),
        tuple(pre_obs.get("static_texts") or []),
        tuple(
            (e.get("role"), e.get("label"), e.get("value"), e.get("state"))
            for e in (pre_obs.get("all_elements") or [])
            if isinstance(e, Mapping)
        ),
    )
    post_sig = (
        post_obs.get("url"),
        post_obs.get("title"),
        tuple(post_obs.get("static_texts") or []),
        tuple(
            (e.get("role"), e.get("label"), e.get("value"), e.get("state"))
            for e in (post_obs.get("all_elements") or [])
            if isinstance(e, Mapping)
        ),
    )
    state_changed = pre_sig != post_sig
    if expected is None:
        return state_changed, False, "no_expected_postcondition_supplied"
    if not isinstance(expected, Mapping) or not expected:
        return state_changed, False, "empty_expected_postcondition"

    post_texts = list(post_obs.get("static_texts") or [])
    if "url_contains" in expected:
        needle = str(expected["url_contains"] or "")
        if not needle or needle not in str(post_obs.get("url") or ""):
            return state_changed, False, f"expected url_contains={needle!r}, got {post_obs.get('url')!r}"
    if "title_contains" in expected:
        needle = str(expected["title_contains"] or "")
        if not needle or needle not in str(post_obs.get("title") or ""):
            return state_changed, False, f"expected title_contains={needle!r}, got {post_obs.get('title')!r}"
    if "static_text_contains" in expected:
        needle = str(expected["static_text_contains"] or "")
        if not needle or not any(needle in t for t in post_texts):
            return state_changed, False, f"expected static_text_contains={needle!r}, got {post_texts!r}"
    if "static_text_equals" in expected:
        exact = str(expected["static_text_equals"] or "")
        if not exact or not any(exact == t for t in post_texts):
            return state_changed, False, f"expected static_text_equals={exact!r}, got {post_texts!r}"
    if "element_value_equals" in expected or "element_label_contains" in expected:
        ref_key = str(expected.get("ref") or target_ref or "").strip()
        post_els = [e for e in (post_obs.get("all_elements") or []) if isinstance(e, Mapping) and e.get("ref")]
        by_ref = {str(e.get("ref")): e for e in post_els}
        post_el = by_ref.get(ref_key)
        if post_el is None and ref_key:
            pre_by_ref = {
                str(e.get("ref")): e
                for e in (pre_obs.get("all_elements") or [])
                if isinstance(e, Mapping) and e.get("ref")
            }
            pre_el = pre_by_ref.get(ref_key)
            ref_suffix = ref_key.split(":", 1)[-1] if ":" in ref_key else ""
            if isinstance(pre_el, Mapping):
                pre_role = str(pre_el.get("role") or "")
                pre_lbl = str(pre_el.get("label") or "")
                for cand_el in post_els:
                    if str(cand_el.get("role") or "") == pre_role and str(cand_el.get("label") or "") == pre_lbl:
                        post_el = cand_el
                        break
            if post_el is None and ref_suffix:
                for cand_el in post_els:
                    cand_ref = str(cand_el.get("ref") or "")
                    if ":" in cand_ref and cand_ref.split(":", 1)[-1] == ref_suffix:
                        if pre_el is None or str(cand_el.get("role") or "") == str(pre_el.get("role") or ""):
                            post_el = cand_el
                            break
        if post_el is None:
            return state_changed, False, f"target_ref_missing_in_post_obs: ref={ref_key!r}"
        if "element_value_equals" in expected:
            want_val = str(expected["element_value_equals"])
            got_val = str(post_el.get("value") or "")
            if got_val != want_val:
                return state_changed, False, f"expected element_value_equals={want_val!r} on ref={ref_key!r}, got {got_val!r}"
        if "element_label_contains" in expected:
            want_lbl = str(expected["element_label_contains"])
            got_lbl = str(post_el.get("label") or "")
            if want_lbl not in got_lbl:
                return state_changed, False, f"expected element_label_contains={want_lbl!r} on ref={ref_key!r}, got {got_lbl!r}"

    return state_changed, True, "expected_postcondition_verified"


_TARGET_LOCK = threading.Lock()
_ACTIVE_TARGETS: dict[tuple[int, int], dict[str, Any]] = {}


def _pid_is_alive(pid: Any) -> bool:
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False


def _default_target_state_path(env: Mapping[str, str] = os.environ) -> str:
    raw = (env.get("AGY_CUA_TARGET_STATE_FILE") or "").strip()
    if raw:
        return raw
    return os.path.join(tempfile.gettempdir(), f"agy-cua-jev-targets-{os.getuid()}.json")


def _mutate_target_state_file(state_path: str, mutator: Callable[[dict[str, Any]], tuple[Any, bool]]) -> Any:
    try:
        parent = os.path.dirname(os.path.abspath(state_path))
        if parent:
            os.makedirs(parent, exist_ok=True)
        fd = os.open(state_path, os.O_CREAT | os.O_RDWR, 0o600)
    except OSError:
        dummy: dict[str, Any] = {}
        res, _ = mutator(dummy)
        return res
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        raw_bytes = b""
        os.lseek(fd, 0, os.SEEK_SET)
        while chunk := os.read(fd, 65_536):
            raw_bytes += chunk
        try:
            data = json.loads(raw_bytes.decode("utf-8")) if raw_bytes.strip() else {}
            if not isinstance(data, dict):
                data = {}
        except ValueError:
            data = {}
        result, dirty = mutator(data)
        if dirty:
            encoded = (json.dumps(data, ensure_ascii=False, sort_keys=True) + "\n").encode("utf-8")
            os.lseek(fd, 0, os.SEEK_SET)
            os.ftruncate(fd, 0)
            os.write(fd, encoded)
        return result
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
        try:
            os.close(fd)
        except OSError:
            pass


class DriverClient:
    """Persistent stdio JSON-RPC client to `cua-driver mcp` for `jev_step` and `jev_batch`."""

    def __init__(
        self,
        driver_bin: str,
        timeout_ms: int = DEFAULT_DRIVER_TIMEOUT_MS,
        env: Mapping[str, str] = os.environ,
        session_id: str | None = None,
    ) -> None:
        self.driver_bin = driver_bin
        self.timeout_ms = clamp_driver_timeout_ms(timeout_ms)
        self._env = env
        self.session_id = session_id
        self._session_active = False
        self.supports_root_element_token = False
        self.supports_include_menubar = False
        self.driver_version: str | None = None
        self._lock = threading.Lock()
        self._proc: subprocess.Popen[bytes] | None = None
        self._rx_buf = bytearray()
        self._next_id = 0

    def _reset_unlocked(self) -> None:
        proc = self._proc
        self._proc = None
        self._session_active = False
        self.supports_root_element_token = False
        self.supports_include_menubar = False
        self.driver_version = None
        self._rx_buf.clear()
        if proc is not None:
            try:
                if proc.stdin:
                    proc.stdin.close()
            except Exception:
                pass
            try:
                if proc.stdout:
                    proc.stdout.close()
            except Exception:
                pass
            try:
                proc.terminate()
                proc.wait(timeout=0.5)
            except Exception:
                try:
                    proc.kill()
                    proc.wait(timeout=0.5)
                except Exception:
                    pass

    def _write_all_unlocked(self, fd: int, data: bytes, deadline: float, method: str) -> None:
        view = memoryview(data)
        sent = 0
        while sent < len(view):
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                self._reset_unlocked()
                raise TimeoutError(f"cua-driver mcp write timed out after {self.timeout_ms} ms during {method}")
            with selectors.DefaultSelector() as sel:
                sel.register(fd, selectors.EVENT_WRITE)
                ready = sel.select(timeout=remaining)
            if not ready:
                self._reset_unlocked()
                raise TimeoutError(f"cua-driver mcp write timed out after {self.timeout_ms} ms during {method}")
            try:
                written = os.write(fd, view[sent:])
            except BlockingIOError:
                continue
            except OSError as exc:
                self._reset_unlocked()
                raise RuntimeError(f"cua-driver mcp stdin write failed during {method}: {exc}") from exc
            if written <= 0:
                self._reset_unlocked()
                raise RuntimeError(f"cua-driver mcp stdin closed during {method}")
            sent += written

    def _ensure_started(self, max_timeout_s: float | None = None) -> subprocess.Popen[bytes]:
        if self._proc is not None and self._proc.poll() is None:
            return self._proc
        self._reset_unlocked()
        env = {"PATH": self._env.get("PATH", os.environ.get("PATH", "/usr/bin:/bin")), "HOME": self._env.get("HOME", os.environ.get("HOME", ""))}
        if self._env.get("AGY_CUA_DRIVER"):
            env["AGY_CUA_DRIVER"] = self._env["AGY_CUA_DRIVER"]
        if self._env.get("CUA_DRIVER_HOME"):
            env["CUA_DRIVER_HOME"] = self._env["CUA_DRIVER_HOME"]
        if self._env.get("AGY_CUA_DRIVER_DIRECT"):
            env["AGY_CUA_DRIVER_DIRECT"] = self._env["AGY_CUA_DRIVER_DIRECT"]
        if sys.platform == "linux":
            for name in ("DISPLAY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS"):
                if self._env.get(name):
                    env[name] = self._env[name]
        mcp_cmd = [self.driver_bin, "mcp"]
        if self._env.get("AGY_CUA_DRIVER_DIRECT") == "1":
            mcp_cmd.append("--direct")
        proc = subprocess.Popen(
            mcp_cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            bufsize=0,
            env=env,
        )
        assert proc.stdin is not None and proc.stdout is not None
        os.set_blocking(proc.stdin.fileno(), False)
        os.set_blocking(proc.stdout.fileno(), False)
        self._proc = proc
        self._next_id = 0
        init_timeout = max(1.0, self.timeout_ms / 1000.0)
        if max_timeout_s is not None:
            init_timeout = min(init_timeout, max_timeout_s)
        startup_deadline = time.monotonic() + max(0.001, init_timeout)
        try:
            init_res = self._request_unlocked(
                "initialize",
                {
                    "protocolVersion": DEFAULT_PROTOCOL,
                    "capabilities": {},
                    "clientInfo": SERVER_INFO,
                },
                timeout_s=max(0.001, startup_deadline - time.monotonic()),
            )
            init_notif = (json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n").encode("utf-8")
            self._write_all_unlocked(proc.stdin.fileno(), init_notif, startup_deadline, "notifications/initialized")
            srv_info = init_res.get("serverInfo") if isinstance(init_res, Mapping) else None
            if isinstance(srv_info, Mapping) and srv_info.get("name") == "cua-driver":
                self.driver_version = str(srv_info.get("version")) if srv_info.get("version") else None
                try:
                    tools_res = self._request_unlocked(
                        "tools/list",
                        {},
                        timeout_s=min(1.5, max(0.001, startup_deadline - time.monotonic())),
                    )
                    for t_def in (tools_res.get("tools") or []) if isinstance(tools_res, Mapping) else []:
                        if isinstance(t_def, Mapping) and t_def.get("name") == "get_window_state":
                            in_schema = t_def.get("inputSchema")
                            props = in_schema.get("properties") if isinstance(in_schema, Mapping) else None
                            if isinstance(props, Mapping):
                                self.supports_root_element_token = "root_element_token" in props
                                self.supports_include_menubar = "include_menubar" in props
                            break
                except Exception:
                    pass
            if (
                isinstance(srv_info, Mapping)
                and srv_info.get("name") == "cua-driver"
                and self._env.get("AGY_CUA_JEV_LEGACY_CURSOR") != "1"
            ):
                target_session = self.session_id or "implicit"
                try:
                    self._request_unlocked(
                        "tools/call",
                        {
                            "name": "start_session",
                            "arguments": {
                                "session": target_session,
                                "cursor_motion": {
                                    "timing": "fixed",
                                    "glide_duration_ms": 1,
                                    "dwell_after_click_ms": 0,
                                },
                                "cursor_theme": {"reduced_motion": "on"},
                            },
                        },
                        timeout_s=min(1.0, max(0.001, startup_deadline - time.monotonic())),
                    )
                    self._request_unlocked(
                        "tools/call",
                        {
                            "name": "set_agent_cursor_enabled",
                            "arguments": {"session": target_session, "enabled": False},
                        },
                        timeout_s=min(1.0, max(0.001, startup_deadline - time.monotonic())),
                    )
                    if self.session_id:
                        self._session_active = True
                except Exception:
                    pass
        except Exception:
            self._reset_unlocked()
            raise
        return proc

    def _readline_unlocked(self, deadline: float, method: str) -> str:
        proc = self._proc
        assert proc is not None and proc.stdout is not None
        fd = proc.stdout.fileno()
        while True:
            nl_pos = self._rx_buf.find(b"\n")
            if nl_pos != -1:
                raw_line = bytes(self._rx_buf[: nl_pos + 1])
                del self._rx_buf[: nl_pos + 1]
                return raw_line.decode("utf-8", errors="replace")

            remaining = deadline - time.monotonic()
            if remaining <= 0:
                self._reset_unlocked()
                raise TimeoutError(f"cua-driver mcp timed out after {self.timeout_ms} ms during {method}")

            with selectors.DefaultSelector() as sel:
                sel.register(fd, selectors.EVENT_READ)
                ready = sel.select(timeout=remaining)
            if not ready:
                self._reset_unlocked()
                raise TimeoutError(f"cua-driver mcp timed out after {self.timeout_ms} ms during {method}")

            try:
                chunk = os.read(fd, 65_536)
            except BlockingIOError:
                continue
            except OSError as exc:
                self._reset_unlocked()
                raise RuntimeError(f"cua-driver mcp stdout read failed during {method}: {exc}") from exc
            if not chunk:
                self._reset_unlocked()
                raise RuntimeError(f"cua-driver mcp exited during {method}")
            self._rx_buf.extend(chunk)

    def _request_unlocked(self, method: str, params: Mapping[str, Any], timeout_s: float | None = None) -> dict[str, Any]:
        proc = self._proc
        assert proc is not None and proc.stdin is not None and proc.stdout is not None
        self._next_id += 1
        req_id = self._next_id
        effective_timeout = timeout_s if timeout_s is not None else (self.timeout_ms / 1000.0)
        deadline = time.monotonic() + max(0.001, effective_timeout)
        payload = (json.dumps({"jsonrpc": "2.0", "id": req_id, "method": method, "params": dict(params)}) + "\n").encode("utf-8")
        self._write_all_unlocked(proc.stdin.fileno(), payload, deadline, method)

        while True:
            line = self._readline_unlocked(deadline, method)
            try:
                msg = json.loads(line)
            except ValueError as exc:
                self._reset_unlocked()
                raise RuntimeError(f"cua-driver mcp returned invalid JSON during {method}") from exc
            if not isinstance(msg, Mapping):
                self._reset_unlocked()
                raise RuntimeError(f"cua-driver mcp returned non-object frame during {method}")
            if msg.get("id") == req_id:
                if "error" in msg:
                    err = msg["error"]
                    raise RuntimeError(err.get("message") if isinstance(err, Mapping) else str(err))
                res = msg.get("result")
                if not isinstance(res, dict):
                    raise RuntimeError(f"cua-driver mcp returned non-object result for {method}")
                return res

    def ensure_capabilities(self, *, deadline_monotonic: float | None = None) -> None:
        if self._proc is not None and self._proc.poll() is None:
            return
        with self._lock:
            max_init_s: float | None = None
            if deadline_monotonic is not None:
                rem = deadline_monotonic - time.monotonic()
                if rem <= 0:
                    raise TimeoutError("batch deadline exceeded")
                max_init_s = rem
            self._ensure_started(max_timeout_s=max_init_s)

    def call_tool(
        self,
        name: str,
        arguments: Mapping[str, Any],
        timeout_s: float | None = None,
        *,
        deadline_monotonic: float | None = None,
    ) -> dict[str, Any]:
        with self._lock:
            max_init_s: float | None = None
            if deadline_monotonic is not None:
                rem = deadline_monotonic - time.monotonic()
                if rem <= 0:
                    raise TimeoutError("batch deadline exceeded")
                max_init_s = rem
            self._ensure_started(max_timeout_s=max_init_s)
            call_args = dict(arguments)
            if self.session_id and name in SESSION_SCOPED_DRIVER_TOOLS:
                call_args.setdefault("session", self.session_id)
                self._session_active = True
            eff_timeout = timeout_s
            if deadline_monotonic is not None:
                rem = deadline_monotonic - time.monotonic()
                if rem <= 0:
                    raise TimeoutError("batch deadline exceeded")
                eff_timeout = min(eff_timeout, rem) if eff_timeout is not None else rem
            return self._request_unlocked("tools/call", {"name": name, "arguments": call_args}, timeout_s=eff_timeout)

    def close(self) -> None:
        with self._lock:
            if (
                self._proc is not None
                and self._proc.poll() is None
                and self._session_active
                and self.session_id
            ):
                try:
                    self._request_unlocked(
                        "tools/call",
                        {"name": "end_session", "arguments": {"session": self.session_id}},
                        timeout_s=min(1.0, self.timeout_ms / 1000.0),
                    )
                except Exception:
                    pass
            self._reset_unlocked()


