    "AXMenuItem",
    "AXDisclosureTriangle",
    "AXTabGroup",
})

TEXT_INPUT_AX_ROLES = frozenset({
    "AXTextField",
    "AXTextArea",
    "AXSearchField",
    "AXComboBox",
})

VALUE_SETTABLE_AX_ROLES = TEXT_INPUT_AX_ROLES | frozenset({
    "AXSlider",
