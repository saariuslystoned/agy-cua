#!/usr/bin/env python3
"""Narrow Jev bounded action-selection and guarded controller MCP server for agy-cua.

Preserves `bin/agy-cua-mcp` as a pure pass-through shim while exposing a separate,
narrow MCP surface (`agy-cua-jev`) for:
  - `jev_status`: non-secret credential/route/model/budget readiness check
  - `jev_select_action`: text-only closed-candidate Jev selection (no Driver dispatch)
  - `jev_step`: Observe -> Candidate Table -> Jev Select -> Validate -> Background Dispatch -> Fresh Verify
  - `jev_batch`: Guarded multi-step sequence over the protected controller loop with explicit postconditions

CLI modes:
  bin/agy-cua-jev-mcp           run stdio MCP server
  bin/agy-cua-jev-mcp --check   print non-secret route readiness JSON (no network)
  bin/agy-cua-jev-mcp --probe   run one tiny bounded boolean/choice probe against configured route
"""
import fcntl
import json
import math
import os
import re
import selectors
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
import weakref
from dataclasses import dataclass, field
from typing import Any, Callable, Mapping

SERVER_INFO = {"name": "agy-cua-jev", "version": "0.2.0"}
DEFAULT_PROTOCOL = "2025-06-18"

HOSTED_ENDPOINT = "https://api.typesafe.ai/v1/systemone"
DEFAULT_KEYCHAIN_SERVICE = "typesafe-jev"
PINNED_JEV_MODEL = "jev-1.13.0"
LOCAL_KEV_MODEL = "kev-latest"
CLIENT_IDENTITY = "agy-cua-jev-stdlib/0.2.0"

DEFAULT_TIMEOUT_MS = 10_000
MIN_TIMEOUT_MS = 1_000
MAX_TIMEOUT_MS = 30_000
DEFAULT_DRIVER_TIMEOUT_MS = 15_000
MIN_DRIVER_TIMEOUT_MS = 50
MAX_DRIVER_TIMEOUT_MS = 60_000
DEFAULT_BATCH_TIMEOUT_MS = 60_000
MIN_BATCH_TIMEOUT_MS = 100
MAX_BATCH_TIMEOUT_MS = 180_000
MAX_BATCH_STEPS = 16
DEFAULT_MAX_CALLS = 32
MAX_ATTEMPTS_PER_CALL = 1
MAX_JSON_BYTES = 65_536
MAX_CANDIDATES = 32
MAX_AUTO_CANDIDATES = 28
MAX_ELEMENTS = 64
MAX_HISTORY = 16

SNAPSHOT_ID_RE = re.compile(r"^s[0-9a-f]{8,}$")
CANDIDATE_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$")
SESSION_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$")
LOOPBACK_RE = re.compile(r"^https?://(?:localhost|127\.0\.0\.1|\[::1\])(?::[0-9]{1,5})?/?$")
BASE64_IMAGE_RE = re.compile(r"data:image/[a-zA-Z0-9.+-]+;base64,|iVBORw0KGgo", re.IGNORECASE)

RESERVED_CANDIDATES: dict[str, str] = {
    "reobserve": "Take a fresh window observation before acting because the current state is incomplete or changing.",
    "abstain": "Refuse to act because no supplied candidate safely advances the goal in the current window state.",
}

ALLOWED_BACKGROUND_TOOLS = frozenset({
    "click",
    "double_click",
    "right_click",
    "type_text",
    "press_key",
    "hotkey",
    "set_value",
    "scroll",
    "invoke_menu",
})

FORBIDDEN_TOOLS = frozenset({
    "bring_to_front",
    "get_desktop_state",
    "clipboard_read",
    "clipboard_write",
    "kill_app",
    "set_config",
    "browser_prepare",
    "browser_navigate",
    "browser_click",
    "browser_type",
    "browser_dialog",
    "browser_set_input_files",
    "browser_download",
    "browser_pointer",
})

ACTIONABLE_AX_ROLES = frozenset({
