                "max_elements": {
                    "type": "integer",
                    "minimum": MIN_OBSERVE_MAX_ELEMENTS,
                    "maximum": MAX_OBSERVE_MAX_ELEMENTS,
                    "description": (
                        "Optional AX tree walk element cap (1..1000) forwarded to both Stage 1 (pre-action) and "
                        "Stage 5 (post-action) get_window_state calls."
                    ),
                },
                "walk_timeout_ms": {
                    "type": "integer",
                    "minimum": MIN_OBSERVE_WALK_TIMEOUT_MS,
                    "maximum": MAX_OBSERVE_WALK_TIMEOUT_MS,
                    "description": (
                        "Optional AX tree walk timeout in milliseconds (100..10000) forwarded as timeout_ms to both "
                        "Stage 1 (pre-action) and Stage 5 (post-action) get_window_state calls."
                    ),
                },
                "mode": {
                    "type": "string",
                    "enum": ["jev", "deterministic"],
                    "description": "Selection mode: 'jev' (default) or 'deterministic' (requires a single bound candidate).",
                },
                "expected_snapshot_id": {
                    "type": "string",
                    "pattern": "^s[0-9a-f]{8,}$",
                    "description": "Optional expected pre-action snapshot_id; refuses with stale_snapshot if observation differs.",
                },
                "candidates": {
                    "type": "array",
                    "description": (
                        "Optional explicit candidates bound to (pid, window_id). If omitted, actionable AX elements "
                        "in the window are automatically offered as background click candidates."
                    ),
                    "items": {"type": "object"},
                },
                "history": {
                    "type": "array",
                    "description": "Optional bounded history of prior steps ({selected_id, outcome}).",
                    "items": {"type": "object"},
                },
                "expected_postcondition": EXPECTED_POSTCONDITION_SCHEMA,
            },
        },
    },
    {
        "name": "jev_batch",
        "description": (
            "Execute a guarded multi-step batch (1..16 steps) on an explicit background window (pid, window_id) "
            "over the protected controller loop. Every step takes a fresh get_window_state (or reuses the prior "
            "step's verified post-observation when chain_observations=true and scope matches), binds a fresh "
            "element_token (<snapshot_id>:<element_index>), enforces background-only window-scoped delivery, "
            "and requires a bound expected_postcondition that achieves verification_outcome='goal_verified' "
            "before advancing. Stops immediately on the first failed/unverified step or timeout and returns "
            "completed_steps, failed_step, and remaining_steps so completed side effects are never replayed."
        ),
        "inputSchema": {
            "type": "object",
            "additionalProperties": False,
            "required": ["pid", "window_id", "steps"],
            "properties": {
                "pid": {"type": "integer", "minimum": 1, "description": "Target application pid."},
                "window_id": {"type": "integer", "minimum": 1, "description": "Target application window_id."},
                "timeout_ms": {
                    "type": "integer",
                    "minimum": MIN_BATCH_TIMEOUT_MS,
                    "maximum": MAX_BATCH_TIMEOUT_MS,
                    "description": "Overall batch deadline in milliseconds (default 60000).",
                },
                "expected_snapshot_id": {
                    "type": "string",
                    "pattern": "^s[0-9a-f]{8,}$",
                    "description": "Optional expected snapshot_id before step 0 executes.",
                },
                "allow_interstep_drift": {
                    "type": "boolean",
                    "description": "If false (default), halts with stale_snapshot if window AX state drifts externally between steps.",
                },
                "chain_observations": {
                    "type": "boolean",
                    "description": (
                        "If true, when step k achieves verification_outcome='goal_verified' and step k+1 uses the "
                        "same (query, max_depth, max_elements, walk_timeout_ms) scope without requiring a pixel "
                        "screenshot anchor, step k's verified post-observation is reused as step k+1's pre-observation "
                        "while binding a fresh element_token to step k's post_snapshot_id. Only honoured together with "
                        "allow_interstep_drift=true, because a reused observation cannot detect external drift; "
                        "otherwise each step takes a fresh read."
                    ),
                },
                "steps": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": MAX_BATCH_STEPS,
                    "description": "Ordered list of guarded steps, each requiring goal and expected_postcondition.",
                    "items": {
                        "type": "object",
                        "additionalProperties": False,
                        "required": ["goal", "expected_postcondition"],
                        "properties": {
                            "goal": {"type": "string"},
                            "value": {
                                "type": "string",
                                "description": "Optional text value for bounded set_value auto-candidates in this step.",
                            },
                            "mode": {"type": "string", "enum": ["jev", "deterministic"]},
                            "query": {"type": "string", "minLength": 1},
                            "max_depth": {
                                "type": "integer",
                                "minimum": MIN_OBSERVE_MAX_DEPTH,
                                "maximum": MAX_OBSERVE_MAX_DEPTH,
                            },
                            "max_elements": {
                                "type": "integer",
                                "minimum": MIN_OBSERVE_MAX_ELEMENTS,
                                "maximum": MAX_OBSERVE_MAX_ELEMENTS,
                            },
                            "walk_timeout_ms": {
                                "type": "integer",
                                "minimum": MIN_OBSERVE_WALK_TIMEOUT_MS,
                                "maximum": MAX_OBSERVE_WALK_TIMEOUT_MS,
                            },
                            "expected_snapshot_id": {"type": "string", "pattern": "^s[0-9a-f]{8,}$"},
                            "candidates": {"type": "array", "items": {"type": "object"}},
                            "expected_postcondition": EXPECTED_POSTCONDITION_SCHEMA,
                        },
                    },
                },
            },
        },
    },
]


def _format_tool_result(payload: Mapping[str, Any], is_error: bool = False) -> dict[str, Any]:
    summary_lines = [
        f"schema={payload.get('schema')} status={payload.get('status', payload.get('kind', 'ok'))}"
    ]
    if "verification_outcome" in payload:
        summary_lines[0] += f" verification_outcome={payload.get('verification_outcome')}"
    if "selected_id" in payload and payload.get("selected_id"):
        summary_lines.append(
            f"selected_id={payload.get('selected_id')} model={payload.get('returned_model')} "
            f"confidence={payload.get('confidence')}"
        )
    if "pre_snapshot_id" in payload or "post_snapshot_id" in payload:
        summary_lines.append(
            f"pre_snapshot_id={payload.get('pre_snapshot_id')} post_snapshot_id={payload.get('post_snapshot_id')} "
            f"verified={payload.get('verified')} post_static_texts={json.dumps(payload.get('post_static_texts', []), ensure_ascii=False)}"
        )
    if "total_actionable_elements" in payload:
        obs_line = (
            f"total_actionable_elements={payload.get('total_actionable_elements')} "
            f"omitted_elements_count={payload.get('omitted_elements_count')} "
            f"omitted_candidates_count={payload.get('omitted_candidates_count')} "
            f"observation_truncated={payload.get('observation_truncated')}"
        )
        if "post_observation_truncated" in payload:
            obs_line += (
                f" post_total_actionable_elements={payload.get('post_total_actionable_elements')} "
                f"post_omitted_elements_count={payload.get('post_omitted_elements_count')} "
                f"post_omitted_candidates_count={payload.get('post_omitted_candidates_count')} "
                f"post_observation_truncated={payload.get('post_observation_truncated')}"
            )
        summary_lines.append(obs_line)
    if "completed_count" in payload and "total_steps" in payload:
        summary_lines.append(
            f"completed={payload.get('completed_count')}/{payload.get('total_steps')} "
            f"verified={payload.get('verified')}"
        )
    if "timings_ms" in payload:
        summary_lines.append(f"timings_ms={json.dumps(payload['timings_ms'], sort_keys=True)}")
    summary_lines.append(json.dumps(payload, ensure_ascii=False, indent=2))
    return {
        "content": [{"type": "text", "text": "\n".join(summary_lines)}],
        "structuredContent": dict(payload),
        "isError": is_error,
    }


class JevMcpServer:
    def __init__(
        self,
        env: Mapping[str, str] = os.environ,
        keychain_reader: Callable[[str], str | None] = read_keychain_secret,
        http_post: Callable[[urllib.request.Request, float], tuple[int, str]] = _default_urlopen,
        driver_client: DriverClient | None = None,
    ) -> None:
        self.env = env
        self.keychain_reader = keychain_reader
        self.http_post = http_post
        self.session_id = resolve_session_id(env)
        self.accounting = SessionAccounting(max_calls=clamp_max_calls(env.get("AGY_CUA_JEV_MAX_CALLS")))
        self._driver_client = driver_client
        if self._driver_client is not None and not self._driver_client.session_id:
            self._driver_client.session_id = self.session_id
        self._closed = False
        self._owned_targets: set[tuple[int, int]] = set()

    def _get_driver(self) -> DriverClient:
        if self._driver_client is not None:
            return self._driver_client
        driver_bin = find_driver(self.env)
        if not driver_bin:
            raise RuntimeError("cua-driver not found; run `bin/agy-cua doctor`")
        timeout_ms = clamp_driver_timeout_ms(self.env.get("AGY_CUA_DRIVER_TIMEOUT_MS"))
        self._driver_client = DriverClient(
            driver_bin,
            timeout_ms=timeout_ms,
            env=self.env,
            session_id=self.session_id,
        )
        return self._driver_client

    def _target_state_path(self) -> str:
        return _default_target_state_path(self.env)

    def _acquire_target(self, pid: int, window_id: int) -> str | None:
        key = (pid, window_id)
        str_key = f"{pid}:{window_id}"
        state_path = self._target_state_path()
        current_pid = os.getpid()
        with _TARGET_LOCK:
            for k in [
                tk
                for tk, tv in _ACTIVE_TARGETS.items()
                if tv.get("owner_ref") is None or tv["owner_ref"]() is None or tv["owner_ref"]()._closed
            ]:
                _ACTIVE_TARGETS.pop(k, None)

            existing = _ACTIVE_TARGETS.get(key)
            if existing is not None:
                owner = existing["owner_ref"]() if existing.get("owner_ref") is not None else None
                owner_sess = existing.get("session_id")
                if owner is not None and not owner._closed and owner_sess != self.session_id:
                    return (
                        f"target_conflict: target (pid={pid}, window_id={window_id}) is actively "
                        f"owned by concurrent session {owner_sess!r}"
                    )

            live_local_sessions = {
                v.get("session_id")
                for v in _ACTIVE_TARGETS.values()
                if isinstance(v.get("session_id"), str)
            }
            live_local_sessions.add(self.session_id)

            def _mutate(data: dict[str, Any]) -> tuple[str | None, bool]:
                dirty = False
                for fk, fval in list(data.items()):
                    if not isinstance(fval, dict):
                        data.pop(fk, None)
                        dirty = True
                        continue
                    srv_pid = fval.get("server_pid")
                    f_sess = fval.get("session_id")
                    if srv_pid == current_pid:
                        if f_sess not in live_local_sessions:
                            data.pop(fk, None)
                            dirty = True
                    elif not _pid_is_alive(srv_pid):
                        data.pop(fk, None)
                        dirty = True

                f_existing = data.get(str_key)
                if isinstance(f_existing, dict):
                    f_sess = f_existing.get("session_id")
                    if isinstance(f_sess, str) and f_sess != self.session_id:
                        return (
                            f"target_conflict: target (pid={pid}, window_id={window_id}) is actively "
                            f"owned by concurrent session {f_sess!r}",
                            dirty,
                        )

                prev_snap = (
                    existing.get("last_snapshot_id")
                    if existing and existing.get("session_id") == self.session_id
                    else (f_existing.get("last_snapshot_id") if isinstance(f_existing, dict) else None)
                )
                data[str_key] = {
                    "session_id": self.session_id,
                    "server_pid": current_pid,
                    "last_snapshot_id": prev_snap,
                }
                return None, True

            file_conflict = _mutate_target_state_file(state_path, _mutate)
            if file_conflict is not None:
                return file_conflict

            _ACTIVE_TARGETS[key] = {
                "session_id": self.session_id,
                "owner_ref": weakref.ref(self),
                "last_snapshot_id": (
                    existing.get("last_snapshot_id")
                    if existing and existing.get("session_id") == self.session_id
                    else None
                ),
            }
            self._owned_targets.add(key)
        return None

    def _release_single_target(self, pid: int, window_id: int) -> None:
        key = (pid, window_id)
        str_key = f"{pid}:{window_id}"
        state_path = self._target_state_path()
        with _TARGET_LOCK:
            entry = _ACTIVE_TARGETS.get(key)
            if entry is not None and entry.get("session_id") == self.session_id:
                _ACTIVE_TARGETS.pop(key, None)
            self._owned_targets.discard(key)

            def _mutate(data: dict[str, Any]) -> tuple[None, bool]:
                f_entry = data.get(str_key)
                if isinstance(f_entry, dict) and f_entry.get("session_id") == self.session_id:
                    data.pop(str_key, None)
                    return None, True
                return None, False

            _mutate_target_state_file(state_path, _mutate)

    def _update_target_snapshot(self, pid: int, window_id: int, snapshot_id: str) -> None:
        key = (pid, window_id)
        str_key = f"{pid}:{window_id}"
        state_path = self._target_state_path()
        with _TARGET_LOCK:
            entry = _ACTIVE_TARGETS.get(key)
            if entry is not None and entry.get("session_id") == self.session_id:
                entry["last_snapshot_id"] = snapshot_id

            def _mutate(data: dict[str, Any]) -> tuple[None, bool]:
                f_entry = data.get(str_key)
                if isinstance(f_entry, dict) and f_entry.get("session_id") == self.session_id:
                    f_entry["last_snapshot_id"] = snapshot_id
                    return None, True
                return None, False

            _mutate_target_state_file(state_path, _mutate)

    def _release_targets(self) -> None:
        state_path = self._target_state_path()
        with _TARGET_LOCK:
            stale_keys = [
                k
                for k, v in _ACTIVE_TARGETS.items()
                if v.get("session_id") == self.session_id
                or v.get("owner_ref") is None
                or v["owner_ref"]() is None
                or v["owner_ref"]() is self
            ]
            for k in stale_keys:
                _ACTIVE_TARGETS.pop(k, None)
            self._owned_targets.clear()

            def _mutate(data: dict[str, Any]) -> tuple[None, bool]:
                dirty = False
                for fk, fval in list(data.items()):
                    if not isinstance(fval, dict) or fval.get("session_id") == self.session_id:
                        data.pop(fk, None)
                        dirty = True
                return None, dirty

            _mutate_target_state_file(state_path, _mutate)

    def _record_trace(self, entry: Mapping[str, Any]) -> None:
        if entry.get("schema") != "agy_cua.jev_batch_v1":
            self.accounting.history_log.append(dict(entry))
        trace_path = self.env.get("AGY_CUA_JEV_TRACE_FILE")
        if trace_path:
            try:
                with open(trace_path, "a", encoding="utf-8") as handle:
                    handle.write(json.dumps(entry, ensure_ascii=False) + "\n")
            except OSError:
                pass

    def handle_step(
        self,
        args: Mapping[str, Any],
        *,
        _deadline_monotonic: float | None = None,
        _expected_pre_sig: tuple[Any, ...] | None = None,
        _out_post_sig: list[tuple[Any, ...]] | None = None,
        _chained_obs: Mapping[str, Any] | None = None,
        _out_post_obs: list[dict[str, Any]] | None = None,
    ) -> dict[str, Any]:
        step_started = time.perf_counter()
        if not isinstance(args, Mapping):
            return _format_tool_result(
                {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_arguments"},
                is_error=True,
            )

        if self.accounting.halted:
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_step_v1",
                    "status": "halted",
                    "reason": self.accounting.halt_reason or "session_halted",
                    "session_id": self.session_id,
                    "accounting": self.accounting.to_dict(),
                },
                is_error=True,
            )

        goal = args.get("goal")
        pid = args.get("pid")
        window_id = args.get("window_id")
        if not isinstance(goal, str) or not goal.strip():
            return _format_tool_result(
                {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_goal"},
                is_error=True,
            )
        if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
            return _format_tool_result(
                {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_pid"},
                is_error=True,
            )
        if not isinstance(window_id, int) or isinstance(window_id, bool) or window_id <= 0:
            return _format_tool_result(
                {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_window_id"},
                is_error=True,
            )

        action_value = args.get("value")
        if action_value is not None and not isinstance(action_value, str):
            return _format_tool_result(
                {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_value"},
                is_error=True,
            )

        query_val: str | None = None
        if "query" in args and args["query"] is not None:
            raw_query = args["query"]
            if not isinstance(raw_query, str) or not raw_query.strip():
                return _format_tool_result(
                    {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_query"},
                    is_error=True,
                )
            query_val = raw_query.strip()

        max_depth_val: int | None = None
        if "max_depth" in args and args["max_depth"] is not None:
            raw_depth = args["max_depth"]
            if (
                not isinstance(raw_depth, int)
                or isinstance(raw_depth, bool)
                or raw_depth < MIN_OBSERVE_MAX_DEPTH
                or raw_depth > MAX_OBSERVE_MAX_DEPTH
            ):
                return _format_tool_result(
                    {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_max_depth"},
                    is_error=True,
                )
            max_depth_val = raw_depth

        max_elements_val: int | None = None
        if "max_elements" in args and args["max_elements"] is not None:
            raw_max_el = args["max_elements"]
            if (
                not isinstance(raw_max_el, int)
                or isinstance(raw_max_el, bool)
                or raw_max_el < MIN_OBSERVE_MAX_ELEMENTS
                or raw_max_el > MAX_OBSERVE_MAX_ELEMENTS
            ):
                return _format_tool_result(
                    {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_max_elements"},
                    is_error=True,
                )
            max_elements_val = raw_max_el

        walk_timeout_ms_val: int | None = None
        if "walk_timeout_ms" in args and args["walk_timeout_ms"] is not None:
            raw_walk_to = args["walk_timeout_ms"]
            if (
                not isinstance(raw_walk_to, int)
                or isinstance(raw_walk_to, bool)
                or raw_walk_to < MIN_OBSERVE_WALK_TIMEOUT_MS
                or raw_walk_to > MAX_OBSERVE_WALK_TIMEOUT_MS
            ):
                return _format_tool_result(
                    {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_walk_timeout_ms"},
                    is_error=True,
                )
            walk_timeout_ms_val = raw_walk_to

        mode = str(args.get("mode") or ("deterministic" if args.get("deterministic") is True else "jev")).strip()
        if mode not in {"jev", "deterministic"}:
            return _format_tool_result(
                {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": f"invalid_mode={mode!r}"},
                is_error=True,
            )

        expected_snap = args.get("expected_snapshot_id")
        if expected_snap is not None and (not isinstance(expected_snap, str) or not SNAPSHOT_ID_RE.match(expected_snap)):
            return _format_tool_result(
                {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_expected_snapshot_id"},
                is_error=True,
            )

        raw_cands = args.get("candidates")
        if mode == "deterministic":
            if not isinstance(raw_cands, list) or len(raw_cands) != 1:
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_step_v1",
                        "status": "candidate_refused",
                        "reason": "deterministic_step_requires_single_candidate",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                        "verified": False,
                        "accounting": self.accounting.to_dict(),
                    },
                    is_error=True,
                )

        was_owned = (pid, window_id) in self._owned_targets
        conflict = self._acquire_target(pid, window_id)
        if conflict is not None:
            payload = {
                "schema": "agy_cua.jev_step_v1",
                "status": "target_conflict",
                "verification_outcome": "not_executed",
                "reason": conflict,
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "verified": False,
                "uncertain_side_effect": False,
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)

        def release_if_unowned() -> None:
            if not was_owned:
                self._release_single_target(pid, window_id)

        def remaining_timeout_s(default_s: float) -> float:
            if _deadline_monotonic is None:
                return default_s
            rem = _deadline_monotonic - time.monotonic()
            if rem <= 0:
                raise TimeoutError("batch deadline exceeded")
            return min(default_s, rem)

        def obs_call_timeout_s(drv: DriverClient) -> float:
            base_ms = (
                max(drv.timeout_ms, walk_timeout_ms_val + 1000)
                if walk_timeout_ms_val is not None
                else drv.timeout_ms
            )
            return remaining_timeout_s(base_ms / 1000.0)

        # Stage 1: Observe target window via cua-driver (text-only to Jev; anchor window screenshot in driver session only if a candidate uses window-local pixels)
        needs_pixel_anchor = False
        if isinstance(raw_cands, list):
            for item in raw_cands:
                if isinstance(item, Mapping):
                    sub = item.get("arguments") if isinstance(item.get("arguments"), Mapping) else item
                    if any(k in sub for k in ("x", "y", "from_x", "from_y", "to_x", "to_y")):
                        needs_pixel_anchor = True
                        break
        obs_started = time.perf_counter()
        if _chained_obs is not None and not needs_pixel_anchor:
            try:
                driver = self._get_driver()
                pre_obs = dict(_chained_obs)
            except Exception as exc:
                release_if_unowned()
                payload = {
                    "schema": "agy_cua.jev_step_v1",
                    "status": "observation_failed",
                    "verification_outcome": "not_executed",
                    "reason": str(exc),
                    "pid": pid,
                    "window_id": window_id,
                    "session_id": self.session_id,
                    "verified": False,
                    "uncertain_side_effect": False,
                    "timings_ms": {
                        "observe_ms": 0.0,
                        "provider_ms": 0.0,
                        "dispatch_ms": 0.0,
                        "verify_ms": 0.0,
                        "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                    },
                    "accounting": self.accounting.to_dict(),
                }
                self._record_trace(payload)
                return _format_tool_result(payload, is_error=True)
            obs_ms = 0.0
        else:
            try:
                driver = self._get_driver()
                pre_obs_args: dict[str, Any] = {
                    "pid": pid,
                    "window_id": window_id,
                    "include_screenshot": needs_pixel_anchor,
                    "tree_format": "both",
                }
                if query_val is not None:
                    pre_obs_args["query"] = query_val
                if max_depth_val is not None:
                    pre_obs_args["max_depth"] = max_depth_val
                if max_elements_val is not None:
                    pre_obs_args["max_elements"] = max_elements_val
                if walk_timeout_ms_val is not None:
                    pre_obs_args["timeout_ms"] = walk_timeout_ms_val
                raw_pre = driver.call_tool(
                    "get_window_state",
                    pre_obs_args,
                    timeout_s=obs_call_timeout_s(driver),
                    deadline_monotonic=_deadline_monotonic,
                )
                if raw_pre.get("isError"):
                    err_txt = "".join(c.get("text", "") for c in (raw_pre.get("content") or []) if isinstance(c, Mapping))
                    raise RuntimeError(err_txt or "get_window_state returned isError=true")
                pre_obs = extract_window_observation(raw_pre, expected_pid=pid, expected_window_id=window_id)
            except Exception as exc:
                release_if_unowned()
                obs_ms = round((time.perf_counter() - obs_started) * 1000, 2)
                payload = {
                    "schema": "agy_cua.jev_step_v1",
                    "status": "observation_failed",
                    "verification_outcome": "not_executed",
                    "reason": str(exc),
                    "pid": pid,
                    "window_id": window_id,
                    "session_id": self.session_id,
                    "verified": False,
                    "uncertain_side_effect": False,
                    "timings_ms": {
                        "observe_ms": obs_ms,
                        "provider_ms": 0.0,
                        "dispatch_ms": 0.0,
                        "verify_ms": 0.0,
                        "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                    },
                    "accounting": self.accounting.to_dict(),
                }
                self._record_trace(payload)
                return _format_tool_result(payload, is_error=True)
            obs_ms = round((time.perf_counter() - obs_started) * 1000, 2)
        obs_disclosure = {
            "total_actionable_elements": pre_obs["total_actionable_elements"],
            "omitted_elements_count": pre_obs["omitted_elements_count"],
            "omitted_candidates_count": pre_obs["omitted_candidates_count"],
            "observation_truncated": pre_obs["observation_truncated"],
        }

        if expected_snap is not None and pre_obs["snapshot_id"] != expected_snap:
            release_if_unowned()
            payload = {
                "schema": "agy_cua.jev_step_v1",
                "status": "stale_snapshot",
                "verification_outcome": "not_executed",
                "reason": f"stale_snapshot_id: expected {expected_snap!r}, observed {pre_obs['snapshot_id']!r}",
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "pre_snapshot_id": pre_obs["snapshot_id"],
                "pre_static_texts": pre_obs["static_texts"],
                "verified": False,
                "uncertain_side_effect": False,
                "timings_ms": {
                    "observe_ms": obs_ms,
                    "provider_ms": 0.0,
                    "dispatch_ms": 0.0,
                    "verify_ms": 0.0,
                    "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                },
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)

        if _expected_pre_sig is not None and _obs_state_signature(pre_obs) != _expected_pre_sig:
            release_if_unowned()
            payload = {
                "schema": "agy_cua.jev_step_v1",
                "status": "stale_snapshot",
                "verification_outcome": "not_executed",
                "reason": "interstep_state_drift: window AX state changed externally between batch steps",
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "pre_snapshot_id": pre_obs["snapshot_id"],
                "pre_static_texts": pre_obs["static_texts"],
                "verified": False,
                "uncertain_side_effect": False,
                "timings_ms": {
                    "observe_ms": obs_ms,
                    "provider_ms": 0.0,
                    "dispatch_ms": 0.0,
                    "verify_ms": 0.0,
                    "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                },
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)

        # Stage 2: Build / validate closed candidate table bound to fresh observation
        try:
            bound_candidates = build_bound_candidates(
                args.get("candidates"),
                pre_obs,
                action_value=action_value,
            )
            history_in = args.get("history")
            if history_in is None:
                history_in = [
                    {"selected_id": h["selected_id"], "outcome": h["status"]}
                    for h in self.accounting.history_log[-MAX_HISTORY:]
                    if isinstance(h.get("selected_id"), str) and isinstance(h.get("status"), str)
                ]
            referenced_el_ids = {
                c["arguments"]["element_index"]
                for c in bound_candidates
                if isinstance(c.get("arguments"), Mapping) and isinstance(c["arguments"].get("element_index"), int)
            }
            all_els = pre_obs.get("all_elements") or pre_obs["elements"]
            prompt_els: list[Mapping[str, Any]] = [
                e for e in all_els if e.get("element_index") in referenced_el_ids
            ][:MAX_ELEMENTS]
            seen_prompt_ids = {e["element_index"] for e in prompt_els}
            for e in pre_obs["elements"]:
                if len(prompt_els) >= MAX_ELEMENTS:
                    break
                if e["element_index"] not in seen_prompt_ids:
                    prompt_els.append(e)
                    seen_prompt_ids.add(e["element_index"])
            select_req = validate_select_request({
                "goal": goal,
                "pid": pid,
                "window_id": window_id,
                "snapshot_id": pre_obs["snapshot_id"],
                "elements": [
                    {
                        "element_index": e["element_index"],
                        "role": e["role"],
                        "label": e["label"],
                        "state": e["state"],
                        "depth": e.get("depth", 1),
                        "in_toolbar": bool(e.get("in_toolbar", False)),
                    }
                    for e in prompt_els
                ],
                "history": history_in,
                "candidates": [{"id": c["id"], "description": c["description"]} for c in bound_candidates],
            })
        except Exception as exc:
            release_if_unowned()
            payload = {
                "schema": "agy_cua.jev_step_v1",
                "status": "candidate_refused",
                "verification_outcome": "not_executed",
                "reason": str(exc),
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "pre_snapshot_id": pre_obs["snapshot_id"],
                "pre_static_texts": pre_obs["static_texts"],
                **obs_disclosure,
                "verified": False,
                "uncertain_side_effect": False,
                "timings_ms": {
                    "observe_ms": obs_ms,
                    "provider_ms": 0.0,
                    "dispatch_ms": 0.0,
                    "verify_ms": 0.0,
                    "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                },
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)

        # Stage 3: Jev bounded candidate selection or deterministic single-candidate validation
        if mode == "deterministic":
            only_cand = bound_candidates[0]
            decision = {
                "schema": "agy_cua.jev_decision_v1",
                "kind": "selected",
                "reason": None,
                "pid": pid,
                "window_id": window_id,
                "snapshot_id": pre_obs["snapshot_id"],
                "selected_id": only_cand["id"],
                "requested_model": "deterministic-controller",
                "returned_model": "deterministic-controller",
                "sdk_identity": CLIENT_IDENTITY,
                "route": "deterministic",
                "confidence": 1.0,
                "probabilities": {only_cand["id"]: 1.0, "reobserve": 0.0, "abstain": 0.0},
                "provider_ms": 0.0,
                "accounting": self.accounting.to_dict(),
            }
            provider_ms = 0.0
        else:
            route = resolve_route(self.env, self.keychain_reader)
            if _deadline_monotonic is not None:
                rem_ms = int((_deadline_monotonic - time.monotonic()) * 1000)
                if rem_ms <= 0:
                    release_if_unowned()
                    payload = {
                        "schema": "agy_cua.jev_step_v1",
                        "status": "batch_timeout",
                        "verification_outcome": "not_executed",
                        "reason": "batch deadline exceeded before Jev selection",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                        "pre_snapshot_id": pre_obs["snapshot_id"],
                        "verified": False,
                        "uncertain_side_effect": False,
                        "timings_ms": {
                            "observe_ms": obs_ms,
                            "provider_ms": 0.0,
                            "dispatch_ms": 0.0,
                            "verify_ms": 0.0,
                            "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                        },
                        "accounting": self.accounting.to_dict(),
                    }
                    self._record_trace(payload)
                    return _format_tool_result(payload, is_error=True)
                if rem_ms < route.timeout_ms:
                    route = JevRoute(
                        kind=route.kind,
                        reason=route.reason,
                        endpoint=route.endpoint,
                        model=route.model,
                        api_key=route.api_key,
                        key_source=route.key_source,
                        timeout_ms=max(1, rem_ms),
                        note=route.note,
                    )
            decision = evaluate_jev_choice(select_req, route, self.accounting, self.http_post)
            provider_ms = decision.get("provider_ms", 0.0)

        if decision["kind"] != "selected":
            release_if_unowned()
            payload = {
                "schema": "agy_cua.jev_step_v1",
                "status": decision["kind"],
                "verification_outcome": "not_executed",
                "reason": decision.get("reason") or decision["kind"],
                "note": decision.get("note"),
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "pre_snapshot_id": pre_obs["snapshot_id"],
                "pre_static_texts": pre_obs["static_texts"],
                **obs_disclosure,
                "selected_id": decision.get("selected_id"),
                "requested_model": decision.get("requested_model"),
                "returned_model": decision.get("returned_model"),
                "sdk_identity": CLIENT_IDENTITY,
                "confidence": decision.get("confidence"),
                "probabilities": decision.get("probabilities"),
                "verified": False,
                "uncertain_side_effect": False,
                "timings_ms": {
                    "observe_ms": obs_ms,
                    "provider_ms": provider_ms,
                    "dispatch_ms": 0.0,
                    "verify_ms": 0.0,
                    "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                },
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=(decision["kind"] == "error"))

        # Stage 4: Local controller authorization & background Driver dispatch
        try:
            authorized = authorize_candidate_dispatch(
                decision,
                bound_candidates,
                expected_pid=pid,
                expected_window_id=window_id,
                current_snapshot_id=pre_obs["snapshot_id"],
                valid_element_indices=pre_obs["indexed_element_ids"],
                observation=pre_obs,
            )
        except Exception as exc:
            release_if_unowned()
            payload = {
                "schema": "agy_cua.jev_step_v1",
                "status": "authorization_refused",
                "verification_outcome": "not_executed",
                "reason": str(exc),
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "pre_snapshot_id": pre_obs["snapshot_id"],
                **obs_disclosure,
                "selected_id": decision.get("selected_id"),
                "returned_model": decision.get("returned_model"),
                "confidence": decision.get("confidence"),
                "probabilities": decision.get("probabilities"),
                "verified": False,
                "uncertain_side_effect": False,
                "timings_ms": {
                    "observe_ms": obs_ms,
                    "provider_ms": provider_ms,
                    "dispatch_ms": 0.0,
                    "verify_ms": 0.0,
                    "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                },
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)

        target_el_idx = authorized["arguments"].get("element_index")
        driver_args = {
            k: v
            for k, v in authorized["arguments"].items()
            if k not in {"element_index", "snapshot_id"}
        }
        if target_el_idx is not None:
            driver_args["element_token"] = f"{pre_obs['snapshot_id']}:{target_el_idx}"
        if authorized["tool"] == "set_value":
            driver_args.pop("delivery_mode", None)
        sanitized_args = {
            k: ("<redacted>" if k in {"text", "value"} else v)
            for k, v in driver_args.items()
        }
        try:
            dispatch_timeout_s = remaining_timeout_s(driver.timeout_ms / 1000.0)
        except TimeoutError as exc:
            release_if_unowned()
            payload = {
                "schema": "agy_cua.jev_step_v1",
                "status": "batch_timeout",
                "verification_outcome": "not_executed",
                "reason": str(exc),
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "pre_snapshot_id": pre_obs["snapshot_id"],
                "selected_id": authorized["id"],
                "returned_model": decision.get("returned_model"),
                "confidence": decision.get("confidence"),
                "probabilities": decision.get("probabilities"),
                "verified": False,
                "uncertain_side_effect": False,
                "timings_ms": {
                    "observe_ms": obs_ms,
                    "provider_ms": provider_ms,
                    "dispatch_ms": 0.0,
                    "verify_ms": 0.0,
                    "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                },
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)

        dispatch_started = time.perf_counter()
        try:
            dispatch_res = driver.call_tool(
                authorized["tool"],
                driver_args,
                timeout_s=dispatch_timeout_s,
                deadline_monotonic=_deadline_monotonic,
            )
            dispatch_text = "".join(
                c.get("text", "") for c in (dispatch_res.get("content") or []) if isinstance(c, Mapping)
            ).strip()
            if dispatch_res.get("isError"):
                raise RuntimeError(dispatch_text or "Driver tool returned isError=true")
        except Exception as exc:
            dispatch_ms = round((time.perf_counter() - dispatch_started) * 1000, 2)
            # Retain ambiguous/failed side-effect and halt automatic repetition
            self.accounting.uncertain_side_effects += 1
            self.accounting.halted = True
            self.accounting.halt_reason = "uncertain_dispatch_side_effect"
            payload = {
                "schema": "agy_cua.jev_step_v1",
                "status": "dispatch_failed",
                "verification_outcome": "outcome_unknown",
                "reason": str(exc),
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "pre_snapshot_id": pre_obs["snapshot_id"],
                **obs_disclosure,
                "selected_id": authorized["id"],
                "dispatched_tool": authorized["tool"],
                "dispatched_arguments": sanitized_args,
                "returned_model": decision.get("returned_model"),
                "confidence": decision.get("confidence"),
                "probabilities": decision.get("probabilities"),
                "verified": False,
                "uncertain_side_effect": True,
                "timings_ms": {
                    "observe_ms": obs_ms,
                    "provider_ms": provider_ms,
                    "dispatch_ms": dispatch_ms,
                    "verify_ms": 0.0,
                    "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                },
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)
        dispatch_ms = round((time.perf_counter() - dispatch_started) * 1000, 2)
        safe_receipt = "<redacted>" if authorized["tool"] in {"type_text", "set_value"} else dispatch_text

        # Stage 5: Fresh observation & independent postcondition verification
        expected_post = args.get("expected_postcondition")
        verify_started = time.perf_counter()
        try:
            post_obs_args: dict[str, Any] = {
                "pid": pid,
                "window_id": window_id,
                "include_screenshot": False,
                "tree_format": "both",
            }
            if query_val is not None:
                post_obs_args["query"] = query_val
            if max_depth_val is not None:
                post_obs_args["max_depth"] = max_depth_val
            if max_elements_val is not None:
                post_obs_args["max_elements"] = max_elements_val
            if walk_timeout_ms_val is not None:
                post_obs_args["timeout_ms"] = walk_timeout_ms_val
            raw_post = driver.call_tool(
                "get_window_state",
                post_obs_args,
                timeout_s=obs_call_timeout_s(driver),
                deadline_monotonic=_deadline_monotonic,
            )
            if raw_post.get("isError"):
                err_txt = "".join(c.get("text", "") for c in (raw_post.get("content") or []) if isinstance(c, Mapping))
                raise RuntimeError(err_txt or "post-dispatch get_window_state returned isError=true")
            post_obs = extract_window_observation(raw_post, expected_pid=pid, expected_window_id=window_id)
            state_changed, post_ok, verify_reason = check_postcondition(
                expected_post,
                pre_obs,
                post_obs,
                target_element_index=target_el_idx,
            )
        except Exception as exc:
            verify_ms = round((time.perf_counter() - verify_started) * 1000, 2)
            self.accounting.uncertain_side_effects += 1
            self.accounting.halted = True
            self.accounting.halt_reason = "uncertain_verification_after_dispatch"
            payload = {
                "schema": "agy_cua.jev_step_v1",
                "status": "verification_failed",
                "verification_outcome": "outcome_unknown",
                "reason": str(exc),
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "pre_snapshot_id": pre_obs["snapshot_id"],
                **obs_disclosure,
                "selected_id": authorized["id"],
                "dispatched_tool": authorized["tool"],
                "dispatch_receipt": safe_receipt,
                "returned_model": decision.get("returned_model"),
                "confidence": decision.get("confidence"),
                "probabilities": decision.get("probabilities"),
                "verified": False,
                "uncertain_side_effect": True,
                "timings_ms": {
                    "observe_ms": obs_ms,
                    "provider_ms": provider_ms,
                    "dispatch_ms": dispatch_ms,
                    "verify_ms": verify_ms,
                    "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                },
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)
        verify_ms = round((time.perf_counter() - verify_started) * 1000, 2)

        self._update_target_snapshot(pid, window_id, post_obs["snapshot_id"])
        if _out_post_sig is not None:
            _out_post_sig.append(_obs_state_signature(post_obs))
        if _out_post_obs is not None:
            _out_post_obs.append(post_obs)

        if expected_post is None:
            verification_outcome = "state_changed" if state_changed else "dispatched"
            step_status = verification_outcome
            is_err = False
        elif post_ok:
            verification_outcome = "goal_verified"
            step_status = "verified"
            is_err = False
        else:
            verification_outcome = "state_changed" if state_changed else "dispatched"
            step_status = "postcondition_unmet"
            is_err = True

        post_obs_disclosure = {
            **obs_disclosure,
            "pre_observation_truncated": pre_obs["observation_truncated"],
            "post_total_actionable_elements": post_obs["total_actionable_elements"],
            "post_omitted_elements_count": post_obs["omitted_elements_count"],
            "post_omitted_candidates_count": post_obs["omitted_candidates_count"],
            "post_observation_truncated": post_obs["observation_truncated"],
            "observation_truncated": bool(
                pre_obs["observation_truncated"] or post_obs["observation_truncated"]
            ),
        }

        payload = {
            "schema": "agy_cua.jev_step_v1",
            "status": step_status,
            "verification_outcome": verification_outcome,
            "verified": post_ok,
            "uncertain_side_effect": False,
            "verification_reason": verify_reason,
            "state_changed": state_changed,
            "pid": pid,
            "window_id": window_id,
            "session_id": self.session_id,
            "mode": mode,
            "pre_snapshot_id": pre_obs["snapshot_id"],
            "post_snapshot_id": post_obs["snapshot_id"],
            "pre_static_texts": pre_obs["static_texts"],
            "post_static_texts": post_obs["static_texts"],
            **post_obs_disclosure,
            "selected_id": authorized["id"],
            "selected_description": authorized["description"],
            "dispatched_tool": authorized["tool"],
            "dispatched_arguments": sanitized_args,
            "dispatch_receipt": safe_receipt,
            "requested_model": decision.get("requested_model"),
            "returned_model": decision.get("returned_model"),
            "sdk_identity": CLIENT_IDENTITY,
            "route": decision.get("route"),
            "confidence": decision.get("confidence"),
            "probabilities": decision.get("probabilities"),
            "timings_ms": {
                "observe_ms": obs_ms,
                "provider_ms": provider_ms,
                "dispatch_ms": dispatch_ms,
                "verify_ms": verify_ms,
                "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
            },
            "accounting": self.accounting.to_dict(),
        }
        self._record_trace(payload)
        return _format_tool_result(payload, is_error=is_err)

    def handle_batch(self, args: Mapping[str, Any]) -> dict[str, Any]:
        batch_started = time.perf_counter()
        if not isinstance(args, Mapping):
            return _format_tool_result(
                {"schema": "agy_cua.jev_batch_v1", "status": "refused", "reason": "invalid_arguments"},
                is_error=True,
            )

        raw_steps = args.get("steps")
        steps_list = raw_steps if isinstance(raw_steps, list) else []

        def format_remaining(start_idx: int) -> list[dict[str, Any]]:
            rem: list[dict[str, Any]] = []
            for idx in range(start_idx, len(steps_list)):
                item = steps_list[idx]
                if isinstance(item, Mapping):
                    rem.append({
                        "step_index": idx,
                        "goal": item.get("goal"),
                        "mode": item.get("mode", "jev"),
                        "expected_postcondition": item.get("expected_postcondition"),
                    })
                else:
                    rem.append({"step_index": idx})
            return rem

        if self.accounting.halted:
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_batch_v1",
                    "status": "halted",
                    "verification_outcome": "not_executed",
                    "reason": self.accounting.halt_reason or "session_halted",
                    "verified": False,
                    "uncertain_side_effect": False,
                    "session_id": self.session_id,
                    "total_steps": len(steps_list),
                    "completed_count": 0,
                    "completed_steps": [],
                    "failed_step": None,
                    "remaining_steps": format_remaining(0),
                    "accounting": self.accounting.to_dict(),
                },
                is_error=True,
            )

        pid = args.get("pid")
        window_id = args.get("window_id")
        if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
            return _format_tool_result(
                {"schema": "agy_cua.jev_batch_v1", "status": "refused", "reason": "invalid_pid"},
                is_error=True,
            )
        if not isinstance(window_id, int) or isinstance(window_id, bool) or window_id <= 0:
            return _format_tool_result(
                {"schema": "agy_cua.jev_batch_v1", "status": "refused", "reason": "invalid_window_id"},
                is_error=True,
            )
        if not isinstance(raw_steps, list) or len(raw_steps) < 1 or len(raw_steps) > MAX_BATCH_STEPS:
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_batch_v1",
                    "status": "refused",
                    "reason": f"steps must be a non-empty list of at most {MAX_BATCH_STEPS} steps",
                    "pid": pid,
                    "window_id": window_id,
                    "session_id": self.session_id,
                },
                is_error=True,
            )

        if "chain_observations" in args and args["chain_observations"] is not None:
            if not isinstance(args["chain_observations"], bool):
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_batch_v1",
                        "status": "refused",
                        "reason": "invalid_chain_observations",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                    },
                    is_error=True,
                )

        initial_expected_snap = args.get("expected_snapshot_id")
        if initial_expected_snap is not None and (
            not isinstance(initial_expected_snap, str) or not SNAPSHOT_ID_RE.match(initial_expected_snap)
        ):
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_batch_v1",
                    "status": "refused",
                    "reason": "invalid_expected_snapshot_id",
                    "pid": pid,
                    "window_id": window_id,
                    "session_id": self.session_id,
                },
                is_error=True,
            )

        # Upfront validation of every step in the batch before executing step 0
        for idx, step_spec in enumerate(raw_steps):
            if not isinstance(step_spec, Mapping):
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_batch_v1",
                        "status": "refused",
                        "reason": f"step[{idx}] must be an object",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                    },
                    is_error=True,
                )
            s_goal = step_spec.get("goal")
            if not isinstance(s_goal, str) or not s_goal.strip():
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_batch_v1",
                        "status": "refused",
                        "reason": f"step[{idx}] missing valid goal",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                    },
                    is_error=True,
                )
            if "value" in step_spec and step_spec["value"] is not None:
                if not isinstance(step_spec["value"], str):
                    return _format_tool_result(
                        {
                            "schema": "agy_cua.jev_batch_v1",
                            "status": "refused",
                            "reason": f"step[{idx}] invalid value",
                            "pid": pid,
                            "window_id": window_id,
                            "session_id": self.session_id,
                        },
                        is_error=True,
                    )
            s_snap = step_spec.get("expected_snapshot_id")
            if s_snap is not None and (not isinstance(s_snap, str) or not SNAPSHOT_ID_RE.match(s_snap)):
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_batch_v1",
                        "status": "refused",
                        "reason": f"step[{idx}] invalid expected_snapshot_id",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                    },
                    is_error=True,
                )
            s_mode = str(step_spec.get("mode") or ("deterministic" if step_spec.get("deterministic") is True else "jev")).strip()
            if s_mode not in {"jev", "deterministic"}:
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_batch_v1",
                        "status": "refused",
                        "reason": f"step[{idx}] invalid mode={s_mode!r}",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                    },
                    is_error=True,
                )
            if "query" in step_spec and step_spec["query"] is not None:
                s_q = step_spec["query"]
                if not isinstance(s_q, str) or not s_q.strip():
                    return _format_tool_result(
                        {
                            "schema": "agy_cua.jev_batch_v1",
                            "status": "refused",
                            "reason": f"step[{idx}] invalid query",
                            "pid": pid,
                            "window_id": window_id,
                            "session_id": self.session_id,
                        },
                        is_error=True,
                    )
            if "max_depth" in step_spec and step_spec["max_depth"] is not None:
                s_d = step_spec["max_depth"]
                if (
                    not isinstance(s_d, int)
                    or isinstance(s_d, bool)
                    or s_d < MIN_OBSERVE_MAX_DEPTH
                    or s_d > MAX_OBSERVE_MAX_DEPTH
                ):
                    return _format_tool_result(
                        {
                            "schema": "agy_cua.jev_batch_v1",
                            "status": "refused",
                            "reason": f"step[{idx}] invalid max_depth",
                            "pid": pid,
                            "window_id": window_id,
                            "session_id": self.session_id,
                        },
                        is_error=True,
                    )
            if "max_elements" in step_spec and step_spec["max_elements"] is not None:
                s_max_el = step_spec["max_elements"]
                if (
                    not isinstance(s_max_el, int)
                    or isinstance(s_max_el, bool)
                    or s_max_el < MIN_OBSERVE_MAX_ELEMENTS
                    or s_max_el > MAX_OBSERVE_MAX_ELEMENTS
                ):
                    return _format_tool_result(
                        {
                            "schema": "agy_cua.jev_batch_v1",
                            "status": "refused",
                            "reason": "invalid_max_elements",
                            "step_index": idx,
                            "pid": pid,
                            "window_id": window_id,
                            "session_id": self.session_id,
                        },
                        is_error=True,
                    )
            if "walk_timeout_ms" in step_spec and step_spec["walk_timeout_ms"] is not None:
                s_walk_to = step_spec["walk_timeout_ms"]
                if (
                    not isinstance(s_walk_to, int)
                    or isinstance(s_walk_to, bool)
                    or s_walk_to < MIN_OBSERVE_WALK_TIMEOUT_MS
                    or s_walk_to > MAX_OBSERVE_WALK_TIMEOUT_MS
                ):
                    return _format_tool_result(
                        {
                            "schema": "agy_cua.jev_batch_v1",
                            "status": "refused",
                            "reason": "invalid_walk_timeout_ms",
                            "step_index": idx,
                            "pid": pid,
                            "window_id": window_id,
                            "session_id": self.session_id,
                        },
                        is_error=True,
                    )
            s_cands = step_spec.get("candidates")
            if s_cands is not None and (
                not isinstance(s_cands, list) or len(s_cands) == 0 or len(s_cands) > MAX_AUTO_CANDIDATES
            ):
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_batch_v1",
                        "status": "refused",
                        "verification_outcome": "not_executed",
                        "reason": f"step[{idx}] candidates must be a non-empty list of at most {MAX_AUTO_CANDIDATES} items",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                    },
                    is_error=True,
                )
            if s_mode == "deterministic" and (not isinstance(s_cands, list) or len(s_cands) != 1):
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_batch_v1",
                        "status": "refused",
                        "reason": f"step[{idx}] deterministic mode requires a single candidate",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                    },
                    is_error=True,
                )
            has_el_cand = True
            if isinstance(s_cands, list):
                has_el_cand = bool(s_cands) and all(
                    isinstance(c, Mapping)
                    and (
                        "element_index" in c
                        or "element_token" in c
                        or (
                            isinstance(c.get("arguments"), Mapping)
                            and ("element_index" in c["arguments"] or "element_token" in c["arguments"])
                        )
                    )
                    for c in s_cands
                )
            post_err = _validate_batch_postcondition_spec(step_spec.get("expected_postcondition"), has_el_cand)
            if post_err is not None:
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_batch_v1",
                        "status": "refused",
                        "verification_outcome": "not_executed",
                        "reason": f"step[{idx}] invalid expected_postcondition: {post_err}",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                        "verified": False,
                        "uncertain_side_effect": False,
                        "total_steps": len(raw_steps),
                        "completed_count": 0,
                        "completed_steps": [],
                        "failed_step": None,
                        "remaining_steps": format_remaining(0),
                        "accounting": self.accounting.to_dict(),
                    },
                    is_error=True,
                )

        was_owned = (pid, window_id) in self._owned_targets
        conflict = self._acquire_target(pid, window_id)
        if conflict is not None:
            payload = {
                "schema": "agy_cua.jev_batch_v1",
                "status": "target_conflict",
                "verification_outcome": "not_executed",
                "reason": conflict,
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "verified": False,
                "uncertain_side_effect": False,
                "total_steps": len(raw_steps),
                "completed_count": 0,
                "completed_steps": [],
                "failed_step": None,
                "remaining_steps": format_remaining(0),
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)

        raw_timeout = (
            args["timeout_ms"]
            if "timeout_ms" in args and args["timeout_ms"] is not None
            else self.env.get("AGY_CUA_BATCH_TIMEOUT_MS")
        )
        batch_timeout_ms = clamp_batch_timeout_ms(raw_timeout)
        batch_deadline = time.monotonic() + (batch_timeout_ms / 1000.0)
        allow_drift = bool(args.get("allow_interstep_drift", False))
        chain_obs = bool(args.get("chain_observations", False))
        chain_effective = chain_obs and allow_drift

        completed_steps: list[dict[str, Any]] = []
        failed_step: dict[str, Any] | None = None
        remaining_steps: list[dict[str, Any]] = []
        prev_post_sig: tuple[Any, ...] | None = None
        prev_post_obs: dict[str, Any] | None = None
        prev_obs_scope: tuple[str | None, int | None, int | None, int | None] | None = None

        agg_observe_ms = 0.0
        agg_provider_ms = 0.0
        agg_dispatch_ms = 0.0
        agg_verify_ms = 0.0

        for idx, step_spec in enumerate(raw_steps):
            if time.monotonic() >= batch_deadline:
                failed_step = {
                    "step_index": idx,
                    "goal": step_spec.get("goal"),
                    "mode": step_spec.get("mode", "jev"),
                    "status": "batch_timeout",
                    "verification_outcome": "not_executed",
                    "verified": False,
                    "uncertain_side_effect": False,
                    "reason": f"batch_timeout_exceeded ({batch_timeout_ms} ms)",
                }
                remaining_steps = format_remaining(idx + 1)
                break

            step_args: dict[str, Any] = {
                "goal": step_spec["goal"],
                "pid": pid,
                "window_id": window_id,
                "expected_postcondition": step_spec["expected_postcondition"],
            }
            if "value" in step_spec and step_spec["value"] is not None:
                step_args["value"] = step_spec["value"]
            if "mode" in step_spec:
                step_args["mode"] = step_spec["mode"]
            if "deterministic" in step_spec:
                step_args["deterministic"] = step_spec["deterministic"]
            if "query" in step_spec and step_spec["query"] is not None:
                step_args["query"] = step_spec["query"]
            if "max_depth" in step_spec and step_spec["max_depth"] is not None:
                step_args["max_depth"] = step_spec["max_depth"]
            if "max_elements" in step_spec and step_spec["max_elements"] is not None:
                step_args["max_elements"] = step_spec["max_elements"]
            if "walk_timeout_ms" in step_spec and step_spec["walk_timeout_ms"] is not None:
                step_args["walk_timeout_ms"] = step_spec["walk_timeout_ms"]
            if "candidates" in step_spec:
                step_args["candidates"] = step_spec["candidates"]
            if "expected_snapshot_id" in step_spec:
                step_args["expected_snapshot_id"] = step_spec["expected_snapshot_id"]
            elif idx == 0 and initial_expected_snap is not None:
                step_args["expected_snapshot_id"] = initial_expected_snap

            curr_obs_scope = (
                step_spec["query"].strip() if isinstance(step_spec.get("query"), str) else None,
                step_spec.get("max_depth"),
                step_spec.get("max_elements"),
                step_spec.get("walk_timeout_ms"),
            )
            out_sig: list[tuple[Any, ...]] = []
            out_obs: list[dict[str, Any]] = []
            # A chained pre-observation IS step k's post-observation, so comparing its signature to
            # prev_post_sig is vacuous. Only reuse it when the caller has explicitly accepted interstep
            # drift; with drift protection on, take a fresh read so external changes are detected.
            use_chained_obs = (
                prev_post_obs
                if (chain_effective and prev_post_obs is not None and prev_obs_scope == curr_obs_scope)
                else None
            )
            summary_chained = use_chained_obs is not None
            step_res = self.handle_step(
                step_args,
                _deadline_monotonic=batch_deadline,
                _expected_pre_sig=(
                    None
                    if (allow_drift or prev_obs_scope != curr_obs_scope)
                    else prev_post_sig
                ),
                _out_post_sig=out_sig,
                _chained_obs=use_chained_obs,
                _out_post_obs=out_obs,
            )
            step_sc = step_res.get("structuredContent") or {}
            t_ms = step_sc.get("timings_ms") or {}
            agg_observe_ms = round(agg_observe_ms + float(t_ms.get("observe_ms", 0.0)), 2)
            agg_provider_ms = round(agg_provider_ms + float(t_ms.get("provider_ms", 0.0)), 2)
            agg_dispatch_ms = round(agg_dispatch_ms + float(t_ms.get("dispatch_ms", 0.0)), 2)
            agg_verify_ms = round(agg_verify_ms + float(t_ms.get("verify_ms", 0.0)), 2)

            summary_item = {
                "step_index": idx,
                "goal": step_spec["goal"],
                "mode": step_sc.get("mode", step_spec.get("mode", "jev")),
                "status": step_sc.get("status"),
                "verification_outcome": step_sc.get("verification_outcome"),
                "verified": bool(step_sc.get("verified")),
                "uncertain_side_effect": bool(step_sc.get("uncertain_side_effect")),
                "reason": step_sc.get("verification_reason") or step_sc.get("reason"),
                "pre_snapshot_id": step_sc.get("pre_snapshot_id"),
                "post_snapshot_id": step_sc.get("post_snapshot_id"),
                "pre_static_texts": step_sc.get("pre_static_texts"),
                "post_static_texts": step_sc.get("post_static_texts"),
                "selected_id": step_sc.get("selected_id"),
                "dispatched_tool": step_sc.get("dispatched_tool"),
                "dispatched_arguments": step_sc.get("dispatched_arguments"),
                "requested_model": step_sc.get("requested_model"),
                "returned_model": step_sc.get("returned_model"),
                "sdk_identity": step_sc.get("sdk_identity"),
                "confidence": step_sc.get("confidence"),
                "observation_chained": summary_chained,
                "timings_ms": t_ms,
            }

            if step_sc.get("status") == "verified" and step_sc.get("verification_outcome") == "goal_verified":
                completed_steps.append(summary_item)
                prev_post_sig = out_sig[0] if out_sig else None
                prev_post_obs = out_obs[0] if out_obs else None
                prev_obs_scope = curr_obs_scope
            else:
                failed_step = summary_item
                remaining_steps = format_remaining(idx + 1)
                break

        if (
            not was_owned
            and not completed_steps
            and (failed_step or {}).get("verification_outcome") == "not_executed"
        ):
            self._release_single_target(pid, window_id)

        all_verified = failed_step is None and len(completed_steps) == len(raw_steps)
        uncertain = bool(failed_step and failed_step.get("uncertain_side_effect"))
        batch_status = "verified" if all_verified else str((failed_step or {}).get("status") or "batch_failed")
        batch_outcome = (
            "goal_verified"
            if all_verified
            else str((failed_step or {}).get("verification_outcome") or "not_executed")
        )
        first_pre_snap = (
            completed_steps[0].get("pre_snapshot_id")
            if completed_steps
            else (failed_step or {}).get("pre_snapshot_id")
        )
        last_post_snap = (
            completed_steps[-1].get("post_snapshot_id")
            if all_verified and completed_steps
            else (failed_step or {}).get("post_snapshot_id")
        )
        last_post_texts = (
            completed_steps[-1].get("post_static_texts")
            if all_verified and completed_steps
            else (
                (failed_step or {}).get("post_static_texts")
                or (completed_steps[-1].get("post_static_texts") if completed_steps else [])
            )
        )
        step_models = [
            s.get("returned_model")
            for s in (completed_steps + ([failed_step] if failed_step else []))
            if isinstance(s.get("returned_model"), str)
        ]
        batch_model = PINNED_JEV_MODEL if PINNED_JEV_MODEL in step_models else (step_models[-1] if step_models else None)

        batch_payload = {
            "schema": "agy_cua.jev_batch_v1",
            "status": batch_status,
            "verification_outcome": batch_outcome,
            "verified": all_verified,
            "all_verified": all_verified,
            "goal_verified": all_verified,
            "chain_observations_effective": chain_effective,
            "uncertain_side_effect": uncertain,
            "pid": pid,
            "window_id": window_id,
            "session_id": self.session_id,
            "pre_snapshot_id": first_pre_snap,
            "post_snapshot_id": last_post_snap,
            "post_static_texts": list(last_post_texts or []),
            "selected_ids": [s["selected_id"] for s in completed_steps if isinstance(s.get("selected_id"), str)],
            "returned_model": batch_model,
            "sdk_identity": CLIENT_IDENTITY,
            "total_steps": len(raw_steps),
            "completed_count": len(completed_steps),
            "completed_steps": completed_steps,
            "failed_step": failed_step,
            "remaining_steps": remaining_steps,
            "halted_at_step_index": None if all_verified else (failed_step or {}).get("step_index"),
            "steps": completed_steps + ([failed_step] if failed_step else []),
            "timings_ms": {
                "observe_ms": agg_observe_ms,
                "provider_ms": agg_provider_ms,
                "dispatch_ms": agg_dispatch_ms,
                "verify_ms": agg_verify_ms,
                "total_ms": round((time.perf_counter() - batch_started) * 1000, 2),
            },
            "accounting": self.accounting.to_dict(),
        }
        self._record_trace(batch_payload)
        return _format_tool_result(batch_payload, is_error=(not all_verified))

    def handle_sequence(self, args: Mapping[str, Any]) -> dict[str, Any]:
        if not isinstance(args, Mapping):
            return self.handle_batch(args)
        seq_args = dict(args)
        seq_args.setdefault("chain_observations", True)
        return self.handle_batch(seq_args)

    def handle_message(self, message: Any) -> dict[str, Any] | None:
        if not isinstance(message, Mapping):
            return {"jsonrpc": "2.0", "id": None, "error": {"code": -32600, "message": "Invalid Request"}}
        req_id = message.get("id")
        is_request = "id" in message and req_id is not None
        method = message.get("method")
        params = message.get("params") if isinstance(message.get("params"), Mapping) else {}

        def reply(result: Any) -> dict[str, Any] | None:
            return {"jsonrpc": "2.0", "id": req_id, "result": result} if is_request else None

        def fail(code: int, text: str) -> dict[str, Any] | None:
            return {"jsonrpc": "2.0", "id": req_id, "error": {"code": code, "message": text}} if is_request else None

        if method == "initialize":
            return reply({
                "protocolVersion": params.get("protocolVersion") or DEFAULT_PROTOCOL,
                "capabilities": {"tools": {}},
                "serverInfo": SERVER_INFO,
            })
        if method == "ping":
            return reply({})
        if method == "tools/list":
            return reply({"tools": TOOLS})
        if method == "resources/list":
            return reply({"resources": []})
        if method == "resources/templates/list":
            return reply({"resourceTemplates": []})
        if method == "prompts/list":
            return reply({"prompts": []})
        if method == "tools/call":
            name = params.get("name")
            arguments = params.get("arguments") if isinstance(params.get("arguments"), Mapping) else {}
            if name == "jev_status":
                route = resolve_route(self.env, self.keychain_reader)
                status_payload = describe_status(route, self.accounting, self.env)
                status_payload["session_id"] = self.session_id
                return reply(_format_tool_result(status_payload))
            if name == "jev_select_action":
                try:
                    validated = validate_select_request(arguments)
                except ValueError as exc:
                    err_payload = {
                        "schema": "agy_cua.jev_decision_v1",
                        "kind": "error",
                        "reason": "invalid_request",
                        "note": str(exc),
                        "accounting": self.accounting.to_dict(),
                    }
                    self._record_trace(err_payload)
                    return reply(_format_tool_result(err_payload, is_error=True))
                route = resolve_route(self.env, self.keychain_reader)
                decision = evaluate_jev_choice(validated, route, self.accounting, self.http_post)
                self._record_trace(decision)
                return reply(_format_tool_result(decision, is_error=(decision["kind"] == "error")))
            if name == "jev_step":
                return reply(self.handle_step(arguments))
            if name in {"jev_batch", "jev_run_steps"}:
                return reply(self.handle_batch(arguments))
            if name == "jev_sequence":
                return reply(self.handle_sequence(arguments))
            return fail(-32602, f"Unknown tool: {name}")
        if isinstance(method, str) and method.startswith("notifications/"):
            return None
        return fail(-32601, f"Method not found: {method}")

    def close(self) -> None:
        if self._closed:
            return
        self._closed = True
        self._release_targets()
        if self._driver_client is not None:
            self._driver_client.close()


def main(argv: list[str] | None = None) -> int:
    args = argv if argv is not None else sys.argv[1:]
    server = JevMcpServer()
    if args == ["--check"]:
        route = resolve_route(server.env, server.keychain_reader)
        sys.stdout.write(json.dumps(describe_status(route, server.accounting, server.env), indent=2) + "\n")
        return 0 if route.kind != "none" else 1
    if args == ["--probe"]:
        route = resolve_route(server.env, server.keychain_reader)
        req = validate_select_request({
            "goal": "Click button 7",
            "pid": 1,
            "window_id": 1,
            "snapshot_id": "s00000001",
            "elements": [{"element_index": 5, "role": "AXButton", "label": "7", "state": "enabled"}],
            "candidates": [{"id": "ax.5.7", "description": 'Click [5] AXButton "7"'}],
        })
        decision = evaluate_jev_choice(req, route, server.accounting, server.http_post)
        sys.stdout.write(json.dumps(decision, indent=2) + "\n")
        return 0 if decision.get("kind") == "selected" and decision.get("selected_id") == "ax.5.7" else 1
    if args:
        sys.stderr.write("usage: agy-cua-jev-mcp [--check | --probe]\n")
        return 2

    for signum in (signal.SIGTERM, signal.SIGINT):
        signal.signal(signum, lambda *_: (server.close(), sys.exit(0)))

    try:
        while raw_bytes := sys.stdin.buffer.readline():
            line = raw_bytes.decode("utf-8", errors="replace").strip()
            if not line:
                continue
            try:
                msg = json.loads(line)
            except ValueError:
                sys.stdout.write(
                    json.dumps({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "Parse error"}})
                    + "\n"
                )
                sys.stdout.flush()
                continue
            resp = server.handle_message(msg)
            if resp is not None:
                sys.stdout.write(json.dumps(resp, ensure_ascii=False) + "\n")
                sys.stdout.flush()
    finally:
        server.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
