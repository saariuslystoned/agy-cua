def _is_retryable_postcondition_reason(reason: str) -> bool:
    if not isinstance(reason, str) or not reason:
        return False
    return (
        reason.startswith("expected ")
        or reason.startswith("target_element_missing: ")
        or reason.startswith("target_ref_missing_in_post_obs:")
        or reason.startswith("static_text_index_out_of_range")
    )


def _should_rerank_decision(decision: Mapping[str, Any], candidate_count: int) -> bool:
    if decision.get("kind") != "selected" or candidate_count <= V2_RERANK_SHORTLIST_K:
        return False
    raw_conf = decision.get("confidence")
    if isinstance(raw_conf, bool) or not isinstance(raw_conf, (int, float)):
        return False
    return 0.0 <= float(raw_conf) < V2_RERANK_CONFIDENCE_THRESHOLD


def _build_rerank_goal(goal: str, suffix: str) -> str:
    budget = MAX_GOAL_CHARS - len(suffix)
    if len(goal) <= budget:
        return f"{goal}{suffix}"
    if budget <= 0:
        return goal[:MAX_GOAL_CHARS]
    trimmed = goal[:budget].rstrip()
    return f"{trimmed}{suffix}" if trimmed else goal[:MAX_GOAL_CHARS]


def _format_tool_result(payload: Mapping[str, Any], is_error: bool = False) -> dict[str, Any]:
    summary_lines = [
        f"schema={payload.get('schema')} status={payload.get('status', payload.get('kind', 'ok'))}"
    ]
    if "verification_outcome" in payload:
        summary_lines[0] += f" verification_outcome={payload.get('verification_outcome')}"
    if "selected_id" in payload and payload.get("selected_id"):
        summary_lines.append(
            f"selected_id={payload.get('selected_id')} model={payload.get('returned_model')} "
            f"confidence={payload.get('confidence')}"
        )
    if "pre_snapshot_id" in payload or "post_snapshot_id" in payload:
        summary_lines.append(
            f"pre_snapshot_id={payload.get('pre_snapshot_id')} post_snapshot_id={payload.get('post_snapshot_id')} "
            f"verified={payload.get('verified')} post_static_texts={json.dumps(payload.get('post_static_texts', []), ensure_ascii=False)}"
        )
    if "total_actionable_elements" in payload:
        obs_line = (
            f"total_actionable_elements={payload.get('total_actionable_elements')} "
            f"omitted_elements_count={payload.get('omitted_elements_count')} "
            f"omitted_candidates_count={payload.get('omitted_candidates_count')} "
            f"observation_truncated={payload.get('observation_truncated')}"
        )
        if "post_observation_truncated" in payload:
            obs_line += (
                f" post_total_actionable_elements={payload.get('post_total_actionable_elements')} "
                f"post_omitted_elements_count={payload.get('post_omitted_elements_count')} "
                f"post_omitted_candidates_count={payload.get('post_omitted_candidates_count')} "
                f"post_observation_truncated={payload.get('post_observation_truncated')}"
            )
        summary_lines.append(obs_line)
    if "completed_count" in payload and "total_steps" in payload:
        summary_lines.append(
            f"completed={payload.get('completed_count')}/{payload.get('total_steps')} "
            f"verified={payload.get('verified')}"
        )
    if "timings_ms" in payload:
        summary_lines.append(f"timings_ms={json.dumps(payload['timings_ms'], sort_keys=True)}")
    summary_lines.append(json.dumps(payload, ensure_ascii=False, indent=2))
    return {
        "content": [{"type": "text", "text": "\n".join(summary_lines)}],
        "structuredContent": dict(payload),
        "isError": is_error,
    }


class JevMcpServer:
    def __init__(
        self,
        env: Mapping[str, str] = os.environ,
        keychain_reader: Callable[[str], str | None] = read_keychain_secret,
        http_post: Callable[[urllib.request.Request, float], tuple[int, str]] = _default_urlopen,
        driver_client: DriverClient | None = None,
    ) -> None:
        self.env = env
        self.keychain_reader = keychain_reader
        self.http_post = http_post
        self.session_id = resolve_session_id(env)
        self.v1_compat = is_v1_compat(env)
        self._driver_client_injected = driver_client is not None
        self.max_elements_cap = MAX_ELEMENTS if self.v1_compat else V2_MAX_ELEMENTS
        self.max_auto_candidates = MAX_AUTO_CANDIDATES if self.v1_compat else V2_MAX_AUTO_CANDIDATES
        self.max_candidates = MAX_CANDIDATES if self.v1_compat else V2_MAX_CANDIDATES
        self.max_json_bytes = MAX_JSON_BYTES if self.v1_compat else V2_MAX_JSON_BYTES
        self.accounting = SessionAccounting(max_calls=clamp_max_calls(env.get("AGY_CUA_JEV_MAX_CALLS")))
        self._driver_client = driver_client
        if self._driver_client is not None and not self._driver_client.session_id:
            self._driver_client.session_id = self.session_id
        self._closed = False
        self._owned_targets: set[tuple[int, int]] = set()
        self._last_observations: dict[tuple[int, int], dict[str, Any]] = {}
        self._window_token_cache: dict[tuple[int, int], dict[str, Any]] = {}
        self._visual_snapshots: dict[tuple[int, int], str] = {}
        self._visual_snapshot_targets: dict[str, tuple[int, int]] = {}
        self._snapshot_targets: dict[str, tuple[int, int]] = {}

    def _update_window_token_cache(self, pid: int, window_id: int, obs: Mapping[str, Any]) -> None:
        snap_id = obs.get("snapshot_id")
        if not isinstance(snap_id, str) or not SNAPSHOT_ID_RE.match(snap_id):
            return
        is_full_window = obs.get("native_root_element_token") is None
        secure_ids = set(obs.get("secure_element_ids") or ())
        el_tokens: dict[int, str] = {}
        if is_full_window:
            all_ids: set[int] = set(obs.get("indexed_element_ids") or ())
            for raw_e in (obs.get("_raw_elements") or []):
                if isinstance(raw_e, Mapping):
                    r_idx = raw_e.get("element_index")
                    if isinstance(r_idx, int) and not isinstance(r_idx, bool) and r_idx >= 0:
                        all_ids.add(r_idx)
            for e_idx in all_ids - secure_ids:
                el_tokens[e_idx] = f"{snap_id}:{e_idx}"
        self._window_token_cache[(pid, window_id)] = {
            "snapshot_id": snap_id,
            "is_full_window": is_full_window,
            "regions": [dict(r) for r in (obs.get("native_regions") or []) if isinstance(r, Mapping)],
            "element_tokens": el_tokens,
        }

    def _resolve_cached_root_token(
        self,
        pid: int,
        window_id: int,
        *,
        region: str | None,
        root_element_index: int | None,
    ) -> str | None:
        cache = self._window_token_cache.get((pid, window_id))
        if not isinstance(cache, Mapping):
            return None
        if region is not None and root_element_index is not None:
            return None
        if region is not None:
            if ">" in region:
                return None
            norm_reg = region.strip().lower()
            matches = [
                r
                for r in (cache.get("regions") or [])
                if isinstance(r, Mapping) and str(r.get("label") or "").strip().lower() == norm_reg
            ]
            if len(matches) == 1 and isinstance(matches[0].get("region_token"), str):
                return str(matches[0]["region_token"])
            return None
        if root_element_index is not None:
            el_tokens = cache.get("element_tokens")
            if isinstance(el_tokens, Mapping) and isinstance(el_tokens.get(root_element_index), str):
                return str(el_tokens[root_element_index])
        return None

    def _resolve_post_obs_root_token(
        self,
        current_obs: Mapping[str, Any],
        *,
        region: str | None,
        root_element_index: int | None = None,
    ) -> str | None:
        if current_obs.get("native_root_element_token") is None:
            return None
        if region is not None and root_element_index is not None:
            return None
        if region is not None and ">" in region:
            return None
        snap_id = current_obs.get("snapshot_id")
        if not isinstance(snap_id, str) or not SNAPSHOT_ID_RE.match(snap_id):
            return None
        if region is not None:
            norm_reg = region.strip().lower()
            matches = [
                r
                for r in (current_obs.get("native_regions") or [])
                if isinstance(r, Mapping) and str(r.get("label") or "").strip().lower() == norm_reg
            ]
            if len(matches) == 1 and isinstance(matches[0].get("region_token"), str):
                return str(matches[0]["region_token"])
        secure_ids = set(current_obs.get("secure_element_ids") or ())
        if 0 not in secure_ids:
            if 0 in (current_obs.get("indexed_element_ids") or set()):
                return f"{snap_id}:0"
            for raw_e in (current_obs.get("_raw_elements") or []):
                if isinstance(raw_e, Mapping) and raw_e.get("element_index") == 0:
                    return f"{snap_id}:0"
        return None

    def _call_get_window_state(
        self,
        driver: Any,
        base_args: Mapping[str, Any],
        *,
        pid: int,
        window_id: int,
        skeleton: bool = False,
        region: str | None = None,
        root_element_index: int | None = None,
        explicit_root_token: str | None = None,
        allow_cached_root_token: bool = True,
        caller_specified_max_elements: bool = False,
        timeout_s: float | None = None,
        deadline_monotonic: float | None = None,
    ) -> dict[str, Any]:
        if hasattr(driver, "ensure_capabilities"):
            driver.ensure_capabilities(deadline_monotonic=deadline_monotonic)
        supports_mb = bool(not self.v1_compat and getattr(driver, "supports_include_menubar", False))
        supports_root = bool(not self.v1_compat and getattr(driver, "supports_root_element_token", False))
        call_args = dict(base_args)
        if supports_mb:
            call_args.setdefault("include_menubar", False)
        root_tok: str | None = None
        if supports_root:
            root_tok = explicit_root_token or (
                self._resolve_cached_root_token(
                    pid,
                    window_id,
                    region=region,
                    root_element_index=root_element_index,
                )
                if allow_cached_root_token
                else None
            )
            if (
                root_tok is None
                and allow_cached_root_token
                and region is not None
                and root_element_index is None
                and ">" not in region
                and (pid, window_id) not in self._window_token_cache
                and not caller_specified_max_elements
            ):
                seed_args: dict[str, Any] = {
                    "pid": pid,
                    "window_id": window_id,
                    "include_screenshot": False,
                    "tree_format": "compact",
                    "max_depth": 2,
                    "max_elements": 60,
                }
                if supports_mb:
                    seed_args["include_menubar"] = False
                seed_raw = driver.call_tool(
                    "get_window_state",
                    seed_args,
                    timeout_s=timeout_s,
                    deadline_monotonic=deadline_monotonic,
                )
                if not seed_raw.get("isError"):
                    seed_sc = seed_raw.get("structuredContent")
                    if isinstance(seed_sc, Mapping):
                        seed_snap = seed_sc.get("snapshot_id")
                        raw_regs = seed_sc.get("regions")
                        if isinstance(seed_snap, str) and SNAPSHOT_ID_RE.match(seed_snap) and isinstance(raw_regs, list):
                            parsed_regs = [
                                {
                                    "region_token": r["region_token"].strip(),
                                    "label": str(r.get("label") or "").strip(),
                                    "role": str(r.get("role") or ""),
                                    "depth": int(r["depth"]) if isinstance(r.get("depth"), int) else 1,
                                    "element_index": r.get("element_index") if isinstance(r.get("element_index"), int) else None,
                                }
                                for r in raw_regs
                                if isinstance(r, Mapping)
                                and isinstance(r.get("region_token"), str)
                                and r["region_token"].startswith(f"{seed_snap}:r")
                                and str(r.get("label") or "").strip()
                            ]
                            self._window_token_cache[(pid, window_id)] = {
                                "snapshot_id": seed_snap,
                                "regions": parsed_regs,
                                "element_tokens": {},
                            }
                            root_tok = self._resolve_cached_root_token(
                                pid,
                                window_id,
                                region=region,
                                root_element_index=None,
                            )
        if not caller_specified_max_elements and not self.v1_compat:
            if root_tok is not None:
                call_args["max_elements"] = 500
            elif (
                skeleton
                and call_args.get("query") is None
                and region is None
                and root_element_index is None
                and supports_root
            ):
                call_args["max_elements"] = 120
            elif skeleton or region is not None or root_element_index is not None:
                call_args["max_elements"] = 2000
        if root_tok is not None:
            call_args["root_element_token"] = root_tok
            call_args.pop("include_diff", None)
        raw = driver.call_tool(
            "get_window_state",
            call_args,
            timeout_s=timeout_s,
            deadline_monotonic=deadline_monotonic,
        )
        if raw.get("isError") and "root_element_token" in call_args:
            err_txt = "".join(c.get("text", "") for c in (raw.get("content") or []) if isinstance(c, Mapping))
            if "unsupported_parameter" in err_txt:
                try:
                    driver.supports_root_element_token = False
                except Exception:
                    pass
            self._window_token_cache.pop((pid, window_id), None)
            has_python_scope = bool(skeleton or region is not None or root_element_index is not None)
            if explicit_root_token is not None and not has_python_scope:
                return raw
            retry_args = dict(base_args)
            if supports_mb:
                retry_args.setdefault("include_menubar", False)
            if (
                not self.v1_compat
                and has_python_scope
                and not caller_specified_max_elements
            ):
                retry_args["max_elements"] = 2000
            raw = driver.call_tool(
                "get_window_state",
                retry_args,
                timeout_s=timeout_s,
                deadline_monotonic=deadline_monotonic,
            )
        return raw

    def _get_driver(self) -> DriverClient:
        if self._driver_client is not None:
            return self._driver_client
        driver_bin = find_driver(self.env)
        if not driver_bin:
            raise RuntimeError("cua-driver not found; run `bin/agy-cua doctor`")
        timeout_ms = clamp_driver_timeout_ms(self.env.get("AGY_CUA_DRIVER_TIMEOUT_MS"))
        self._driver_client = DriverClient(
            driver_bin,
            timeout_ms=timeout_ms,
            env=self.env,
            session_id=self.session_id,
        )
        return self._driver_client

    def _target_state_path(self) -> str:
        return _default_target_state_path(self.env)

    def _acquire_target(self, pid: int, window_id: int) -> str | None:
        key = (pid, window_id)
        str_key = f"{pid}:{window_id}"
        state_path = self._target_state_path()
        current_pid = os.getpid()
        with _TARGET_LOCK:
            for k in [
                tk
                for tk, tv in _ACTIVE_TARGETS.items()
                if tv.get("owner_ref") is None or tv["owner_ref"]() is None or tv["owner_ref"]()._closed
            ]:
                _ACTIVE_TARGETS.pop(k, None)

            existing = _ACTIVE_TARGETS.get(key)
            if existing is not None:
                owner = existing["owner_ref"]() if existing.get("owner_ref") is not None else None
                owner_sess = existing.get("session_id")
                if owner is not None and not owner._closed and owner_sess != self.session_id:
                    return (
                        f"target_conflict: target (pid={pid}, window_id={window_id}) is actively "
                        f"owned by concurrent session {owner_sess!r}"
                    )

            live_local_sessions = {
                v.get("session_id")
                for v in _ACTIVE_TARGETS.values()
                if isinstance(v.get("session_id"), str)
            }
            live_local_sessions.add(self.session_id)

            def _mutate(data: dict[str, Any]) -> tuple[str | None, bool]:
                dirty = False
                for fk, fval in list(data.items()):
                    if not isinstance(fval, dict):
                        data.pop(fk, None)
                        dirty = True
                        continue
                    srv_pid = fval.get("server_pid")
                    f_sess = fval.get("session_id")
                    if srv_pid == current_pid:
                        if f_sess not in live_local_sessions:
                            data.pop(fk, None)
                            dirty = True
                    elif not _pid_is_alive(srv_pid):
                        data.pop(fk, None)
                        dirty = True

                f_existing = data.get(str_key)
                if isinstance(f_existing, dict):
                    f_sess = f_existing.get("session_id")
                    if isinstance(f_sess, str) and f_sess != self.session_id:
                        return (
                            f"target_conflict: target (pid={pid}, window_id={window_id}) is actively "
                            f"owned by concurrent session {f_sess!r}",
                            dirty,
                        )

                prev_snap = (
                    existing.get("last_snapshot_id")
                    if existing and existing.get("session_id") == self.session_id
                    else (f_existing.get("last_snapshot_id") if isinstance(f_existing, dict) else None)
                )
                data[str_key] = {
                    "session_id": self.session_id,
                    "server_pid": current_pid,
                    "last_snapshot_id": prev_snap,
                }
                return None, True

            file_conflict = _mutate_target_state_file(state_path, _mutate)
            if file_conflict is not None:
                return file_conflict

            _ACTIVE_TARGETS[key] = {
                "session_id": self.session_id,
                "owner_ref": weakref.ref(self),
                "last_snapshot_id": (
                    existing.get("last_snapshot_id")
                    if existing and existing.get("session_id") == self.session_id
                    else None
                ),
            }
            self._owned_targets.add(key)
        return None

    def _release_single_target(self, pid: int, window_id: int) -> None:
        key = (pid, window_id)
        self._window_token_cache.pop(key, None)
        str_key = f"{pid}:{window_id}"
        state_path = self._target_state_path()
        with _TARGET_LOCK:
            entry = _ACTIVE_TARGETS.get(key)
            if entry is not None and entry.get("session_id") == self.session_id:
                _ACTIVE_TARGETS.pop(key, None)
            self._owned_targets.discard(key)

            def _mutate(data: dict[str, Any]) -> tuple[None, bool]:
                f_entry = data.get(str_key)
                if isinstance(f_entry, dict) and f_entry.get("session_id") == self.session_id:
                    data.pop(str_key, None)
                    return None, True
                return None, False

            _mutate_target_state_file(state_path, _mutate)

    def _update_target_snapshot(self, pid: int, window_id: int, snapshot_id: str) -> None:
        key = (pid, window_id)
        str_key = f"{pid}:{window_id}"
        state_path = self._target_state_path()
        with _TARGET_LOCK:
            entry = _ACTIVE_TARGETS.get(key)
            if entry is not None and entry.get("session_id") == self.session_id:
                entry["last_snapshot_id"] = snapshot_id

            def _mutate(data: dict[str, Any]) -> tuple[None, bool]:
                f_entry = data.get(str_key)
                if isinstance(f_entry, dict) and f_entry.get("session_id") == self.session_id:
                    f_entry["last_snapshot_id"] = snapshot_id
                    return None, True
                return None, False

            _mutate_target_state_file(state_path, _mutate)

    def _release_targets(self) -> None:
        state_path = self._target_state_path()
        with _TARGET_LOCK:
            stale_keys = [
                k
                for k, v in _ACTIVE_TARGETS.items()
                if v.get("session_id") == self.session_id
                or v.get("owner_ref") is None
                or v["owner_ref"]() is None
                or v["owner_ref"]() is self
            ]
            for k in stale_keys:
                _ACTIVE_TARGETS.pop(k, None)
            self._owned_targets.clear()

            def _mutate(data: dict[str, Any]) -> tuple[None, bool]:
                dirty = False
                for fk, fval in list(data.items()):
                    if not isinstance(fval, dict) or fval.get("session_id") == self.session_id:
                        data.pop(fk, None)
                        dirty = True
                return None, dirty

            _mutate_target_state_file(state_path, _mutate)

    def _record_trace(self, entry: Mapping[str, Any]) -> None:
        if entry.get("schema") != "agy_cua.jev_batch_v1":
            self.accounting.history_log.append(dict(entry))
        trace_path = self.env.get("AGY_CUA_JEV_TRACE_FILE")
        if trace_path:
            try:
                with open(trace_path, "a", encoding="utf-8") as handle:
                    handle.write(json.dumps(entry, ensure_ascii=False) + "\n")
            except OSError:
                pass

    def handle_step(
        self,
        args: Mapping[str, Any],
        *,
        _deadline_monotonic: float | None = None,
        _expected_pre_sig: tuple[Any, ...] | None = None,
        _out_post_sig: list[tuple[Any, ...]] | None = None,
        _chained_obs: Mapping[str, Any] | None = None,
        _out_post_obs: list[dict[str, Any]] | None = None,
    ) -> dict[str, Any]:
        step_started = time.perf_counter()
        if not isinstance(args, Mapping):
            return _format_tool_result(
                {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_arguments"},
                is_error=True,
            )

        if self.accounting.halted:
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_step_v1",
                    "status": "halted",
                    "reason": self.accounting.halt_reason or "session_halted",
                    "session_id": self.session_id,
                    "accounting": self.accounting.to_dict(),
                },
                is_error=True,
            )

        goal = args.get("goal")
        pid = args.get("pid")
        window_id = args.get("window_id")
        if not isinstance(goal, str) or not goal.strip() or len(goal) > MAX_GOAL_CHARS:
            return _format_tool_result(
                {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_goal"},
                is_error=True,
            )
        if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
            return _format_tool_result(
                {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_pid"},
                is_error=True,
            )
        if not isinstance(window_id, int) or isinstance(window_id, bool) or window_id <= 0:
            return _format_tool_result(
                {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_window_id"},
                is_error=True,
            )

        action_value = args.get("value")
        if action_value is not None and not isinstance(action_value, str):
            return _format_tool_result(
                {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_value"},
                is_error=True,
            )

        query_val: str | None = None
        if "query" in args and args["query"] is not None:
            raw_query = args["query"]
            if not isinstance(raw_query, str) or not raw_query.strip():
                return _format_tool_result(
                    {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_query"},
                    is_error=True,
                )
            query_val = raw_query.strip()

        max_depth_val: int | None = None
        if "max_depth" in args and args["max_depth"] is not None:
            raw_depth = args["max_depth"]
            if (
                not isinstance(raw_depth, int)
                or isinstance(raw_depth, bool)
                or raw_depth < MIN_OBSERVE_MAX_DEPTH
                or raw_depth > MAX_OBSERVE_MAX_DEPTH
            ):
                return _format_tool_result(
                    {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_max_depth"},
                    is_error=True,
                )
            max_depth_val = raw_depth

        max_elements_val: int | None = None
        if "max_elements" in args and args["max_elements"] is not None:
            raw_max_el = args["max_elements"]
            if (
                not isinstance(raw_max_el, int)
                or isinstance(raw_max_el, bool)
                or raw_max_el < MIN_OBSERVE_MAX_ELEMENTS
                or raw_max_el > MAX_OBSERVE_MAX_ELEMENTS
            ):
                return _format_tool_result(
                    {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_max_elements"},
                    is_error=True,
                )
            max_elements_val = raw_max_el

        walk_timeout_ms_val: int | None = None
        if "walk_timeout_ms" in args and args["walk_timeout_ms"] is not None:
            raw_walk_to = args["walk_timeout_ms"]
            if (
                not isinstance(raw_walk_to, int)
                or isinstance(raw_walk_to, bool)
                or raw_walk_to < MIN_OBSERVE_WALK_TIMEOUT_MS
                or raw_walk_to > MAX_OBSERVE_WALK_TIMEOUT_MS
            ):
                return _format_tool_result(
                    {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_walk_timeout_ms"},
                    is_error=True,
                )
            walk_timeout_ms_val = raw_walk_to

        skeleton_val = False
        if "skeleton" in args and args["skeleton"] is not None:
            if not isinstance(args["skeleton"], bool):
                return _format_tool_result(
                    {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_skeleton"},
                    is_error=True,
                )
            skeleton_val = args["skeleton"]

        region_val: str | None = None
        if "region" in args and args["region"] is not None:
            raw_region = args["region"]
            if not isinstance(raw_region, str) or not raw_region.strip():
                return _format_tool_result(
                    {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_region"},
                    is_error=True,
                )
            region_val = raw_region.strip()

        root_element_index_val: int | None = None
        if "root_element_index" in args and args["root_element_index"] is not None:
            raw_root_idx = args["root_element_index"]
            if not isinstance(raw_root_idx, int) or isinstance(raw_root_idx, bool) or raw_root_idx < 0:
                return _format_tool_result(
                    {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_root_element_index"},
                    is_error=True,
                )
            root_element_index_val = raw_root_idx

        wait_timeout_ms_val: int | None = None
        if "wait_timeout_ms" in args and args["wait_timeout_ms"] is not None:
            raw_wait_to = args["wait_timeout_ms"]
            if (
                not isinstance(raw_wait_to, int)
                or isinstance(raw_wait_to, bool)
                or raw_wait_to < MIN_WAIT_TIMEOUT_MS
                or raw_wait_to > MAX_WAIT_TIMEOUT_MS
            ):
                return _format_tool_result(
                    {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_wait_timeout_ms"},
                    is_error=True,
                )
            wait_timeout_ms_val = raw_wait_to

        is_hierarchy_scoped = bool(skeleton_val or region_val is not None or root_element_index_val is not None)

        mode = str(args.get("mode") or ("deterministic" if args.get("deterministic") is True else "jev")).strip()
        if mode not in {"jev", "deterministic"}:
            return _format_tool_result(
                {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": f"invalid_mode={mode!r}"},
                is_error=True,
            )

        expected_snap = args.get("expected_snapshot_id")
        if expected_snap is not None and (not isinstance(expected_snap, str) or not SNAPSHOT_ID_RE.match(expected_snap)):
            return _format_tool_result(
                {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_expected_snapshot_id"},
                is_error=True,
            )

        source_snap = args.get("source_snapshot_id")
        if source_snap is not None and (not isinstance(source_snap, str) or not SNAPSHOT_ID_RE.match(source_snap)):
            return _format_tool_result(
                {"schema": "agy_cua.jev_step_v1", "status": "refused", "reason": "invalid_source_snapshot_id"},
                is_error=True,
            )

        raw_cands = args.get("candidates")
        if mode == "deterministic":
            if not isinstance(raw_cands, list) or len(raw_cands) != 1:
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_step_v1",
                        "status": "candidate_refused",
                        "reason": "deterministic_step_requires_single_candidate",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                        "verified": False,
                        "accounting": self.accounting.to_dict(),
                    },
                    is_error=True,
                )

        was_owned = (pid, window_id) in self._owned_targets
        conflict = self._acquire_target(pid, window_id)
        if conflict is not None:
            payload = {
                "schema": "agy_cua.jev_step_v1",
                "status": "target_conflict",
                "verification_outcome": "not_executed",
                "reason": conflict,
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "verified": False,
                "uncertain_side_effect": False,
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)

        def release_if_unowned() -> None:
            if not was_owned:
                self._release_single_target(pid, window_id)

        def remaining_timeout_s(default_s: float) -> float:
            if _deadline_monotonic is None:
                return default_s
            rem = _deadline_monotonic - time.monotonic()
            if rem <= 0:
                raise TimeoutError("batch deadline exceeded")
            return min(default_s, rem)

        def obs_call_timeout_s(drv: DriverClient, walk_ms: int | None = walk_timeout_ms_val) -> float:
            base_ms = (
                max(drv.timeout_ms, walk_ms + 1000)
                if walk_ms is not None
                else drv.timeout_ms
            )
            return remaining_timeout_s(base_ms / 1000.0)

        # Stage 1: Observe target window via cua-driver (text-only to Jev; anchor window screenshot in driver session only if a candidate uses window-local pixels)
        needs_pixel_anchor = False
        if isinstance(raw_cands, list):
            for item in raw_cands:
                if isinstance(item, Mapping):
                    sub = item.get("arguments") if isinstance(item.get("arguments"), Mapping) else item
                    if any(k in sub for k in ("x", "y", "from_x", "from_y", "to_x", "to_y")):
                        needs_pixel_anchor = True
                        break
        obs_started = time.perf_counter()
        if _chained_obs is not None and not needs_pixel_anchor:
            try:
                driver = self._get_driver()
                pre_obs = dict(_chained_obs)
            except Exception as exc:
                release_if_unowned()
                payload = {
                    "schema": "agy_cua.jev_step_v1",
                    "status": "observation_failed",
                    "verification_outcome": "not_executed",
                    "reason": str(exc),
                    "pid": pid,
                    "window_id": window_id,
                    "session_id": self.session_id,
                    "verified": False,
                    "uncertain_side_effect": False,
                    "timings_ms": {
                        "observe_ms": 0.0,
                        "provider_ms": 0.0,
                        "dispatch_ms": 0.0,
                        "verify_ms": 0.0,
                        "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                    },
                    "accounting": self.accounting.to_dict(),
                }
                self._record_trace(payload)
                return _format_tool_result(payload, is_error=True)
            obs_ms = 0.0
        else:
            try:
                if not self.v1_compat and not self._driver_client_injected and not self.env.get("AGY_CUA_DRIVER"):
                    wake_macos_app_nap(pid)
                driver = self._get_driver()
                pre_obs_args: dict[str, Any] = {
                    "pid": pid,
                    "window_id": window_id,
                    "include_screenshot": needs_pixel_anchor,
                    "tree_format": "both",
                }
                if query_val is not None:
                    pre_obs_args["query"] = query_val
                if max_depth_val is not None:
                    pre_obs_args["max_depth"] = max_depth_val
                if max_elements_val is not None:
                    pre_obs_args["max_elements"] = max_elements_val
                elif not self.v1_compat and is_hierarchy_scoped:
                    pre_obs_args["max_elements"] = 2000
                if walk_timeout_ms_val is not None:
                    pre_obs_args["timeout_ms"] = walk_timeout_ms_val
                elif not self.v1_compat and is_hierarchy_scoped and driver.timeout_ms >= 4000:
                    pre_obs_args["timeout_ms"] = 5000
                raw_pre = self._call_get_window_state(
                    driver,
                    pre_obs_args,
                    pid=pid,
                    window_id=window_id,
                    skeleton=skeleton_val,
                    region=region_val,
                    root_element_index=root_element_index_val,
                    caller_specified_max_elements=(max_elements_val is not None),
                    timeout_s=obs_call_timeout_s(driver, pre_obs_args.get("timeout_ms")),
                    deadline_monotonic=_deadline_monotonic,
                )
                if raw_pre.get("isError"):
                    err_txt = "".join(c.get("text", "") for c in (raw_pre.get("content") or []) if isinstance(c, Mapping))
                    raise RuntimeError(err_txt or "get_window_state returned isError=true")
                prev_cached_obs = self._last_observations.get((pid, window_id))
                prev_baseline = None if is_hierarchy_scoped else prev_cached_obs
                try:
                    pre_obs = extract_window_observation(
                        raw_pre,
                        expected_pid=pid,
                        expected_window_id=window_id,
                        query=query_val,
                        previous_observation=prev_baseline,
                        skeleton=skeleton_val,
                        region=region_val,
                        root_element_index=root_element_index_val,
                        max_elements_cap=self.max_elements_cap,
                        max_auto_candidates=self.max_auto_candidates,
                        enrich_descriptions=not self.v1_compat,
                    )
                except ValueError as diff_exc:
                    if "invalid_diff_baseline" not in str(diff_exc):
                        raise
                    fallback_args = dict(pre_obs_args, include_diff=False, tree_format="both")
                    raw_pre = self._call_get_window_state(
                        driver,
                        fallback_args,
                        pid=pid,
                        window_id=window_id,
                        skeleton=skeleton_val,
                        region=region_val,
                        root_element_index=root_element_index_val,
                        caller_specified_max_elements=(max_elements_val is not None),
                        timeout_s=obs_call_timeout_s(driver, pre_obs_args.get("timeout_ms")),
                        deadline_monotonic=_deadline_monotonic,
                    )
                    if raw_pre.get("isError"):
                        err_txt = "".join(c.get("text", "") for c in (raw_pre.get("content") or []) if isinstance(c, Mapping))
                        raise RuntimeError(err_txt or "get_window_state fallback returned isError=true")
                    pre_obs = extract_window_observation(
                        raw_pre,
                        expected_pid=pid,
                        expected_window_id=window_id,
                        query=query_val,
                        previous_observation=None,
                        skeleton=skeleton_val,
                        region=region_val,
                        root_element_index=root_element_index_val,
                        max_elements_cap=self.max_elements_cap,
                        max_auto_candidates=self.max_auto_candidates,
                        enrich_descriptions=not self.v1_compat,
                    )
                if isinstance(prev_cached_obs, Mapping) and isinstance(prev_cached_obs.get("window_bounds"), Mapping):
                    prev_wb = prev_cached_obs["window_bounds"]
                    cur_wb = pre_obs.get("window_bounds") if isinstance(pre_obs.get("window_bounds"), dict) else {}
                    if "logical_width" in prev_wb and "logical_width" not in cur_wb:
                        cur_wb["logical_width"] = prev_wb["logical_width"]
                        cur_wb["logical_height"] = prev_wb.get("logical_height", prev_wb["logical_width"])
                        cur_wb["width"] = prev_wb["width"]
                        cur_wb["height"] = prev_wb["height"]
                        pre_obs["window_bounds"] = cur_wb
                if not pre_obs.get("query_incomplete") and not is_hierarchy_scoped:
                    self._last_observations[(pid, window_id)] = pre_obs
                self._snapshot_targets[pre_obs["snapshot_id"]] = (pid, window_id)
                self._update_window_token_cache(pid, window_id, pre_obs)
            except Exception as exc:
                release_if_unowned()
                obs_ms = round((time.perf_counter() - obs_started) * 1000, 2)
                payload = {
                    "schema": "agy_cua.jev_step_v1",
                    "status": "observation_failed",
                    "verification_outcome": "not_executed",
                    "reason": str(exc),
                    "pid": pid,
                    "window_id": window_id,
                    "session_id": self.session_id,
                    "verified": False,
                    "action_dispatched": False,
                    "uncertain_side_effect": False,
                    "timings_ms": {
                        "observe_ms": obs_ms,
                        "provider_ms": 0.0,
                        "dispatch_ms": 0.0,
                        "verify_ms": 0.0,
                        "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                    },
                    "accounting": self.accounting.to_dict(),
                }
                self._record_trace(payload)
                return _format_tool_result(payload, is_error=True)
            obs_ms = round((time.perf_counter() - obs_started) * 1000, 2)
        obs_disclosure: dict[str, Any] = {
            "total_actionable_elements": pre_obs["total_actionable_elements"],
            "omitted_elements_count": pre_obs["omitted_elements_count"],
            "omitted_candidates_count": pre_obs["omitted_candidates_count"],
            "observation_truncated": pre_obs["observation_truncated"],
            "query_status": pre_obs.get("query_status"),
            "query_incomplete": pre_obs.get("query_incomplete", False),
            "search_complete": pre_obs.get("search_complete", True),
            "visual_fallback_recommended": pre_obs.get("visual_fallback_recommended", False),
        }
        if is_hierarchy_scoped or pre_obs.get("drill_regions"):
            obs_disclosure["drill_regions"] = pre_obs.get("drill_regions") or []
            obs_disclosure["skeleton"] = bool(pre_obs.get("skeleton", False))
            obs_disclosure["region"] = pre_obs.get("region")
            obs_disclosure["root_element_index"] = pre_obs.get("root_element_index")
        if pre_obs.get("active_surfaces"):
            obs_disclosure["active_surfaces"] = pre_obs.get("active_surfaces") or []

        if expected_snap is not None and pre_obs["snapshot_id"] != expected_snap:
            release_if_unowned()
            payload = {
                "schema": "agy_cua.jev_step_v1",
                "status": "stale_snapshot",
                "verification_outcome": "not_executed",
                "reason": f"stale_snapshot_id: expected {expected_snap!r}, observed {pre_obs['snapshot_id']!r}",
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "pre_snapshot_id": pre_obs["snapshot_id"],
                "pre_static_texts": pre_obs["static_texts"],
                "verified": False,
                "action_dispatched": False,
                "uncertain_side_effect": False,
                "timings_ms": {
                    "observe_ms": obs_ms,
                    "provider_ms": 0.0,
                    "dispatch_ms": 0.0,
                    "verify_ms": 0.0,
                    "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                },
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)

        if source_snap is not None:
            known_target = self._visual_snapshot_targets.get(source_snap) or self._snapshot_targets.get(source_snap)
            if known_target is not None and known_target != (pid, window_id):
                release_if_unowned()
                payload = {
                    "schema": "agy_cua.jev_step_v1",
                    "status": "out_of_scope_target",
                    "verification_outcome": "not_executed",
                    "reason": (
                        f"out_of_scope_target: source_snapshot_id={source_snap!r} belongs to "
                        f"(pid={known_target[0]}, window_id={known_target[1]}), expected (pid={pid}, window_id={window_id})"
                    ),
                    "pid": pid,
                    "window_id": window_id,
                    "session_id": self.session_id,
                    "pre_snapshot_id": pre_obs["snapshot_id"],
                    "pre_static_texts": pre_obs["static_texts"],
                    "verified": False,
                    "action_dispatched": False,
                    "uncertain_side_effect": False,
                    "timings_ms": {
                        "observe_ms": obs_ms,
                        "provider_ms": 0.0,
                        "dispatch_ms": 0.0,
                        "verify_ms": 0.0,
                        "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                    },
                    "accounting": self.accounting.to_dict(),
                }
                self._record_trace(payload)
                return _format_tool_result(payload, is_error=True)
            latest_visual_snap = self._visual_snapshots.get((pid, window_id))
            if source_snap not in self._visual_snapshot_targets or latest_visual_snap != source_snap:
                release_if_unowned()
                reason_code = (
                    f"unknown_source_snapshot_id: source_snapshot_id={source_snap!r} was not observed via jev_observe(include_screenshot=true)"
                    if source_snap not in self._visual_snapshot_targets
                    else (
                        f"stale_snapshot_id: source_snapshot_id={source_snap!r} does not match "
                        f"last observed visual snapshot {latest_visual_snap!r}"
                    )
                )
                payload = {
                    "schema": "agy_cua.jev_step_v1",
                    "status": "stale_snapshot",
                    "verification_outcome": "not_executed",
                    "reason": reason_code,
                    "pid": pid,
                    "window_id": window_id,
                    "session_id": self.session_id,
                    "pre_snapshot_id": pre_obs["snapshot_id"],
                    "pre_static_texts": pre_obs["static_texts"],
                    "verified": False,
                    "action_dispatched": False,
                    "uncertain_side_effect": False,
                    "timings_ms": {
                        "observe_ms": obs_ms,
                        "provider_ms": 0.0,
                        "dispatch_ms": 0.0,
                        "verify_ms": 0.0,
                        "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                    },
                    "accounting": self.accounting.to_dict(),
                }
                self._record_trace(payload)
                return _format_tool_result(payload, is_error=True)

        if _expected_pre_sig is not None and _obs_state_signature(pre_obs) != _expected_pre_sig:
            release_if_unowned()
            payload = {
                "schema": "agy_cua.jev_step_v1",
                "status": "stale_snapshot",
                "verification_outcome": "not_executed",
                "reason": "interstep_state_drift: window AX state changed externally between batch steps",
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "pre_snapshot_id": pre_obs["snapshot_id"],
                "pre_static_texts": pre_obs["static_texts"],
                "verified": False,
                "uncertain_side_effect": False,
                "timings_ms": {
                    "observe_ms": obs_ms,
                    "provider_ms": 0.0,
                    "dispatch_ms": 0.0,
                    "verify_ms": 0.0,
                    "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                },
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)

        # Stage 2 & 3: Build / validate closed candidate table + Jev selection (with optional 1-hop drill.*)
        history_in = args.get("history")
        if history_in is None:
            history_in = [
                {"selected_id": h["selected_id"], "outcome": h["status"]}
                for h in self.accounting.history_log[-MAX_HISTORY:]
                if isinstance(h.get("selected_id"), str) and isinstance(h.get("status"), str)
            ]

        def _build_and_select_for_obs(
            obs_curr: dict[str, Any],
            *,
            forbid_drill: bool = False,
        ) -> tuple[list[dict[str, Any]], dict[str, Any], float, bool, dict[str, Any] | None]:
            try:
                b_cands = build_bound_candidates(
                    args.get("candidates"),
                    obs_curr,
                    action_value=action_value,
                    source_snapshot_id=source_snap,
                    max_auto_candidates=self.max_auto_candidates,
                    enrich_descriptions=not self.v1_compat,
                )
                if forbid_drill:
                    non_drill = [c for c in b_cands if not str(c.get("id") or "").startswith("drill.")]
                    if non_drill:
                        b_cands = non_drill
                ref_el_ids = {
                    c["arguments"]["element_index"]
                    for c in b_cands
                    if isinstance(c.get("arguments"), Mapping) and isinstance(c["arguments"].get("element_index"), int)
                }
                all_els_c = obs_curr.get("all_elements") or obs_curr["elements"]
                prompt_els_c: list[Mapping[str, Any]] = [
                    e for e in all_els_c if e.get("element_index") in ref_el_ids
                ][: self.max_elements_cap]
                seen_p_ids = {e["element_index"] for e in prompt_els_c}
                for e in obs_curr["elements"]:
                    if len(prompt_els_c) >= self.max_elements_cap:
                        break
                    if e["element_index"] not in seen_p_ids:
                        prompt_els_c.append(e)
                        seen_p_ids.add(e["element_index"])
                sel_elements: list[dict[str, Any]] = []
                for e in prompt_els_c:
                    se_item: dict[str, Any] = {
                        "element_index": e["element_index"],
                        "role": e["role"],
                        "label": e["label"],
                        "state": e["state"],
                        "depth": e.get("depth", 1),
                        "in_toolbar": bool(e.get("in_toolbar", False)),
                        "supported_actions": list(e.get("supported_actions") or []),
                    }
                    if not self.v1_compat and isinstance(e.get("container_path"), str) and e["container_path"]:
                        se_item["container_path"] = e["container_path"]
                    sel_elements.append(se_item)
                if not sel_elements:
                    for idx_c, c in enumerate(b_cands):
                        c_args = c.get("arguments")
                        if isinstance(c_args, Mapping) and "x" in c_args and "y" in c_args and "element_index" not in c_args:
                            sel_elements.append({
                                "element_index": idx_c,
                                "role": "AXCanvasTarget",
                                "label": str(c.get("description") or c.get("id") or "Canvas Target"),
                                "state": f"enabled (visual coordinate {c_args['x']}, {c_args['y']})",
                                "depth": 1,
                                "in_toolbar": False,
                                "supported_actions": [str(c.get("tool") or "click")],
                            })
                        elif c.get("tool") == "drill_region":
                            reg_name_c = (
                                str(c_args.get("region") or "")
                                if isinstance(c_args, Mapping)
                                else ""
                            ) or str(c.get("description") or c.get("id") or "Region")
                            sel_elements.append({
                                "element_index": idx_c,
                                "role": "AXGroup",
                                "label": reg_name_c[:160],
                                "state": "enabled (region container)",
                                "depth": 1,
                                "in_toolbar": False,
                                "supported_actions": ["drill_region"],
                            })
                raw_sel_req = _fit_select_request_to_byte_budget(
                    {
                        "goal": goal,
                        "pid": pid,
                        "window_id": window_id,
                        "snapshot_id": obs_curr["snapshot_id"],
                        "elements": sel_elements,
                        "history": history_in,
                        "candidates": [{"id": c["id"], "description": c["description"]} for c in b_cands],
                    },
                    max_json_bytes=self.max_json_bytes,
                    referenced_el_ids=ref_el_ids,
                )
                sel_req = validate_select_request(
                    raw_sel_req,
                    max_elements=self.max_elements_cap,
                    max_candidates=self.max_candidates,
                    max_json_bytes=self.max_json_bytes,
                )
            except Exception as exc:
                err_msg = str(exc)
                err_status = "stale_snapshot" if "stale_snapshot_id" in err_msg else "candidate_refused"
                err_payload = {
                    "schema": "agy_cua.jev_step_v1",
                    "status": err_status,
                    "verification_outcome": "not_executed",
                    "reason": err_msg,
                    "pid": pid,
                    "window_id": window_id,
                    "session_id": self.session_id,
                    "pre_snapshot_id": obs_curr["snapshot_id"],
                    "pre_static_texts": obs_curr["static_texts"],
                    **obs_disclosure,
                    "verified": False,
                    "action_dispatched": False,
                    "uncertain_side_effect": False,
                    "timings_ms": {
                        "observe_ms": obs_ms,
                        "provider_ms": 0.0,
                        "dispatch_ms": 0.0,
                        "verify_ms": 0.0,
                        "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                    },
                    "accounting": self.accounting.to_dict(),
                }
                return [], {}, 0.0, False, err_payload

            reranked_c = False
            if mode == "deterministic":
                only_cand = b_cands[0]
                dec_c = {
                    "schema": "agy_cua.jev_decision_v1",
                    "kind": "selected",
                    "reason": None,
                    "pid": pid,
                    "window_id": window_id,
                    "snapshot_id": obs_curr["snapshot_id"],
                    "selected_id": only_cand["id"],
                    "requested_model": "deterministic-controller",
                    "returned_model": "deterministic-controller",
                    "sdk_identity": CLIENT_IDENTITY,
                    "route": "deterministic",
                    "confidence": 1.0,
                    "probabilities": {only_cand["id"]: 1.0, "reobserve": 0.0, "abstain": 0.0},
                    "provider_ms": 0.0,
                    "accounting": self.accounting.to_dict(),
                }
                p_ms = 0.0
            else:
                route = resolve_route(self.env, self.keychain_reader)
                if _deadline_monotonic is not None:
                    rem_ms = int((_deadline_monotonic - time.monotonic()) * 1000)
                    if rem_ms <= 0:
                        to_payload = {
                            "schema": "agy_cua.jev_step_v1",
                            "status": "batch_timeout",
                            "verification_outcome": "not_executed",
                            "reason": "batch deadline exceeded before Jev selection",
                            "pid": pid,
                            "window_id": window_id,
                            "session_id": self.session_id,
                            "pre_snapshot_id": obs_curr["snapshot_id"],
                            "verified": False,
                            "action_dispatched": False,
                            "uncertain_side_effect": False,
                            "timings_ms": {
                                "observe_ms": obs_ms,
                                "provider_ms": 0.0,
                                "dispatch_ms": 0.0,
                                "verify_ms": 0.0,
                                "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                            },
                            "accounting": self.accounting.to_dict(),
                        }
                        return [], {}, 0.0, False, to_payload
                    if rem_ms < route.timeout_ms:
                        route = JevRoute(
                            kind=route.kind,
                            reason=route.reason,
                            endpoint=route.endpoint,
                            model=route.model,
                            api_key=route.api_key,
                            key_source=route.key_source,
                            timeout_ms=max(1, rem_ms),
                            note=route.note,
                        )
                dec_c = evaluate_jev_choice(sel_req, route, self.accounting, self.http_post)
                p_ms = float(dec_c.get("provider_ms", 0.0))
                if (
                    not self.v1_compat
                    and _should_rerank_decision(dec_c, len(b_cands))
                    and self.accounting.calls_used < self.accounting.max_calls
                ):
                    probs_p1 = dec_c.get("probabilities") if isinstance(dec_c.get("probabilities"), Mapping) else {}
                    ranked_cands = sorted(
                        b_cands,
                        key=lambda c: (1 if c["id"] == dec_c.get("selected_id") else 0, float(probs_p1.get(c["id"], 0.0))),
                        reverse=True,
                    )
                    shortlist_cands = ranked_cands[:V2_RERANK_SHORTLIST_K]
                    short_el_ids = {
                        c["arguments"]["element_index"]
                        for c in shortlist_cands
                        if isinstance(c.get("arguments"), Mapping) and isinstance(c["arguments"].get("element_index"), int)
                    }
                    short_elements = (
                        [se for se in sel_elements if se.get("element_index") in short_el_ids]
                        if short_el_ids
                        else sel_elements[:V2_RERANK_SHORTLIST_K]
                    )
                    can_rerank = True
                    route_p2 = route
                    if _deadline_monotonic is not None:
                        rem_p2_ms = int((_deadline_monotonic - time.monotonic()) * 1000)
                        if rem_p2_ms <= 0:
                            can_rerank = False
                        elif rem_p2_ms < route.timeout_ms:
                            route_p2 = JevRoute(
                                kind=route.kind,
                                reason=route.reason,
                                endpoint=route.endpoint,
                                model=route.model,
                                api_key=route.api_key,
                                key_source=route.key_source,
                                timeout_ms=max(1, rem_p2_ms),
                                note=route.note,
                            )
                    if can_rerank:
                        rerank_goal = _build_rerank_goal(
                            goal,
                            f" (disambiguate shortlisted top-{len(shortlist_cands)} candidates)",
                        )
                        try:
                            rerank_req = validate_select_request(
                                {
                                    "goal": rerank_goal,
                                    "pid": pid,
                                    "window_id": window_id,
                                    "snapshot_id": obs_curr["snapshot_id"],
                                    "elements": short_elements,
                                    "history": history_in,
                                    "candidates": [{"id": c["id"], "description": c["description"]} for c in shortlist_cands],
                                },
                                max_elements=self.max_elements_cap,
                                max_candidates=self.max_candidates,
                                max_json_bytes=self.max_json_bytes,
                            )
                        except ValueError:
                            rerank_req = None
                        if rerank_req is not None:
                            rerank_dec = evaluate_jev_choice(rerank_req, route_p2, self.accounting, self.http_post)
                            p_ms = round(float(p_ms) + float(rerank_dec.get("provider_ms", 0.0)), 2)
                            dec_c = rerank_dec
                            reranked_c = True
            return b_cands, dec_c, p_ms, reranked_c, None

        bound_candidates, decision, provider_ms, reranked, stage2_err = _build_and_select_for_obs(pre_obs)
        if stage2_err is not None:
            release_if_unowned()
            self._record_trace(stage2_err)
            return _format_tool_result(stage2_err, is_error=True)

        auto_drilled = False
        if (
            not self.v1_compat
            and decision.get("kind") == "selected"
            and isinstance(decision.get("selected_id"), str)
            and decision["selected_id"].startswith("drill.")
            and args.get("candidates") is None
            and (mode == "deterministic" or self.accounting.calls_used < self.accounting.max_calls)
        ):
            sel_drill_id = decision["selected_id"]
            drill_reg = next(
                (
                    r
                    for r in (pre_obs.get("drill_regions") or [])
                    if isinstance(r, Mapping) and r.get("candidate_id") == sel_drill_id
                ),
                None,
            )
            drill_region_name = (
                str(drill_reg["region"]).strip()
                if isinstance(drill_reg, Mapping)
                and not drill_reg.get("ambiguous_region")
                and isinstance(drill_reg.get("region"), str)
                and str(drill_reg["region"]).strip()
                else None
            )
            raw_drill_el_idx = (
                drill_reg.get("element_index")
                if isinstance(drill_reg, Mapping) and "element_index" in drill_reg
                else (drill_reg.get("root_element_index") if isinstance(drill_reg, Mapping) else None)
            )
            drill_root_idx = (
                int(raw_drill_el_idx)
                if isinstance(raw_drill_el_idx, int) and not isinstance(raw_drill_el_idx, bool)
                else None
            )
            explicit_drill_tok = (
                str(drill_reg["region_token"]).strip()
                if isinstance(drill_reg, Mapping)
                and isinstance(drill_reg.get("region_token"), str)
                and ":" in str(drill_reg["region_token"])
                else None
            )
            if drill_region_name is not None or drill_root_idx is not None or explicit_drill_tok is not None:
                drill_obs_started = time.perf_counter()
                try:
                    drill_obs_args: dict[str, Any] = {
                        "pid": pid,
                        "window_id": window_id,
                        "include_screenshot": needs_pixel_anchor,
                        "tree_format": "both",
                    }
                    if query_val is not None:
                        drill_obs_args["query"] = query_val
                    if max_depth_val is not None:
                        drill_obs_args["max_depth"] = max_depth_val
                    if max_elements_val is not None:
                        drill_obs_args["max_elements"] = max_elements_val
                    if walk_timeout_ms_val is not None:
                        drill_obs_args["timeout_ms"] = walk_timeout_ms_val
                    elif driver.timeout_ms >= 4000:
                        drill_obs_args["timeout_ms"] = 5000
                    raw_drill = self._call_get_window_state(
                        driver,
                        drill_obs_args,
                        pid=pid,
                        window_id=window_id,
                        skeleton=False,
                        region=drill_region_name,
                        root_element_index=(None if drill_region_name is not None else drill_root_idx),
                        explicit_root_token=explicit_drill_tok,
                        allow_cached_root_token=(explicit_drill_tok is None),
                        caller_specified_max_elements=(max_elements_val is not None),
                        timeout_s=obs_call_timeout_s(driver, drill_obs_args.get("timeout_ms")),
                        deadline_monotonic=_deadline_monotonic,
                    )
                    if raw_drill.get("isError"):
                        err_txt = "".join(c.get("text", "") for c in (raw_drill.get("content") or []) if isinstance(c, Mapping))
                        raise RuntimeError(err_txt or "auto-drill get_window_state returned isError=true")
                    drilled_obs = extract_window_observation(
                        raw_drill,
                        expected_pid=pid,
                        expected_window_id=window_id,
                        query=query_val,
                        previous_observation=None,
                        skeleton=False,
                        region=drill_region_name,
                        root_element_index=(None if drill_region_name is not None else drill_root_idx),
                        max_elements_cap=self.max_elements_cap,
                        max_auto_candidates=self.max_auto_candidates,
                        enrich_descriptions=not self.v1_compat,
                    )
                    obs_ms = round(obs_ms + (time.perf_counter() - drill_obs_started) * 1000, 2)
                    self._update_window_token_cache(pid, window_id, drilled_obs)
                    self._snapshot_targets[drilled_obs["snapshot_id"]] = (pid, window_id)
                    pre_obs = drilled_obs
                    auto_drilled = True
                    is_hierarchy_scoped = True
                    skeleton_val = False
                    region_val = drill_region_name
                    root_element_index_val = None if drill_region_name is not None else drill_root_idx
                    obs_disclosure = {
                        "total_actionable_elements": pre_obs["total_actionable_elements"],
                        "omitted_elements_count": pre_obs["omitted_elements_count"],
                        "omitted_candidates_count": pre_obs["omitted_candidates_count"],
                        "observation_truncated": pre_obs["observation_truncated"],
                        "query_status": pre_obs.get("query_status"),
                        "query_incomplete": pre_obs.get("query_incomplete", False),
                        "search_complete": pre_obs.get("search_complete", True),
                        "visual_fallback_recommended": pre_obs.get("visual_fallback_recommended", False),
                        "drill_regions": pre_obs.get("drill_regions") or [],
                        "skeleton": False,
                        "region": pre_obs.get("region"),
                        "root_element_index": pre_obs.get("root_element_index"),
                    }
                    if pre_obs.get("active_surfaces"):
                        obs_disclosure["active_surfaces"] = pre_obs.get("active_surfaces") or []
                except Exception as exc:
                    obs_ms = round(obs_ms + (time.perf_counter() - drill_obs_started) * 1000, 2)
                    release_if_unowned()
                    payload = {
                        "schema": "agy_cua.jev_step_v1",
                        "status": "observation_failed",
                        "verification_outcome": "not_executed",
                        "reason": f"auto_drill_failed: {exc}",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                        "pre_snapshot_id": pre_obs["snapshot_id"],
                        "verified": False,
                        "action_dispatched": False,
                        "uncertain_side_effect": False,
                        "timings_ms": {
                            "observe_ms": obs_ms,
                            "provider_ms": provider_ms,
                            "dispatch_ms": 0.0,
                            "verify_ms": 0.0,
                            "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                        },
                        "accounting": self.accounting.to_dict(),
                    }
                    self._record_trace(payload)
                    return _format_tool_result(payload, is_error=True)

                b_cands_2, dec_2, p_ms_2, reranked_2, drill_sel_err = _build_and_select_for_obs(
                    pre_obs,
                    forbid_drill=True,
                )
                provider_ms = round(float(provider_ms) + float(p_ms_2), 2)
                reranked = bool(reranked or reranked_2)
                if drill_sel_err is not None:
                    drill_sel_err["timings_ms"]["provider_ms"] = provider_ms
                    drill_sel_err["auto_drilled"] = True
                    release_if_unowned()
                    self._record_trace(drill_sel_err)
                    return _format_tool_result(drill_sel_err, is_error=True)
                bound_candidates = b_cands_2
                decision = dec_2

        if decision["kind"] != "selected":
            release_if_unowned()
            payload = {
                "schema": "agy_cua.jev_step_v1",
                "status": decision["kind"],
                "verification_outcome": "not_executed",
                "reason": decision.get("reason") or decision["kind"],
                "note": decision.get("note"),
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "pre_snapshot_id": pre_obs["snapshot_id"],
                "pre_static_texts": pre_obs["static_texts"],
                **obs_disclosure,
                "selected_id": decision.get("selected_id"),
                "requested_model": decision.get("requested_model"),
                "returned_model": decision.get("returned_model"),
                "sdk_identity": CLIENT_IDENTITY,
                "confidence": decision.get("confidence"),
                "probabilities": decision.get("probabilities"),
                "reranked": reranked,
                "auto_drilled": auto_drilled,
                "verified": False,
                "action_dispatched": False,
                "uncertain_side_effect": False,
                "timings_ms": {
                    "observe_ms": obs_ms,
                    "provider_ms": provider_ms,
                    "dispatch_ms": 0.0,
                    "verify_ms": 0.0,
                    "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                },
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=(decision["kind"] == "error"))

        # Stage 4: Local controller authorization & background Driver dispatch
        try:
            authorized = authorize_candidate_dispatch(
                decision,
                bound_candidates,
                expected_pid=pid,
                expected_window_id=window_id,
                current_snapshot_id=pre_obs["snapshot_id"],
                valid_element_indices=pre_obs["indexed_element_ids"],
                observation=pre_obs,
            )
        except Exception as exc:
            release_if_unowned()
            payload = {
                "schema": "agy_cua.jev_step_v1",
                "status": "authorization_refused",
                "verification_outcome": "not_executed",
                "reason": str(exc),
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "pre_snapshot_id": pre_obs["snapshot_id"],
                **obs_disclosure,
                "selected_id": decision.get("selected_id"),
                "returned_model": decision.get("returned_model"),
                "confidence": decision.get("confidence"),
                "probabilities": decision.get("probabilities"),
                "reranked": reranked,
                "auto_drilled": auto_drilled,
                "verified": False,
                "action_dispatched": False,
                "uncertain_side_effect": False,
                "timings_ms": {
                    "observe_ms": obs_ms,
                    "provider_ms": provider_ms,
                    "dispatch_ms": 0.0,
                    "verify_ms": 0.0,
                    "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                },
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)

        target_el_idx = authorized["arguments"].get("element_index")
        driver_args = {
            k: v
            for k, v in authorized["arguments"].items()
            if k not in {"element_index", "snapshot_id"}
        }
        if target_el_idx is not None:
            driver_args["element_token"] = f"{pre_obs['snapshot_id']}:{target_el_idx}"
        if authorized["tool"] == "set_value":
            driver_args.pop("delivery_mode", None)
        sanitized_args = {
            k: ("<redacted>" if k in {"text", "value"} else v)
            for k, v in driver_args.items()
        }
        try:
            dispatch_timeout_s = remaining_timeout_s(driver.timeout_ms / 1000.0)
        except TimeoutError as exc:
            release_if_unowned()
            payload = {
                "schema": "agy_cua.jev_step_v1",
                "status": "batch_timeout",
                "verification_outcome": "not_executed",
                "reason": str(exc),
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "pre_snapshot_id": pre_obs["snapshot_id"],
                "selected_id": authorized["id"],
                "returned_model": decision.get("returned_model"),
                "confidence": decision.get("confidence"),
                "probabilities": decision.get("probabilities"),
                "reranked": reranked,
                "auto_drilled": auto_drilled,
                "verified": False,
                "action_dispatched": False,
                "uncertain_side_effect": False,
                "timings_ms": {
                    "observe_ms": obs_ms,
                    "provider_ms": provider_ms,
                    "dispatch_ms": 0.0,
                    "verify_ms": 0.0,
                    "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                },
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)

        explicit_discover_windows = args.get("discover_windows") is True
        pre_same_pid_windows: list[dict[str, Any]] = []
        if explicit_discover_windows:
            pre_same_pid_windows = _discover_same_pid_windows(
                driver,
                pid,
                window_id,
                timeout_s=min(1.0, dispatch_timeout_s),
                deadline_monotonic=_deadline_monotonic,
            )

        already_in_target_state: bool | None = None
        pre_checkbox_label: str | None = None
        pre_checkbox_container_path: str = ""
        pre_ambiguous_same_container_cb = False
        if authorized["tool"] in {"check", "uncheck"}:
            pre_els_chk = pre_obs.get("all_elements") or pre_obs.get("elements") or pre_obs.get("_raw_elements") or []
            pre_cpaths = pre_obs.get("_container_paths") if isinstance(pre_obs.get("_container_paths"), Mapping) else {}
            cb_el = next(
                (
                    e
                    for e in pre_els_chk
                    if isinstance(e, Mapping) and e.get("element_index") == target_el_idx
                ),
                None,
            )
            pre_checkbox_label = str(cb_el.get("label") or "") if isinstance(cb_el, Mapping) else None
            pre_checkbox_container_path = str(
                (cb_el.get("container_path") if isinstance(cb_el, Mapping) else None)
                or pre_cpaths.get(target_el_idx)
                or ""
            )
            if pre_checkbox_label:
                same_scope_cbs = [
                    e
                    for e in pre_els_chk
                    if isinstance(e, Mapping)
                    and e.get("role") == "AXCheckBox"
                    and str(e.get("label") or "") == pre_checkbox_label
                    and str(
                        e.get("container_path")
                        or (pre_cpaths.get(e.get("element_index")) if isinstance(e.get("element_index"), int) else "")
                        or ""
                    )
                    == pre_checkbox_container_path
                ]
                pre_ambiguous_same_container_cb = len(same_scope_cbs) > 1
            cb_raw_val = (
                (cb_el.get("value") if cb_el.get("value") is not None else cb_el.get("value_state"))
                if isinstance(cb_el, Mapping)
                else None
            )
            cur_cb_bool = _parse_checkbox_bool_state(cb_raw_val)
            desired_cb_bool = authorized["tool"] == "check"
            already_in_target_state = cur_cb_bool == desired_cb_bool

        self._visual_snapshots.pop((pid, window_id), None)
        self._window_token_cache.pop((pid, window_id), None)
        if already_in_target_state is True:
            action_dispatched = False
            dispatch_ms = 0.0
            safe_receipt = f"already_{'checked' if authorized['tool'] == 'check' else 'unchecked'}_noop"
        else:
            action_dispatched = True
            actual_driver_tool = "click" if authorized["tool"] in {"check", "uncheck"} else authorized["tool"]
            dispatch_started = time.perf_counter()
            try:
                dispatch_res = driver.call_tool(
                    actual_driver_tool,
                    driver_args,
                    timeout_s=dispatch_timeout_s,
                    deadline_monotonic=_deadline_monotonic,
                )
                dispatch_text = "".join(
                    c.get("text", "") for c in (dispatch_res.get("content") or []) if isinstance(c, Mapping)
                ).strip()
                if dispatch_res.get("isError"):
                    raise RuntimeError(dispatch_text or "Driver tool returned isError=true")
            except Exception as exc:
                dispatch_ms = round((time.perf_counter() - dispatch_started) * 1000, 2)
                # Retain ambiguous/failed side-effect and halt automatic repetition
                self.accounting.uncertain_side_effects += 1
                self.accounting.halted = True
                self.accounting.halt_reason = "uncertain_dispatch_side_effect"
                payload = {
                    "schema": "agy_cua.jev_step_v1",
                    "status": "dispatch_failed",
                    "verification_outcome": "outcome_unknown",
                    "reason": str(exc),
                    "pid": pid,
                    "window_id": window_id,
                    "session_id": self.session_id,
                    "pre_snapshot_id": pre_obs["snapshot_id"],
                    **obs_disclosure,
                    "selected_id": authorized["id"],
                    "dispatched_tool": authorized["tool"],
                    "dispatched_arguments": sanitized_args,
                    "returned_model": decision.get("returned_model"),
                    "confidence": decision.get("confidence"),
                    "probabilities": decision.get("probabilities"),
                    "reranked": reranked,
                    "auto_drilled": auto_drilled,
                    "verified": False,
                    "action_dispatched": True,
                    "uncertain_side_effect": True,
                    "timings_ms": {
                        "observe_ms": obs_ms,
                        "provider_ms": provider_ms,
                        "dispatch_ms": dispatch_ms,
                        "verify_ms": 0.0,
                        "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                    },
                    "accounting": self.accounting.to_dict(),
                }
                self._record_trace(payload)
                return _format_tool_result(payload, is_error=True)
            dispatch_ms = round((time.perf_counter() - dispatch_started) * 1000, 2)
            safe_receipt = "<redacted>" if authorized["tool"] in {"type_text", "set_value"} else dispatch_text

        # Stage 5: Fresh observation & independent postcondition verification
        expected_post = args.get("expected_postcondition")
        is_checkbox_op = authorized["tool"] in {"check", "uncheck"}
        eff_wait_ms = (
            0
            if (expected_post is None and not (is_checkbox_op and action_dispatched))
            else (
                wait_timeout_ms_val
                if wait_timeout_ms_val is not None
                else (0 if self.v1_compat else DEFAULT_V2_WAIT_TIMEOUT_MS)
            )
        )
        verify_polls = 0
        verify_started = time.perf_counter()
        verify_started_mono = time.monotonic()
        try:
            post_obs_args: dict[str, Any] = {
                "pid": pid,
                "window_id": window_id,
                "include_screenshot": False,
                "tree_format": "both",
            }
            if query_val is not None:
                post_obs_args["query"] = query_val
            if max_depth_val is not None:
                post_obs_args["max_depth"] = max_depth_val
            if max_elements_val is not None:
                post_obs_args["max_elements"] = max_elements_val
            if walk_timeout_ms_val is not None:
                post_obs_args["timeout_ms"] = walk_timeout_ms_val
            elif not self.v1_compat and is_hierarchy_scoped and driver.timeout_ms >= 4000:
                post_obs_args["timeout_ms"] = 5000

            def _bound_post_call_params(
                base_args: Mapping[str, Any],
                poll_deadline: float | None,
            ) -> tuple[dict[str, Any], float, float | None]:
                call_args = dict(base_args)
                eff_deadline = _deadline_monotonic
                if poll_deadline is not None:
                    now_m = time.monotonic()
                    if _deadline_monotonic is not None and _deadline_monotonic - now_m <= 0:
                        raise TimeoutError("batch_deadline_exceeded")
                    eff_deadline = poll_deadline if eff_deadline is None else min(eff_deadline, poll_deadline)
                    rem_s = eff_deadline - now_m
                    rem_ms = int(rem_s * 1000)
                    if rem_s <= 0 or rem_ms < MIN_OBSERVE_WALK_TIMEOUT_MS:
                        if _deadline_monotonic is not None and _deadline_monotonic <= poll_deadline and (_deadline_monotonic - now_m) < (MIN_OBSERVE_WALK_TIMEOUT_MS / 1000.0):
                            raise TimeoutError("batch_deadline_exceeded")
                        raise TimeoutError("settle_timeout_exceeded")
                    walk_cap = (
                        max(MIN_OBSERVE_WALK_TIMEOUT_MS, rem_ms - 50)
                        if rem_ms > MIN_OBSERVE_WALK_TIMEOUT_MS + 50
                        else rem_ms
                    )
                    cur_walk = call_args.get("timeout_ms")
                    call_args["timeout_ms"] = min(cur_walk, walk_cap) if isinstance(cur_walk, int) else walk_cap
                    call_timeout_s = min(obs_call_timeout_s(driver, call_args.get("timeout_ms")), rem_s)
                else:
                    call_timeout_s = obs_call_timeout_s(driver, call_args.get("timeout_ms"))
                return call_args, call_timeout_s, eff_deadline

            def _read_post_observation(
                baseline_obs: Mapping[str, Any] | None,
                *,
                poll_deadline: float | None = None,
            ) -> dict[str, Any]:
                eff_base = None if is_hierarchy_scoped else baseline_obs
                post_root_tok = (
                    self._resolve_post_obs_root_token(
                        baseline_obs,
                        region=region_val,
                        root_element_index=root_element_index_val,
                    )
                    if baseline_obs is not None
                    else None
                )
                call_args, call_timeout_s, eff_deadline = _bound_post_call_params(post_obs_args, poll_deadline)
                raw_p = self._call_get_window_state(
                    driver,
                    call_args,
                    pid=pid,
                    window_id=window_id,
                    skeleton=skeleton_val,
                    region=region_val,
                    root_element_index=root_element_index_val,
                    explicit_root_token=post_root_tok,
                    allow_cached_root_token=False,
                    caller_specified_max_elements=(max_elements_val is not None),
                    timeout_s=call_timeout_s,
                    deadline_monotonic=eff_deadline,
                )
                if raw_p.get("isError"):
                    err_t = "".join(c.get("text", "") for c in (raw_p.get("content") or []) if isinstance(c, Mapping))
                    raise RuntimeError(err_t or "post-dispatch get_window_state returned isError=true")
                try:
                    obs_p = extract_window_observation(
                        raw_p,
                        expected_pid=pid,
                        expected_window_id=window_id,
                        query=query_val,
                        previous_observation=eff_base,
                        skeleton=skeleton_val,
                        region=region_val,
                        root_element_index=root_element_index_val,
                        max_elements_cap=self.max_elements_cap,
                        max_auto_candidates=self.max_auto_candidates,
                        enrich_descriptions=not self.v1_compat,
                    )
                except ValueError as diff_exc:
                    if "invalid_diff_baseline" not in str(diff_exc):
                        raise
                    fb_base = dict(post_obs_args, include_diff=False, tree_format="both")
                    fb_args, fb_timeout_s, fb_deadline = _bound_post_call_params(fb_base, poll_deadline)
                    raw_p = self._call_get_window_state(
                        driver,
                        fb_args,
                        pid=pid,
                        window_id=window_id,
                        skeleton=skeleton_val,
                        region=region_val,
                        root_element_index=root_element_index_val,
                        explicit_root_token=post_root_tok,
                        allow_cached_root_token=False,
                        caller_specified_max_elements=(max_elements_val is not None),
                        timeout_s=fb_timeout_s,
                        deadline_monotonic=fb_deadline,
                    )
                    if raw_p.get("isError"):
                        err_t = "".join(c.get("text", "") for c in (raw_p.get("content") or []) if isinstance(c, Mapping))
                        raise RuntimeError(err_t or "post-dispatch get_window_state fallback returned isError=true")
                    obs_p = extract_window_observation(
                        raw_p,
                        expected_pid=pid,
                        expected_window_id=window_id,
                        query=query_val,
                        previous_observation=None,
                        skeleton=skeleton_val,
                        region=region_val,
                        root_element_index=root_element_index_val,
                        max_elements_cap=self.max_elements_cap,
                        max_auto_candidates=self.max_auto_candidates,
                        enrich_descriptions=not self.v1_compat,
                    )
                self._update_window_token_cache(pid, window_id, obs_p)
                return obs_p

            def _checkbox_matches_desired(obs_check: Mapping[str, Any]) -> bool:
                if not is_checkbox_op:
                    return False
                if obs_check.get("snapshot_id") == pre_obs.get("snapshot_id"):
                    return False
                if bool(obs_check.get("native_root_element_token")) != bool(pre_obs.get("native_root_element_token")):
                    return False
                desired_b = authorized["tool"] == "check"
                obs_sec_ids = set(obs_check.get("secure_element_ids") or ())
                obs_cpaths = (
                    obs_check.get("_container_paths")
                    if isinstance(obs_check.get("_container_paths"), Mapping)
                    else {}
                )

                def _cpath_matches(elem: Mapping[str, Any]) -> bool:
                    e_idx = elem.get("element_index")
                    cand_cp = str(
                        elem.get("container_path")
                        or (obs_cpaths.get(e_idx) if isinstance(e_idx, int) else "")
                        or ""
                    )
                    return cand_cp == pre_checkbox_container_path

                els_c = obs_check.get("all_elements") or obs_check.get("elements") or obs_check.get("_raw_elements") or []
                cand_el = next(
                    (
                        e
                        for e in els_c
                        if isinstance(e, Mapping)
                        and e.get("element_index") == target_el_idx
                        and e.get("element_index") not in obs_sec_ids
                        and e.get("role") == "AXCheckBox"
                        and (not pre_checkbox_label or str(e.get("label") or "") == pre_checkbox_label)
                        and _cpath_matches(e)
                    ),
                    None,
                )
                if cand_el is None and pre_checkbox_label and not pre_ambiguous_same_container_cb:
                    lbl_matches = [
                        e
                        for e in els_c
                        if isinstance(e, Mapping)
                        and e.get("element_index") not in obs_sec_ids
                        and e.get("role") == "AXCheckBox"
                        and str(e.get("label") or "") == pre_checkbox_label
                        and _cpath_matches(e)
                    ]
                    if len(lbl_matches) == 1:
                        cand_el = lbl_matches[0]
                if cand_el is None:
                    return False
                cand_raw_val = cand_el.get("value") if cand_el.get("value") is not None else cand_el.get("value_state")
                return _parse_checkbox_bool_state(cand_raw_val) == desired_b

            post_obs = _read_post_observation(pre_obs)
            verify_polls = 1
            if not post_obs.get("query_incomplete") and not is_hierarchy_scoped:
                self._last_observations[(pid, window_id)] = post_obs
            self._snapshot_targets[post_obs["snapshot_id"]] = (pid, window_id)
            state_changed, post_ok, verify_reason = check_postcondition(
                expected_post,
                pre_obs,
                post_obs,
                target_element_index=target_el_idx,
            )
            fresh_post_snap = post_obs.get("snapshot_id") != pre_obs.get("snapshot_id")
            cb_satisfied = fresh_post_snap and _checkbox_matches_desired(post_obs)
            if is_checkbox_op and not cb_satisfied:
                post_ok = False
                if fresh_post_snap:
                    verify_reason = f"checkbox_target_state_unmet ({authorized['tool']})"
            elif is_checkbox_op and already_in_target_state is True and cb_satisfied:
                if expected_post is None or (isinstance(expected_post, Mapping) and expected_post.get("kind") == "any_change"):
                    post_ok = True
                    verify_reason = "idempotent_checkbox_already_in_target_state"
            need_cb_poll = bool(is_checkbox_op and action_dispatched and fresh_post_snap and not cb_satisfied)
            if eff_wait_ms > 0 and ((not post_ok and _is_retryable_postcondition_reason(verify_reason)) or need_cb_poll):
                settle_deadline = verify_started_mono + (eff_wait_ms / 1000.0)
                if _deadline_monotonic is not None:
                    settle_deadline = min(settle_deadline, _deadline_monotonic - 0.05)
                min_poll_read_s = MIN_OBSERVE_WALK_TIMEOUT_MS / 1000.0
                while (not post_ok and _is_retryable_postcondition_reason(verify_reason)) or need_cb_poll:
                    rem_settle = settle_deadline - time.monotonic()
                    if rem_settle <= min_poll_read_s + 0.01:
                        break
                    time.sleep(min(0.10, max(0.01, rem_settle - min_poll_read_s)))
                    if settle_deadline - time.monotonic() < min_poll_read_s:
                        break
                    try:
                        post_obs = _read_post_observation(post_obs, poll_deadline=settle_deadline)
                    except TimeoutError as settle_exc:
                        if _deadline_monotonic is not None and time.monotonic() >= _deadline_monotonic - 0.05:
                            raise
                        if "batch_deadline" in str(settle_exc):
                            raise
                        break
                    verify_polls += 1
                    if not post_obs.get("query_incomplete") and not is_hierarchy_scoped:
                        self._last_observations[(pid, window_id)] = post_obs
                    self._snapshot_targets[post_obs["snapshot_id"]] = (pid, window_id)
                    state_changed, post_ok, verify_reason = check_postcondition(
                        expected_post,
                        pre_obs,
                        post_obs,
                        target_element_index=target_el_idx,
                    )
                    fresh_post_snap = post_obs.get("snapshot_id") != pre_obs.get("snapshot_id")
                    cb_satisfied = fresh_post_snap and _checkbox_matches_desired(post_obs)
                    if is_checkbox_op and not cb_satisfied:
                        post_ok = False
                        if fresh_post_snap:
                            verify_reason = f"checkbox_target_state_unmet ({authorized['tool']})"
                    elif is_checkbox_op and already_in_target_state is True and cb_satisfied:
                        if expected_post is None or (isinstance(expected_post, Mapping) and expected_post.get("kind") == "any_change"):
                            post_ok = True
                            verify_reason = "idempotent_checkbox_already_in_target_state"
                    need_cb_poll = bool(is_checkbox_op and action_dispatched and fresh_post_snap and not cb_satisfied)
        except Exception as exc:
            verify_ms = round((time.perf_counter() - verify_started) * 1000, 2)
            self._last_observations.pop((pid, window_id), None)
            if action_dispatched:
                self.accounting.uncertain_side_effects += 1
                self.accounting.halted = True
                self.accounting.halt_reason = "uncertain_verification_after_dispatch"
            else:
                release_if_unowned()
            payload = {
                "schema": "agy_cua.jev_step_v1",
                "status": "verification_failed",
                "verification_outcome": "outcome_unknown" if action_dispatched else "not_executed",
                "reason": str(exc),
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "pre_snapshot_id": pre_obs["snapshot_id"],
                **obs_disclosure,
                "selected_id": authorized["id"],
                "dispatched_tool": authorized["tool"],
                "dispatch_receipt": safe_receipt,
                "returned_model": decision.get("returned_model"),
                "confidence": decision.get("confidence"),
                "probabilities": decision.get("probabilities"),
                "reranked": reranked,
                "auto_drilled": auto_drilled,
                "verified": False,
                "action_dispatched": action_dispatched,
                "already_in_target_state": already_in_target_state,
                "uncertain_side_effect": action_dispatched,
                "timings_ms": {
                    "observe_ms": obs_ms,
                    "provider_ms": provider_ms,
                    "dispatch_ms": dispatch_ms,
                    "verify_ms": verify_ms,
                    "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
                },
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)

        discovered_windows: list[dict[str, Any]] = []
        newly_opened_windows: list[dict[str, Any]] = []
        should_discover_post = explicit_discover_windows or (
            action_dispatched
            and args.get("discover_windows") is not False
            and _out_post_sig is None
            and not state_changed
            and not post_ok
        )
        if should_discover_post:
            discovered_windows = _discover_same_pid_windows(
                driver,
                pid,
                window_id,
                timeout_s=min(0.4, obs_call_timeout_s(driver, post_obs_args.get("timeout_ms"))),
                deadline_monotonic=_deadline_monotonic,
            )
            pre_wids = {w["window_id"] for w in pre_same_pid_windows} | {window_id}
            newly_opened_windows = [w for w in discovered_windows if w["window_id"] not in pre_wids]
            if newly_opened_windows and not post_ok:
                state_changed = True
                if expected_post is None:
                    verify_reason = "new_same_pid_window_discovered"

        verify_ms = round((time.perf_counter() - verify_started) * 1000, 2)

        self._update_target_snapshot(pid, window_id, post_obs["snapshot_id"])
        if _out_post_sig is not None:
            _out_post_sig.append(_obs_state_signature(post_obs))
        if _out_post_obs is not None:
            _out_post_obs.append(post_obs)

        if expected_post is None:
            if is_checkbox_op and already_in_target_state is True and cb_satisfied:
                post_ok = True
                verification_outcome = "goal_verified"
                step_status = "verified"
                is_err = False
            elif is_checkbox_op and action_dispatched and cb_satisfied:
                post_ok = True
                state_changed = True
                verify_reason = f"checkbox_{'checked' if authorized['tool'] == 'check' else 'unchecked'}_verified"
                verification_outcome = "state_changed"
                step_status = "state_changed"
                is_err = False
            elif is_checkbox_op:
                post_ok = False
                verification_outcome = "state_changed" if state_changed else ("noop" if not action_dispatched else "dispatched")
                step_status = "postcondition_unmet"
                is_err = True
            else:
                verification_outcome = "state_changed" if state_changed else "dispatched"
                step_status = verification_outcome
                is_err = False
        elif post_ok:
            verification_outcome = "goal_verified"
            step_status = "verified"
            is_err = False
        else:
            verification_outcome = "state_changed" if state_changed else ("noop" if not action_dispatched else "dispatched")
            step_status = "postcondition_unmet"
            is_err = True

        post_obs_disclosure = {
            **obs_disclosure,
            "pre_observation_truncated": pre_obs["observation_truncated"],
            "post_total_actionable_elements": post_obs["total_actionable_elements"],
            "post_omitted_elements_count": post_obs["omitted_elements_count"],
            "post_omitted_candidates_count": post_obs["omitted_candidates_count"],
            "post_observation_truncated": post_obs["observation_truncated"],
            "post_query_status": post_obs.get("query_status"),
            "post_query_incomplete": post_obs.get("query_incomplete", False),
            "post_search_complete": post_obs.get("search_complete", True),
            "post_visual_fallback_recommended": post_obs.get("visual_fallback_recommended", False),
            "observation_truncated": bool(
                pre_obs["observation_truncated"] or post_obs["observation_truncated"]
            ),
        }
        if post_obs.get("active_surfaces"):
            post_obs_disclosure["post_active_surfaces"] = post_obs.get("active_surfaces") or []

        point_fallback_used = bool(target_el_idx is None and ("x" in driver_args or "y" in driver_args))
        payload = {
            "schema": "agy_cua.jev_step_v1",
            "status": step_status,
            "verification_outcome": verification_outcome,
            "verified": post_ok,
            "action_dispatched": action_dispatched,
            "already_in_target_state": already_in_target_state,
            "auto_drilled": auto_drilled,
            "point_fallback_used": point_fallback_used,
            "uncertain_side_effect": False,
            "verification_reason": verify_reason,
            "verify_polls": verify_polls,
            "reranked": reranked,
            "state_changed": state_changed,
            "pid": pid,
            "window_id": window_id,
            "session_id": self.session_id,
            "mode": mode,
            "source_snapshot_id": source_snap,
            "pre_snapshot_id": pre_obs["snapshot_id"],
            "post_snapshot_id": post_obs["snapshot_id"],
            "pre_static_texts": pre_obs["static_texts"],
            "post_static_texts": post_obs["static_texts"],
            "discovered_windows": discovered_windows,
            "newly_opened_windows": newly_opened_windows,
            **post_obs_disclosure,
            "selected_id": authorized["id"],
            "selected_description": authorized["description"],
            "dispatched_tool": authorized["tool"],
            "dispatched_arguments": sanitized_args,
            "dispatch_receipt": safe_receipt,
            "requested_model": decision.get("requested_model"),
            "returned_model": decision.get("returned_model"),
            "sdk_identity": CLIENT_IDENTITY,
            "route": decision.get("route"),
            "confidence": decision.get("confidence"),
            "probabilities": decision.get("probabilities"),
            "timings_ms": {
                "observe_ms": obs_ms,
                "provider_ms": provider_ms,
                "dispatch_ms": dispatch_ms,
                "verify_ms": verify_ms,
                "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
            },
            "accounting": self.accounting.to_dict(),
        }
        self._record_trace(payload)
        return _format_tool_result(payload, is_error=is_err)

    def handle_observe(self, args: Mapping[str, Any]) -> dict[str, Any]:
        obs_started = time.perf_counter()
        if not isinstance(args, Mapping):
            return _format_tool_result(
                {"schema": "agy_cua.jev_observe_v1", "status": "refused", "reason": "invalid_arguments"},
                is_error=True,
            )
        pid = args.get("pid")
        window_id = args.get("window_id")
        if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
            return _format_tool_result(
                {"schema": "agy_cua.jev_observe_v1", "status": "refused", "reason": "invalid_pid"},
                is_error=True,
            )
        if not isinstance(window_id, int) or isinstance(window_id, bool) or window_id <= 0:
            return _format_tool_result(
                {"schema": "agy_cua.jev_observe_v1", "status": "refused", "reason": "invalid_window_id"},
                is_error=True,
            )
        query_val: str | None = None
        if "query" in args and args["query"] is not None:
            raw_q = args["query"]
            if not isinstance(raw_q, str) or not raw_q.strip():
                return _format_tool_result(
                    {"schema": "agy_cua.jev_observe_v1", "status": "refused", "reason": "invalid_query"},
                    is_error=True,
                )
            query_val = raw_q.strip()

        skeleton_val = False
        if "skeleton" in args and args["skeleton"] is not None:
            if not isinstance(args["skeleton"], bool):
                return _format_tool_result(
                    {"schema": "agy_cua.jev_observe_v1", "status": "refused", "reason": "invalid_skeleton"},
                    is_error=True,
                )
            skeleton_val = args["skeleton"]

        region_val: str | None = None
        if "region" in args and args["region"] is not None:
            raw_region = args["region"]
            if not isinstance(raw_region, str) or not raw_region.strip():
                return _format_tool_result(
                    {"schema": "agy_cua.jev_observe_v1", "status": "refused", "reason": "invalid_region"},
                    is_error=True,
                )
            region_val = raw_region.strip()

        root_element_index_val: int | None = None
        if "root_element_index" in args and args["root_element_index"] is not None:
            raw_root_idx = args["root_element_index"]
            if not isinstance(raw_root_idx, int) or isinstance(raw_root_idx, bool) or raw_root_idx < 0:
                return _format_tool_result(
                    {"schema": "agy_cua.jev_observe_v1", "status": "refused", "reason": "invalid_root_element_index"},
                    is_error=True,
                )
            root_element_index_val = raw_root_idx

        is_hierarchy_scoped = bool(skeleton_val or region_val is not None or root_element_index_val is not None)

        want_screenshot = bool(args.get("include_screenshot", False))
        if want_screenshot:
            self._visual_snapshots.pop((pid, window_id), None)
        obs_call_args: dict[str, Any] = {
            "pid": pid,
            "window_id": window_id,
            "include_screenshot": want_screenshot,
            "tree_format": "both",
        }
        if query_val is not None:
            obs_call_args["query"] = query_val
        if "max_depth" in args and args["max_depth"] is not None:
            obs_call_args["max_depth"] = args["max_depth"]
        if "max_elements" in args and args["max_elements"] is not None:
            obs_call_args["max_elements"] = args["max_elements"]
        elif not self.v1_compat and is_hierarchy_scoped:
            obs_call_args["max_elements"] = 2000
        if "walk_timeout_ms" in args and args["walk_timeout_ms"] is not None:
            obs_call_args["timeout_ms"] = args["walk_timeout_ms"]
        if "include_diff" in args and isinstance(args["include_diff"], bool):
            obs_call_args["include_diff"] = args["include_diff"]

        diff_fallback_used = False
        try:
            if not self.v1_compat and not self._driver_client_injected and not self.env.get("AGY_CUA_DRIVER"):
                wake_macos_app_nap(pid)
            driver = self._get_driver()
            if (
                not self.v1_compat
                and is_hierarchy_scoped
                and "timeout_ms" not in obs_call_args
                and driver.timeout_ms >= 4000
            ):
                obs_call_args["timeout_ms"] = 5000
            raw_walk_to = obs_call_args.get("timeout_ms")
            obs_rpc_timeout_s = (
                max(driver.timeout_ms, raw_walk_to + 1000) / 1000.0
                if (isinstance(raw_walk_to, int) and not isinstance(raw_walk_to, bool) and raw_walk_to > 0)
                else None
            )
            raw_obs = self._call_get_window_state(
                driver,
                obs_call_args,
                pid=pid,
                window_id=window_id,
                skeleton=skeleton_val,
                region=region_val,
                root_element_index=root_element_index_val,
                caller_specified_max_elements=("max_elements" in args and args["max_elements"] is not None),
                timeout_s=obs_rpc_timeout_s,
            )
            if raw_obs.get("isError"):
                err_txt = "".join(c.get("text", "") for c in (raw_obs.get("content") or []) if isinstance(c, Mapping))
                raise RuntimeError(err_txt or "get_window_state returned isError=true")
            prev_baseline = None if is_hierarchy_scoped else self._last_observations.get((pid, window_id))
            try:
                obs = extract_window_observation(
                    raw_obs,
                    expected_pid=pid,
                    expected_window_id=window_id,
                    query=query_val,
                    previous_observation=prev_baseline,
                    skeleton=skeleton_val,
                    region=region_val,
                    root_element_index=root_element_index_val,
                    max_elements_cap=self.max_elements_cap,
                    max_auto_candidates=self.max_auto_candidates,
                    enrich_descriptions=not self.v1_compat,
                )
            except ValueError as diff_exc:
                if "invalid_diff_baseline" not in str(diff_exc):
                    raise
                diff_fallback_used = True
                fallback_args = dict(obs_call_args, include_diff=False, tree_format="both")
                raw_obs = self._call_get_window_state(
                    driver,
                    fallback_args,
                    pid=pid,
                    window_id=window_id,
                    skeleton=skeleton_val,
                    region=region_val,
                    root_element_index=root_element_index_val,
                    caller_specified_max_elements=("max_elements" in args and args["max_elements"] is not None),
                    timeout_s=obs_rpc_timeout_s,
                )
                if raw_obs.get("isError"):
                    err_txt = "".join(c.get("text", "") for c in (raw_obs.get("content") or []) if isinstance(c, Mapping))
                    raise RuntimeError(err_txt or "get_window_state fallback returned isError=true")
                obs = extract_window_observation(
                    raw_obs,
                    expected_pid=pid,
                    expected_window_id=window_id,
                    query=query_val,
                    previous_observation=None,
                    skeleton=skeleton_val,
                    region=region_val,
                    root_element_index=root_element_index_val,
                    max_elements_cap=self.max_elements_cap,
                    max_auto_candidates=self.max_auto_candidates,
                    enrich_descriptions=not self.v1_compat,
                )
            if not obs.get("query_incomplete") and not is_hierarchy_scoped:
                self._last_observations[(pid, window_id)] = obs
            self._snapshot_targets[obs["snapshot_id"]] = (pid, window_id)
            self._update_window_token_cache(pid, window_id, obs)
            discovered_windows: list[dict[str, Any]] = []
            if bool(args.get("discover_windows", True)):
                discovered_windows = _discover_same_pid_windows(driver, pid, window_id)
        except Exception as exc:
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_observe_v1",
                    "status": "observation_failed",
                    "reason": str(exc),
                    "pid": pid,
                    "window_id": window_id,
                    "session_id": self.session_id,
                    "observe_ms": round((time.perf_counter() - obs_started) * 1000, 2),
                },
                is_error=True,
            )

        secure_redacted_count = len(obs.get("secure_element_ids") or ()) + int(
            bool(obs.get("_has_unindexed_secure_node"))
        )
        if want_screenshot and secure_redacted_count > 0:
            refused_payload = {
                "schema": "agy_cua.jev_observe_v1",
                "status": "screenshot_refused_secure_window",
                "reason": (
                    "screenshot_refused_secure_window: cannot return window screenshot when secure fields are present"
                ),
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "snapshot_id": obs["snapshot_id"],
                "secure_fields_redacted_count": secure_redacted_count,
                "observe_ms": round((time.perf_counter() - obs_started) * 1000, 2),
            }
            self._record_trace(refused_payload)
            return _format_tool_result(refused_payload, is_error=True)

        image_blocks = [
            dict(item)
            for item in (raw_obs.get("content") or [])
            if isinstance(item, Mapping) and item.get("type") == "image" and item.get("data")
        ]
        capture_metadata = raw_obs.get("structuredContent")
        capture_metadata = capture_metadata if isinstance(capture_metadata, Mapping) else {}
        if want_screenshot and capture_metadata.get("screenshot_frame_valid") is False:
            image_blocks = []
        if want_screenshot and image_blocks:
            self._visual_snapshots[(pid, window_id)] = obs["snapshot_id"]
            self._visual_snapshot_targets[obs["snapshot_id"]] = (pid, window_id)
        elif not want_screenshot and not obs.get("query_incomplete") and not is_hierarchy_scoped:
            self._visual_snapshots.pop((pid, window_id), None)

        payload = {
            "schema": "agy_cua.jev_observe_v1",
            "status": "ok",
            "pid": pid,
            "window_id": window_id,
            "session_id": self.session_id,
            "snapshot_id": obs["snapshot_id"],
            "app_name": obs["app_name"],
            "window_title": obs["window_title"],
            "window_bounds": obs.get("window_bounds"),
            "elements": obs["elements"],
            "static_texts": obs["static_texts"],
            "skeleton": bool(obs.get("skeleton", False)),
            "region": obs.get("region"),
            "root_element_index": obs.get("root_element_index"),
            "drill_regions": obs.get("drill_regions") or [],
            "active_surfaces": obs.get("active_surfaces") or [],
            "total_actionable_elements": obs["total_actionable_elements"],
            "omitted_elements_count": obs["omitted_elements_count"],
            "omitted_candidates_count": obs["omitted_candidates_count"],
            "observation_truncated": obs["observation_truncated"],
            "secure_fields_redacted_count": secure_redacted_count,
            "query": obs.get("query"),
            "matched_elements_count": obs.get("matched_elements_count"),
            "query_status": obs.get("query_status"),
            "query_incomplete": obs.get("query_incomplete", False),
            "search_complete": obs.get("search_complete", True),
            "visual_fallback_recommended": obs.get("visual_fallback_recommended", False),
            "is_diff": obs.get("is_diff", False),
            "diff_from_snapshot_id": obs.get("diff_from_snapshot_id"),
            "diff_fallback_used": diff_fallback_used,
            "discovered_windows": discovered_windows,
            "observe_ms": round((time.perf_counter() - obs_started) * 1000, 2),
        }
        if want_screenshot and not image_blocks:
            payload["screenshot_frame_valid"] = False
            capture_error = capture_metadata.get("screenshot_error")
            payload["screenshot_error"] = dict(capture_error) if isinstance(capture_error, Mapping) else {
                "code": "screenshot_unavailable",
                "reason": "The requested screenshot was not returned",
            }
        res_out = _format_tool_result(payload, is_error=False)
        if want_screenshot and image_blocks:
            res_out.setdefault("content", []).extend(image_blocks)
        return res_out

    def handle_browser_prepare(self, args: Mapping[str, Any]) -> dict[str, Any]:
        try:
            validated = validate_browser_prepare_args(args if isinstance(args, Mapping) else {})
        except ValueError as exc:
            payload = {
                "schema": "agy_cua.jev_browser_prepare_v1",
                "status": "refused",
                "reason": str(exc),
                "session_id": self.session_id,
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)

        try:
            driver = self._get_driver()
            prep_timeout_s = max(driver.timeout_ms / 1000.0, 15.0)
            driver_prep_args: dict[str, Any] = {
                "allow_launch": True,
                "profile": validated["profile"],
            }
            if "browser" in validated:
                driver_prep_args["browser"] = validated["browser"]
            if "url" in validated:
                driver_prep_args["url"] = validated["url"]
            res = driver.call_tool("browser_prepare", driver_prep_args, timeout_s=prep_timeout_s)
            if res.get("isError"):
                err_txt = "".join(c.get("text", "") for c in (res.get("content") or []) if isinstance(c, Mapping))
                raise RuntimeError(err_txt or "browser_prepare returned isError=true")
            sc = res.get("structuredContent") if isinstance(res.get("structuredContent"), Mapping) else {}
            eo = sc.get("endpoint_ownership") if isinstance(sc.get("endpoint_ownership"), Mapping) else {}
            raw_pid = sc.get("prepared_pid") or sc.get("pid") or eo.get("owner_pid")
            prepared_pid = (
                int(raw_pid)
                if isinstance(raw_pid, int) and not isinstance(raw_pid, bool) and raw_pid > 0
                else None
            )
            raw_wid = sc.get("window_id")
            window_id = (
                int(raw_wid)
                if isinstance(raw_wid, int) and not isinstance(raw_wid, bool) and raw_wid > 0
                else None
            )
            target_id = str(sc.get("target_id") or sc.get("browser_target_id") or "").strip()
            tab_id = str(sc.get("tab_id") or sc.get("active_tab_id") or "").strip()

            if prepared_pid is not None and (not target_id or not tab_id):
                if window_id is None:
                    for attempt in range(10):
                        lw_res = driver.call_tool("list_windows", {"pid": prepared_pid})
                        lw_sc = lw_res.get("structuredContent") if isinstance(lw_res.get("structuredContent"), Mapping) else {}
                        wins = lw_sc.get("windows") if isinstance(lw_sc.get("windows"), list) else []
                        for w in wins:
                            if isinstance(w, Mapping) and isinstance(w.get("window_id"), int) and not isinstance(w.get("window_id"), bool):
                                if w.get("pid") in (None, prepared_pid):
                                    window_id = int(w["window_id"])
                                    break
                        if window_id is not None or attempt == 9:
                            break
                        time.sleep(0.15)
                if window_id is not None:
                    gbs_res = driver.call_tool(
                        "get_browser_state",
                        {"pid": prepared_pid, "window_id": window_id, "include_screenshot": False},
                        timeout_s=prep_timeout_s,
                    )
                    if gbs_res.get("isError"):
                        err_txt = "".join(c.get("text", "") for c in (gbs_res.get("content") or []) if isinstance(c, Mapping))
                        raise RuntimeError(err_txt or "get_browser_state bind after browser_prepare returned isError=true")
                    gbs_sc = gbs_res.get("structuredContent") if isinstance(gbs_res.get("structuredContent"), Mapping) else {}
                    tabs = gbs_sc.get("tabs") if isinstance(gbs_sc.get("tabs"), list) else []
                    first_tab_id = tabs[0].get("tab_id") if (tabs and isinstance(tabs[0], Mapping)) else None
                    target_id = str(gbs_sc.get("target_id") or gbs_sc.get("browser_target_id") or target_id or "isolated").strip()
                    tab_id = str(gbs_sc.get("tab_id") or gbs_sc.get("active_tab_id") or first_tab_id or tab_id or "tab-1").strip()
                    if validated.get("url"):
                        nav_res = driver.call_tool(
                            "browser_navigate",
                            {"target_id": target_id, "tab_id": tab_id, "url": validated["url"]},
                            timeout_s=prep_timeout_s,
                        )
                        if nav_res.get("isError"):
                            err_txt = "".join(c.get("text", "") for c in (nav_res.get("content") or []) if isinstance(c, Mapping))
                            raise RuntimeError(err_txt or "browser_navigate after browser_prepare returned isError=true")

            target_id = target_id or "isolated"
            tab_id = tab_id or "tab-1"
            payload = {
                "schema": "agy_cua.jev_browser_prepare_v1",
                "status": "ok",
                "mode": "isolated",
                "prepared_pid": prepared_pid,
                "pid": prepared_pid,
                "window_id": window_id,
                "target_id": target_id,
                "tab_id": tab_id,
                "url": validated.get("url") or sc.get("url"),
                "session_id": self.session_id,
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=False)
        except Exception as exc:
            payload = {
                "schema": "agy_cua.jev_browser_prepare_v1",
                "status": "failed",
                "reason": str(exc),
                "session_id": self.session_id,
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)

    def handle_browser_step(self, args: Mapping[str, Any]) -> dict[str, Any]:
        step_started = time.perf_counter()
        if not isinstance(args, Mapping):
            return _format_tool_result(
                {"schema": "agy_cua.jev_browser_step_v1", "status": "refused", "reason": "invalid_arguments", "action_dispatched": False},
                is_error=True,
            )
        if self.accounting.halted:
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_browser_step_v1",
                    "status": "halted",
                    "reason": self.accounting.halt_reason or "session_halted",
                    "session_id": self.session_id,
                    "action_dispatched": False,
                    "uncertain_side_effect": False,
                    "accounting": self.accounting.to_dict(),
                },
                is_error=True,
            )
        try:
            _reject_binary_or_image_payload(args, "jev_browser_step")
        except ValueError as exc:
            return _format_tool_result(
                {"schema": "agy_cua.jev_browser_step_v1", "status": "refused", "reason": str(exc), "action_dispatched": False},
                is_error=True,
            )

        goal = args.get("goal")
        if not isinstance(goal, str) or not goal.strip() or len(goal) > MAX_GOAL_CHARS:
            return _format_tool_result(
                {"schema": "agy_cua.jev_browser_step_v1", "status": "refused", "reason": "invalid_goal", "action_dispatched": False},
                is_error=True,
            )
        wait_timeout_ms_val: int | None = None
        if "wait_timeout_ms" in args and args["wait_timeout_ms"] is not None:
            raw_wait_to = args["wait_timeout_ms"]
            if (
                not isinstance(raw_wait_to, int)
                or isinstance(raw_wait_to, bool)
                or raw_wait_to < MIN_WAIT_TIMEOUT_MS
                or raw_wait_to > MAX_WAIT_TIMEOUT_MS
            ):
                return _format_tool_result(
                    {"schema": "agy_cua.jev_browser_step_v1", "status": "refused", "reason": "invalid_wait_timeout_ms", "action_dispatched": False},
                    is_error=True,
                )
            wait_timeout_ms_val = raw_wait_to

        target_id = str(args.get("target_id") or "isolated").strip()
        tab_id = str(args.get("tab_id") or "tab-1").strip()
        action_value = args.get("value") if isinstance(args.get("value"), str) else None
        mode = str(args.get("mode") or ("deterministic" if args.get("deterministic") is True else "jev")).strip()
        expected_snap = args.get("expected_snapshot_id")

        obs_started = time.perf_counter()
        try:
            driver = self._get_driver()
            raw_pre = driver.call_tool(
                "get_browser_state",
                {
                    "target_id": target_id,
                    "tab_id": tab_id,
                    "include_screenshot": False,
                    "snapshot_format": "semantic_v2",
                },
            )
            if raw_pre.get("isError"):
                err_txt = "".join(c.get("text", "") for c in (raw_pre.get("content") or []) if isinstance(c, Mapping))
                raise RuntimeError(err_txt or "get_browser_state returned isError=true")
            pre_obs = extract_browser_observation(
                raw_pre,
                expected_target_id=target_id,
                expected_tab_id=tab_id,
                max_elements_cap=self.max_elements_cap,
                max_auto_candidates=self.max_auto_candidates,
            )
        except Exception as exc:
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_browser_step_v1",
                    "status": "observation_failed",
                    "verification_outcome": "not_executed",
                    "reason": str(exc),
                    "target_id": target_id,
                    "tab_id": tab_id,
                    "session_id": self.session_id,
                    "verified": False,
                    "action_dispatched": False,
                    "uncertain_side_effect": False,
                },
                is_error=True,
            )
        obs_ms = round((time.perf_counter() - obs_started) * 1000, 2)

        if expected_snap is not None and pre_obs["snapshot_id"] != expected_snap:
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_browser_step_v1",
                    "status": "stale_snapshot",
                    "verification_outcome": "not_executed",
                    "reason": f"stale_snapshot: expected {expected_snap!r}, observed {pre_obs['snapshot_id']!r}",
                    "target_id": target_id,
                    "tab_id": tab_id,
                    "pre_snapshot_id": pre_obs["snapshot_id"],
                    "session_id": self.session_id,
                    "verified": False,
                    "action_dispatched": False,
                    "uncertain_side_effect": False,
                },
                is_error=True,
            )

        try:
            bound_cands = build_bound_browser_candidates(
                args.get("candidates"),
                pre_obs,
                action_value=action_value,
                max_auto_candidates=self.max_auto_candidates,
            )
        except Exception as exc:
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_browser_step_v1",
                    "status": "candidate_refused",
                    "verification_outcome": "not_executed",
                    "reason": str(exc),
                    "target_id": target_id,
                    "tab_id": tab_id,
                    "pre_snapshot_id": pre_obs["snapshot_id"],
                    "session_id": self.session_id,
                    "verified": False,
                    "action_dispatched": False,
                    "uncertain_side_effect": False,
                },
                is_error=True,
            )

        reranked = False
        if mode == "deterministic":
            if len(bound_cands) != 1:
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_browser_step_v1",
                        "status": "candidate_refused",
                        "reason": "deterministic_step_requires_single_candidate",
                        "target_id": target_id,
                        "tab_id": tab_id,
                        "verified": False,
                        "action_dispatched": False,
                        "uncertain_side_effect": False,
                    },
                    is_error=True,
                )
            only_cand = bound_cands[0]
            decision = {
                "kind": "selected",
                "selected_id": only_cand["id"],
                "requested_model": "deterministic-controller",
                "returned_model": "deterministic-controller",
                "route": "deterministic",
                "confidence": 1.0,
                "probabilities": {only_cand["id"]: 1.0, "reobserve": 0.0, "abstain": 0.0},
                "provider_ms": 0.0,
            }
            provider_ms = 0.0
        else:
            synth_snap = (
                pre_obs["snapshot_id"]
                if SNAPSHOT_ID_RE.match(pre_obs["snapshot_id"])
                else f"s{abs(hash(pre_obs['snapshot_id'])) & 0xFFFFFFFF:08x}"
            )
            browser_select_els = [
                {
                    "element_index": e["element_index"],
                    "role": e["role"],
                    "label": f"[{e['ref']}] {e['label']}",
                    "state": e["state"],
                    "supported_actions": list(e.get("supported_actions") or []),
                }
                for e in pre_obs["elements"]
            ]
            try:
                raw_browser_req = _fit_select_request_to_byte_budget(
                    {
                        "goal": goal,
                        "pid": 1,
                        "window_id": 1,
                        "snapshot_id": synth_snap,
                        "elements": browser_select_els[: self.max_elements_cap],
                        "candidates": [{"id": c["id"], "description": c["description"]} for c in bound_cands],
                    },
                    max_json_bytes=self.max_json_bytes,
                )
                select_req = validate_select_request(
                    raw_browser_req,
                    max_elements=self.max_elements_cap,
                    max_candidates=self.max_candidates,
                    max_json_bytes=self.max_json_bytes,
                )
            except Exception as exc:
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_browser_step_v1",
                        "status": "candidate_refused",
                        "verification_outcome": "not_executed",
                        "reason": str(exc),
                        "target_id": target_id,
                        "tab_id": tab_id,
                        "pre_snapshot_id": pre_obs["snapshot_id"],
                        "session_id": self.session_id,
                        "verified": False,
                        "action_dispatched": False,
                        "uncertain_side_effect": False,
                    },
                    is_error=True,
                )
            route = resolve_route(self.env, self.keychain_reader)
            decision = evaluate_jev_choice(select_req, route, self.accounting, self.http_post)
            provider_ms = decision.get("provider_ms", 0.0)
            if (
                not self.v1_compat
                and _should_rerank_decision(decision, len(bound_cands))
                and self.accounting.calls_used < self.accounting.max_calls
            ):
                probs_p1 = decision.get("probabilities") if isinstance(decision.get("probabilities"), Mapping) else {}
                ranked_cands = sorted(
                    bound_cands,
                    key=lambda c: (1 if c["id"] == decision.get("selected_id") else 0, float(probs_p1.get(c["id"], 0.0))),
                    reverse=True,
                )
                shortlist_cands = ranked_cands[:V2_RERANK_SHORTLIST_K]
                short_refs = {
                    str(c["arguments"].get("ref"))
                    for c in shortlist_cands
                    if isinstance(c.get("arguments"), Mapping) and c["arguments"].get("ref")
                }
                short_els = (
                    [
                        se
                        for se, orig_e in zip(browser_select_els, pre_obs["elements"])
                        if str(orig_e.get("ref")) in short_refs
                    ]
                    if short_refs
                    else browser_select_els[:V2_RERANK_SHORTLIST_K]
                )
                rerank_goal = _build_rerank_goal(
                    goal,
                    f" (disambiguate shortlisted top-{len(shortlist_cands)} browser candidates)",
                )
                try:
                    rerank_req = validate_select_request(
                        {
                            "goal": rerank_goal,
                            "pid": 1,
                            "window_id": 1,
                            "snapshot_id": synth_snap,
                            "elements": short_els,
                            "candidates": [{"id": c["id"], "description": c["description"]} for c in shortlist_cands],
                        },
                        max_elements=self.max_elements_cap,
                        max_candidates=self.max_candidates,
                        max_json_bytes=self.max_json_bytes,
                    )
                except ValueError:
                    rerank_req = None
                if rerank_req is not None:
                    rerank_dec = evaluate_jev_choice(rerank_req, route, self.accounting, self.http_post)
                    provider_ms = round(float(provider_ms) + float(rerank_dec.get("provider_ms", 0.0)), 2)
                    decision = rerank_dec
                    reranked = True

        if decision["kind"] != "selected":
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_browser_step_v1",
                    "status": decision["kind"],
                    "verification_outcome": "not_executed",
                    "reason": decision.get("reason") or decision["kind"],
                    "target_id": target_id,
                    "tab_id": tab_id,
                    "pre_snapshot_id": pre_obs["snapshot_id"],
                    "selected_id": decision.get("selected_id"),
                    "reranked": reranked,
                    "verified": False,
                    "action_dispatched": False,
                    "uncertain_side_effect": False,
                    "accounting": self.accounting.to_dict(),
                },
                is_error=(decision["kind"] == "error"),
            )

        try:
            authorized = authorize_browser_candidate_dispatch(
                decision,
                bound_cands,
                expected_target_id=target_id,
                expected_tab_id=tab_id,
                current_snapshot_id=pre_obs["snapshot_id"],
                valid_refs=pre_obs["valid_refs"],
            )
        except Exception as exc:
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_browser_step_v1",
                    "status": "authorization_refused",
                    "verification_outcome": "not_executed",
                    "reason": str(exc),
                    "target_id": target_id,
                    "tab_id": tab_id,
                    "pre_snapshot_id": pre_obs["snapshot_id"],
                    "reranked": reranked,
                    "verified": False,
                    "action_dispatched": False,
                    "uncertain_side_effect": False,
                },
                is_error=True,
            )

        dispatch_driver_args = {
            k: v for k, v in authorized["arguments"].items() if k != "snapshot_id"
        }
        dispatch_started = time.perf_counter()
        try:
            dispatch_res = driver.call_tool(authorized["tool"], dispatch_driver_args)
            dispatch_text = "".join(
                c.get("text", "") for c in (dispatch_res.get("content") or []) if isinstance(c, Mapping)
            ).strip()
            if dispatch_res.get("isError"):
                raise RuntimeError(dispatch_text or "browser tool returned isError=true")
        except Exception as exc:
            self.accounting.uncertain_side_effects += 1
            self.accounting.halted = True
            self.accounting.halt_reason = "uncertain_browser_dispatch_side_effect"
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_browser_step_v1",
                    "status": "dispatch_failed",
                    "verification_outcome": "outcome_unknown",
                    "reason": str(exc),
                    "target_id": target_id,
                    "tab_id": tab_id,
                    "pre_snapshot_id": pre_obs["snapshot_id"],
                    "reranked": reranked,
                    "verified": False,
                    "action_dispatched": False,
                    "uncertain_side_effect": True,
                    "accounting": self.accounting.to_dict(),
                },
                is_error=True,
            )
        dispatch_ms = round((time.perf_counter() - dispatch_started) * 1000, 2)

        expected_post = args.get("expected_postcondition")
        eff_wait_ms = (
            0
            if expected_post is None
            else (
                wait_timeout_ms_val
                if wait_timeout_ms_val is not None
                else (0 if self.v1_compat else DEFAULT_V2_WAIT_TIMEOUT_MS)
            )
        )
        verify_polls = 0
        verify_started = time.perf_counter()
        verify_started_mono = time.monotonic()
        drv_base_s = getattr(driver, "timeout_ms", DEFAULT_DRIVER_TIMEOUT_MS) / 1000.0
        try:
            def _read_post_browser_obs(*, poll_deadline: float | None = None) -> dict[str, Any]:
                call_timeout_s = drv_base_s
                if poll_deadline is not None:
                    rem_s = poll_deadline - time.monotonic()
                    if rem_s <= 0:
                        raise TimeoutError("settle_timeout_exceeded")
                    call_timeout_s = min(drv_base_s, rem_s)
                raw_p = driver.call_tool(
                    "get_browser_state",
                    {
                        "target_id": target_id,
                        "tab_id": tab_id,
                        "include_screenshot": False,
                        "snapshot_format": "semantic_v2",
                    },
                    timeout_s=call_timeout_s,
                    deadline_monotonic=poll_deadline,
                )
                if raw_p.get("isError"):
                    err_t = "".join(c.get("text", "") for c in (raw_p.get("content") or []) if isinstance(c, Mapping))
                    raise RuntimeError(err_t or "post-dispatch get_browser_state returned isError=true")
                return extract_browser_observation(
                    raw_p,
                    expected_target_id=target_id,
                    expected_tab_id=tab_id,
                    max_elements_cap=self.max_elements_cap,
                    max_auto_candidates=self.max_auto_candidates,
                )

            post_obs = _read_post_browser_obs()
            verify_polls = 1
            state_changed, post_ok, verify_reason = check_browser_postcondition(
                expected_post,
                pre_obs,
                post_obs,
                target_ref=authorized["arguments"].get("ref"),
            )
            if eff_wait_ms > 0 and not post_ok and _is_retryable_postcondition_reason(verify_reason):
                settle_deadline = verify_started_mono + (eff_wait_ms / 1000.0)
                min_browser_read_s = 0.05
                while not post_ok and _is_retryable_postcondition_reason(verify_reason):
                    rem_settle = settle_deadline - time.monotonic()
                    if rem_settle <= min_browser_read_s + 0.01:
                        break
                    time.sleep(min(0.10, max(0.01, rem_settle - min_browser_read_s)))
                    if settle_deadline - time.monotonic() < min_browser_read_s:
                        break
                    try:
                        post_obs = _read_post_browser_obs(poll_deadline=settle_deadline)
                    except TimeoutError:
                        break
                    verify_polls += 1
                    state_changed, post_ok, verify_reason = check_browser_postcondition(
                        expected_post,
                        pre_obs,
                        post_obs,
                        target_ref=authorized["arguments"].get("ref"),
                    )
        except Exception as exc:
            self.accounting.uncertain_side_effects += 1
            self.accounting.halted = True
            self.accounting.halt_reason = "uncertain_browser_verification"
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_browser_step_v1",
                    "status": "verification_failed",
                    "verification_outcome": "outcome_unknown",
                    "reason": str(exc),
                    "target_id": target_id,
                    "tab_id": tab_id,
                    "pre_snapshot_id": pre_obs["snapshot_id"],
                    "reranked": reranked,
                    "verified": False,
                    "action_dispatched": True,
                    "uncertain_side_effect": True,
                    "accounting": self.accounting.to_dict(),
                },
                is_error=True,
            )
        verify_ms = round((time.perf_counter() - verify_started) * 1000, 2)

        if args.get("expected_postcondition") is None:
            verification_outcome = "state_changed" if state_changed else "dispatched"
            step_status = verification_outcome
            is_err = False
        elif post_ok:
            verification_outcome = "goal_verified"
            step_status = "verified"
            is_err = False
        else:
            verification_outcome = "state_changed" if state_changed else "dispatched"
            step_status = "postcondition_unmet"
            is_err = True

        sanitized_args = {
            k: ("<redacted>" if k in {"text", "value"} else v)
            for k, v in authorized["arguments"].items()
        }
        payload = {
            "schema": "agy_cua.jev_browser_step_v1",
            "status": step_status,
            "verification_outcome": verification_outcome,
            "verified": post_ok,
            "action_dispatched": True,
            "uncertain_side_effect": False,
            "verification_reason": verify_reason,
            "verify_polls": verify_polls,
            "reranked": reranked,
            "state_changed": state_changed,
            "target_id": target_id,
            "tab_id": tab_id,
            "session_id": self.session_id,
            "mode": mode,
            "pre_snapshot_id": pre_obs["snapshot_id"],
            "post_snapshot_id": post_obs["snapshot_id"],
            "pre_url": pre_obs["url"],
            "post_url": post_obs["url"],
            "pre_static_texts": pre_obs["static_texts"],
            "post_static_texts": post_obs["static_texts"],
            "selected_id": authorized["id"],
            "selected_description": authorized["description"],
            "dispatched_tool": authorized["tool"],
            "dispatched_arguments": sanitized_args,
            "returned_model": decision.get("returned_model"),
            "confidence": decision.get("confidence"),
            "probabilities": decision.get("probabilities"),
            "timings_ms": {
                "observe_ms": obs_ms,
                "provider_ms": provider_ms,
                "dispatch_ms": dispatch_ms,
                "verify_ms": verify_ms,
                "total_ms": round((time.perf_counter() - step_started) * 1000, 2),
            },
            "accounting": self.accounting.to_dict(),
        }
        self._record_trace(payload)
        return _format_tool_result(payload, is_error=is_err)

    def handle_batch(self, args: Mapping[str, Any]) -> dict[str, Any]:
        batch_started = time.perf_counter()
        if not isinstance(args, Mapping):
            return _format_tool_result(
                {"schema": "agy_cua.jev_batch_v1", "status": "refused", "reason": "invalid_arguments"},
                is_error=True,
            )

        raw_steps = args.get("steps")
        steps_list = raw_steps if isinstance(raw_steps, list) else []

        def format_remaining(start_idx: int) -> list[dict[str, Any]]:
            rem: list[dict[str, Any]] = []
            for idx in range(start_idx, len(steps_list)):
                item = steps_list[idx]
                if isinstance(item, Mapping):
                    rem.append({
                        "step_index": idx,
                        "goal": item.get("goal"),
                        "mode": item.get("mode", "jev"),
                        "expected_postcondition": item.get("expected_postcondition"),
                    })
                else:
                    rem.append({"step_index": idx})
            return rem

        if self.accounting.halted:
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_batch_v1",
                    "status": "halted",
                    "verification_outcome": "not_executed",
                    "reason": self.accounting.halt_reason or "session_halted",
                    "verified": False,
                    "uncertain_side_effect": False,
                    "session_id": self.session_id,
                    "total_steps": len(steps_list),
                    "completed_count": 0,
                    "completed_steps": [],
                    "failed_step": None,
                    "remaining_steps": format_remaining(0),
                    "accounting": self.accounting.to_dict(),
                },
                is_error=True,
            )

        pid = args.get("pid")
        window_id = args.get("window_id")
        if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
            return _format_tool_result(
                {"schema": "agy_cua.jev_batch_v1", "status": "refused", "reason": "invalid_pid"},
                is_error=True,
            )
        if not isinstance(window_id, int) or isinstance(window_id, bool) or window_id <= 0:
            return _format_tool_result(
                {"schema": "agy_cua.jev_batch_v1", "status": "refused", "reason": "invalid_window_id"},
                is_error=True,
            )
        if not isinstance(raw_steps, list) or len(raw_steps) < 1 or len(raw_steps) > MAX_BATCH_STEPS:
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_batch_v1",
                    "status": "refused",
                    "reason": f"steps must be a non-empty list of at most {MAX_BATCH_STEPS} steps",
                    "pid": pid,
                    "window_id": window_id,
                    "session_id": self.session_id,
                },
                is_error=True,
            )

        if "chain_observations" in args and args["chain_observations"] is not None:
            if not isinstance(args["chain_observations"], bool):
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_batch_v1",
                        "status": "refused",
                        "reason": "invalid_chain_observations",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                    },
                    is_error=True,
                )

        initial_expected_snap = args.get("expected_snapshot_id")
        if initial_expected_snap is not None and (
            not isinstance(initial_expected_snap, str) or not SNAPSHOT_ID_RE.match(initial_expected_snap)
        ):
            return _format_tool_result(
                {
                    "schema": "agy_cua.jev_batch_v1",
                    "status": "refused",
                    "reason": "invalid_expected_snapshot_id",
                    "pid": pid,
                    "window_id": window_id,
                    "session_id": self.session_id,
                },
                is_error=True,
            )

        # Upfront validation of every step in the batch before executing step 0
        for idx, step_spec in enumerate(raw_steps):
            if not isinstance(step_spec, Mapping):
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_batch_v1",
                        "status": "refused",
                        "reason": f"step[{idx}] must be an object",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                    },
                    is_error=True,
                )
            s_goal = step_spec.get("goal")
            if not isinstance(s_goal, str) or not s_goal.strip() or len(s_goal) > MAX_GOAL_CHARS:
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_batch_v1",
                        "status": "refused",
                        "reason": f"step[{idx}] missing valid goal",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                    },
                    is_error=True,
                )
            if "value" in step_spec and step_spec["value"] is not None:
                if not isinstance(step_spec["value"], str):
                    return _format_tool_result(
                        {
                            "schema": "agy_cua.jev_batch_v1",
                            "status": "refused",
                            "reason": f"step[{idx}] invalid value",
                            "pid": pid,
                            "window_id": window_id,
                            "session_id": self.session_id,
                        },
                        is_error=True,
                    )
            s_snap = step_spec.get("expected_snapshot_id")
            if s_snap is not None and (not isinstance(s_snap, str) or not SNAPSHOT_ID_RE.match(s_snap)):
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_batch_v1",
                        "status": "refused",
                        "reason": f"step[{idx}] invalid expected_snapshot_id",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                    },
                    is_error=True,
                )
            s_mode = str(step_spec.get("mode") or ("deterministic" if step_spec.get("deterministic") is True else "jev")).strip()
            if s_mode not in {"jev", "deterministic"}:
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_batch_v1",
                        "status": "refused",
                        "reason": f"step[{idx}] invalid mode={s_mode!r}",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                    },
                    is_error=True,
                )
            if "query" in step_spec and step_spec["query"] is not None:
                s_q = step_spec["query"]
                if not isinstance(s_q, str) or not s_q.strip():
                    return _format_tool_result(
                        {
                            "schema": "agy_cua.jev_batch_v1",
                            "status": "refused",
                            "reason": f"step[{idx}] invalid query",
                            "pid": pid,
                            "window_id": window_id,
                            "session_id": self.session_id,
                        },
                        is_error=True,
                    )
            if "max_depth" in step_spec and step_spec["max_depth"] is not None:
                s_d = step_spec["max_depth"]
                if (
                    not isinstance(s_d, int)
                    or isinstance(s_d, bool)
                    or s_d < MIN_OBSERVE_MAX_DEPTH
                    or s_d > MAX_OBSERVE_MAX_DEPTH
                ):
                    return _format_tool_result(
                        {
                            "schema": "agy_cua.jev_batch_v1",
                            "status": "refused",
                            "reason": f"step[{idx}] invalid max_depth",
                            "pid": pid,
                            "window_id": window_id,
                            "session_id": self.session_id,
                        },
                        is_error=True,
                    )
            if "max_elements" in step_spec and step_spec["max_elements"] is not None:
                s_max_el = step_spec["max_elements"]
                if (
                    not isinstance(s_max_el, int)
                    or isinstance(s_max_el, bool)
                    or s_max_el < MIN_OBSERVE_MAX_ELEMENTS
                    or s_max_el > MAX_OBSERVE_MAX_ELEMENTS
                ):
                    return _format_tool_result(
                        {
                            "schema": "agy_cua.jev_batch_v1",
                            "status": "refused",
                            "reason": "invalid_max_elements",
                            "step_index": idx,
                            "pid": pid,
                            "window_id": window_id,
                            "session_id": self.session_id,
                        },
                        is_error=True,
                    )
            if "walk_timeout_ms" in step_spec and step_spec["walk_timeout_ms"] is not None:
                s_walk_to = step_spec["walk_timeout_ms"]
                if (
                    not isinstance(s_walk_to, int)
                    or isinstance(s_walk_to, bool)
                    or s_walk_to < MIN_OBSERVE_WALK_TIMEOUT_MS
                    or s_walk_to > MAX_OBSERVE_WALK_TIMEOUT_MS
                ):
                    return _format_tool_result(
                        {
                            "schema": "agy_cua.jev_batch_v1",
                            "status": "refused",
                            "reason": "invalid_walk_timeout_ms",
                            "step_index": idx,
                            "pid": pid,
                            "window_id": window_id,
                            "session_id": self.session_id,
                        },
                        is_error=True,
                    )
            if "skeleton" in step_spec and step_spec["skeleton"] is not None:
                if not isinstance(step_spec["skeleton"], bool):
                    return _format_tool_result(
                        {
                            "schema": "agy_cua.jev_batch_v1",
                            "status": "refused",
                            "reason": "invalid_skeleton",
                            "step_index": idx,
                            "pid": pid,
                            "window_id": window_id,
                            "session_id": self.session_id,
                        },
                        is_error=True,
                    )
            if "region" in step_spec and step_spec["region"] is not None:
                s_reg = step_spec["region"]
                if not isinstance(s_reg, str) or not s_reg.strip():
                    return _format_tool_result(
                        {
                            "schema": "agy_cua.jev_batch_v1",
                            "status": "refused",
                            "reason": "invalid_region",
                            "step_index": idx,
                            "pid": pid,
                            "window_id": window_id,
                            "session_id": self.session_id,
                        },
                        is_error=True,
                    )
            if "root_element_index" in step_spec and step_spec["root_element_index"] is not None:
                s_root = step_spec["root_element_index"]
                if not isinstance(s_root, int) or isinstance(s_root, bool) or s_root < 0:
                    return _format_tool_result(
                        {
                            "schema": "agy_cua.jev_batch_v1",
                            "status": "refused",
                            "reason": "invalid_root_element_index",
                            "step_index": idx,
                            "pid": pid,
                            "window_id": window_id,
                            "session_id": self.session_id,
                        },
                        is_error=True,
                    )
            if "wait_timeout_ms" in step_spec and step_spec["wait_timeout_ms"] is not None:
                s_wait = step_spec["wait_timeout_ms"]
                if (
                    not isinstance(s_wait, int)
                    or isinstance(s_wait, bool)
                    or s_wait < MIN_WAIT_TIMEOUT_MS
                    or s_wait > MAX_WAIT_TIMEOUT_MS
                ):
                    return _format_tool_result(
                        {
                            "schema": "agy_cua.jev_batch_v1",
                            "status": "refused",
                            "reason": "invalid_wait_timeout_ms",
                            "step_index": idx,
                            "pid": pid,
                            "window_id": window_id,
                            "session_id": self.session_id,
                        },
                        is_error=True,
                    )
            s_cands = step_spec.get("candidates")
            if s_cands is not None and (
                not isinstance(s_cands, list) or len(s_cands) == 0 or len(s_cands) > self.max_auto_candidates
            ):
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_batch_v1",
                        "status": "refused",
                        "verification_outcome": "not_executed",
                        "reason": f"step[{idx}] candidates must be a non-empty list of at most {self.max_auto_candidates} items",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                    },
                    is_error=True,
                )
            if s_mode == "deterministic" and (not isinstance(s_cands, list) or len(s_cands) != 1):
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_batch_v1",
                        "status": "refused",
                        "reason": f"step[{idx}] deterministic mode requires a single candidate",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                    },
                    is_error=True,
                )
            has_el_cand = True
            if isinstance(s_cands, list):
                has_el_cand = bool(s_cands) and all(
                    isinstance(c, Mapping)
                    and (
                        "element_index" in c
                        or "element_token" in c
                        or (
                            isinstance(c.get("arguments"), Mapping)
                            and ("element_index" in c["arguments"] or "element_token" in c["arguments"])
                        )
                    )
                    for c in s_cands
                )
            post_err = _validate_batch_postcondition_spec(step_spec.get("expected_postcondition"), has_el_cand)
            if post_err is not None:
                return _format_tool_result(
                    {
                        "schema": "agy_cua.jev_batch_v1",
                        "status": "refused",
                        "verification_outcome": "not_executed",
                        "reason": f"step[{idx}] invalid expected_postcondition: {post_err}",
                        "pid": pid,
                        "window_id": window_id,
                        "session_id": self.session_id,
                        "verified": False,
                        "uncertain_side_effect": False,
                        "total_steps": len(raw_steps),
                        "completed_count": 0,
                        "completed_steps": [],
                        "failed_step": None,
                        "remaining_steps": format_remaining(0),
                        "accounting": self.accounting.to_dict(),
                    },
                    is_error=True,
                )

        was_owned = (pid, window_id) in self._owned_targets
        conflict = self._acquire_target(pid, window_id)
        if conflict is not None:
            payload = {
                "schema": "agy_cua.jev_batch_v1",
                "status": "target_conflict",
                "verification_outcome": "not_executed",
                "reason": conflict,
                "pid": pid,
                "window_id": window_id,
                "session_id": self.session_id,
                "verified": False,
                "uncertain_side_effect": False,
                "total_steps": len(raw_steps),
                "completed_count": 0,
                "completed_steps": [],
                "failed_step": None,
                "remaining_steps": format_remaining(0),
                "accounting": self.accounting.to_dict(),
            }
            self._record_trace(payload)
            return _format_tool_result(payload, is_error=True)

        raw_timeout = (
            args["timeout_ms"]
            if "timeout_ms" in args and args["timeout_ms"] is not None
            else self.env.get("AGY_CUA_BATCH_TIMEOUT_MS")
        )
        batch_timeout_ms = clamp_batch_timeout_ms(raw_timeout)
        batch_deadline = time.monotonic() + (batch_timeout_ms / 1000.0)
        allow_drift = bool(args.get("allow_interstep_drift", False))
        chain_obs = bool(args.get("chain_observations", False))
        chain_effective = chain_obs and allow_drift

        completed_steps: list[dict[str, Any]] = []
        failed_step: dict[str, Any] | None = None
        remaining_steps: list[dict[str, Any]] = []
        prev_post_sig: tuple[Any, ...] | None = None
        prev_post_obs: dict[str, Any] | None = None
        prev_obs_scope: tuple[Any, ...] | None = None

        agg_observe_ms = 0.0
        agg_provider_ms = 0.0
        agg_dispatch_ms = 0.0
        agg_verify_ms = 0.0

        for idx, step_spec in enumerate(raw_steps):
            if time.monotonic() >= batch_deadline:
                failed_step = {
                    "step_index": idx,
                    "goal": step_spec.get("goal"),
                    "mode": step_spec.get("mode", "jev"),
                    "status": "batch_timeout",
                    "verification_outcome": "not_executed",
                    "verified": False,
                    "uncertain_side_effect": False,
                    "reason": f"batch_timeout_exceeded ({batch_timeout_ms} ms)",
                }
                remaining_steps = format_remaining(idx + 1)
                break

            step_args: dict[str, Any] = {
                "goal": step_spec["goal"],
                "pid": pid,
                "window_id": window_id,
                "expected_postcondition": step_spec["expected_postcondition"],
            }
            if "value" in step_spec and step_spec["value"] is not None:
                step_args["value"] = step_spec["value"]
            if "mode" in step_spec:
                step_args["mode"] = step_spec["mode"]
            if "deterministic" in step_spec:
                step_args["deterministic"] = step_spec["deterministic"]
            if "query" in step_spec and step_spec["query"] is not None:
                step_args["query"] = step_spec["query"]
            if "max_depth" in step_spec and step_spec["max_depth"] is not None:
                step_args["max_depth"] = step_spec["max_depth"]
            if "max_elements" in step_spec and step_spec["max_elements"] is not None:
                step_args["max_elements"] = step_spec["max_elements"]
            if "walk_timeout_ms" in step_spec and step_spec["walk_timeout_ms"] is not None:
                step_args["walk_timeout_ms"] = step_spec["walk_timeout_ms"]
            if "skeleton" in step_spec and step_spec["skeleton"] is not None:
                step_args["skeleton"] = step_spec["skeleton"]
            if "region" in step_spec and step_spec["region"] is not None:
                step_args["region"] = step_spec["region"]
            if "root_element_index" in step_spec and step_spec["root_element_index"] is not None:
                step_args["root_element_index"] = step_spec["root_element_index"]
            if "wait_timeout_ms" in step_spec and step_spec["wait_timeout_ms"] is not None:
                step_args["wait_timeout_ms"] = step_spec["wait_timeout_ms"]
            if "candidates" in step_spec:
                step_args["candidates"] = step_spec["candidates"]
            if "expected_snapshot_id" in step_spec:
                step_args["expected_snapshot_id"] = step_spec["expected_snapshot_id"]
            elif idx == 0 and initial_expected_snap is not None:
                step_args["expected_snapshot_id"] = initial_expected_snap

            curr_obs_scope = (
                step_spec["query"].strip() if isinstance(step_spec.get("query"), str) else None,
                step_spec.get("max_depth"),
                step_spec.get("max_elements"),
                step_spec.get("walk_timeout_ms"),
                bool(step_spec.get("skeleton", False)),
                step_spec["region"].strip() if isinstance(step_spec.get("region"), str) else None,
                step_spec.get("root_element_index"),
            )
            out_sig: list[tuple[Any, ...]] = []
            out_obs: list[dict[str, Any]] = []
            # A chained pre-observation IS step k's post-observation, so comparing its signature to
            # prev_post_sig is vacuous. Only reuse it when the caller has explicitly accepted interstep
            # drift; with drift protection on, take a fresh read so external changes are detected.
            use_chained_obs = (
                prev_post_obs
                if (chain_effective and prev_post_obs is not None and prev_obs_scope == curr_obs_scope)
                else None
            )
            summary_chained = use_chained_obs is not None
            step_res = self.handle_step(
                step_args,
                _deadline_monotonic=batch_deadline,
                _expected_pre_sig=(
                    None
                    if (allow_drift or prev_obs_scope != curr_obs_scope)
                    else prev_post_sig
                ),
                _out_post_sig=out_sig,
                _chained_obs=use_chained_obs,
                _out_post_obs=out_obs,
            )
            step_sc = step_res.get("structuredContent") or {}
            t_ms = step_sc.get("timings_ms") or {}
            agg_observe_ms = round(agg_observe_ms + float(t_ms.get("observe_ms", 0.0)), 2)
            agg_provider_ms = round(agg_provider_ms + float(t_ms.get("provider_ms", 0.0)), 2)
            agg_dispatch_ms = round(agg_dispatch_ms + float(t_ms.get("dispatch_ms", 0.0)), 2)
            agg_verify_ms = round(agg_verify_ms + float(t_ms.get("verify_ms", 0.0)), 2)

            summary_item = {
                "step_index": idx,
                "goal": step_spec["goal"],
                "mode": step_sc.get("mode", step_spec.get("mode", "jev")),
                "status": step_sc.get("status"),
                "verification_outcome": step_sc.get("verification_outcome"),
                "verified": bool(step_sc.get("verified")),
                "action_dispatched": bool(step_sc.get("action_dispatched", False)),
                "already_in_target_state": step_sc.get("already_in_target_state"),
                "auto_drilled": bool(step_sc.get("auto_drilled", False)),
                "uncertain_side_effect": bool(step_sc.get("uncertain_side_effect")),
                "reason": step_sc.get("verification_reason") or step_sc.get("reason"),
                "pre_snapshot_id": step_sc.get("pre_snapshot_id"),
                "post_snapshot_id": step_sc.get("post_snapshot_id"),
                "pre_static_texts": step_sc.get("pre_static_texts"),
                "post_static_texts": step_sc.get("post_static_texts"),
                "selected_id": step_sc.get("selected_id"),
                "dispatched_tool": step_sc.get("dispatched_tool"),
                "dispatched_arguments": step_sc.get("dispatched_arguments"),
                "requested_model": step_sc.get("requested_model"),
                "returned_model": step_sc.get("returned_model"),
                "sdk_identity": step_sc.get("sdk_identity"),
                "confidence": step_sc.get("confidence"),
                "reranked": bool(step_sc.get("reranked", False)),
                "verify_polls": step_sc.get("verify_polls", 1),
                "observation_chained": summary_chained,
                "timings_ms": t_ms,
            }

            if step_sc.get("status") == "verified" and step_sc.get("verification_outcome") == "goal_verified":
                completed_steps.append(summary_item)
                prev_post_sig = out_sig[0] if out_sig else None
                prev_post_obs = out_obs[0] if out_obs else None
                if step_sc.get("auto_drilled"):
                    if step_sc.get("region") is None and step_sc.get("root_element_index") is None:
                        prev_obs_scope = None
                    else:
                        prev_obs_scope = (
                            curr_obs_scope[0],
                            curr_obs_scope[1],
                            curr_obs_scope[2],
                            curr_obs_scope[3],
                            False,
                            step_sc.get("region"),
                            step_sc.get("root_element_index"),
                        )
                else:
                    prev_obs_scope = curr_obs_scope
            else:
                failed_step = summary_item
                remaining_steps = format_remaining(idx + 1)
                break

        if (
            not was_owned
            and not completed_steps
            and (failed_step or {}).get("verification_outcome") == "not_executed"
        ):
            self._release_single_target(pid, window_id)

        all_verified = failed_step is None and len(completed_steps) == len(raw_steps)
        uncertain = bool(failed_step and failed_step.get("uncertain_side_effect"))
        batch_status = "verified" if all_verified else str((failed_step or {}).get("status") or "batch_failed")
        batch_outcome = (
            "goal_verified"
            if all_verified
            else str((failed_step or {}).get("verification_outcome") or "not_executed")
        )
        first_pre_snap = (
            completed_steps[0].get("pre_snapshot_id")
            if completed_steps
            else (failed_step or {}).get("pre_snapshot_id")
        )
        last_post_snap = (
            completed_steps[-1].get("post_snapshot_id")
            if all_verified and completed_steps
            else (failed_step or {}).get("post_snapshot_id")
        )
        last_post_texts = (
            completed_steps[-1].get("post_static_texts")
            if all_verified and completed_steps
            else (
                (failed_step or {}).get("post_static_texts")
                or (completed_steps[-1].get("post_static_texts") if completed_steps else [])
            )
        )
        step_models = [
            s.get("returned_model")
            for s in (completed_steps + ([failed_step] if failed_step else []))
            if isinstance(s.get("returned_model"), str)
        ]
        batch_model = PINNED_JEV_MODEL if PINNED_JEV_MODEL in step_models else (step_models[-1] if step_models else None)

        batch_payload = {
            "schema": "agy_cua.jev_batch_v1",
            "status": batch_status,
            "verification_outcome": batch_outcome,
            "verified": all_verified,
            "all_verified": all_verified,
            "goal_verified": all_verified,
            "chain_observations_effective": chain_effective,
            "uncertain_side_effect": uncertain,
            "pid": pid,
            "window_id": window_id,
            "session_id": self.session_id,
            "pre_snapshot_id": first_pre_snap,
            "post_snapshot_id": last_post_snap,
            "post_static_texts": list(last_post_texts or []),
            "selected_ids": [s["selected_id"] for s in completed_steps if isinstance(s.get("selected_id"), str)],
            "returned_model": batch_model,
            "sdk_identity": CLIENT_IDENTITY,
            "total_steps": len(raw_steps),
            "completed_count": len(completed_steps),
            "completed_steps": completed_steps,
            "failed_step": failed_step,
            "remaining_steps": remaining_steps,
            "halted_at_step_index": None if all_verified else (failed_step or {}).get("step_index"),
            "steps": completed_steps + ([failed_step] if failed_step else []),
            "timings_ms": {
                "observe_ms": agg_observe_ms,
                "provider_ms": agg_provider_ms,
                "dispatch_ms": agg_dispatch_ms,
                "verify_ms": agg_verify_ms,
                "total_ms": round((time.perf_counter() - batch_started) * 1000, 2),
            },
            "accounting": self.accounting.to_dict(),
        }
        self._record_trace(batch_payload)
        return _format_tool_result(batch_payload, is_error=(not all_verified))

    def handle_sequence(self, args: Mapping[str, Any]) -> dict[str, Any]:
        if not isinstance(args, Mapping):
            return self.handle_batch(args)
        seq_args = dict(args)
        seq_args.setdefault("chain_observations", True)
        return self.handle_batch(seq_args)

    def handle_message(self, message: Any) -> dict[str, Any] | None:
        if not isinstance(message, Mapping):
            return {"jsonrpc": "2.0", "id": None, "error": {"code": -32600, "message": "Invalid Request"}}
        req_id = message.get("id")
        is_request = "id" in message and req_id is not None
        method = message.get("method")
        params = message.get("params") if isinstance(message.get("params"), Mapping) else {}

        def reply(result: Any) -> dict[str, Any] | None:
            return {"jsonrpc": "2.0", "id": req_id, "result": result} if is_request else None

        def fail(code: int, text: str) -> dict[str, Any] | None:
            return {"jsonrpc": "2.0", "id": req_id, "error": {"code": code, "message": text}} if is_request else None

        if method == "initialize":
            return reply({
                "protocolVersion": params.get("protocolVersion") or DEFAULT_PROTOCOL,
                "capabilities": {"tools": {}},
                "serverInfo": SERVER_INFO,
            })
        if method == "ping":
            return reply({})
        if method == "tools/list":
            return reply({"tools": TOOLS})
        if method == "resources/list":
            return reply({"resources": []})
        if method == "resources/templates/list":
            return reply({"resourceTemplates": []})
        if method == "prompts/list":
            return reply({"prompts": []})
        if method == "tools/call":
            name = params.get("name")
            arguments = params.get("arguments") if isinstance(params.get("arguments"), Mapping) else {}
            if name == "jev_status":
                route = resolve_route(self.env, self.keychain_reader)
                status_payload = describe_status(route, self.accounting, self.env)
                status_payload["session_id"] = self.session_id
                return reply(_format_tool_result(status_payload))
            if name == "jev_observe":
                return reply(self.handle_observe(arguments))
            if name == "jev_select_action":
                try:
                    validated = validate_select_request(
                        arguments,
                        max_elements=self.max_elements_cap,
                        max_candidates=self.max_candidates,
                        max_json_bytes=self.max_json_bytes,
                    )
                except ValueError as exc:
                    err_payload = {
                        "schema": "agy_cua.jev_decision_v1",
                        "kind": "error",
                        "reason": "invalid_request",
                        "note": str(exc),
                        "accounting": self.accounting.to_dict(),
                    }
                    self._record_trace(err_payload)
                    return reply(_format_tool_result(err_payload, is_error=True))
                route = resolve_route(self.env, self.keychain_reader)
                decision = evaluate_jev_choice(validated, route, self.accounting, self.http_post)
                self._record_trace(decision)
                return reply(_format_tool_result(decision, is_error=(decision["kind"] == "error")))
            if name == "jev_step":
                return reply(self.handle_step(arguments))
            if name == "jev_browser_prepare":
                return reply(self.handle_browser_prepare(arguments))
            if name == "jev_browser_step":
                return reply(self.handle_browser_step(arguments))
            if name in {"jev_batch", "jev_run_steps"}:
                return reply(self.handle_batch(arguments))
            if name == "jev_sequence":
                return reply(self.handle_sequence(arguments))
            return fail(-32602, f"Unknown tool: {name}")
        if isinstance(method, str) and method.startswith("notifications/"):
            return None
        return fail(-32601, f"Method not found: {method}")

    def close(self) -> None:
        if self._closed:
            return
        self._closed = True
        self._release_targets()
        if self._driver_client is not None:
            self._driver_client.close()


def main(argv: list[str] | None = None) -> int:
    args = argv if argv is not None else sys.argv[1:]
    server = JevMcpServer()
    if args == ["--check"]:
        route = resolve_route(server.env, server.keychain_reader)
        sys.stdout.write(json.dumps(describe_status(route, server.accounting, server.env), indent=2) + "\n")
        return 0 if route.kind != "none" else 1
    if args == ["--probe"]:
        route = resolve_route(server.env, server.keychain_reader)
        req = validate_select_request({
            "goal": "Click button 7",
            "pid": 1,
            "window_id": 1,
            "snapshot_id": "s00000001",
            "elements": [{"element_index": 5, "role": "AXButton", "label": "7", "state": "enabled"}],
            "candidates": [{"id": "ax.5.7", "description": 'Click [5] AXButton "7"'}],
        })
        decision = evaluate_jev_choice(req, route, server.accounting, server.http_post)
        sys.stdout.write(json.dumps(decision, indent=2) + "\n")
        return 0 if decision.get("kind") == "selected" and decision.get("selected_id") == "ax.5.7" else 1
    if args:
        sys.stderr.write("usage: agy-cua-jev-mcp [--check | --probe]\n")
        return 2

    for signum in (signal.SIGTERM, signal.SIGINT):
        signal.signal(signum, lambda *_: (server.close(), sys.exit(0)))

    try:
        while raw_bytes := sys.stdin.buffer.readline():
            line = raw_bytes.decode("utf-8", errors="replace").strip()
            if not line:
                continue
            try:
                msg = json.loads(line)
            except ValueError:
                sys.stdout.write(
                    json.dumps({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "Parse error"}})
                    + "\n"
                )
                sys.stdout.flush()
                continue
            resp = server.handle_message(msg)
            if resp is not None:
                sys.stdout.write(json.dumps(resp, ensure_ascii=False) + "\n")
                sys.stdout.flush()
    finally:
        server.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
