#!/usr/bin/env python3
"""Minimal pass-through stdio MCP shim between Antigravity and `cua-driver mcp`.

Upstream trycua/cua#4346 shipped text-visible `snapshot_id` and `element_token`
headers directly in `cua-driver` (verified in 0.60.0+), retiring the old
`get_window_state` text-injection workaround. This shim resolves `cua-driver`,
forwards `--direct` when `AGY_CUA_DRIVER_DIRECT=1`, and `exec`s `cua-driver mcp`.
"""
import os
import sys

DRIVER_CANDIDATES = [
    os.environ.get("AGY_CUA_DRIVER", ""),
    os.path.expanduser("~/.local/bin/cua-driver"),
    "/Applications/CuaDriver.app/Contents/MacOS/cua-driver",
]


def driver_path():
    for candidate in DRIVER_CANDIDATES:
        if candidate and os.access(candidate, os.X_OK):
            return candidate
    sys.stderr.write("agy-cua: cua-driver not found; run `agy-cua doctor`\n")
    sys.exit(127)


def build_driver_argv(driver, argv, env=os.environ):
    extra_args = list(argv)
    if env.get("AGY_CUA_DRIVER_DIRECT") == "1" and "--direct" not in extra_args:
        extra_args.insert(0, "--direct")
    return [driver, "mcp", *extra_args]


def main():
    driver = driver_path()
    os.execv(driver, build_driver_argv(driver, sys.argv[1:], os.environ))


if __name__ == "__main__":
    main()
